+    /// Every equal-area cell has the same ellipsoidal area: integrate the WGS-84 area element
+    /// M(phi) N(phi) cos(phi) over two cells far apart in latitude, independently of q.
+    #[test]
+    fn equal_area_cells_have_equal_ellipsoidal_area() {
+        let e2 = geo::WGS84_E2;
+        let a = geo::WGS84_A_KM;
+        let element = |phi: f64| {
+            let w = 1.0 - e2 * phi.sin().powi(2);
+            (a * (1.0 - e2) / w.powf(1.5)) * (a / w.sqrt()) * phi.cos()
+        };
+        // Latitude of a q value, by bisection.
+        let latitude = |q: f64| {
+            let (mut lo, mut hi) = (-90.0, 90.0);
+            for _ in 0..200 {
+                let mid = 0.5 * (lo + hi);
+                if authalic_q(mid) < q { lo = mid } else { hi = mid }
+            }
+            0.5 * (lo + hi)
+        };
+        for y in [3, 150] {
+            let q0 = authalic_q(MAP_LAT.0) + y as f64 * equal_area_q_step();
+            let (p0, p1) = (latitude(q0).to_radians(), latitude(q0 + equal_area_q_step()).to_radians());
+            let steps = 2000;
+            let h = (p1 - p0) / steps as f64;
+            let integral: f64 = (0..steps).map(|k| element(p0 + (k as f64 + 0.5) * h) * h).sum::<f64>() * MAP_STEP.to_radians();
+            assert!((integral / equal_area_cell_km2() - 1.0).abs() < 1e-8, "cell {y}: {integral} vs {}", equal_area_cell_km2());
+        }
+        assert_eq!(equal_area_cell(MAP_LAT.0, MAP_LON.0), Some((0, 0)));
+    }
+
+    /// A composed product pooled by `composed()` (summary.rs pooling of the composer's
+    /// per-(replicate, mode) evidence) equals the pooled base sample reweighted directly.
+    #[test]
+    fn composed_products_pool_like_direct_reweighting() {
+        let prior = [0.5, 0.0, 0.0, 0.5, 0.0];
+        let log_z: [[f64; 2]; 3] = [[-40.0, -41.3], [-40.6, -39.9], [-41.0, -40.2]];
+        let mut reps = Vec::new();
+        let mut samples = Vec::new();
+        for (i, z) in log_z.iter().enumerate() {
+            let un = [prior[0] * z[0].exp(), prior[3] * z[1].exp()];
+            let p = [un[0] / (un[0] + un[1]), un[1] / (un[0] + un[1])];
+            let mode = |m: usize, k: usize| json!({"mode": hypothesis::MODES[m], "prior_weight": prior[m],
+                "log_evidence": if k < 2 { json!(z[k]) } else { json!(null) },
+                "posterior_probability": if k < 2 { p[k] } else { 0.0 }, "final_ess": 1.0, "distinct_origins": 1,
+                "epochs": [], "runtime_s": 0.0});
+            let modes = vec![mode(0, 0), mode(1, 9), mode(2, 9), mode(3, 1), mode(4, 9)];
+            reps.push(serde_json::from_value::<Replicate>(json!({"case": "c", "seed": i + 1, "particles_per_mode": [1, 0, 0, 1, 0],
+                "log_evidence": 0.0, "modes": modes, "runtime_s": 0.0})).unwrap());
+            let columns: Vec<String> = ["weight", "parent", "mode", "family", "latitude_deg", "longitude_deg", "probe:loglik"].iter().map(|c| c.to_string()).collect();
+            let mut values = Vec::new();
+            let k = 200 + 50 * i;
+            for (s, m) in [(0usize, 0usize), (1, 3)] {
+                for j in 0..k {
+                    let lat = -39.0 + 2.0 * s as f64 + 3.0 * (j as f64 + 0.5) / k as f64;
+                    values.extend([p[s] / k as f64, (s * k + j) as f64, m as f64, (j % 2) as f64, lat, 92.0 + lat / 10.0, -0.5 * ((lat + 36.5) / 0.8f64).powi(2)]);
+                }
+            }
+            let to_mode = |k: usize| compose::Mode { prior_weight: prior[[0, 3][k]], log_evidence: z[k], posterior_probability: p[k] };
+            let none = compose::Mode { prior_weight: 0.0, log_evidence: f64::NEG_INFINITY, posterior_probability: 0.0 };
+            samples.push(compose::Replicate { seed: i as u64 + 1, columns, values, modes: [to_mode(0), none, none, to_mode(1), none] });
+        }
+        let base = compose::Product::filter(&samples, vec![]).unwrap();
+        let probe = compose::Declaration { name: "probe".into(), prefix: "probe:loglik".into(), observations: vec![], alternatives: vec![], absolute_scale: true };
+        let set = compose::Set { ess_floor: 0.0, ..compose::Set::new("core+probe", &["probe"]) };
+        let product = compose::compose(&base, &samples, &[probe], &set, None).unwrap();
+        let refs: Vec<&Replicate> = reps.iter().collect();
+        let out = composed(&refs, &samples, &product).unwrap();
+
+        // Direct: pool the base sample with summary.rs, multiply by the likelihood, renormalise.
+        let base_pool = pooling(&refs);
+        let mut hist = vec![0.0; points()];
+        let mut by_mode = [0.0; 5];
+        for (i, s) in samples.iter().enumerate() {
+            for row in s.values.chunks_exact(s.columns.len()) {
+                let w = row[0] * base_pool.factors[i][row[2] as usize] * row[6].exp();
+                hist[grid_bin(row[4]).unwrap()] += w;
+                by_mode[row[2] as usize] += w;
+            }
+        }
+        let total: f64 = by_mode.iter().sum();
+        for m in [0, 3] {
+            let got = out["mode_probability"][m].as_f64().unwrap();
+            assert!((got - by_mode[m] / total).abs() < 1e-12, "mode {m}: {got} vs {}", by_mode[m] / total);
+        }
+        let direct = stats(&smooth_to_density(&hist));
+        for q in ["q025", "median", "q975"] {
+            let (a, b) = (out["stats"][q].as_f64().unwrap(), direct[q].as_f64().unwrap());
+            assert!((a - b).abs() < 1e-9, "{q}: {a} vs {b}");
+        }
+        assert!(out["equal_area_map"]["cells"].as_array().is_some_and(|c| !c.is_empty()));
+        assert_eq!(out["families"].as_array().unwrap().len(), 2);
+    }
 }
