+/// Composed products (stage 4, crates/compose) on the 2-D equal-area grid: cells uniform in
+/// longitude and in the WGS-84 authalic function q(latitude), so every cell has exactly the
+/// same ellipsoidal area, a^2/2 * dlon * dq. dq is the q-span of [0, MAP_STEP] degrees of
+/// latitude, so cells match the MAP_STEP map's cells at the equator; extent as MAP_LAT/MAP_LON.
+fn authalic_q(latitude_deg: f64) -> f64 {
+    let e = geo::WGS84_E2.sqrt();
+    let s = latitude_deg.to_radians().sin();
+    (1.0 - geo::WGS84_E2) * (s / (1.0 - geo::WGS84_E2 * s * s) - ((1.0 - e * s) / (1.0 + e * s)).ln() / (2.0 * e))
+}
+
+fn equal_area_q_step() -> f64 {
+    authalic_q(MAP_STEP) - authalic_q(0.0)
+}
+
+/// Area of every equal-area cell, km^2.
+pub fn equal_area_cell_km2() -> f64 {
+    0.5 * geo::WGS84_A_KM * geo::WGS84_A_KM * MAP_STEP.to_radians() * equal_area_q_step()
+}
+
+fn equal_area_cell(lat: f64, lon: f64) -> Option<(i32, i32)> {
+    let inside = (MAP_LAT.0..MAP_LAT.1).contains(&lat) && (MAP_LON.0..MAP_LON.1).contains(&lon);
+    inside.then(|| {
+        let y = ((authalic_q(lat) - authalic_q(MAP_LAT.0)) / equal_area_q_step()).floor() as i32;
+        (y, ((lon - MAP_LON.0) / MAP_STEP).floor() as i32)
+    })
+}
+
+/// The PDFs of one composed product, pooled exactly as `case_summary` pools final.npy: the
+/// composer's per-(replicate, mode) evidence goes through `pooling()`, and its composed
+/// weights take the place of the stored weights. Per descent family first. An unconverged
+/// product is reported with its status and no densities.
+#[allow(dead_code)] // Called by the composer runner stage (core request to core stages).
+pub fn composed(reps: &[&Replicate], samples: &[compose::Replicate], product: &compose::Product) -> Result<Value, String> {
+    let report = serde_json::to_value(product).map_err(|e| e.to_string())?;
+    if product.status != compose::Status::Converged {
+        return Ok(json!({"product": report, "converged": false, "density": null, "map": null}));
+    }
+    if reps.len() != samples.len() || reps.len() != product.replicates.len() {
+        return Err(format!("{}: {} replicates, {} sample sets, {} composed", product.id, reps.len(), samples.len(), product.replicates.len()));
+    }
+    // The replicates as the composer left them: its evidence and posterior per mode.
+    let updated: Vec<Replicate> = reps
+        .iter()
+        .zip(&product.replicates)
+        .map(|(r, p)| {
+            let mut v = serde_json::to_value(r).map_err(|e| e.to_string())?;
+            for (m, mode) in p.modes.iter().enumerate() {
+                v["modes"][m]["log_evidence"] = json!(mode.log_evidence);
+                v["modes"][m]["posterior_probability"] = json!(mode.posterior_probability);
+            }
+            serde_json::from_value(v).map_err(|e| e.to_string())
+        })
+        .collect::<Result<_, String>>()?;
+    let refs: Vec<&Replicate> = updated.iter().collect();
+    let pool = pooling(&refs);
+    let half = refs.len() / 2;
+    let halves = (half > 0).then(|| (pooling(&refs[..half]), pooling(&refs[half..])));
+
+    let n = points();
+    let mut pooled = vec![0.0; n];
+    let mut halves_hist = [vec![0.0; n], vec![0.0; n]];
+    let mut families = std::collections::BTreeMap::<usize, (f64, Vec<f64>)>::new();
+    let mut map = std::collections::BTreeMap::<(i32, i32), f64>::new();
+    let mut mass = 0.0;
+    for (i, (s, p)) in samples.iter().zip(&product.replicates).enumerate() {
+        let column = |name: &str| s.column(name).ok_or_else(|| format!("{}: samples have no {name} column", product.id));
+        let (lat_c, lon_c, mode_c) = (column("latitude_deg")?, column("longitude_deg")?, column(compose::STRATUM)?);
+        let family_c = s.column(compose::FAMILY);
+        let width = s.columns.len();
+        for (r, w) in p.weights.iter().enumerate() {
+            let row = &s.values[r * width..(r + 1) * width];
+            let mode = row[mode_c] as usize;
+            let w = w * pool.factors[i][mode];
+            if w == 0.0 {
+                continue;
+            }
+            let (lat, lon) = (row[lat_c], row[lon_c]);
+            mass += w;
+            if let Some(bin) = grid_bin(lat) {
+                pooled[bin] += w;
+                if let Some((a, b)) = &halves {
+                    let f = if i < half { a.factors[i][mode] } else { b.factors[i - half][mode] };
+                    halves_hist[usize::from(i >= half)][bin] += p.weights[r] * f;
+                }
+            }
+            if let Some(fc) = family_c {
+                let entry = families.entry(row[fc] as usize).or_insert_with(|| (0.0, vec![0.0; n]));
+                entry.0 += w;
+                if let Some(bin) = grid_bin(lat) {
+                    entry.1[bin] += w;
+                }
+            }
+            if let Some(cell) = equal_area_cell(lat, lon) {
+                *map.entry(cell).or_default() += w;
+            }
+        }
+    }
+    let density = smooth_to_density(&pooled);
+    let area = equal_area_cell_km2();
+    Ok(json!({
+        "product": report,
+        "converged": true,
+        "families": families.iter().map(|(family, (m, hist))| {
+            let d = smooth_to_density(hist);
+            json!({"family": family, "probability": m / mass, "density": round_all(&d), "stats": stats(&d)})
+        }).collect::<Vec<_>>(),
+        "mode_probability": pool.mode_probability,
+        "pool_factors": pool.factors,
+        "density": round_all(&density),
+        "stats": stats(&density),
+        "split_half_overlap": halves.is_some().then(|| overlap(&smooth_to_density(&halves_hist[0]), &smooth_to_density(&halves_hist[1]))),
+        "equal_area_map": {
+            "lat": [MAP_LAT.0, MAP_LAT.1], "lon": [MAP_LON.0, MAP_LON.1], "lon_step": MAP_STEP,
+            "authalic_q_step": equal_area_q_step(), "cell_km2": area,
+            "cells": map.iter().filter(|(_, &v)| v > 0.0).map(|(&(y, x), &v)| json!([y, x, round(v / mass / area)])).collect::<Vec<_>>(),
+        },
+    }))
+}
