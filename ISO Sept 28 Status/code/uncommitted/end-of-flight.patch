+/// Total thrust, in units of one engine's maximum continuous thrust.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Thrust {
+    /// A fixed setting: 0 with both engines out, up to 1 with one running, up to 2 with both.
+    Set(f64),
+    /// Both engines managed between flight idle and maximum continuous to hold a vertical speed
+    /// (m/s, negative descending) while the pitch law holds the equivalent airspeed: pitch for
+    /// speed, power for path. Where even idle is too much, the aircraft descends at the idle
+    /// rate.
+    VerticalSpeed(f64),
+}
+
+/// Flight idle of both engines together (an assumption: three per cent of maximum continuous
+/// thrust each).
+const IDLE: f64 = 0.06;
+
+/// beta = -d(ln rho)/dh (1/m) of the ISA at a pressure altitude (m).
+fn density_gradient(alt_m: f64) -> f64 {
+    let rho = |h: f64| isa_pressure(h) / isa_temperature(h);
+    (rho(alt_m - 50.0) / rho(alt_m + 50.0)).ln() / 100.0
+}
