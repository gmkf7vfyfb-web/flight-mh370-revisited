+    /// Pitch for speed, power for path: from level flight the managed thrust settles on the
+    /// commanded descent rate at the held speed; where idle is too much, on the idle descent at
+    /// constant EAS, sin(gamma) = (T - D) / W / (1 + V^2 beta / 2g), the acceleration factor
+    /// of performance engineering, with beta = (g/R - lapse) / T in the ISA troposphere.
+    #[test]
+    fn managed_thrust_holds_the_descent_rate() {
+        let (alt, tas) = (8000.0, 180.0);
+        let drag = (0.02 + 0.05 * level_cl(alt, tas).powi(2)) * 0.5 * density(alt) * tas * tas * 100.0;
+        let aero = Parabolic { cd0: 0.02, k: 0.05, thrust: drag };
+        let a = aircraft(&aero);
+        let eas = a.eas(&start(alt, tas, 0.0));
+        let pilot = Pitch::Speed { ref_eas: eas, ref_tau_s: 0.0, stiffness: 2.0, damping: 1.0, lag_s: 0.0 };
+        let fly = |rate: f64| {
+            let p = Phase { thrust: Thrust::VerticalSpeed(rate), ..phase(pilot, 0.0) };
+            a.fly(start(alt, tas, 0.0), &[(0.0, p)], &[], 300.0, 0.5, None).last
+        };
+        let s = fly(-5.0);
+        let rate = s.tas * s.gamma.sin();
+        assert!((rate + 5.0).abs() < 0.05 && (a.eas(&s) - eas).abs() / eas < 0.01, "{rate} m/s at {} vs {eas}", a.eas(&s));
+        // Idle: 6% of one engine's thrust, which here equals the level-flight drag.
+        let s = fly(-50.0);
+        let v = a.eas(&s);
+        assert!((v - eas).abs() / eas < 0.01, "{v} vs {eas}");
+        let q = 0.5 * SEA_LEVEL_DENSITY * v * v * 100.0;
+        let d = (0.02 + 0.05 * (MASS * G * s.gamma.cos() / (q * 100.0)).powi(2)) * q * 100.0;
+        let t = isa_temperature(s.alt_m);
+        let beta = (G / 287.052_87 - 0.0065) / t;
+        let expected = ((0.06 * drag - d) / (MASS * G) / (1.0 + s.tas * s.tas * beta / (2.0 * G))).asin();
+        assert!((s.gamma - expected).abs() < 0.001, "{} vs {expected}", s.gamma);
+    }
