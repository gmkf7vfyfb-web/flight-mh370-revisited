+    /// Thrust (N) given the drag (N) it works against.
+    fn thrust(&self, s: &State, d: &AirData, phase: &Phase, drag: f64) -> f64 {
+        match phase.thrust {
+            Thrust::Set(k) if k > 0.0 => k * self.aero.engine_thrust(d.mach, &d.air),
+            Thrust::Set(_) => 0.0,
+            Thrust::VerticalSpeed(rate) => {
+                // Steady at constant EAS: T = D + W sin(gamma) + m dV/dt with sin(gamma) = rate/V,
+                // the true airspeed following the density: dV/dt = V beta rate / 2.
+                let one = self.aero.engine_thrust(d.mach, &d.air);
+                let v = s.tas.max(1.0);
+                let wanted = drag + self.mass_kg * (G * (rate / v).clamp(-1.0, 1.0) + 0.5 * v * density_gradient(s.alt_m) * rate);
+                wanted.clamp(IDLE * one, 2.0 * one)
+            }
+        }
+    }
