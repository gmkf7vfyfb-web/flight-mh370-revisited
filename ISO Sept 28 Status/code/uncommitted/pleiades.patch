+/// Quadrature nodes (lat, lon, area km²) over lat/lon boxes [south, north, west, east]:
+/// Gauss–Legendre in sin(lat) and in lon, 36 per box. The weights sum to the boxes' area.
+pub fn footprint_nodes(boxes: &[[f64; 4]]) -> Vec<(f64, f64, f64)> {
+    let mut nodes = Vec::new();
+    for &[s, n, w, e] in boxes {
+        let (u0, u1) = (s.to_radians().sin(), n.to_radians().sin());
+        for &(xu, wu) in &GAUSS_LEGENDRE_6 {
+            let lat = (0.5 * (u0 + u1) + 0.5 * (u1 - u0) * xu).asin().to_degrees();
+            for &(xl, wl) in &GAUSS_LEGENDRE_6 {
+                let lon = 0.5 * (w + e) + 0.5 * (e - w) * xl;
+                nodes.push((lat, lon, EARTH_RADIUS_KM.powi(2) * 0.25 * (u1 - u0) * (e - w).to_radians() * wu * wl));
+            }
+        }
+    }
+    nodes
+}
