+/// Subset weights γ_m, for m of the n clusters being MRO objects (see "Likelihood").
+/// Jeffreys: Γ(n − m + 1/2) / Γ(n + 1/2) = 1 / Π_{j=n−m}^{n−1} (j + 1/2). Plug-in: n^−m.
+pub fn subset_weights(n: usize, background: Background) -> Vec<f64> {
+    (0..=n)
+        .map(|m| match background {
+            Background::Jeffreys => 1.0 / ((n - m)..n).map(|j| j as f64 + 0.5).product::<f64>(),
+            Background::PlugIn => (n as f64).powi(-(m as i32)),
+        })
+        .collect()
+}
+
+/// ln Σ_{S≠∅} γ_|S| Π_{c∈S} k·a_c from ln a_c (a_c = A · p_c) and ln k. Summed over subsets, so
+/// small a_c never cancel.
+pub fn ln_detected(ln_a: &[f64], ln_k: f64, gamma: &[f64]) -> f64 {
+    let n = ln_a.len();
+    log_sum_exp((1u32..1 << n).map(|mask| {
+        let members = (0..n).filter(|c| mask & (1 << c) != 0);
+        gamma[members.clone().count()].ln() + members.map(|c| ln_k + ln_a[c]).sum::<f64>()
+    }))
+}
