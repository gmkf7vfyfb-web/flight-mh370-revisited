+/// ln of the weighted mean of exp(l) over (weight, l) pairs.
+fn log_mean(terms: impl Iterator<Item = (f64, f64)>) -> f64 {
+    let terms: Vec<(f64, f64)> = terms.filter(|t| t.0 > 0.0).collect();
+    if terms.iter().any(|t| t.1.is_nan()) {
+        return f64::NAN;
+    }
+    let max = terms.iter().map(|t| t.1).fold(f64::NEG_INFINITY, f64::max);
+    if max == f64::NEG_INFINITY {
+        return max;
+    }
+    let mass: f64 = terms.iter().map(|t| t.0).sum();
+    max + (terms.iter().map(|(p, l)| p * (l - max).exp()).sum::<f64>() / mass).ln()
+}
