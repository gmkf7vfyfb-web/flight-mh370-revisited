+        "prior.track_deg" => (Some("Prior track"), Some((180.0, 360.0)), "Mean control angle at the radar point, degrees true."),
+        "prior.track_sd_deg" => (Some("Prior track s.d."), Some((0.1, 30.0)), "Standard deviation of the initial control angle, degrees."),
+        "bfo_bias.mean_hz" => (Some("BFO bias prior mean"), Some((0.0, 300.0)),
