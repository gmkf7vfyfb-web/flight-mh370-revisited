+            "Independent replicates. A result whose replicates disagree is unconverged, not a result."),
+        "resample_ess_fraction" => (Some("Resample below ESS fraction"), Some((0.05, 1.0)),
+            "Systematic resampling fires when the effective sample size falls below this fraction of the particle count."),
+        "exclude_epochs" => (Some("SATCOM epochs left out"), None,
+            "Epoch ids to drop from the run, e.g. m0019a m0019b for the messages after the SDU restart."),
+        "environment.wind_scale" => (Some("Nominal wind scale"), Some((0.0, 2.0)),
+            "Multiplier on the gridded wind. 1.0 is the estimate; 0.0 turns the nominal wind off and keeps the wind-error process."),
+        "environment.declination_scale" => (Some("Declination scale"), Some((0.0, 2.0)),
+            "Multiplier on IGRF declination. 0.0 makes the magnetic modes identical to the true ones."),
+        "prior.time_utc" => (Some("Prior epoch"), None, "The radar point the filter starts from."),
+        "prior.latitude_deg" => (Some("Prior latitude"), Some((-10.0, 20.0)),
+            "18:01:49 UTC radar point, reconstructed from Davey ch. 4 figures."),
+        "prior.longitude_deg" => (Some("Prior longitude"), Some((90.0, 110.0)),
