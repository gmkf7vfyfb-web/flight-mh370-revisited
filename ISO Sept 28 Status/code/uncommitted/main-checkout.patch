+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Every control edits a field the runner still has. The controls are turned back into
+    /// an override and loaded over the base configuration; `deny_unknown_fields` rejects a
+    /// key the core has dropped or renamed, so a stale control cannot sit in the app
+    /// silently doing nothing.
+    #[test]
+    fn every_control_edits_a_field_the_runner_accepts() {
+        let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../..");
+        let base_path = root.join("config/davey2016.toml");
+        let base = crate::config::load(&[base_path.clone()]).unwrap();
+        let controls = controls(&base, &base.dynamics.apply(Parameters::default()));
+        assert!(controls.len() > 20, "expected the configuration to yield controls, got {}", controls.len());
+
+        let mut table = toml::Table::new();
+        for control in &controls {
+            let key = control["key"].as_str().unwrap();
+            let mut node = &mut table;
+            let parts: Vec<&str> = key.split('.').collect();
+            for part in &parts[..parts.len() - 1] {
+                node = node
+                    .entry(part.to_string())
+                    .or_insert_with(|| toml::Value::Table(toml::Table::new()))
+                    .as_table_mut()
+                    .unwrap();
+            }
+            node.insert(parts[parts.len() - 1].to_string(), to_toml(&control["value"]));
+        }
+        crate::config::load_with(&[base_path], Some(table)).expect("controls must load as an override");
+    }
+
+    fn to_toml(value: &Value) -> toml::Value {
+        match value {
+            Value::Bool(b) => toml::Value::Boolean(*b),
+            Value::String(s) => toml::Value::String(s.clone()),
+            Value::Number(n) => match n.as_i64() {
+                Some(i) if !n.is_f64() => toml::Value::Integer(i),
+                _ => toml::Value::Float(n.as_f64().unwrap_or_default()),
+            },
+            Value::Array(items) => toml::Value::Array(items.iter().map(to_toml).collect()),
+            _ => toml::Value::String(String::new()),
+        }
+    }
+}
