+/// Settings the app may change. Every key is a path in the run configuration, so changing
+/// one in the app is the same as writing it in an override file.
+///
+/// The list is discovered from the configuration itself, so a field added to the core
+/// appears in the app without the app being touched. Two things cannot be discovered that
+/// way and are named here: fields that are optional and unset (they serialise to nothing),
+/// and the published dynamics constants (they are compiled into `crates/flight`, and the
+/// configuration carries only the overrides).
 fn controls(base: &Config, p: &Parameters) -> Vec<Value> {
+    // Handled by their own panels: the run name, the data sources, the measurement cases
+    // and the hypotheses.
+    const SKIP: [&str; 4] = ["name", "inputs", "cases", "hypotheses"];
+    let mut out = Vec::new();
+    if let Ok(Value::Object(fields)) = serde_json::to_value(base) {
+        for (key, value) in fields.iter().filter(|(k, _)| !SKIP.contains(&k.as_str()) && *k != "dynamics") {
+            collect(key, value, &mut out);
+        }
+    }
+    // Optional fields are absent from a configuration that does not set them.
+    for (key, empty) in [("exclude_epochs", json!([])), ("output.history_after_epoch", json!(""))] {
+        if !out.iter().any(|c| c["key"] == key) {
+            out.push(control_for(key, &empty));
+        }
+    }
+    out.extend(dynamics_controls(p));
+    out
+}
+
+/// One control per leaf of the configuration, recursing into its tables.
+fn collect(key: &str, value: &Value, out: &mut Vec<Value>) {
+    match value {
+        Value::Object(fields) => {
+            for (name, value) in fields {
+                collect(&format!("{key}.{name}"), value, out);
+            }
+        }
+        Value::Null => {}
+        _ => out.push(control_for(key, value)),
+    }
+}
+
+/// A control for one configuration key: its kind from the value, its label, range and note
+/// from the table below when the key is one worth explaining.
+fn control_for(key: &str, value: &Value) -> Value {
+    let (label, range, note) = described(key);
+    let kind = match (key, value) {
+        ("particles_per_mode", _) => "integer5",
+        (_, Value::Bool(_)) => "boolean",
+        (_, Value::String(_)) => "text",
+        (_, Value::Number(n)) if n.is_f64() && n.as_i64().is_none() => "number",
+        (_, Value::Number(_)) => "integer",
+        (_, Value::Array(items)) => match items.first() {
+            Some(Value::String(_)) | None if key.ends_with("epochs") => "texts",
+            Some(Value::Number(n)) if n.is_f64() && n.as_i64().is_none() => "range",
+            Some(Value::String(_)) => "texts",
+            _ => "integers",
+        },
+        _ => "text",
+    };
+    let last = key.rsplit('.').next().unwrap_or(key).replace('_', " ");
+    let derived = last[..1].to_uppercase() + &last[1..];
+    json!({
+        "key": key,
+        "label": label.unwrap_or(&derived),
+        "kind": kind,
+        "value": value,
+        "min": range.map(|r| r.0),
+        "max": range.map(|r| r.1),
+        "note": note,
+        "group": group_of(key),
+    })
+}
+
+fn group_of(key: &str) -> &'static str {
+    match key.split('.').next().unwrap_or("") {
+        "prior" => "Prior",
+        "bfo_bias" => "Measurement",
+        "environment" => "Environment",
+        "output" => "Output",
+        "dynamics" => "Dynamics",
+        _ => "Run size",
+    }
+}
+
+/// Label, range and note for the keys where one helps. A key absent here still gets a
+/// control; it is named after itself and accepts any value the configuration accepts.
