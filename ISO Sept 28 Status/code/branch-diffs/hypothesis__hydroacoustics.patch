+                         (f"D1 peak S={e['s_max_db']} (rank {e['rank_in_panel']})" if e["d1_peak_within_5s"] else "no D1 peak within 5 s") +
+                         f"; peak {e['peak_pa']} Pa, SNR {e['snr_db']} dB")
+    ax.text(0, 1, "\n".join(lines), va="top", family="monospace", fontsize=6.3)
+    ax = axes[1, 0]
+    rows = results["loudness"]
+    for k, r in enumerate(rows):
+        colour = "tab:green" if r["timing_consistent"] else "tab:red"
+        marker = "o" if r["distinct_in_figure"] else "s"
+        ax.errorbar(r["predicted_peak_pa_favourable"], r["observed_peak_pa"], yerr=r["observed_sd_pa"], fmt=marker, color=colour)
+        ax.annotate(f"{r['crash']} {r['station']}", (r["predicted_peak_pa_favourable"], r["observed_peak_pa"]), fontsize=7,
+                    xytext=(5, 9 * ((k % 3) - 1)), textcoords="offset points")
+    lim = [0.05, 20]
+    ax.plot(lim, lim, color="k", lw=0.8, label="equal (favourable coupling, F-35 eta)")
+    ax.plot(lim, np.array(lim) / 10 ** (15 / 20), color="0.5", ls="--", lw=0.8, label="module default coupling (-15 dB)")
+    ax.set_xscale("log")
+    ax.set_yscale("log")
+    ax.set_xlim(lim)
+    ax.set_ylim(0.1, 3)
+    ax.set_xlabel("Predicted peak (Pa), chain relative to the F-35 anchor")
+    ax.set_ylabel("Peak read from Kadri Figs 4-5 (Pa)")
+    ax.set_title("(c) Loudness. Green: arrival fits a water path; red: it does not. Squares: not distinct")
+    ax.grid(alpha=0.3, which="both")
+    ax.legend(fontsize=7, loc="lower right")
+    ax = axes[1, 1]
+    ax.axis("off")
+    lines = ["(c) Timing and level of the crash signals", "",
+             f"{'crash':15}{'stn':5}{'km':>6}{'MJ':>6}{'window (water path)':>21}{'figure':>9}{'off min':>8}{'pred Pa':>8}{'read Pa':>8}{'dB':>6}"]
+    for r in rows:
+        lines.append(f"{r['crash'][:15]:15}{r['station']:5}{r['range_km']:>6}{r['kinetic_energy_mj']:>6}"
+                     f"{r['arrival_window_utc'][0] + '-' + r['arrival_window_utc'][1]:>21}{r['figure_transient_utc']:>9}"
+                     f"{r['timing_offset_min']:>8}{r['predicted_peak_pa_favourable']:>8}{r['observed_peak_pa']:>8}{r['implied_extra_loss_db']:>6}")
+    fits = [r for r in rows if r["timing_consistent"]]
+    lines += ["", "dB: predicted over read, i.e. the extra loss the favourable-coupling F-35 chain needs.",
+              "Masses are assumed from type and phase; Sriwijaya's speed is assumed (Kadri gives none).",
+              "Timing: water path from the crash site at the reported impact time, +/-1.5 min.",
+              f"Consistent: {', '.join(sorted({r['crash'] for r in fits}))}; "
+              f"inconsistent: {', '.join(sorted({r['crash'] for r in rows if not r['timing_consistent']}))}.",
+              "Only timing-consistent signals can test eta; the F-35A is the anchor itself."]
+    ax.text(0, 1, "\n".join(lines), va="top", family="monospace", fontsize=7)
+    fig.tight_layout(rect=(0, 0, 1, 0.96))
+    fig.savefig(OUT / "kadri-tests.png", dpi=110)
+
+
+def main() -> None:
+    OUT.mkdir(parents=True, exist_ok=True)
+    results = {"label": LABEL, "timing": timing(), "measurement": measurement(), "loudness": loudness()}
+    (OUT / "kadri-tests.json").write_text(json.dumps(results, indent=1, default=float))
+    page(results)
+    print(f"{OUT / 'kadri-tests.png'}; {LABEL}")
+
+
+if __name__ == "__main__":
+    main()
