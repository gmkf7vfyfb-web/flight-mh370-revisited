@@ -0,0 +1,67 @@
+//! Geodesics on the WGS-84 ellipsoid (Vincenty's inverse formula) and points along a path.
+
+use geo::{WGS84_A_KM, WGS84_F};
+
+/// Distance (km) from point 1 to point 2, and the azimuth (degrees clockwise from true
+/// north) of the geodesic leaving point 1. Vincenty (1975); converges to 1e-12 rad except
+/// for nearly antipodal points, which never occur here.
+pub fn inverse(lat1: f64, lon1: f64, lat2: f64, lon2: f64) -> (f64, f64) {
+    let (a, f) = (WGS84_A_KM, WGS84_F);
+    let b = a * (1.0 - f);
+    let l = (lon2 - lon1).to_radians();
+    let (sin_u1, cos_u1) = ((1.0 - f) * lat1.to_radians().tan()).atan().sin_cos();
+    let (sin_u2, cos_u2) = ((1.0 - f) * lat2.to_radians().tan()).atan().sin_cos();
+    let mut lambda = l;
+    let (mut sin_sigma, mut cos_sigma, mut sigma, mut cos2_alpha, mut cos_2sm) = (0.0, 1.0, 0.0, 1.0, 0.0);
+    for _ in 0..200 {
+        let (sin_l, cos_l) = lambda.sin_cos();
+        sin_sigma = ((cos_u2 * sin_l).powi(2) + (cos_u1 * sin_u2 - sin_u1 * cos_u2 * cos_l).powi(2)).sqrt();
+        if sin_sigma == 0.0 {
+            return (0.0, 0.0);
+        }
+        cos_sigma = sin_u1 * sin_u2 + cos_u1 * cos_u2 * cos_l;
+        sigma = sin_sigma.atan2(cos_sigma);
+        let sin_alpha = cos_u1 * cos_u2 * sin_l / sin_sigma;
+        cos2_alpha = 1.0 - sin_alpha * sin_alpha;
+        cos_2sm = if cos2_alpha == 0.0 { 0.0 } else { cos_sigma - 2.0 * sin_u1 * sin_u2 / cos2_alpha };
+        let c = f / 16.0 * cos2_alpha * (4.0 + f * (4.0 - 3.0 * cos2_alpha));
+        let next = l
+            + (1.0 - c) * f * sin_alpha * (sigma + c * sin_sigma * (cos_2sm + c * cos_sigma * (2.0 * cos_2sm * cos_2sm - 1.0)));
+        let done = (next - lambda).abs() < 1e-12;
+        lambda = next;
+        if done {
+            break;
+        }
+    }
+    let u2 = cos2_alpha * (a * a - b * b) / (b * b);
+    let big_a = 1.0 + u2 / 16384.0 * (4096.0 + u2 * (-768.0 + u2 * (320.0 - 175.0 * u2)));
+    let big_b = u2 / 1024.0 * (256.0 + u2 * (-128.0 + u2 * (74.0 - 47.0 * u2)));
+    let delta_sigma = big_b
+        * sin_sigma
+        * (cos_2sm
+            + big_b / 4.0
+                * (cos_sigma * (2.0 * cos_2sm * cos_2sm - 1.0)
+                    - big_b / 6.0 * cos_2sm * (4.0 * sin_sigma * sin_sigma - 3.0) * (4.0 * cos_2sm * cos_2sm - 3.0)));
+    let (sin_l, cos_l) = lambda.sin_cos();
+    let azimuth = (cos_u2 * sin_l).atan2(cos_u1 * sin_u2 - sin_u1 * cos_u2 * cos_l).to_degrees();
+    (b * big_a * (sigma - delta_sigma), azimuth.rem_euclid(360.0))
+}
+
+/// The point a fraction `t` of the way from point 1 to point 2 along the great circle through
+/// them (spherical interpolation of geodetic coordinates). Within a few km of the ellipsoidal
+/// geodesic at these ranges, which is enough for sampling bathymetry.
+pub fn along(lat1: f64, lon1: f64, lat2: f64, lon2: f64, t: f64) -> (f64, f64) {
+    let unit = |lat: f64, lon: f64| {
+        let (sl, cl) = lat.to_radians().sin_cos();
+        let (so, co) = lon.to_radians().sin_cos();
+        [cl * co, cl * so, sl]
+    };
+    let (p, q) = (unit(lat1, lon1), unit(lat2, lon2));
+    let omega = (p[0] * q[0] + p[1] * q[1] + p[2] * q[2]).clamp(-1.0, 1.0).acos();
+    if omega < 1e-12 {
+        return (lat1, lon1);
+    }
+    let (wp, wq) = (((1.0 - t) * omega).sin() / omega.sin(), (t * omega).sin() / omega.sin());
+    let v = [wp * p[0] + wq * q[0], wp * p[1] + wq * q[1], wp * p[2] + wq * q[2]];
+    (v[2].atan2(v[0].hypot(v[1])).to_degrees(), v[1].atan2(v[0]).to_degrees())
+}
