@@ -0,0 +1,317 @@
+#!/usr/bin/env python3
+"""Build the package for Usama Kadri: a draft for Pete's review. Nothing is sent from here.
+
+Writes runs/hydroacoustics/kadri-package/:
+- cover.txt and requests.txt (R0-R6);
+- measure.py, the reference measurement script;
+- preregistration.toml and stations.toml;
+- synthetic/: triad waveforms with known arrivals, their truth and our measurements of them;
+- windows.csv and predictions.csv, from `mh370 evaluate` output on impact samples (the
+  stand-in until the end-of-flight stage exists), when that output is present;
+- outreach/: short separate asks to Metz's group (F-35 waveforms) and to Royer (OHASISBIO).
+
+    .venv/bin/python hypotheses/hydroacoustics/prepare/package.py [evaluate-output.csv]
+"""
+
+from __future__ import annotations
+
+import csv
+import json
+import shutil
+import sys
+import textwrap
+from pathlib import Path
+
+import numpy as np
+
+import detect
+import waveforms as w
+from measure import BANDS, delay, measure, plane_wave_delays, synthetic
+
+ROOT = w.HERE.parents[2]
+OUT = ROOT / "runs/hydroacoustics/kadri-package"
+MODULE = "hydroacoustics:"
+ETA_STEPS = 7  # eta = F-35 anchor x 10^(-k/2), k = 0..6: three decades
+
+
+def utc(seconds: float) -> str:
+    return str(np.datetime64(int(round(seconds)), "s")) + "Z"
+
+
+def weighted_quantile(x: np.ndarray, weight: np.ndarray, q: float) -> float:
+    order = np.argsort(x)
+    cumulative = np.cumsum(weight[order]) / weight.sum()
+    return float(x[order][min(np.searchsorted(cumulative, q), x.size - 1)])
+
+
+def read_evaluate(path: Path) -> dict[str, np.ndarray]:
+    with open(path) as f:
+        header = next(csv.reader(f))
+    data = np.loadtxt(path, delimiter=",", skiprows=1, ndmin=2)
+    return {name: data[:, k] for k, name in enumerate(header)}
+
+
+def windows(table: dict[str, np.ndarray]) -> list[dict]:
+    """preregistration.toml [windows] rule, applied to the evaluated impact samples."""
+    rule = detect.PREREG["windows"]
+    weight = table.get("weight", np.ones(len(table["unix_s"])))
+    rows = []
+    for sid, s in w.stations().items():
+        early, late = table[f"{MODULE}{sid}.arrival_early_unix_s"], table[f"{MODULE}{sid}.arrival_late_unix_s"]
+        baz = table[f"{MODULE}{sid}.back_azimuth_deg"]
+        row = {"station": sid,
+               "start_utc": utc(weighted_quantile(early, weight, 0.0025) - rule["timing_pad_s"]),
+               "end_utc": utc(weighted_quantile(late, weight, 0.9975) + rule["timing_pad_s"]),
+               "blocked_fraction": round(float(np.average(table[f"{MODULE}{sid}.blocked"] == 1, weights=weight)), 3)}
+        if len(s["elements"]) == 3:
+            row["back_azimuth_min_deg"] = round(weighted_quantile(baz, weight, 0.0025) - rule["bearing_pad_deg"], 2)
+            row["back_azimuth_max_deg"] = round(weighted_quantile(baz, weight, 0.9975) + rule["bearing_pad_deg"], 2)
+        rows.append(row)
+    return rows
+
+
+def predictions(table: dict[str, np.ndarray], step_deg: float = 0.5) -> list[dict]:
+    """One row per 0.5-degree location bin and station: medians over the bin's impact samples."""
+    weight = table.get("weight", np.ones(len(table["unix_s"])))
+    eta_anchor = float(np.nanmedian(table[f"{MODULE}f35_eta"]))
+    etas = eta_anchor * 10 ** (-np.arange(ETA_STEPS) / 2)
+    keys = np.floor(table["latitude_deg"] / step_deg), np.floor(table["longitude_deg"] / step_deg)
+    rows = []
+    for key in sorted(set(zip(*keys))):
+        m = (keys[0] == key[0]) & (keys[1] == key[1])
+        share = weight[m].sum() / weight.sum()
+        for sid in w.stations():
+            c = lambda name: table[f"{MODULE}{sid}.{name}"][m]
+            row = {"station": sid, "weight": round(float(share), 6),
+                   "latitude_deg": (key[0] + 0.5) * step_deg, "longitude_deg": (key[1] + 0.5) * step_deg,
+                   "seafloor_depth_m": round(float(np.nanmedian(table[f"{MODULE}site_depth_m"][m])), 0),
+                   "impact_first_utc": utc(table["unix_s"][m].min()), "impact_last_utc": utc(table["unix_s"][m].max()),
+                   "kinetic_energy_j": float(np.median(table["kinetic_energy_j"][m])),
+                   "range_km": round(float(np.median(c("range_km"))), 1),
+                   "back_azimuth_deg": round(float(np.median(c("back_azimuth_deg"))), 2),
+                   "arrival_first_utc": utc(c("arrival_early_unix_s").min()),
+                   "arrival_last_utc": utc(c("arrival_late_unix_s").max()),
+                   "blocked": int(np.median(c("blocked")) >= 0.5)}
+            for low, high in BANDS:
+                band = f"{low:g}-{high:g}hz"
+                row[f"tl_db_{band}"] = round(float(np.median(c(f"tl_db.{band}"))), 1)
+                row[f"tl_sd_db_{band}"] = round(float(np.median(c(f"tl_sd_db.{band}"))), 1)
+            for k, eta in enumerate(etas):
+                total = 10 * np.log10(sum(10 ** ((c(f"sel_eta1_db.{low:g}-{high:g}hz") + 10 * np.log10(eta)) / 10)
+                                          for low, high in BANDS))
+                row[f"exposure_db_eta{k}"] = round(float(np.median(total)), 1)
+                row[f"peak_pa_eta{k}"] = float(f"{np.median(c('peak_eta1_pa')) * np.sqrt(eta):.3g}")
+            rows.append(row)
+    return rows, etas
+
+
+def kadri_in_window(rows: list[dict]) -> str:
+    """Which Kadri (2024) Table 1 transients fall inside the H01W time and bearing window."""
+    window = next(r for r in rows if r["station"] == "H01W")
+    start, end = (np.datetime64(window[k].rstrip("Z")) for k in ("start_utc", "end_utc"))
+    lo, hi = window["back_azimuth_min_deg"], window["back_azimuth_max_deg"]
+    table = np.genfromtxt(w.HERE.parent / "kadri2024-table1.csv", delimiter=",", skip_header=4, dtype=str)
+    inside = [f"{t[11:19]} ({float(b):.1f} deg)" for t, b, _ in table
+              if start <= np.datetime64(t.rstrip("Z")) <= end and lo <= float(b) <= hi]
+    return (f"{len(inside)} of {len(table)} transients lie inside it ({window['start_utc'][11:19]}-"
+            f"{window['end_utc'][11:19]} UTC, {lo:.1f}-{hi:.1f} deg): {', '.join(inside)}. Your "
+            "00:54:30 candidate (306.2 deg) is outside the bearing window, and your table stops at "
+            "00:55:07 while the window runs later.")
+
+
+def coloured_noise(n: int, fs: float, f_psd: np.ndarray, psd_db: np.ndarray, rng: np.random.Generator) -> np.ndarray:
+    """Gaussian noise whose one-sided PSD follows `psd_db` (dB re 1 uPa^2/Hz)."""
+    f = np.fft.rfftfreq(n, 1 / fs)
+    psd = 10 ** (np.interp(f, f_psd, psd_db) / 10) * 1e-12
+    return np.fft.irfft(np.fft.rfft(rng.standard_normal(n)) * np.sqrt(psd * fs / 2), n)
+
+
+def synthetic_triads(rng: np.random.Generator) -> None:
+    """Triad waveforms with known arrivals, for checking that measure.py runs identically on both sides."""
+    folder = OUT / "synthetic"
+    folder.mkdir(parents=True, exist_ok=True)
+    imos = json.loads((ROOT / "runs/hydroacoustics/imos/detection-control.json").read_text())
+    spectrum = next(r for r in imos if r["logger"] == "3315")["psd_percentiles_db"]
+    fs, n = 250.0, int(300 * 250)
+    arrivals = {"H01W": [(100.0, 253.3, 110.0), (200.0, 301.6, 100.0)], "H08S": [(100.0, 156.8, 110.0), (200.0, 145.0, 100.0)]}
+    truth, expected = [], []
+    for sid, events in arrivals.items():
+        elements = w.stations()[sid]["elements"]
+        lat, lon = np.array([e["lat"] for e in elements]), np.array([e["lon"] for e in elements])
+        p = np.vstack([coloured_noise(n, fs, np.array(spectrum["frequency_hz"]), np.array(spectrum["50"]), rng) for _ in elements])
+        for centre, bearing, exposure in events:
+            duration = 2.0 + 1.2e-3 * (2300.0 if sid == "H01W" else 3700.0)
+            signal = np.zeros(n)
+            s = synthetic(fs, duration, exposure, rng)
+            k = int(round((centre - duration / 2) * fs))
+            signal[k:k + s.size] = s
+            for i, dt in enumerate(plane_wave_delays(lat, lon, bearing)):
+                p[i] += delay(signal, fs, dt)
+            truth.append({"station": sid, "centre_s": centre, "back_azimuth_deg": bearing, "exposure_db": exposure,
