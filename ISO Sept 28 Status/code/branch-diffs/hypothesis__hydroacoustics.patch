+#!/usr/bin/env python3
+"""Fetch the regional bathymetry grid the hydroacoustics module reads.
+
+ETOPO 2022 (NOAA NCEI, 15 arc-second, EGM2008 heights) sampled every 4th cell,
+i.e. on a 1 arc-minute grid, over 50S-5N, 55E-145E: every station (H01W, H08S,
+Perth Canyon, Scott Reef, Portland) and every path from the 7th arc. Written outside git
+as little-endian int16 metres (positive up), rows south to north, with a TOML
+sidecar that states the grid and its provenance.
+
+    .venv/bin/python hypotheses/hydroacoustics/prepare/bathymetry.py
+"""
+
+from __future__ import annotations
+
+import sys
+import urllib.request
+from datetime import datetime, timezone
+from pathlib import Path
+
+import numpy as np
+
+DATASET = "https://coastwatch.pfeg.noaa.gov/erddap/griddap/ETOPO_2022_v1_15s"
+SOUTH, NORTH, WEST, EAST, STRIDE = -50.0, 5.0, 55.0, 145.0, 4
+OUT = Path("/jackbox/home/MH370-inputs/bathymetry")
+NAME = "etopo2022-1min-50S5N-55E145E"
+
+
+def read_dods(raw: bytes) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    """Decode a DAP2 .dods GRID response: z[lat][lon] float32, then its two coordinate maps."""
+    body = raw[raw.index(b"\nData:\n") + len(b"\nData:\n"):]
+
+    def array(offset: int, dtype: str) -> tuple[np.ndarray, int]:
+        n = int(np.frombuffer(body, ">u4", 1, offset)[0])  # XDR arrays repeat their length
+        values = np.frombuffer(body, dtype, n, offset + 8)
+        return values, offset + 8 + n * np.dtype(dtype).itemsize
+
+    z, offset = array(0, ">f4")
+    lat, offset = array(offset, ">f8")
+    lon, offset = array(offset, ">f8")
+    assert offset == len(body), "trailing bytes in .dods response"
+    return z.reshape(lat.size, lon.size), lat, lon
+
+
+def main() -> None:
+    query = f"z[({SOUTH}):{STRIDE}:({NORTH})][({WEST}):{STRIDE}:({EAST})]"
+    url = f"{DATASET}.dods?{urllib.request.quote(query, safe='():')}"
+    print(f"fetching {url}", file=sys.stderr)
+    with urllib.request.urlopen(url, timeout=600) as response:
+        raw = response.read()
+    z, lat, lon = read_dods(raw)
+    if lat[0] > lat[-1]:
+        z, lat = z[::-1], lat[::-1]
+    step_lat, step_lon = np.diff(lat), np.diff(lon)
+    assert np.allclose(step_lat, step_lat[0]) and np.allclose(step_lon, step_lon[0]), "grid is not regular"
+    assert np.isfinite(z).all(), "missing values in the grid"
+
+    OUT.mkdir(parents=True, exist_ok=True)
+    np.round(z).astype("<i2").tofile(OUT / f"{NAME}.i16")
+    retrieved = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+    (OUT / f"{NAME}.toml").write_text(
+        "# Bathymetry for hypotheses/hydroacoustics; written by its prepare/bathymetry.py.\n"
+        f'source = "NOAA NCEI ETOPO 2022 v1, 15 arc-second (every {STRIDE}th cell), via ERDDAP"\n'
+        f'url = "{url}"\n'
+        f'retrieved = "{retrieved}"\n'
+        'layout = "little-endian int16 metres, positive up; rows south to north, columns west to east"\n'
+        f"rows = {lat.size}\ncolumns = {lon.size}\n"
+        f"south_deg = {lat[0]:.10f}\nwest_deg = {lon[0]:.10f}\n"
+        f"step_lat_deg = {step_lat[0]:.12f}\nstep_lon_deg = {step_lon[0]:.12f}\n"
+    )
+    print(f"{OUT / NAME}.i16: {lat.size} x {lon.size}, depth range {z.min():.0f} to {z.max():.0f} m")
+
+
+if __name__ == "__main__":
+    main()
