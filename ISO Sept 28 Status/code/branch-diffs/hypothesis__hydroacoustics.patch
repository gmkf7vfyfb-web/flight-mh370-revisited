+def great_circle(a: tuple[float, float], b: tuple[float, float], n: int = 200) -> np.ndarray:
+    """Points on the great circle from a to b (lat, lon in degrees), for drawing only."""
+    def unit(lat, lon):
+        la, lo = np.radians(lat), np.radians(lon)
+        return np.array([np.cos(la) * np.cos(lo), np.cos(la) * np.sin(lo), np.sin(la)])
+    p, q = unit(*a), unit(*b)
+    omega = np.arccos(np.clip(p @ q, -1, 1))
+    t = np.linspace(0, 1, n)[:, None]
+    v = (np.sin((1 - t) * omega) * p + np.sin(t * omega) * q) / np.sin(omega)
+    return np.column_stack([np.degrees(np.arctan2(v[:, 2], np.hypot(v[:, 0], v[:, 1]))), np.degrees(np.arctan2(v[:, 1], v[:, 0]))])
+
