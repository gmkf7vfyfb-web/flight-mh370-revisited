+        print(r["logger"], f"{r['background_hours']:.2f} h", "thresholds", {k: round(v, 1) for k, v in r["thresholds_db"].items()})
+        print("   screened out:", r["records_screened_out"])
+        print("   controls:", [(c["utc"][11:19], c["found"], c["strength"]) for c in r["controls"]])
+        inj = r["injection"]
+        at = {int(x): p for x, p in zip(inj["exposure_db"], inj["p_detect"])}
+        print("   P_D:", {k: at[k] for k in (96, 100, 104, 108, 112, 116, 120)}, "timing", inj["timing_error_s"])
+
+
+if __name__ == "__main__":
+    main()
