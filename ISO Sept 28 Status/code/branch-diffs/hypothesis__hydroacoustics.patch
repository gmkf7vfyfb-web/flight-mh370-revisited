+                                                                     for k2, v in row.items()}})
+        header = "time_s," + ",".join(e["id"] for e in elements)
+        np.savetxt(folder / f"{sid}-synthetic.csv", np.column_stack([np.arange(n) / fs, p.T]), fmt="%.6g", delimiter=",",
+                   header=header, comments="")
+    write_csv(folder / "truth.csv", truth)
+    write_csv(folder / "expected-measurements.csv", expected)
+
