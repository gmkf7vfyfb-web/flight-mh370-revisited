+# Base estimate plus the hydroacoustic predictions. The module adds zero log-likelihood, so the
+# estimate equals the base; the run is for evaluating predictions on impact samples.
+base = "../../config/davey2016.toml"
+name = "hydroacoustics"
+
+[hypotheses.hydroacoustics]
+bathymetry = "data/external/bathymetry/etopo2022-1min-50S5N-55E145E.i16"
+celerity_km_s = [1.478, 1.492]
+energy_basis = "total"
+# Coupling loss of the impact site relative to air9, and its s.d. (dB): between air9-like
+# favourable coupling (0) and Duncan & Dall'Osto's 20-30 dB for an MH370 path to HA01.
+site_coupling_db = 15.0
+site_coupling_sd_db = 10.0
+blocking_depth_m = 1000.0
+
+# The module acts on impact samples (predictions only; its log-likelihood is zero).
+[[compose]]
+id = "hydroacoustics"
+modules = ["hydroacoustics"]
+
