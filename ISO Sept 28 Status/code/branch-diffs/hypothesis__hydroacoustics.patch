+        keep = (f >= 1.5) & (f <= 100)
+        ax.fill_between(f[keep], np.array(p["5"])[keep], np.array(p["95"])[keep], color="0.85", label="5-95 %")
+        ax.plot(f[keep], np.array(p["50"])[keep], color="k", lw=1, label="median")
+        ax.set_xscale("log")
+        ax.set_title(f"Logger {r['logger']}: noise PSD, {r['records_used']} records")
+        ax.set_xlabel("Frequency (Hz)")
+        ax.grid(alpha=0.3)
+    axes[0].set_ylabel("dB re 1 uPa^2/Hz")
+    axes[0].legend()
+    figs.append(fig)
+
+    fig, axes = plt.subplots(1, len(results), figsize=(12, 3.8), sharey=True)
+    for ax, r in zip(axes, results):
+        levels = r["far_per_hour"]["threshold_db"]
+        for band, tau in r["thresholds_db"].items():
+            line, = ax.semilogy(levels, np.maximum(r["far_per_hour"][band], 1e-3), label=f"{band} Hz")
+            ax.axvline(tau, color=line.get_color(), ls=":", lw=1)
+        ax.axhline(0.25, color="k", lw=0.8)
+        ax.set_title(f"Logger {r['logger']}: D1 false alarms ({r['background_hours']:.1f} h)")
+        ax.set_xlabel("Threshold S (dB)")
