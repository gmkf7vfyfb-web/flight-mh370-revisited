+    density.legend(fontsize=7, loc="center right")
+    fig.suptitle("Predicted exposure over the labelled stand-in impacts (nominal 4 GJ; TL incl. 15 +/- 10 dB site coupling) "
+                 "against measured P_D. P = mean over impacts of record coverage x P_D, zero if blocked", fontsize=9)
+    (OUT / "imos/detection-probability.json").write_text(json.dumps(summary, indent=1))
+    return [fig]
+
+
+def search_page() -> list[plt.Figure]:
+    path = OUT / "imos/search.json"
+    if not path.exists():
+        return []
+    results = json.loads(path.read_text())
+    lines = ["Pre-registered search of the IMOS loggers (windows from the stand-in envelope; thresholds fixed from background)", "",
+             f"{'logger':8}{'window (UTC)':>22}{'searched':>10}{'expected':>10}{'found':>7}{'P(N>=n)':>9}"]
+    for r in results:
+        if "logger" not in r:
+            continue
+        window = f"{r['window'][0][11:19]}-{r['window'][1][11:19]}"
+        lines.append(f"{r['logger']:8}{window:>22}{r['searched_s']:>9.0f}s{r['expected']:>10.2f}{len(r['detections']):>7}{r['p_value']:>9.2f}")
+        for d in r["detections"]:
+            lines.append(f"    detection {d['utc'][11:19]} UTC, {d['band_hz'][0]:g}-{d['band_hz'][1]:g} Hz, S = {d['s_max_db']} dB")
+        if r.get("other_nights"):
+            o = r["other_nights"]
+            lines.append(f"    same UTC window on 13 other nights: {o['detections']} detections in {o['searched_hours']:.1f} h "
+                         f"({o['per_hour']:.2f}/h, i.e. {o['per_hour'] * r['searched_s'] / 3600:.2f} expected)")
+    lines += ["", "Controls (published arrivals at 3315; D1's S near each, and how often background peaks are as strong):"]
+    for r in results:
+        for c in r.get("controls", []):
+            parts = ", ".join(f"{b} Hz S={v['s_max_db']} ({v['background_per_hour_at_or_above']}/h)" for b, v in c["strength"].items())
+            lines.append(f"  {c['utc'][11:19]} {c['station']}: {parts}")
+    quakes = OUT / "imos/earthquake-controls.json"
+    if quakes.exists():
+        lines += ["", "Exploratory controls, not pre-registered: T-phases of USGS M>=4 earthquakes (largest S per band near the prediction)"]
+        for q in json.loads(quakes.read_text()):
+            best = max(q["bands"].items(), key=lambda kv: kv[1]["s_max_db"]) if q["bands"] else None
+            if best:
+                lines.append(f"  {q['logger']} {q['event'][:45]:45} {q['distance_km']:>5} km: best {best[0]} Hz S={best[1]['s_max_db']} "
+                             f"at {best[1]['offset_s']:+.0f} s ({best[1]['background_per_hour_at_or_above']}/h)")
+    fig, ax = plt.subplots(figsize=(11, 8.5))
+    ax.axis("off")
+    ax.text(0.0, 1.0, "\n".join(lines), va="top", family="monospace", fontsize=7.5)
+    return [fig]
+
+
+def main() -> None:
+    pages = [map_page()] + detection_pages() + kadri_page() + level_page() + search_page()
+    with PdfPages(OUT / "report.pdf") as pdf:
+        for k, fig in enumerate(pages, 1):
+            fig.tight_layout()
+            pdf.savefig(fig)
+            fig.savefig(OUT / f"report-page-{k}.png", dpi=110)
+    print(f"{OUT / 'report.pdf'}: {len(pages)} pages, PNG beside each")
+
+
+if __name__ == "__main__":
+    main()
