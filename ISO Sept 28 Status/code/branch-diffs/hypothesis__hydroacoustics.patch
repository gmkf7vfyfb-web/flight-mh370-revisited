@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+"""Exploratory positive controls, not pre-registered: T-phases of catalogued earthquakes at the
+IMOS loggers, outside the quarantine.
+
+Events come from the USGS ComCat catalogue: M >= 4, 7-9 March 2014, 65 S-15 N, 40-160 E
+(https://earthquake.usgs.gov/fdsnws/event/1/query, queried 2026-09-26). Only events whose
+predicted arrival falls in a logger record are listed. The arrival is predicted as origin time
+plus the spherical distance at 1.48 km/s, from 120 s early to 60 s late: T-phases start with
+faster seismic legs. The script reports D1's largest S near that time in each band, and how
+often background peaks at that logger reach it (detection-control.json).
+
+    .venv/bin/python hypotheses/hydroacoustics/prepare/earthquakes.py
+"""
+
+from __future__ import annotations
+
+import json
+
+import numpy as np
+
+import detect
+import waveforms as w
+from measure import bandpass
+
+OUT = w.HERE.parents[2] / "runs/hydroacoustics/imos"
+EVENTS = [  # (origin UTC, lat, lon, depth km, magnitude, place): USGS ComCat
+    ("2014-03-07T20:36:06", -49.0178, 123.3764, 14.9, 4.5, "western Indian-Antarctic Ridge"),
+    ("2014-03-07T22:50:07", -54.3570, 140.0450, 10.7, 4.2, "west of Macquarie Island"),
+    ("2014-03-07T23:52:18", -9.6744, 108.4193, 34.1, 4.1, "243 km SSW of Kroya, Java"),
+    ("2014-03-08T03:37:52", -4.2194, 133.6963, 10.0, 5.2, "187 km NE of Tual"),
+    ("2014-03-08T05:50:41", -7.4612, 128.4641, 162.2, 4.0, "199 km NE of Lospalos"),
+    ("2014-03-08T08:50:55", -6.0063, 102.5166, 35.2, 4.4, "233 km SSW of Pagar Alam, Sumatra"),
+    ("2014-03-08T23:42:47", -10.1577, 118.8848, 75.0, 4.1, "161 km WSW of Waingapu"),
+]
+EARLY_S, LATE_S = 120.0, 60.0
+
+
+def distance_km(lat1, lon1, lat2, lon2) -> float:
+    a, b = np.radians([lat1, lat2]), np.radians(lon2 - lon1)
+    return float(6371.0 * np.arccos(np.clip(np.sin(a[0]) * np.sin(a[1]) + np.cos(a[0]) * np.cos(a[1]) * np.cos(b), -1, 1)))
+
+
+def main() -> None:
+    controls = {r["logger"]: r for r in json.loads((OUT / "detection-control.json").read_text())}
+    quarantine = [np.datetime64(t.rstrip("Z"), "ns") for t in detect.PREREG["windows"]["quarantine_utc"]]
+    rows = []
+    for logger, station in ((k, v) for k, v in w.stations().items() if k in controls):
+        element = station["elements"][0]
+        records = w.imos_records(logger)
+        for origin, lat, lon, depth, magnitude, place in EVENTS:
+            km = distance_km(lat, lon, element["lat"], element["lon"])
+            arrival = np.datetime64(origin, "ns") + np.timedelta64(int(km / 1.48 * 1e9), "ns")
+            for member, opened in records:
+                if not (opened <= arrival <= opened + np.timedelta64(330, "s")):
+                    continue
+                if quarantine[0] - np.timedelta64(400, "s") <= opened <= quarantine[1]:
+                    continue
+                trace = w.read_imos(logger, member)
+                offset = (arrival - trace.t0) / np.timedelta64(1, "ns") * 1e-9
+                if trace.quality or not (10 <= offset <= trace.p.shape[1] / trace.fs - 10):
+                    continue
+                far = controls[logger]["far_per_hour"]
+                bands = {}
+                for band in detect.BANDS:
+                    t, e, s = detect.statistic(bandpass(trace.p[0], trace.fs, *band), trace.fs, trace.edge_s)
+                    near = [(tp, smax) for tp, smax, _ in detect.peaks(t, s, e) if -EARLY_S <= tp - offset <= LATE_S]
+                    if near:
+                        tp, smax = max(near, key=lambda x: x[1])
+                        key = f"{band[0]:g}-{band[1]:g}"
+                        bands[key] = {"s_max_db": round(smax, 1), "offset_s": round(tp - offset, 1),
+                                      "background_per_hour_at_or_above": round(float(np.interp(smax, far["threshold_db"], far[key])), 2),
+                                      "above_threshold": bool(smax >= controls[logger]["thresholds_db"][key])}
+                rows.append({"logger": logger, "event": f"{origin} M{magnitude} {place}", "distance_km": round(km),
+                             "predicted_arrival": str(arrival)[:19], "bands": bands})
+                print(logger, rows[-1]["event"], rows[-1]["distance_km"], "km;",
+                      {k: (v["s_max_db"], v["offset_s"], v["background_per_hour_at_or_above"]) for k, v in bands.items()})
+    (OUT / "earthquake-controls.json").write_text(json.dumps(rows, indent=1))
+
+
+if __name__ == "__main__":
+    main()
