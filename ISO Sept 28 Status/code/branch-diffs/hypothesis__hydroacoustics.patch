@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+"""Stand-in impact samples until the end-of-flight stage exists (labelled; never evidence).
+
+Draws N positions from the pooled BTO+BFO posterior at 00:19:37 (base run final.npy,
+replicates combined with summary.json's pool factors). Each is moved a uniform 0-250 km in a
+uniform direction, and given an impact time uniform on 00:19:37-00:55:00 UTC, as fixed in
+preregistration.toml [windows.stand_in]. The spread is deliberately wider than any glide.
+Kinetic energy is a nominal 4 GJ (200 t at 200 m/s; vertical half of it). The windows do not
+use it, and nothing here predicts it.
+
+Options set other labelled stand-ins without changing the registered one:
+- --spread-km;
+- --last (last impact time, UTC);
+- --beyond-arc: move only away from the satellite's sub-point (0 N, 64.5 E), i.e. outside the arc;
+- --out.
+
+    .venv/bin/python hypotheses/hydroacoustics/prepare/stand_in.py [--spread-km 250] [--last 00:55:00] [--beyond-arc]
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[3]
+T_FIRST = np.datetime64("2014-03-08T00:19:37")
+EARTH_KM = 6371.0
+SUB_SATELLITE = (0.0, 64.5)  # Inmarsat-3F1, degrees
+SEED = 20260926
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--run", default="runs/davey2016")
+    parser.add_argument("--n", type=int, default=20_000)
+    parser.add_argument("--spread-km", type=float, default=250.0)
+    parser.add_argument("--last", default="00:55:00")
+    parser.add_argument("--beyond-arc", action="store_true")
+    parser.add_argument("--out", default="stand-in-impacts.csv")
+    args = parser.parse_args()
+    run, n = ROOT / args.run, args.n
+    case = next(c for c in json.loads((run / "summary.json").read_text())["cases"] if c["case"] == "bto-bfo")
+    lat, lon, weight = [], [], []
+    for rep, seed in enumerate(case["seeds"]):
+        final = np.load(run / f"bto-bfo/seed-{seed}/final.npy", mmap_mode="r")
+        factors = np.asarray(case["pool_factors"][rep])
+        weight.append(np.asarray(final[:, 0]) * factors[np.asarray(final[:, 9]).astype(int)])
+        lat.append(np.asarray(final[:, 1]))
+        lon.append(np.asarray(final[:, 2]))
+    lat, lon, weight = np.concatenate(lat), np.concatenate(lon), np.concatenate(weight)
+    rng = np.random.default_rng(SEED)
+    cumulative = np.cumsum(weight / weight.sum())
+    pick = np.minimum(np.searchsorted(cumulative, (rng.random() + np.arange(n)) / n), lat.size - 1)
+
+    # Spherical destination point: a stand-in spread, not a prediction, so no ellipsoid.
+    delta = rng.uniform(0, args.spread_km, n) / EARTH_KM
+    phi1, lam1 = np.radians(lat[pick]), np.radians(lon[pick])
+    if args.beyond_arc:  # within 90 deg of the direction pointing away from the sub-satellite point
+        phi_s, lam_s = np.radians(SUB_SATELLITE)
+        towards = np.arctan2(np.sin(lam_s - lam1) * np.cos(phi_s),
+                             np.cos(phi1) * np.sin(phi_s) - np.sin(phi1) * np.cos(phi_s) * np.cos(lam_s - lam1))
+        azimuth = towards + np.pi + rng.uniform(-np.pi / 2, np.pi / 2, n)
+    else:
+        azimuth = rng.uniform(0, 2 * np.pi, n)
+    phi2 = np.arcsin(np.sin(phi1) * np.cos(delta) + np.cos(phi1) * np.sin(delta) * np.cos(azimuth))
+    lam2 = lam1 + np.arctan2(np.sin(azimuth) * np.sin(delta) * np.cos(phi1), np.cos(delta) - np.sin(phi1) * np.sin(phi2))
+    t0 = T_FIRST.astype("datetime64[s]").astype(float)
+    last = np.datetime64(f"2014-03-08T{args.last}").astype("datetime64[s]").astype(float)
+    t = rng.uniform(t0, last, n)
+
+    out = ROOT / "runs/hydroacoustics"
+    out.mkdir(parents=True, exist_ok=True)
+    path = out / args.out
+    header = "unix_s,latitude_deg,longitude_deg,kinetic_energy_j,vertical_kinetic_energy_j,weight"
+    rows = np.column_stack([t, np.degrees(phi2), (np.degrees(lam2) + 180) % 360 - 180,
+                            np.full(n, 4e9), np.full(n, 2e9), np.full(n, 1.0 / n)])
+    np.savetxt(path, rows, fmt=["%.3f", "%.6f", "%.6f", "%.4e", "%.4e", "%.6e"], delimiter=",", header=header,
+               comments="")
+    print(f"{path}: {n} stand-in impacts; posterior draws from {lat.size} particles, "
+          f"latitude {np.degrees(phi2).min():.2f} to {np.degrees(phi2).max():.2f}")
+
+
+if __name__ == "__main__":
+    main()
