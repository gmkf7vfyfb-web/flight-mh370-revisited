@@ -0,0 +1,94 @@
+//! Regional seafloor grid (ETOPO 2022, 1 arc-minute) and what the module reads from it:
+//! depth at the impact, the seabed slope towards each station, and the shallowest point on
+//! each path.
+
+use serde::Deserialize;
+use std::path::Path;
+
+/// Little-endian int16 elevations (m, positive up), rows south to north, as written by
+/// prepare/bathymetry.py, with a TOML sidecar of the same stem describing the grid.
+pub struct Grid {
+    south: f64,
+    west: f64,
+    step_lat: f64,
+    step_lon: f64,
+    rows: usize,
+    columns: usize,
+    z: Vec<i16>,
+}
+
+#[derive(Deserialize)]
+struct Sidecar {
+    rows: usize,
+    columns: usize,
+    south_deg: f64,
+    west_deg: f64,
+    step_lat_deg: f64,
+    step_lon_deg: f64,
+}
+
+impl Grid {
+    pub fn load(path: &Path) -> Result<Grid, String> {
+        let sidecar = path.with_extension("toml");
+        let text = std::fs::read_to_string(&sidecar).map_err(|e| format!("{}: {e}", sidecar.display()))?;
+        let s: Sidecar = toml::from_str(&text).map_err(|e| format!("{}: {e}", sidecar.display()))?;
+        let bytes = std::fs::read(path).map_err(|e| format!("{}: {e}", path.display()))?;
+        if bytes.len() != 2 * s.rows * s.columns {
+            return Err(format!("{}: expected {} x {} int16 values", path.display(), s.rows, s.columns));
+        }
+        let z = bytes.chunks_exact(2).map(|b| i16::from_le_bytes([b[0], b[1]])).collect();
+        Ok(Grid::new(s.south_deg, s.west_deg, s.step_lat_deg, s.step_lon_deg, s.rows, s.columns, z))
+    }
+
+    pub fn new(south: f64, west: f64, step_lat: f64, step_lon: f64, rows: usize, columns: usize, z: Vec<i16>) -> Grid {
+        assert_eq!(z.len(), rows * columns);
+        Grid { south, west, step_lat, step_lon, rows, columns, z }
+    }
+
+    /// Bilinear elevation (m, positive up), or None outside the grid.
+    pub fn elevation(&self, lat: f64, lon: f64) -> Option<f64> {
+        let y = (lat - self.south) / self.step_lat;
+        let x = (lon - self.west) / self.step_lon;
+        if !(y >= 0.0 && x >= 0.0 && y <= (self.rows - 1) as f64 && x <= (self.columns - 1) as f64) {
+            return None;
+        }
+        let (i, j) = ((y as usize).min(self.rows - 2), (x as usize).min(self.columns - 2));
+        let (fy, fx) = (y - i as f64, x - j as f64);
+        let at = |r: usize, c: usize| f64::from(self.z[r * self.columns + c]);
+        Some(
+            (1.0 - fy) * ((1.0 - fx) * at(i, j) + fx * at(i, j + 1))
+                + fy * ((1.0 - fx) * at(i + 1, j) + fx * at(i + 1, j + 1)),
+        )
+    }
+}
+
+/// Seabed along one impact-to-station path.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct PathSeabed {
+    /// Seabed slope towards the station over the first SLOPE_KM, degrees; positive when the
+    /// seabed deepens towards the station, which is what lets a surface source couple into
+    /// the sound channel (Curtin report 2014-30, sec. 7).
+    pub downslope_deg: f64,
+    /// Shallowest seabed (m, positive down) more than END_KM from both ends. Negative is land.
+    pub min_depth_m: f64,
+}
+
+pub const SLOPE_KM: f64 = 20.0;
+pub const END_KM: f64 = 30.0;
+const STEP_KM: f64 = 2.0;
+
+/// Sample the seabed every STEP_KM along the great circle from the impact to the station.
+pub fn path_seabed(grid: &Grid, from: (f64, f64), to: (f64, f64), range_km: f64) -> Option<PathSeabed> {
+    let depth_at = |km: f64| {
+        let (lat, lon) = super::geodesy::along(from.0, from.1, to.0, to.1, km / range_km);
+        grid.elevation(lat, lon).map(|z| -z)
+    };
+    let downslope_deg = (depth_at(SLOPE_KM.min(range_km))? - depth_at(0.0)?).atan2(SLOPE_KM * 1000.0).to_degrees();
+    let mut min_depth_m = f64::INFINITY;
+    let mut km = END_KM;
+    while km <= range_km - END_KM {
+        min_depth_m = min_depth_m.min(depth_at(km)?);
+        km += STEP_KM;
+    }
+    Some(PathSeabed { downslope_deg, min_depth_m })
+}
