+ROOT = w.HERE.parents[2]
+OUT = ROOT / "runs/hydroacoustics/kadri-tests"
+SRC = w.Path("/jackbox/home/MH370-v01-share-withdrawn-one-turn-20260907/v01/workspace/.sources/kadri-2024-hydroacoustics")
+LABEL = "published, processed traces; not raw data; not blind"
+ARC_TIME = np.datetime64("2014-03-08T00:19:29")
+KADRI_C = 1.5  # km/s, Kadri's stated speed
+
+# ISC registry element coordinates (queried 2026-09-28), triad centres, for stations outside stations.toml.
+IMS = {"H11N": (19.7209, 166.8993), "H11S": (18.4981, 166.6977), "H10S": (-8.9510, -14.6522),
+       "H08N": (-6.3375, 71.0021), "H08S": (-7.6394, 72.4838), "H01W": (-34.8916, 114.1413)}
+F35 = {"energy_j": 900e6, "peak_pa": 0.7, "range_km": 3300.0}  # Brown et al. (2026), the module's anchor
+# (name, UTC of impact, lat, lon, speed m/s [S1], assumed mass kg (type, phase), station, figure panel start UTC,
+#  transient minute read in the panel, peak Pa read, reading uncertainty Pa, distinct from noise in the figure?)
+CRASHES = [
+    ("F-35A", "2019-04-09T10:26:30", 40.5028, 142.0769, 300.0, None, "H11N", "2019-04-09T10:58", 5.05, 1.10, 0.15, True),
+    ("F-35A", "2019-04-09T10:26:30", 40.5028, 142.0769, 300.0, None, "H11S", "2019-04-09T10:59", 5.10, 1.00, 0.20, True),
+    ("Yemenia 626", "2009-06-29T22:50:00", -11.6749, 43.2777, 133.3, 115e3, "H08N", "2009-06-29T23:29", 4.80, 0.23, 0.05, False),
+    ("Yemenia 626", "2009-06-29T22:50:00", -11.6749, 43.2777, 133.3, 115e3, "H08S", "2009-06-29T23:27", 4.95, 0.70, 0.10, False),
+    ("Sriwijaya 182", "2021-01-09T07:40:27", -5.9150, 107.1183, 150.0, 57e3, "H08S", "2021-01-09T08:06", 5.30, 1.00, 0.10, True),
+    ("Air France 447", "2009-06-01T02:14:28", 3.0658, -30.5617, 78.3, 205e3, "H10S", "2009-06-01T02:41", 4.75, 0.80, 0.10, True),
+    ("Transair 810", "2021-07-02T11:46:00", 21.3114, -157.9044, 59.7, 48e3, "H11S", "2021-07-02T12:27", 4.80, 0.45, 0.08, True),
+    ("Transair 810", "2021-07-02T11:46:00", 21.3114, -157.9044, 59.7, 48e3, "H11N", "2021-07-02T12:28", 4.90, 0.40, 0.10, False),
