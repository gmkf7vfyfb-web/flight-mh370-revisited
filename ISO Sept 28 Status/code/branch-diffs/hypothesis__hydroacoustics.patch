+//! Hydroacoustics: where and when an MH370 sea impact would have been heard, and how loudly.
+//!
+//! **Assumption.** A high-energy impact near the 7th arc radiates a low-frequency pulse into
+//! the SOFAR channel. The pulse reaches the IMS hydrophone triads H01W (Cape Leeuwin) and H08S
+//! (Diego Garcia) and the IMOS loggers 3315/3376 (Perth Canyon), 3250 (Scott Reef) and
+//! 3274/3275 (Portland shelf).
+//!
+//! **How it enters the estimate.** It does not yet. Every log-likelihood hook returns zero.
+//! It is an impact module: named in a `[[compose]]` set, it writes predictions for each impact
+//! sample (`prediction_columns`, `predict`), which `mh370 evaluate` also runs on a samples file.
+//! Per impact sample and station, the module predicts:
+//! - geodesic range and back-azimuth (WGS-84, Vincenty);
+//! - the arrival window for a group celerity of 1.478-1.492 km/s;
+//! - the shallowest seabed on the path and a blockage flag;
+//! - the seabed slope at the impact;
+//! - band transmission loss with its s.d.;
+//! - band received exposure and broadband peak pressure at eta = 1.
+//!
+//! Exposure scales as 10 log10(eta) and peak pressure as sqrt(eta). Detection data can enter
+//! only once a detector's probability of detection and false-alarm rate are measured
+//! (prepare/, the detection-control protocol). The form will then be
+//! (1 - P_D) + P_D x (detection match / background rate), so an absence counts only where a
+//! signal would have been detectable.
+//!
+//! **Sources and departures.**
+//! - Source: eta x impact kinetic energy (total by default), radiated as a monopole with a
+//!   flat spectrum over 2-40 Hz.
+//! - eta's upper anchor is the F-35A crash (Brown et al. 2026, Icarus): 900 MJ gave 0.7 Pa at
+//!   H11, 3,300 km away. Brown's eta ~ 1e-4 comes from Arons' near-field explosion law
+//!   applied at 3,300 km. Here the F-35 is re-expressed in this chain (`f35_eta`), which gives
+//!   eta = 8.7e-3. The two numbers are different conventions, not a disagreement.
+//! - The F-35 site was favourable, so its eta is an upper bound.
+//! - Transmission loss: the air9 airgun shots of 19 Oct 2001 (27 deg 33.2-34.0' S,
+//!   98 deg 51.6-53.9' E, Blackman et al. 2004, UCRL-TR-207323, Table I and Fig. 23) are
+//!   116 km from the 7th arc. Their loss at H01 (1,663 km) and H08S (3,549 km) is used per band.
+//! - The report's text gives 4,825 km to H08S, but its own Table I positions give 3,549 km;
+//!   we use the table.
+//! - Bands without measured frequencies (below 5 Hz at both stations, below 13 Hz at H01)
+//!   borrow the nearest measured band, with 6 dB extra s.d.
+//! - Loss moves to other ranges by cylindrical spreading.
+//! - A site-coupling loss relative to air9 (`site_coupling_db`, s.d. `site_coupling_sd_db`)
+//!   carries the largest unknown: how a surface impact over a deep, flat seabed couples into
+//!   the channel (see `propagation::SiteCoupling`).
+//! - The IMOS loggers have no loss calibration. They borrow H01's, with 10 dB extra s.d.
+//!
+//! **Data.**
+//! - Stations: stations.toml (ISC registry; Curtin metadata).
+//! - Measured loss: blackman-air9-tl.csv (digitised by prepare/digitise_blackman.py).
+//! - Bathymetry: NOAA NCEI ETOPO 2022 (15 arc-second, public domain), sampled every 1 arc-minute
+//!   by prepare/bathymetry.py into /jackbox/home/MH370-inputs/bathymetry/. It is outside git
+//!   and read through `bathymetry` in run.toml.
+//! - IMOS acoustic data: CC BY 4.0. "Data was sourced from Australia's Integrated Marine
+//!   Observing System (IMOS) - IMOS is enabled by the National Collaborative Research
+//!   Infrastructure Strategy (NCRIS)."
+
+mod bathymetry;
+mod geodesy;
+mod propagation;
+
+use hypothesis::{Hypothesis, ImpactView};
+use propagation::{Calibration, SiteCoupling, BANDS};
+use serde::Deserialize;
+use std::path::Path;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Params {
+    /// Bathymetry grid (.i16 with a .toml sidecar), relative to the repository root.
+    bathymetry: String,
+    /// Group celerity of the SOFAR arrival, km/s. Curtin modelled 1.484-1.486 km/s and Blackman
+    /// found arrivals within seconds of 1.49 km/s.
+    celerity_km_s: [f64; 2],
+    /// "total" or "vertical" impact kinetic energy as the source energy.
+    energy_basis: String,
+    site_coupling_db: f64,
+    site_coupling_sd_db: f64,
+    /// A path is blocked if the seabed rises above this depth (m) away from its ends.
+    blocking_depth_m: f64,
+}
+
+#[derive(Deserialize)]
+struct StationTable {
+    station: Vec<StationEntry>,
+}
+
+#[derive(Deserialize)]
+struct StationEntry {
+    id: String,
+    elements: Vec<Element>,
+}
+
+#[derive(Deserialize)]
+struct Element {
+    lat: f64,
+    lon: f64,
+}
+
+/// air9, the mean of the first and last shot positions (Blackman et al. 2004, Table I).
+const AIR9: (f64, f64) = (-27.56, 98.879_167);
+/// Extra TL s.d. for a receiver without its own calibration (the IMOS loggers), dB.
+const UNCALIBRATED_RECEIVER_SD: f64 = 10.0;
+/// Share of the F-35's kinetic energy that was vertical, for the vertical-energy variant.
+/// Its impact angle is not in the sources held here; 0.5 is a 45-degree dive.
+const F35_VERTICAL_FRACTION: f64 = 0.5;
+
+struct Station {
+    id: String,
+    lat: f64,
+    lon: f64,
+    calibration: Calibration,
+    extra_sd: f64,
+}
+
+pub struct Hydroacoustics {
+    params: Params,
+    stations: Vec<Station>,
+    grid: bathymetry::Grid,
+    coupling: SiteCoupling,
+    vertical_energy: bool,
+    /// eta at which the F-35 crash is reproduced: the upper anchor of the eta range.
+    pub f35_eta: f64,
+}
+
+pub fn new(params: &toml::Value) -> Result<Box<dyn Hypothesis>, String> {
+    Ok(Box::new(Hydroacoustics::from_params(params)?))
+}
+
+impl Hydroacoustics {
+    pub fn from_params(params: &toml::Value) -> Result<Hydroacoustics, String> {
+        let params: Params = params.clone().try_into().map_err(|e| format!("hydroacoustics: {e}"))?;
+        let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("..");
+        let grid = bathymetry::Grid::load(&root.join(&params.bathymetry)).map_err(|e| {
+            format!("hydroacoustics: {e}; fetch it with hypotheses/hydroacoustics/prepare/bathymetry.py")
+        })?;
+        Hydroacoustics::with_grid(params, grid)
+    }
+
+    fn with_grid(params: Params, grid: bathymetry::Grid) -> Result<Hydroacoustics, String> {
+        let [c_min, c_max] = params.celerity_km_s;
+        if !(c_min > 1.4 && c_max >= c_min && c_max < 1.6) {
+            return Err("hydroacoustics: celerity_km_s must be ordered and within 1.4-1.6 km/s".into());
+        }
+        let vertical_energy = match params.energy_basis.as_str() {
+            "total" => false,
+            "vertical" => true,
+            other => return Err(format!("hydroacoustics: energy_basis `{other}` is not total or vertical")),
+        };
+        if !(params.site_coupling_sd_db >= 0.0) {
+            return Err("hydroacoustics: site_coupling_sd_db must be non-negative".into());
+        }
+        let table: StationTable = toml::from_str(include_str!("stations.toml")).map_err(|e| e.to_string())?;
+        let (h08s, h01w) = measured_loss();
+        let mut stations = Vec::new();
+        for entry in table.station {
+            let n = entry.elements.len() as f64;
+            let lat = entry.elements.iter().map(|e| e.lat).sum::<f64>() / n;
+            let lon = entry.elements.iter().map(|e| e.lon).sum::<f64>() / n;
+            // The IMOS loggers have no calibration of their own; they borrow the nearest IMS one.
+            let (rows, reference, extra_sd) = match entry.id.as_str() {
+                "H08S" => (&h08s, (lat, lon), 0.0),
+                "H01W" => (&h01w, (lat, lon), 0.0),
+                _ => (&h01w, h01w_reference(), UNCALIBRATED_RECEIVER_SD),
+            };
+            let (range_km, _) = geodesy::inverse(reference.0, reference.1, AIR9.0, AIR9.1);
+            stations.push(Station { id: entry.id, lat, lon, calibration: Calibration::from_table(range_km, rows), extra_sd });
+        }
+        let reference: Vec<Calibration> =
+            stations.iter().filter(|s| s.extra_sd == 0.0).map(|s| s.calibration).collect();
+        let f35_energy = propagation::F35_ENERGY_J * if vertical_energy { F35_VERTICAL_FRACTION } else { 1.0 };
+        let f35_eta = propagation::f35_eta(&reference, f35_energy);
+        let coupling = SiteCoupling { loss_db: params.site_coupling_db, sd_db: params.site_coupling_sd_db };
+        Ok(Hydroacoustics { params, stations, grid, coupling, vertical_energy, f35_eta })
+    }
+}
+
+impl Hypothesis for Hydroacoustics {
+    /// Names of the values `predict` writes, in order. First the seabed depth at the impact and
+    /// the F-35 anchor eta (a constant, so downstream eta scans read it from here). Then, per
+    /// station: range, back-azimuth, arrival window and path seabed; per band TL, its s.d. and
+    /// exposure at eta = 1 (dB re 1 uPa^2 s); and the broadband peak pressure at eta = 1.
+    fn prediction_columns(&self) -> Vec<String> {
+        let mut columns = vec!["site_depth_m".to_string(), "f35_eta".to_string()];
+        for s in &self.stations {
+            for name in [
+                "range_km",
+                "back_azimuth_deg",
+                "arrival_early_unix_s",
+                "arrival_late_unix_s",
+                "path_min_depth_m",
+                "blocked",
+                "site_downslope_deg",
+            ] {
+                columns.push(format!("{}.{name}", s.id));
+            }
+            for (lo, hi) in BANDS {
+                for name in ["tl_db", "tl_sd_db", "sel_eta1_db"] {
+                    columns.push(format!("{}.{name}.{lo}-{hi}hz", s.id));
+                }
+            }
+            columns.push(format!("{}.peak_eta1_pa", s.id));
+        }
+        columns
+    }
+
+    fn predict(&self, impact: &ImpactView, out: &mut [f64]) {
+        let at = (impact.latitude_deg, impact.longitude_deg);
+        let energy = if self.vertical_energy { impact.vertical_kinetic_energy_j } else { impact.kinetic_energy_j };
+        let [c_min, c_max] = self.params.celerity_km_s;
+        out[0] = self.grid.elevation(at.0, at.1).map_or(f64::NAN, |z| -z);
+        out[1] = self.f35_eta;
+        let mut k = 2;
+        for s in &self.stations {
+            let (range_km, back_azimuth) = geodesy::inverse(s.lat, s.lon, at.0, at.1);
+            let seabed = bathymetry::path_seabed(&self.grid, at, (s.lat, s.lon), range_km);
+            let (min_depth, blocked, downslope) = match seabed {
+                Some(p) => (p.min_depth_m, f64::from(u8::from(p.min_depth_m < self.params.blocking_depth_m)), p.downslope_deg),
+                None => (f64::NAN, f64::NAN, f64::NAN),
+            };
+            out[k..k + 7].copy_from_slice(&[
+                range_km,
+                back_azimuth,
+                impact.unix_s + range_km / c_max,
+                impact.unix_s + range_km / c_min,
+                min_depth,
+                blocked,
+                downslope,
+            ]);
+            k += 7;
+            let mut sel = [0.0; 4];
+            for (b, band) in BANDS.iter().enumerate() {
+                let tl = s.calibration.tl_at(b, range_km) + self.coupling.loss_db;
+                let sd = (s.calibration.sd_db[b].powi(2) + s.extra_sd.powi(2) + self.coupling.sd_db.powi(2)).sqrt();
+                sel[b] = propagation::energy_source_level_db(energy, *band) - tl;
+                out[k..k + 3].copy_from_slice(&[tl, sd, sel[b]]);
+                k += 3;
+            }
+            out[k] = propagation::peak_pa(&sel, range_km);
+            k += 1;
+        }
+    }
+}
+
+/// The digitised air9 loss per frequency: (H08S rows, H01W rows) of (Hz, dB).
+fn measured_loss() -> (Vec<(f64, f64)>, Vec<(f64, f64)>) {
+    let (mut h08s, mut h01w) = (Vec::new(), Vec::new());
+    for line in include_str!("blackman-air9-tl.csv").lines().filter(|l| !l.starts_with('#')).skip(1) {
+        let fields: Vec<&str> = line.split(',').collect();
+        let f: f64 = fields[0].parse().unwrap();
+        if let Ok(v) = fields[1].parse() {
+            h08s.push((f, v));
+        }
+        if let Ok(v) = fields[2].parse() {
+            h01w.push((f, v));
+        }
+    }
+    (h08s, h01w)
+}
+
+/// H01W's centre, the calibration point borrowed by the IMOS loggers.
+fn h01w_reference() -> (f64, f64) {
+    let table: StationTable = toml::from_str(include_str!("stations.toml")).unwrap();
+    let h01w = table.station.iter().find(|s| s.id == "H01W").unwrap();
+    let n = h01w.elements.len() as f64;
+    (h01w.elements.iter().map(|e| e.lat).sum::<f64>() / n, h01w.elements.iter().map(|e| e.lon).sum::<f64>() / n)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const H01W: (f64, f64) = (-34.891_566_666_666_67, 114.1413);
+
+    /// A module over a flat 4,000 m seabed covering the whole region.
+    fn module(celerity: [f64; 2]) -> Hydroacoustics {
+        let grid = bathymetry::Grid::new(-50.0, 55.0, 0.5, 0.5, 111, 141, vec![-4000; 111 * 141]);
+        let params = Params {
+            bathymetry: String::new(),
+            celerity_km_s: celerity,
+            energy_basis: "total".into(),
+            site_coupling_db: 15.0,
+            site_coupling_sd_db: 10.0,
+            blocking_depth_m: 1000.0,
+        };
+        Hydroacoustics::with_grid(params, grid).unwrap()
+    }
+
+    fn predict(m: &Hydroacoustics, lat: f64, lon: f64, energy_j: f64) -> std::collections::HashMap<String, f64> {
+        let impact = ImpactView {
+            parent: 0,
+            unix_s: 1_000.0,
+            latitude_deg: lat,
+            longitude_deg: lon,
+            velocity_east_mps: 0.0,
+            velocity_north_mps: 0.0,
+            velocity_up_mps: 0.0,
+            flight_path_angle_deg: 0.0,
+            mass_kg: 0.0,
+            kinetic_energy_j: energy_j,
+            vertical_kinetic_energy_j: energy_j,
+            family: 0,
+            takeover_unix_s: f64::NAN,
+            takeover_latitude_deg: f64::NAN,
+            takeover_longitude_deg: f64::NAN,
+            takeover_altitude_ft: f64::NAN,
+            mode: 0,
+            alternative: 0,
+            latents: &[],
+        };
+        let mut out = vec![0.0; m.prediction_columns().len()];
+        m.predict(&impact, &mut out);
+        m.prediction_columns().into_iter().zip(out).collect()
+    }
+
+    #[test]
+    fn geodesics_match_geographiclib() {
+        // GeographicLib (pyproj 3.8 Geod, WGS-84), computed independently.
+        let (d, az) = geodesy::inverse(H01W.0, H01W.1, AIR9.0, AIR9.1);
+        assert!((d - 1663.093_802).abs() < 1e-3 && (az - 295.062_582_56).abs() < 1e-6, "{d} {az}");
+        let (d, az) = geodesy::inverse(-7.639_366_666_666_667, 72.483_833_333_333_34, AIR9.0, AIR9.1);
+        assert!((d - 3548.858_639).abs() < 1e-3 && (az - 131.683_010_82).abs() < 1e-6, "{d} {az}");
+    }
+
+    #[test]
+    fn zero_range_has_zero_travel_time() {
+        let p = predict(&module([1.478, 1.492]), H01W.0, H01W.1, 1e9);
+        assert_eq!(p["H01W.range_km"], 0.0);
+        assert_eq!(p["H01W.arrival_early_unix_s"], 1_000.0);
+        assert_eq!(p["H01W.arrival_late_unix_s"], 1_000.0);
+    }
+
+    #[test]
+    fn four_times_the_energy_doubles_the_pressure() {
+        let m = module([1.478, 1.492]);
+        let (one, four) = (predict(&m, -35.0, 92.0, 1e9), predict(&m, -35.0, 92.0, 4e9));
+        for s in ["H01W", "H08S", "3315"] {
+            let ratio = four[&format!("{s}.peak_eta1_pa")] / one[&format!("{s}.peak_eta1_pa")];
+            assert!((ratio - 2.0).abs() < 1e-12, "{s}: {ratio}");
+            let gain = four[&format!("{s}.sel_eta1_db.20-40hz")] - one[&format!("{s}.sel_eta1_db.20-40hz")];
+            assert!((gain - 10.0 * 4f64.log10()).abs() < 1e-9);
+        }
+    }
+
+    #[test]
+    fn cape_leeuwin_and_diego_garcia_ranges_match_the_archived_scale() {
+        // The previous codebase's independent check: a source at 34.9167 S 92.0472 E is
+        // ~2,011 km from H01W and ~3,632 km from H08S, i.e. 22.4 and 40.5 min at 1.45-1.55 km/s.
+        let p = predict(&module([1.45, 1.55]), -34.9167, 92.0472, 1e9);
+        let mid = |s: &str| {
+            0.5 * (p[&format!("{s}.arrival_early_unix_s")] + p[&format!("{s}.arrival_late_unix_s")]) - 1_000.0
+        };
+        assert!((p["H01W.range_km"] - 2_011.0).abs() < 10.0);
+        assert!((p["H08S.range_km"] - 3_632.0).abs() < 15.0);
+        assert!((mid("H01W") / 60.0 - 22.4).abs() < 0.2);
+        assert!((mid("H08S") / 60.0 - 40.5).abs() < 0.3);
+    }
+
+    #[test]
+    fn levels_follow_hand_computed_values() {
+        // 1 J over 2-40 Hz: 10 log10(1.539e6 / 4 pi) + 120 = 170.880 dB re 1 uPa^2 s m^2.
+        assert!((propagation::energy_source_level_db(1.0, (2.0, 40.0)) - 170.880).abs() < 1e-3);
+        // 1 Pa^2 s received over the 6.0 s duration at 3,333.33 km: rms 0.408 Pa, peak 1.225 Pa.
+        let sel = [120.0 - 10.0 * 4f64.log10(); 4];
+        assert!((propagation::peak_pa(&sel, 3_333.333_333) - 3.0 / 6f64.sqrt()).abs() < 1e-9);
+        // The anchor reproduces the F-35 peak it was built from.
+        let m = module([1.478, 1.492]);
+        let reference: Vec<Calibration> = m.stations[..2].iter().map(|s| s.calibration).collect();
+        let mut sel = [0.0; 4];
+        for (b, band) in BANDS.iter().enumerate() {
+            let tl = reference.iter().map(|c| c.tl_at(b, 3300.0)).sum::<f64>() / 2.0;
+            sel[b] = propagation::energy_source_level_db(m.f35_eta * 900e6, *band) - tl;
+        }
+        assert!((propagation::peak_pa(&sel, 3300.0) - 0.7).abs() < 1e-9);
+    }
+
+    #[test]
+    fn a_ridge_on_the_path_blocks_it_and_flat_seabed_does_not() {
+        let mut m = module([1.478, 1.492]);
+        assert_eq!(predict(&m, -35.0, 92.0, 1e9)["H01W.blocked"], 0.0);
+        // A 200 m deep ridge along 100 E, across every path from 92 E to Cape Leeuwin.
+        let mut z = vec![-4000i16; 111 * 141];
+        for row in 0..111 {
+            z[row * 141 + 90] = -200;
+        }
+        m.grid = bathymetry::Grid::new(-50.0, 55.0, 0.5, 0.5, 111, 141, z);
+        let p = predict(&m, -35.0, 92.0, 1e9);
+        assert_eq!(p["H01W.blocked"], 1.0);
+        assert!(p["H01W.path_min_depth_m"] < 1000.0 && p["site_depth_m"] == 4000.0);
+    }
+}
