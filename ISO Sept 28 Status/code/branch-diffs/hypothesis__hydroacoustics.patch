index 0000000..30475c4
--- /dev/null
+++ b/hypotheses/hydroacoustics/prepare/imos_analysis.py
@@ -0,0 +1,224 @@
+#!/usr/bin/env python3
+"""Detection control on the IMOS/Curtin loggers (3315, 3376, 3250), outside the quarantine.
+
+For each logger it computes:
+- noise: PSD and band-power percentiles (5/50/95) and burstiness;
+- the D1 false-alarm rate against threshold, and the pre-registered thresholds;
+- positive controls: Curtin's published arrivals, which must be found within 5 s;
+- injection-recovery: P_D against broadband 2-40 Hz exposure, and timing errors.
+
+Records overlapping preregistration.toml's quarantine are never read. Output goes to
+runs/hydroacoustics/imos/: detection-control.json, PNG figures and detection-control.pdf.
+
+    .venv/bin/python hypotheses/hydroacoustics/prepare/imos_analysis.py
+"""
+
+from __future__ import annotations
+
+import json
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
+from matplotlib.backends.backend_pdf import PdfPages
+
+import detect
+import waveforms as w
+from measure import bandpass, synthetic
+
+ROOT = w.HERE.parents[2]
+OUT = ROOT / "runs/hydroacoustics/imos"
+LOGGERS = ["3315", "3376", "3250", "3274", "3275"]
+# Typical 7th-arc range (km) for the injected duration, 2 s + 1.2 s per 1000 km.
+TYPICAL_RANGE_KM = {"3315": 2300.0, "3376": 2300.0, "3250": 3600.0, "3274": 4900.0, "3275": 4900.0}
+EXPOSURES_DB = np.arange(90.0, 132.0, 2.0)
+PAD_S = detect.PREREG["windows"]["timing_pad_s"]
+QUARANTINE = [np.datetime64(t.rstrip("Z"), "ns") for t in detect.PREREG["windows"]["quarantine_utc"]]
+CONTROLS = [(c["station"], np.datetime64(c["utc"].rstrip("Z"), "ns"), c["note"]) for c in detect.PREREG["controls"]["events"]]
+RECORD_S = 310.0
+
+
+def quarantined(opened: np.datetime64) -> bool:
+    """True if a record opened at `opened` (within ~30 s of its first sample) could overlap the quarantine."""
+    margin = np.timedelta64(60, "s")
+    return opened - margin < QUARANTINE[1] and opened + np.timedelta64(int(RECORD_S * 1e9), "ns") + margin > QUARANTINE[0]
+
+
+def seconds_into(trace: w.Trace, t: np.datetime64) -> float:
+    return (t - trace.t0) / np.timedelta64(1, "ns") * 1e-9
+
+
+def analyse_logger(logger: str, rng: np.random.Generator) -> dict:
+    # The file-opening time in the name is within ~30 s of the first sample: widen the check.
+    records = [(m, s) for m, s in w.imos_records(logger) if not quarantined(s)]
+    controls = [(t, note) for station, t, note in CONTROLS if station == logger]
+    band_power = {b: [] for b in detect.BANDS}
+    peaks = {b: [] for b in detect.BANDS}
+    psd, hours, background, control_traces = [], 0.0, [], []
+    screened = []
+    for member, _ in records:
+        trace = w.read_imos(logger, member)
+        if trace.quality:
+            screened.append({"record": member, "reason": trace.quality})
+            continue
+        x = trace.p[0]
+        f, spectrum = w.welch_psd(x[int(trace.edge_s * trace.fs):-int(trace.edge_s * trace.fs)], trace.fs, 1024)
+        psd.append(10 * np.log10(spectrum / 1e-12))
+        inside = [(t, note) for t, note in controls if 0 <= seconds_into(trace, t) <= x.size / trace.fs]
+        filtered = {b: bandpass(x, trace.fs, *b) for b in detect.BANDS}
+        for b in detect.BANDS:
+            t, e, s = detect.statistic(filtered[b], trace.fs, trace.edge_s)
+            band_power[b].append(10 * np.log10(e[np.isfinite(s)] / 1e-12))
+            found = detect.peaks(t, s, e)
+            # Known events are controls, not background: drop peaks within 30 s of them.
+            found = [pk for pk in found if all(abs(pk[0] - seconds_into(trace, tc)) > 30 for tc, _ in inside)]
+            peaks[b].extend(pk[1] for pk in found)
+        valid = detect.statistic(filtered[detect.BANDS[0]], trace.fs, trace.edge_s)
+        hours += np.isfinite(valid[2]).sum() * detect.STEP_S / 3600
+        if inside:
+            control_traces.append((trace, filtered, inside))
+        else:
+            background.append((trace, filtered))
+
+    thresholds = {b: detect.threshold(peaks[b], hours) for b in detect.BANDS}
+    levels = np.arange(0.0, 30.01, 0.5)
+    far = {b: [float(np.sum(np.asarray(peaks[b]) >= level) / hours) for level in levels] for b in detect.BANDS}
+
+    control_results = []
+    for trace, filtered, inside in control_traces:
+        for tc, note in inside:
+            hits = []
+            for b in detect.BANDS:
+                t, e, s = detect.statistic(filtered[b], trace.fs, trace.edge_s)
+                hits += [(tp, snr, b) for tp, smax, snr in detect.peaks(t, s, e) if smax >= thresholds[b]]
+            offset = seconds_into(trace, tc)
+            near = [h for h in hits if abs(h[0] - offset) <= 5.0]
+            # The control's own S maximum per band (any threshold), and how often background peaks reach it.
+            strength = {}
+            for b in detect.BANDS:
+                t, e, s = detect.statistic(filtered[b], trace.fs, trace.edge_s)
+                close = [smax for tp, smax, _ in detect.peaks(t, s, e) if abs(tp - offset) <= 5.0]
+                if close:
+                    level = max(close)
+                    strength[f"{b[0]:g}-{b[1]:g}"] = {"s_max_db": round(level, 1),
+                                                      "background_per_hour_at_or_above": round(sum(v >= level for v in peaks[b]) / hours, 2)}
+            control_results.append({
+                "utc": str(tc), "note": note, "found": bool(near),
+                "detections": [{"offset_s": round(tp - offset, 1), "snr_db": round(sp, 1), "band_hz": list(b)} for tp, sp, b in near],
+                "strength": strength, "record": trace.note.split(":")[0],
+            })
+
+    duration = 2.0 + 1.2e-3 * TYPICAL_RANGE_KM[logger]
+    pd, timing = [], []
+    for exposure in EXPOSURES_DB:
+        found = 0
+        for _ in range(detect.PREREG["injection"]["injections_per_step"]):
+            trace, filtered = background[rng.integers(len(background))]
+            n = trace.p.shape[1]
+            centre = rng.uniform(75.0, n / trace.fs - 75.0)
+            signal = synthetic(trace.fs, duration, exposure, rng)
+            pad = int(10 * trace.fs)
+            start = int(round((centre - duration / 2) * trace.fs)) - pad
+            hit = None
+            for b in detect.BANDS:
+                piece = bandpass(np.concatenate([np.zeros(pad), signal, np.zeros(pad)]), trace.fs, *b)
+                x = filtered[b].copy()
+                x[start:start + piece.size] += piece
+                t, e, s = detect.statistic(x, trace.fs, trace.edge_s)
+                near = [tp for tp, smax, _ in detect.peaks(t, s, e) if smax >= thresholds[b] and abs(tp - centre) <= PAD_S]
+                if near and hit is None:
+                    hit = near[0] - centre
+            found += hit is not None
+            if hit is not None:
+                timing.append(hit)
+        pd.append(found / detect.PREREG["injection"]["injections_per_step"])
+
+    power = {b: np.concatenate(band_power[b]) for b in detect.BANDS}
+    psd = np.array(psd)
+    return {
+        "logger": logger,
+        "records_used": len(records) - len(screened),
+        "records_screened_out": screened,
+        "background_hours": hours,
+        "thresholds_db": {f"{b[0]:g}-{b[1]:g}": thresholds[b] for b in detect.BANDS},
+        "background_peaks": {f"{b[0]:g}-{b[1]:g}": len(peaks[b]) for b in detect.BANDS},
+        "band_power_db": {f"{b[0]:g}-{b[1]:g}": {q: float(np.percentile(power[b], q)) for q in (5, 50, 95)} for b in detect.BANDS},
+        "burstiness_db": {f"{b[0]:g}-{b[1]:g}": float(np.percentile(power[b], 99) - np.percentile(power[b], 50)) for b in detect.BANDS},
+        "psd_percentiles_db": {"frequency_hz": f.tolist(), **{str(q): np.percentile(psd, q, axis=0).tolist() for q in (5, 50, 95)}},
+        "far_per_hour": {"threshold_db": levels.tolist(), **{f"{b[0]:g}-{b[1]:g}": far[b] for b in detect.BANDS}},
+        "controls": control_results,
