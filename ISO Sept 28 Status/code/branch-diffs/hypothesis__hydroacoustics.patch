+
+def coverage(logger: str, early: np.ndarray, late: np.ndarray, pad_s: float) -> np.ndarray:
+    """Fraction of each arrival window (widened by pad_s) that falls where D1 can search a record:
+    the first sample comes within ~30 s of the file-opening time in the record's name, and the
+    edges are excluded. Uses only file names, so quarantined records are never opened."""
+    import detect
+
+    opened = np.array([t for _, t in w.imos_records(logger)]).astype("datetime64[s]").astype(float)
+    lo = opened + 20.0 + detect.DET["edge_s"] + detect.DET["energy_window_s"] / 2
+    hi = opened + 20.0 + 307.0 - detect.DET["edge_s"] - detect.DET["energy_window_s"] / 2
+    a, b = early - pad_s, late + pad_s
+    overlap = np.zeros_like(a)
+    for l, h in zip(lo, hi):
+        overlap += np.clip(np.minimum(b, h) - np.maximum(a, l), 0, None)
+    return overlap / (b - a)
+
+
+def level_page() -> list[plt.Figure]:
