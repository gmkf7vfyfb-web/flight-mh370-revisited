+#!/usr/bin/env python3
+"""Tests of our chain on Kadri's published material. Requested by Pete, 28 Sep 2026.
+
+Published, processed traces; not raw data; not blind. They test code only, and never choose
+windows, thresholds or eta; nothing here feeds preregistration.toml or the package.
+
+(a) Timing. Kadri's Table 1 delta-t, recomputed with our travel-time model under his
+    assumption: an impact on the 7th arc at 00:19:29 along each bearing. Arc and station
+    geometry come from `mh370 evaluate` (the module itself) on points of the m0019a arc
+    (base run reference arc, 35,000 ft).
+(b) Measurement. D1 and measure.py on the Figure 9 vector traces (old extraction, metadata.json).
+    Each panel is one plotted channel with ~15 vertices per second. Only its envelope and
+    content below about 5 Hz are real, and it carries no bearing.
+(c) Loudness. The six crashes of Figures 4-5, with positions and speeds from Kadri's S1:
+    - masses are our assumptions from aircraft type and phase of flight;
+    - peaks and arrival times are read by eye from the published figures;
+    - the prediction is the module's chain relative to the F-35 anchor: favourable coupling,
+      cylindrical spreading, duration 2 s + 1.2 s per 1000 km, pressure proportional to
+      sqrt(eta KE / (range x duration)).
+    Station distances are spherical (under 0.5 % from the geodesic), which is enough for
+    minute-scale timing and dB-scale levels.
+
+    .venv/bin/python hypotheses/hydroacoustics/prepare/kadri_tests.py
+"""
+
+from __future__ import annotations
+
+import csv
+import json
+import subprocess
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
