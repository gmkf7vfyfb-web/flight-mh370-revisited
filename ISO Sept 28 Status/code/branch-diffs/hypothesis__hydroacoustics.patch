+                      "timing_error_s": {"median": float(np.median(timing)) if timing else None,
+                                         "p05": float(np.percentile(timing, 5)) if timing else None,
+                                         "p95": float(np.percentile(timing, 95)) if timing else None}},
+    }
+
+
+def figures(results: list[dict]) -> list[plt.Figure]:
+    figs = []
+    fig, axes = plt.subplots(1, len(results), figsize=(12, 3.8), sharey=True)
+    for ax, r in zip(axes, results):
+        p = r["psd_percentiles_db"]
