+    lat = meta["south_deg"] + 6 * meta["step_lat_deg"] * np.arange(z.shape[0])
+    lon = meta["west_deg"] + 6 * meta["step_lon_deg"] * np.arange(z.shape[1])
+    fig, ax = plt.subplots(figsize=(11, 7.5))
+    depth = np.where(z < 0, -z, np.nan)
+    image = ax.pcolormesh(lon, lat, depth, cmap="Blues", vmin=0, vmax=6500, shading="auto")
+    ax.contourf(lon, lat, (z >= 0).astype(float), levels=[0.5, 1.5], colors=["0.75"])
+    ax.contour(lon, lat, depth, levels=[1000], colors="0.35", linewidths=0.4)
+    fig.colorbar(image, ax=ax, label="Water depth (m); grey line 1,000 m (sound-channel axis)", shrink=0.8)
+    impacts = OUT / "stand-in-impacts.csv"
