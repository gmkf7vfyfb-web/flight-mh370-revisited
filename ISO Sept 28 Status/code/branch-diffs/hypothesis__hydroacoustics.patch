index 0000000..32a8c75
--- /dev/null
+++ b/hypotheses/hydroacoustics/prepare/search.py
@@ -0,0 +1,132 @@
+#!/usr/bin/env python3
+"""The pre-registered search of the IMOS loggers. Run only after the windows are committed.
+
+For each logger:
+- open the records that overlap its window (windows.csv from package.py, built by the
+  preregistration.toml rule);
+- run D1 at the thresholds imos_analysis.py fixed from the background;
+- list every detection inside the window;
+- compare the count with the background expectation lambda x searched time, where lambda is
+  the logger's own D1 rate outside the quarantine and, for 3376, on other nights.
+The loggers record 5 minutes in every 15, so the searched time is the overlap of records
+with the window, not the window length. Output: runs/hydroacoustics/imos/search.json.
+
+    .venv/bin/python hypotheses/hydroacoustics/prepare/search.py runs/hydroacoustics/kadri-package/windows.csv
+"""
+
+from __future__ import annotations
+
+import csv
+import json
+import math
+import sys
+
+import numpy as np
+
+import detect
+import waveforms as w
+from measure import bandpass
+
+ROOT = w.HERE.parents[2]
+OUT = ROOT / "runs/hydroacoustics/imos"
+
+
+def poisson_tail(k: int, mean: float) -> float:
+    """P(N >= k) for N ~ Poisson(mean)."""
+    return 1.0 - sum(math.exp(-mean) * mean**j / math.factorial(j) for j in range(k))
+
+
+def background_rate(logger: str, control: dict, thresholds: dict) -> tuple[float, float]:
+    """D1 detections per hour above threshold (any band), outside the quarantine."""
+    far = control["far_per_hour"]
+    levels = np.array(far["threshold_db"])
+    rate = sum(float(np.interp(tau, levels, far[f"{b[0]:g}-{b[1]:g}"])) for b, tau in thresholds.items())
+    return rate, control["background_hours"]
+
+
+def other_night_rate(start: np.datetime64, end: np.datetime64, thresholds: dict) -> dict:
+    """D1 detections per hour (any band, same thresholds) in the same UTC time of day on the other
+    nights, from other_nights.py."""
+    rows = [r for r in json.loads((OUT / "other-nights.json").read_text()) if "unusable" not in r]
+    seconds = lambda t: float((t - t.astype("datetime64[D]")) / np.timedelta64(1, "s"))
+    lo, hi = seconds(start), seconds(end)
+    count, searched = 0, 0.0
+    for r in rows:
+        t0 = np.datetime64(r["start_utc"][:26])
+        for band, tau in thresholds.items():
+            data = r["bands"][f"{band[0]:g}-{band[1]:g}"]
+            count += sum(1 for tp, smax, _ in data["peaks"] if smax >= tau and lo <= seconds(t0) + tp <= hi)
+        overlap = max(0.0, min(seconds(t0) + 307.0, hi) - max(seconds(t0), lo))
+        searched += overlap * r["bands"]["2-5"]["searched_s"] / 307.0
+    return {"detections": count, "searched_hours": searched / 3600, "per_hour": count / (searched / 3600) if searched else None}
+
+
+def control_strengths(controls: dict) -> list[dict]:
+    """Every control's S per band and how often background peaks reach it, including the 01:33:44
+    arrival at 3315: inside the quarantine but outside the 3315 window, so it can be opened once
+    the windows are committed."""
+    out = []
+    for c in detect.PREREG["controls"]["events"]:
+        logger, t = c["station"], np.datetime64(c["utc"].rstrip("Z"), "ns")
+        for member, opened in w.imos_records(logger):
+            if not (opened <= t <= opened + np.timedelta64(340, "s")):
+                continue
+            trace = w.read_imos(logger, member)
+            offset = (t - trace.t0) / np.timedelta64(1, "ns") * 1e-9
+            if trace.quality or not (0 <= offset <= trace.p.shape[1] / trace.fs):
+                continue
+            far = controls[logger]["far_per_hour"]
+            strength = {}
+            for band in detect.BANDS:
+                tt, e, s = detect.statistic(bandpass(trace.p[0], trace.fs, *band), trace.fs, trace.edge_s)
+                close = [(tp, smax) for tp, smax, _ in detect.peaks(tt, s, e) if abs(tp - offset) <= 5.0]
+                if close:
+                    tp, smax = max(close, key=lambda x: x[1])
+                    key = f"{band[0]:g}-{band[1]:g}"
+                    strength[key] = {"s_max_db": round(smax, 1), "offset_s": round(tp - offset, 1),
+                                     "background_per_hour_at_or_above": round(float(np.interp(smax, far["threshold_db"], far[key])), 2)}
+            out.append({"station": logger, "utc": c["utc"], "note": c["note"], "strength": strength})
+    return out
+
+
+def main() -> None:
+    windows = {row["station"]: row for row in csv.DictReader(open(sys.argv[1]))}
+    controls = {r["logger"]: r for r in json.loads((OUT / "detection-control.json").read_text())}
+    results = []
+    for logger, control in controls.items():
+        window = windows[logger]
+        start, end = (np.datetime64(window[k].rstrip("Z"), "ns") for k in ("start_utc", "end_utc"))
+        thresholds = {tuple(float(x) for x in b.split("-")): v for b, v in control["thresholds_db"].items()}
+        detections, searched_s = [], 0.0
+        for member, opened in w.imos_records(logger):
+            if opened > end or opened + np.timedelta64(400, "s") < start:
+                continue
+            trace = w.read_imos(logger, member)
+            if trace.quality:
+                continue  # the pre-registered data-quality screen (amendment 2)
+            for band, tau in thresholds.items():
+                t, e, s = detect.statistic(bandpass(trace.p[0], trace.fs, *band), trace.fs, trace.edge_s)
+                inside = np.array([start <= trace.time_of(x) <= end for x in t])
+                if band == next(iter(thresholds)):
+                    searched_s += float((np.isfinite(s) & inside).sum() * detect.STEP_S)
+                for tp, smax, snr in detect.peaks(t, s, e):
+                    if smax >= tau and start <= trace.time_of(tp) <= end:
+                        detections.append({"utc": str(trace.time_of(tp)), "band_hz": list(band), "s_max_db": round(smax, 2),
+                                           "snr_db": round(snr, 2), "record": member})
+        rate, hours = background_rate(logger, control, thresholds)
+        expected = rate * searched_s / 3600
+        result = {"logger": logger, "window": [str(start), str(end)], "searched_s": searched_s,
+                  "background_per_hour": rate, "background_hours": hours, "expected": expected,
+                  "detections": sorted(detections, key=lambda d: d["utc"]),
+                  "p_value": poisson_tail(len(detections), expected)}
+        if logger == "3376":
+            result["other_nights"] = other_night_rate(start, end, thresholds)
+        results.append(result)
+        print(f"{logger}: searched {searched_s:.0f} s of {window['start_utc']}-{window['end_utc']}; "
+              f"{len(detections)} detections, {expected:.2f} expected; P(N >= n) = {results[-1]['p_value']:.3f}")
+    results.append({"controls": control_strengths(controls)})
+    (OUT / "search.json").write_text(json.dumps(results, indent=1))
+
+
+if __name__ == "__main__":
+    main()
