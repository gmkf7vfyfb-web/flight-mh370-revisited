+    if not (evaluated.exists() and control.exists()):
+        return []
+    import detect
+    import package
+
+    table = package.read_evaluate(evaluated)
+    controls = {r["logger"]: r for r in json.loads(control.read_text())}
+    eta_anchor = float(np.nanmedian(table["hydroacoustics:f35_eta"]))
+    etas = eta_anchor * 10 ** (-np.arange(package.ETA_STEPS) / 2)
+    rng = np.random.default_rng(1)
+    bands = [f"{lo:g}-{hi:g}hz" for lo, hi in package.BANDS]
+    fig, axes = plt.subplots(1, len(controls), figsize=(14, 4.8), sharey=True)
+    summary = {}
+    for ax, (logger, r) in zip(np.atleast_1d(axes), controls.items()):
+        inj = r["injection"]
+        column = lambda name: table[f"hydroacoustics:{logger}.{name}"]
+        sel = np.column_stack([column(f"sel_eta1_db.{b}") for b in bands])
+        spread = np.column_stack([column(f"tl_sd_db.{b}") for b in bands]).mean(axis=1)
+        cover = coverage(logger, column("arrival_early_unix_s"), column("arrival_late_unix_s"),
+                         detect.PREREG["windows"]["timing_pad_s"])
+        blocked = column("blocked") == 1
+        summary[logger] = {"mean_coverage": float(cover.mean()), "blocked_fraction": float(blocked.mean()), "p_detect": {}}
+        ax.plot(inj["exposure_db"], inj["p_detect"], color="k", lw=2, label="P_D (injection)")
+        density = ax.twinx()
+        density.set_yticks([])
+        for k, eta in enumerate(etas):
+            total = 10 * np.log10((10 ** ((sel + 10 * np.log10(eta)) / 10)).sum(axis=1)) - rng.normal(0, spread)
+            p_d = np.interp(total, inj["exposure_db"], inj["p_detect"], left=0.0, right=1.0)
+            summary[logger]["p_detect"][f"{eta:.2e}"] = float(np.mean(cover * p_d * ~blocked))
+            if k % 2 == 0:
+                density.hist(total, bins=50, density=True, histtype="step", lw=1.2, label=f"eta = {eta:.1e}")
+        text = "\n".join(f"eta {e}: P = {v:.3f}" for e, v in summary[logger]["p_detect"].items())
+        ax.text(0.02, 0.98, f"coverage {cover.mean():.2f}\n{text}", transform=ax.transAxes, va="top", fontsize=6.5,
+                family="monospace", bbox={"facecolor": "white", "alpha": 0.95, "lw": 0}, zorder=10)
+        ax.set_title(f"Logger {logger}")
+        ax.set_xlabel("Broadband exposure (dB re 1 uPa^2 s)")
+        ax.grid(alpha=0.3)
+    np.atleast_1d(axes)[0].set_ylabel("P_D (black); predicted exposure density (coloured, own scale)")
