@@ -0,0 +1,120 @@
+//! Source level, transmission loss and received level, per frequency band.
+//!
+//! Received exposure in band b (dB re 1 uPa^2 s) is SEL_b = ESL_b - TL_b.
+//! - ESL_b is the energy source level at 1 m of a monopole that radiates eta x KE, with a
+//!   flat energy spectrum over 2-40 Hz.
+//! - TL_b is Blackman et al.'s measured air9 loss for the station, moved to the impact's
+//!   range by cylindrical spreading, plus a site-coupling term (see `SiteCoupling`).
+//!
+//! Peak pressure = CREST x sqrt(exposure / duration). The received duration grows with range
+//! through multipath dispersion.
+
+pub const BANDS: [(f64, f64); 4] = [(2.0, 5.0), (5.0, 10.0), (10.0, 20.0), (20.0, 40.0)];
+const SPECTRUM: (f64, f64) = (2.0, 40.0);
+/// Seawater impedance, kg m^-2 s^-1 (1026 kg/m^3 x 1500 m/s).
+const RHO_C: f64 = 1.539e6;
+/// Peak over RMS pressure within the received signal duration.
+pub const CREST: f64 = 3.0;
+
+/// Received signal duration (s): 2 s plus 1.2 s per 1000 km. This gives the ~6 s F-35 pulse at
+/// 3,300 km (Kadri 2024) and the few-second to >5 s airgun wavetrains of Blackman et al.
+pub fn duration_s(range_km: f64) -> f64 {
+    2.0 + 1.2e-3 * range_km
+}
+
+/// ESL_b (dB re 1 uPa^2 s m^2) of a monopole radiating `energy_j` over 2-40 Hz.
+pub fn energy_source_level_db(energy_j: f64, band: (f64, f64)) -> f64 {
+    let fraction = (band.1 - band.0) / (SPECTRUM.1 - SPECTRUM.0);
+    10.0 * (RHO_C * energy_j * fraction / (4.0 * std::f64::consts::PI)).log10() + 120.0
+}
+
+/// Measured transmission loss from air9 (Blackman et al. 2004, Fig. 23), energy-averaged per band.
+#[derive(Debug, Clone, Copy)]
+pub struct Calibration {
+    /// Geodesic range from air9 to the station, km.
+    pub range_km: f64,
+    pub tl_db: [f64; 4],
+    pub sd_db: [f64; 4],
+}
+
+/// Standard deviations (dB) that make up a band's TL uncertainty.
+const SD_DIGITISED: f64 = 1.0; // reading Fig. 23, and the shot-to-shot median
+const SD_OTHER_PATH: f64 = 3.0; // another path to the same station: air7 vs air9 differ by 1-3 dB
+const SD_EXTRAPOLATED: f64 = 6.0; // band with no measured frequencies, taken from its neighbour
+
+impl Calibration {
+    /// Band TL from one column of the digitised table. A band where the measurement covers
+    /// less than half the band is borrowed from the nearest measured band, with extra s.d.
+    pub fn from_table(range_km: f64, rows: &[(f64, f64)]) -> Calibration {
+        let mut measured = [None; 4];
+        for (k, &(lo, hi)) in BANDS.iter().enumerate() {
+            let in_band: Vec<&(f64, f64)> = rows.iter().filter(|(f, _)| *f >= lo && *f < hi).collect();
+            let values: Vec<f64> = in_band.iter().map(|r| r.1).collect();
+            let covered = match (in_band.first(), in_band.last()) {
+                (Some(first), Some(last)) => (last.0 - first.0) / (hi - lo),
+                _ => 0.0,
+            };
+            if covered >= 0.5 {
+                let energy = values.iter().map(|tl| 10f64.powf(-tl / 10.0)).sum::<f64>() / values.len() as f64;
+                let mean = values.iter().sum::<f64>() / values.len() as f64;
+                let spread = (values.iter().map(|v| (v - mean).powi(2)).sum::<f64>() / values.len() as f64).sqrt();
+                measured[k] = Some((-10.0 * energy.log10(), spread));
+            }
+        }
+        let mut tl_db = [0.0; 4];
+        let mut sd_db = [0.0; 4];
+        for k in 0..4 {
+            let (source, extra) = match measured[k] {
+                Some(m) => (m, 0.0),
+                None => {
+                    let nearest = (0..4).filter(|&j| measured[j].is_some()).min_by_key(|&j| j.abs_diff(k)).unwrap();
+                    (measured[nearest].unwrap(), SD_EXTRAPOLATED)
+                }
+            };
+            tl_db[k] = source.0;
+            sd_db[k] = (SD_DIGITISED.powi(2) + source.1.powi(2) + SD_OTHER_PATH.powi(2) + extra.powi(2)).sqrt();
+        }
+        Calibration { range_km, tl_db, sd_db }
+    }
+
+    /// TL (dB) for a favourable source site at another range: cylindrical spreading from the
+    /// calibration range. Absorption is below 0.2 dB per 1000 km at 40 Hz (Ainslie & McColm
+    /// 1998) and is neglected.
+    pub fn tl_at(&self, band: usize, range_km: f64) -> f64 {
+        self.tl_db[band] + 10.0 * (range_km / self.range_km).log10()
+    }
+}
+
+/// How well an impact site couples into the sound channel, relative to air9. air9 was chosen
+/// for favourable coupling (Blackman et al. 2004, sec. 1.2), and so was the F-35 site, on the
+/// Japan Trench slope with a shallow channel (Brown et al. 2026). A surface source over a deep,
+/// flat seabed couples worse. Duncan & Dall'Osto (2023, abstract) model an MH370 path to HA01
+/// 20-30 dB below the F-35's.
+#[derive(Debug, Clone, Copy)]
+pub struct SiteCoupling {
+    pub loss_db: f64,
+    pub sd_db: f64,
+}
+
+/// Broadband (2-40 Hz) peak pressure (Pa) from band exposures (dB re 1 uPa^2 s).
+pub fn peak_pa(sel_db: &[f64; 4], range_km: f64) -> f64 {
+    let exposure_pa2s: f64 = sel_db.iter().map(|s| 10f64.powf(s / 10.0) * 1e-12).sum();
+    CREST * (exposure_pa2s / duration_s(range_km)).sqrt()
+}
+
+/// Brown et al. (2026): F-35A, 9 Apr 2019, 900 +/- 200 MJ at impact, 0.7 Pa peak at H11
+/// (Wake Island), 3,300 km, on a clear path from a favourable site.
+pub const F35_ENERGY_J: f64 = 900e6;
+pub const F35_PEAK_PA: f64 = 0.7;
+pub const F35_RANGE_KM: f64 = 3300.0;
+
+/// eta that reproduces the F-35 peak in this chain. The F-35 site is favourable (no coupling
+/// loss) and its path TL is the mean of the air9 calibrations moved to 3,300 km.
+pub fn f35_eta(calibrations: &[Calibration], energy_j: f64) -> f64 {
+    let mut sel = [0.0; 4];
+    for (k, band) in BANDS.iter().enumerate() {
+        let tl = calibrations.iter().map(|c| c.tl_at(k, F35_RANGE_KM)).sum::<f64>() / calibrations.len() as f64;
+        sel[k] = energy_source_level_db(energy_j, *band) - tl;
+    }
+    (F35_PEAK_PA / peak_pa(&sel, F35_RANGE_KM)).powi(2)
+}
