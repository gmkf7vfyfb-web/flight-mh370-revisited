+    ("Lion Air 904", "2013-04-13T07:10:00", -8.7503, 115.1503, 66.7, 60e3, "H08S", "2013-04-13T07:58", 4.80, 0.50, 0.08, True),
+]
+SPEED_NOTE = {"Sriwijaya 182": "speed not given by Kadri: 150 m/s assumed (100-200)",
+              "F-35A": "energy 900 +/- 200 MJ (Brown et al. 2026)"}
+
+
+def spherical_km(a, b) -> float:
+    (la1, lo1), (la2, lo2) = np.radians(a), np.radians(b)
+    c = np.sin(la1) * np.sin(la2) + np.cos(la1) * np.cos(la2) * np.cos(lo2 - lo1)
+    return float(6371.0 * np.arccos(np.clip(c, -1, 1)))
+
+
+def duration_s(range_km: float) -> float:
+    return 2.0 + 1.2e-3 * range_km  # the module's received duration (propagation::duration_s)
+
+
+def evaluate(samples: list[tuple[float, float, float]]) -> dict[str, np.ndarray]:
+    """The module's predictions for (unix_s, lat, lon) samples, through `mh370 evaluate`."""
+    OUT.mkdir(parents=True, exist_ok=True)
+    path = OUT / "arc-samples.csv"
+    with open(path, "w") as f:
+        f.write("unix_s,latitude_deg,longitude_deg\n")
+        f.writelines(f"{t:.3f},{la:.6f},{lo:.6f}\n" for t, la, lo in samples)
+    subprocess.run([str(ROOT / "target/release/mh370"), "evaluate", "hypotheses/hydroacoustics/run.toml", str(path), str(OUT / "arc-evaluate")],
+                   cwd=ROOT, check=True, capture_output=True)
+    import package
+    return package.read_evaluate(OUT / "arc-evaluate/evaluate.csv")
+
+
+def timing() -> list[dict]:
+    arc = next(a for a in json.loads((ROOT / "runs/davey2016/run.json").read_text())["reference_arcs"] if a["epoch"] == "m0019a")
+    t0 = float(ARC_TIME.astype("datetime64[s]").astype(float))
+    table = evaluate([(t0, la, lo) for la, lo in arc["lat_lon"]])
+    baz, rng = table["hydroacoustics:H01W.back_azimuth_deg"], table["hydroacoustics:H01W.range_km"]
+    mid = 0.5 * (table["hydroacoustics:H01W.arrival_early_unix_s"] + table["hydroacoustics:H01W.arrival_late_unix_s"])
+    rows = []
+    for r in csv.DictReader(line for line in open(w.HERE.parent / "kadri2024-table1.csv") if not line.startswith("#")):
+        t_obs = float(np.datetime64(r["time_utc"].rstrip("Z")).astype("datetime64[s]").astype(float))
+        bearing = float(r["bearing_deg"])
+        # Arc crossings along this bearing: segments whose back-azimuth brackets it; take the nearest.
+        k = [i for i in range(len(baz) - 1) if (baz[i] - bearing) * (baz[i + 1] - bearing) <= 0 and abs(baz[i] - baz[i + 1]) < 20]
+        row = {"time_utc": r["time_utc"], "bearing_deg": bearing, "kadri_dt_min": float(r["delta_t_min"]) if r["delta_t_min"] else None}
+        if k:
+            i = min(k, key=lambda j: rng[j])
+            f = (bearing - baz[i]) / (baz[i + 1] - baz[i])
+            r7 = rng[i] + f * (rng[i + 1] - rng[i])
+            arrival = mid[i] + f * (mid[i + 1] - mid[i])
+            row.update(arc_lat=float(table["latitude_deg"][i] + f * (table["latitude_deg"][i + 1] - table["latitude_deg"][i])),
+                       our_range_km=float(r7), our_dt_min=(t_obs - arrival) / 60,
+                       kadri_c_dt_min=((t_obs - t0) - r7 / KADRI_C) / 60)
+            if row["kadri_dt_min"] is not None:
+                row["residual_min"] = row["our_dt_min"] - row["kadri_dt_min"]
+                row["kadri_implied_range_km"] = KADRI_C * ((t_obs - t0) - row["kadri_dt_min"] * 60)
+        rows.append(row)
+    return rows
+
+
+def measurement() -> dict:
+    meta = json.loads((SRC / "data/kadri-figure-extraction/metadata.json").read_text())
+    table = [(np.datetime64(r["time_utc"].rstrip("Z")), float(r["bearing_deg"]))
+             for r in csv.DictReader(line for line in open(w.HERE.parent / "kadri2024-table1.csv") if not line.startswith("#"))]
+    panels = []
+    for p in meta["figure9_vector_traces"]:
+        data = np.genfromtxt(SRC / "data/kadri-figure-extraction" / p["file"], delimiter=",", names=True, usecols=(0, 2))
+        t, x = data["plotted_time_s"], data["pressure_pa"]
+        grid = np.arange(0.0, 600.0, 1 / 250.0)
+        trace = np.interp(grid, t, x)  # the plotted polyline on a uniform grid; content above ~5 Hz is not real
+        start = np.datetime64(p["start_utc"].rstrip("Z"))
+        tt, e, s = detect.statistic(trace, 250.0, 0.0)  # broadband: Kadri already band-passed 2-40 Hz
+        found = detect.peaks(tt, s, e)
+        entries = []
+        for when, bearing in table:
+            offset = (when - start) / np.timedelta64(1, "s")
+            if not (70 <= offset <= 590):
+                continue
+            near = [pk for pk in found if abs(pk[0] - offset) <= 5.0]
+            m = measure(trace[None, :], 250.0, t=offset - 2.0, duration=8.0, bands=((0.5, 40.0),))[0]
+            rank = sorted([pk[1] for pk in found], reverse=True)
+            entries.append({"time_utc": str(when), "bearing_deg": bearing, "d1_peak_within_5s": bool(near),
+                            "s_max_db": round(max(pk[1] for pk in near), 1) if near else None,
+                            "rank_in_panel": (rank.index(max(pk[1] for pk in near)) + 1) if near else None,
+                            "peak_pa": round(float(m["peak_pa"]), 3), "snr_db": round(float(m["snr_db"]), 1),
+                            "exposure_db": round(float(10 * np.log10(m["exposure_pa2s"] / 1e-12)), 1)})
+        top = sorted(found, key=lambda pk: -pk[1])[:5]
+        panels.append({"panel": p["panel"], "station": p["station"], "start_utc": p["start_utc"], "d1_peaks": len(found),
+                       "top_peaks": [{"utc": str(start + np.timedelta64(int(pk[0] * 1e3), "ms"))[11:19], "s_max_db": round(pk[1], 1)} for pk in top],
+                       "table1": entries})
+    return {"panels": panels}
+
+
+def loudness() -> list[dict]:
+    rows = []
+    t_f35 = duration_s(F35["range_km"])
+    for name, when, lat, lon, speed, mass, station, panel, minute, peak, peak_sd, distinct in CRASHES:
+        km = spherical_km((lat, lon), IMS[station])
+        energy = F35["energy_j"] if mass is None else 0.5 * mass * speed**2
+        # The chain relative to its own anchor, favourable coupling like the F-35 site.
+        predicted = F35["peak_pa"] * np.sqrt((energy / F35["energy_j"]) * (F35["range_km"] / km) * (t_f35 / duration_s(km)))
+        impact = np.datetime64(when)
+        early = impact + np.timedelta64(int(km / 1.492 - 9), "s")
+        late = impact + np.timedelta64(int(km / 1.478 + 9), "s")
+        observed = np.datetime64(panel) + np.timedelta64(int(minute * 60), "s")
+        offset_min = (observed - (early + (late - early) / 2)) / np.timedelta64(60, "s")
+        rows.append({"crash": name, "station": station, "range_km": round(km), "kinetic_energy_mj": round(energy / 1e6),
+                     "note": SPEED_NOTE.get(name, "mass assumed from type and phase"),
+                     "predicted_peak_pa_favourable": round(float(predicted), 3),
+                     "observed_peak_pa": peak, "observed_sd_pa": peak_sd, "distinct_in_figure": distinct,
+                     "implied_extra_loss_db": round(float(20 * np.log10(predicted / peak)), 1),
+                     "arrival_window_utc": [str(early)[11:19], str(late)[11:19]], "figure_transient_utc": str(observed)[11:19],
+                     "timing_offset_min": round(float(offset_min), 1),
+                     "timing_consistent": bool(abs(offset_min) <= 1.5)})
+    return rows
+
+
+def page(results: dict) -> None:
