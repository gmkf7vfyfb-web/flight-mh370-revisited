index 0000000..ac68d93
--- /dev/null
+++ b/hypotheses/hydroacoustics/prepare/waveforms.py
@@ -0,0 +1,522 @@
+"""Calibrated-pressure traces, the readers that produce them, and zero-phase filters.
+
+Every reader returns a `Trace`: pressure in pascals, one row per hydrophone, on a common
+250 Hz grid (the IMS rate), with the UTC time of the first sample and each hydrophone's
+position. Detection, noise statistics and injection-recovery all work on Traces, so the
+same analysis runs on the IMOS loggers here and on IMS triads in Usama Kadri's archive.
+
+Filters (measure.bandpass) act in the frequency domain, so each reader tapers the record ends
+and `edge_s` seconds at each end should be ignored.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import functools
+import re
+import tomllib
+import zipfile
+from datetime import datetime, timezone
+from pathlib import Path
+
+import numpy as np
+
+FS = 250.0
+HERE = Path(__file__).resolve().parent
+IMOS_ZIP = HERE.parents[2] / "data/external/imos-acoustic/MH370.zip"
+
+
+@dataclasses.dataclass
+class Trace:
+    station: str
+    channels: list[str]
+    lat: np.ndarray
+    lon: np.ndarray
+    t0: np.datetime64  # UTC of the first sample, ns resolution
+    fs: float
+    p: np.ndarray  # (channel, sample) pressure in Pa
+    note: str  # provenance: source files, calibration, clock corrections
+    edge_s: float = 0.0  # seconds at each end corrupted by tapering and circular filtering
+    quality: str = ""  # empty, or why the record fails the data-quality screen
+
+    @property
+    def seconds(self) -> np.ndarray:
+        return np.arange(self.p.shape[1]) / self.fs
+
+    def time_of(self, s: float) -> np.datetime64:
+        return self.t0 + np.timedelta64(int(round(s * 1e9)), "ns")
+
+    def window(self, start: np.datetime64, stop: np.datetime64) -> "Trace":
+        """The part of the trace between two UTC times."""
+        i = max(0, int(np.ceil((start - self.t0) / np.timedelta64(1, "ns") * 1e-9 * self.fs)))
+        j = min(self.p.shape[1], int(np.floor((stop - self.t0) / np.timedelta64(1, "ns") * 1e-9 * self.fs)))
+        return dataclasses.replace(self, t0=self.time_of(i / self.fs), p=self.p[:, i:max(i, j)])
+
+
+def stations() -> dict[str, dict]:
+    """Receiver positions: the module's stations.toml, shared with the Rust code."""
+    table = tomllib.loads((HERE.parent / "stations.toml").read_text())
+    return {s["id"]: s for s in table["station"]}
+
+
+def smooth(k: int) -> int:
+    """The smallest integer >= k with no prime factor above 5: a fast FFT length."""
+    while True:
+        r = k
+        for p in (2, 3, 5):
+            while r % p == 0:
+                r //= p
+        if r == 1:
+            return k
+        k += 1
+
+
+def tukey(n: int, taper: int) -> np.ndarray:
+    w = np.ones(n)
+    if taper > 0:
+        ramp = 0.5 - 0.5 * np.cos(np.pi * np.arange(taper) / taper)
+        w[:taper], w[n - taper:] = ramp, ramp[::-1]
+    return w
+
+
+def welch_psd(x: np.ndarray, fs: float, nfft: int) -> tuple[np.ndarray, np.ndarray]:
+    """One-sided power spectral density (units^2/Hz), Hann segments with 50 % overlap."""
+    w = np.hanning(nfft)
+    step = nfft // 2
+    segments = np.lib.stride_tricks.sliding_window_view(x, nfft)[::step]
+    spectra = np.abs(np.fft.rfft((segments - segments.mean(axis=1, keepdims=True)) * w, axis=1)) ** 2
+    psd = spectra.mean(axis=0) / (fs * (w**2).sum())
+    psd[1:-1] *= 2
+    return np.fft.rfftfreq(nfft, 1 / fs), psd
+
+
+# --- IMOS / Curtin CMST sea-noise loggers ---------------------------------------------------
+
+CAL_INPUT_DB = -90.0  # white noise injected in series with the hydrophone, dB re 1 V^2/Hz
+CAL_FLOOR_DB = 30.0  # below the gain peak by more than this, the response is not inverted
+CAL_MIN_HZ = 1.5  # below this the white-noise records stop falling with frequency (leakage floor)
+PORTLAND_ZIP = "https://imos-data.s3-ap-southeast-2.amazonaws.com/IMOS/ANMN/Acoustic/Portland_MH370.zip"
+# Logger: (archive, its top folder, metadata file, calibration folder, record folder). MH370.zip
+# is local (data/external); Portland_MH370.zip is read member by member over HTTP.
+IMOS_LOGGERS = {
+    "3315": (IMOS_ZIP, "MH370/", "3315_3250_3376__MetaData.txt", "Calibration/", "3315_PerthCanyon/"),
+    "3376": (IMOS_ZIP, "MH370/", "3315_3250_3376__MetaData.txt", "Calibration/", "3376_PerthCanyon/"),
+    "3250": (IMOS_ZIP, "MH370/", "3315_3250_3376__MetaData.txt", "Calibration/", "3250_ScottReef/"),
+    "3274": (PORTLAND_ZIP, "Portland_MH370/", "MetaData_3274_3275.txt", "calibration/", "3274_Portland/"),
+    "3275": (PORTLAND_ZIP, "Portland_MH370/", "MetaData_3274_3275.txt", "calibration/", "3275_Portland/"),
+}
+
+
+class RemoteZip:
+    """A zip on a web server, read one member at a time by HTTP range requests; nothing is stored."""
+
+    def __init__(self, url: str):
+        import struct
+        import urllib.request
+
+        def get(span: str) -> bytes:
+            return urllib.request.urlopen(urllib.request.Request(url, headers={"Range": f"bytes={span}"}), timeout=300).read()
+
+        self.get = lambda first, last: get(f"{first}-{last}")
+        tail = get("-65536")  # the end-of-directory record and the central directory
+        end = tail.rindex(b"PK\x05\x06")
+        size, = struct.unpack("<I", tail[end + 12:end + 16])
+        self.members, k = {}, end - size
+        while k < end:
+            method, = struct.unpack("<H", tail[k + 10:k + 12])
+            compressed, = struct.unpack("<I", tail[k + 20:k + 24])
+            n, extra, comment = struct.unpack("<HHH", tail[k + 28:k + 34])
+            offset, = struct.unpack("<I", tail[k + 42:k + 46])
+            self.members[tail[k + 46:k + 46 + n].decode("latin1")] = (method, compressed, offset)
+            k += 46 + n + extra + comment
+
+    def namelist(self) -> list[str]:
+        return list(self.members)
+
+    def read(self, name: str) -> bytes:
+        import struct
+        import zlib
+
+        method, compressed, offset = self.members[name]
+        head = self.get(offset, offset + 29)
+        n, extra = struct.unpack("<HH", head[26:30])
+        data = self.get(offset + 30 + n + extra, offset + 30 + n + extra + compressed - 1)
+        return zlib.decompress(data, -15) if method == 8 else data
+
+
+_ARCHIVES: dict = {}
+
+
+def imos_archive(logger: str):
+    source = IMOS_LOGGERS[logger][0]
+    if source not in _ARCHIVES:
+        _ARCHIVES[source] = RemoteZip(source) if str(source).startswith("http") else zipfile.ZipFile(source)
+    return _ARCHIVES[source]
+
+
+def read_dat(raw: bytes) -> tuple[list[str], str, float, np.ndarray]:
+    """Curtin logger .DAT: five ASCII header lines, big-endian unsigned 16-bit samples, a footer
+    starting 'Record Marker'. Returns header lines, footer, sample rate and volts at the A/D
+    (0-5 V over 65536 counts, mean removed), as in Curtin's load_loggerdatanew.m."""
+    start, header = 0, []
+    for _ in range(5):
+        end = raw.index(b"\n", start)
+        header.append(raw[start:end].decode("ascii"))
+        start = end + 1
+    stop = raw.rindex(b"\nRecord Marker")
+    enabled = [int(c) for c in re.findall(r"C\d=(\d)", header[3] + header[4])]
+    if sum(enabled) != 1:
+        raise ValueError("only single-channel logger records are supported")
+    rate = float(re.search(r"Sample Rate (\d+)", header[2]).group(1))
+    volts = np.frombuffer(raw[start:stop], ">u2").astype(float) * (5.0 / 65536)
+    return header, raw[stop + 1:].decode("ascii"), rate, volts - volts.mean()
+
+
+def dropout(raw: bytes) -> str:
+    """Why a record fails the data-quality screen (preregistration.toml amendment 2), or "".
+    The screen reads only the A/D counts: a run of identical counts lasting 0.1 s or more, or a
+    mean more than 10,000 counts from mid-scale (a dead or offset channel)."""
+    start = 0
+    for _ in range(5):
+        start = raw.index(b"\n", start) + 1
+    counts = np.frombuffer(raw[start:raw.rindex(b"\nRecord Marker")], ">u2")
+    rate = float(re.search(rb"Sample Rate (\d+)", raw[:start]).group(1))
+    change = np.flatnonzero(np.diff(counts) != 0)
+    longest = int(np.diff(np.concatenate([[-1], change, [counts.size - 1]])).max()) if counts.size else 0
+    if longest >= 0.1 * rate:
+        return f"{longest / rate:.2f} s of identical A/D counts"
+    if abs(counts.mean() - 32768) > 10_000:
+        return f"A/D mean {counts.mean():.0f}, far from mid-scale"
+    return ""
+
+
+@functools.cache
+def imos_metadata(logger: str) -> dict:
+    """Sensitivity (dB re 1 V^2/uPa^2), calibration file and clock settings from Curtin's metadata.
+    The file writes the unit as 'V^2/Pa^2'; -197.8 dB only makes sense per uPa^2 (0.13 mV/Pa, a
+    standard HTI-90 value), and noise levels come out right with that reading."""
+    _, top, name, _, _ = IMOS_LOGGERS[logger]
+    text = imos_archive(logger).read(top + name).decode("latin1")
+    block = next(b for b in text.split("Curtin ID")[1:] if b.split()[0] == logger)
+    sets = re.findall(r"system clock set \d\s+(\S+ \S+)\s+(-?[\d.]+)", block)
+    return {
+        "sensitivity_db": float(re.search(r"sensitivity \(dB re V\^2/Pa\^2\)\s+(-?[\d.]+)", block).group(1)),
+        "cal_file": re.search(r"system gain file\s+\S+\s+(\S+\.DAT)", block).group(1),
+        "clock_sets": [(np.datetime64(datetime.strptime(t, "%d-%b-%Y %H:%M:%S"), "ns"), float(o)) for t, o in sets],
+    }
+
+
+def imos_records(logger: str) -> list[tuple[str, np.datetime64]]:
+    """(member, file-opening time) for each record: the instrument-clock time written in hex in the
+    file name, within ~30 s of the first sample. read_imos times each record exactly."""
+    _, top, _, _, folder = IMOS_LOGGERS[logger]
+    names = [m for m in imos_archive(logger).namelist() if m.startswith(top + folder) and m.upper().endswith(".DAT")]
+    return sorted((m, np.datetime64(int(m.rsplit("/", 1)[1][:8], 16), "s").astype("datetime64[ns]")) for m in names)
+
+
+def imos_drift_s(logger: str, clock: np.datetime64) -> float:
+    """Logger clock minus UTC (s) at `clock`, linear between the metadata's two clock settings.
+    For 3315, 3376 and 3250 this reproduces Curtin's drift-corrected listing to 0.4 ms."""
+    (t1, o1), (t2, o2) = imos_metadata(logger)["clock_sets"]
+    return o1 + (o2 - o1) * float((clock - t1) / (t2 - t1))
+
+
+_GAIN: dict[str, tuple[np.ndarray, np.ndarray]] = {}
+
+
+def imos_gain(logger: str) -> tuple[np.ndarray, np.ndarray]:
+    """System gain (dB, volts at the A/D per volt at the hydrophone) from the white-noise record."""
+    _, top, _, calibration, _ = IMOS_LOGGERS[logger]
+    name = top + calibration + imos_metadata(logger)["cal_file"]
+    if name not in _GAIN:
+        _, _, rate, volts = read_dat(imos_archive(logger).read(name))
+        f, psd = welch_psd(volts, rate, 2**15)
+        _GAIN[name] = f, 10 * np.log10(np.maximum(psd, 1e-30)) - CAL_INPUT_DB
+    return _GAIN[name]
+
+
+def read_imos(logger: str, member: str) -> Trace:
+    """One record from the logger's archive (MH370.zip or Portland_MH370.zip)."""
+    return imos_trace(logger, imos_archive(logger).read(member), member)
+
+
+def read_imos_aodn(logger: str, url: str) -> Trace:
+    """One record streamed from the logger's AODN deployment folder; nothing is stored."""
+    import urllib.request
+
+    with urllib.request.urlopen(url, timeout=300) as response:
+        return imos_trace(logger, response.read(), url)
+
+
+def imos_trace(logger: str, raw: bytes, source: str) -> Trace:
+    """A logger record as calibrated pressure at 250 Hz, timed by the logger clock (footer) minus
+    the metadata's linear drift.
+
+    The A/D volts are divided by the system gain from the logger's white-noise calibration
+    and by the hydrophone sensitivity, all in one FFT. The spectrum is then truncated to
+    125 Hz, with a cosine taper from 100 to 120 Hz. The deliberate low-frequency roll-off is
+    inverted only where the gain is within CAL_FLOOR_DB of its peak; below that the output is
+    zero, and so is everything below CAL_MIN_HZ. The usable low-frequency limit is recorded in
+    `note`."""
+    meta = imos_metadata(logger)
+    header, footer, rate, volts = read_dat(raw)
+    quality = dropout(raw)
+    clock = logger_clock(footer)
+    start = clock - np.timedelta64(int(round(imos_drift_s(logger, clock) * 1e9)), "ns")
+    factor = int(round(rate / FS))
+    keep = volts.size // factor  # output samples; the input is zero-padded to a fast FFT length
+    m = smooth(keep)
+    n = m * factor
+    volts = np.concatenate([volts[: keep * factor] * tukey(keep * factor, int(0.5 * rate)), np.zeros(n - keep * factor)])
+    spectrum = np.fft.rfft(volts)
+    f = np.fft.rfftfreq(n, 1 / rate)
+    cal_f, gain_db = imos_gain(logger)
+    gain_db = np.interp(f, cal_f, gain_db)
+    usable = (f >= CAL_MIN_HZ) & (gain_db >= gain_db[f <= 120].max() - CAL_FLOOR_DB)
+    f_min = f[usable & (f < 120)].min()
+    volts_per_pa = 10 ** (meta["sensitivity_db"] / 20) * 1e6
+    response = np.where(usable, 1.0 / (10 ** (gain_db / 20) * volts_per_pa), 0.0)
+    anti_alias = np.where(f <= 100, 1.0, np.where(f < 120, 0.5 + 0.5 * np.cos(np.pi * (f - 100) / 20), 0.0))
+    out = np.fft.irfft((spectrum * response * anti_alias)[: m // 2 + 1] / factor, m)[:keep]
+    s = stations()[logger]["elements"][0]
+    return Trace(
+        station=logger,
+        channels=[logger],
+        lat=np.array([s["lat"]]),
+        lon=np.array([s["lon"]]),
+        t0=start,
+        fs=FS,
+        p=out[None, :],
+        quality=quality,
+        note=(f"{source}: {header[1].strip()}; footer '{footer.splitlines()[1].strip()}'. Start = logger clock "
+              f"minus linear drift (metadata). Gain from {meta['cal_file']}, sensitivity {meta['sensitivity_db']} "
+              f"dB re V^2/uPa^2; response inverted above {f_min:.1f} Hz."),
+        edge_s=2.0,
+    )
+
+
+def logger_clock(footer: str) -> np.datetime64:
+    """Instrument-clock time of the first sample: 'First Data-YYYY/MM/DD hh:mm:ss - ticks/65536'."""
+    day, clock, ticks = re.search(r"First Data-(\S+) (\S+) - (\d+)", footer).groups()
+    t = datetime.strptime(f"{day} {clock}", "%Y/%m/%d %H:%M:%S").replace(tzinfo=timezone.utc)
+    return np.datetime64(t.replace(tzinfo=None), "ns") + np.timedelta64(int(int(ticks) / 65536 * 1e9), "ns")
+
+
+# --- IMS hydrophones: IDC formats ------------------------------------------------------------
+# Each reader returns one single-channel Trace per waveform segment, in pascals, with the
+# element's position from stations.toml (NaN if the code is not there). `pa_per_unit` converts
+# the file's calibrated unit to Pa: CSS3.0 and IMS2.0 give `calib` per count. The IDC unit for
+# hydrophone channels must be confirmed by whoever holds the data (Kadri, request R0); a wrong
+# unit shows up as noise levels orders of magnitude from 60-110 dB re 1 uPa^2/Hz.
+
+
+def _element_position(code: str) -> tuple[float, float]:
+    for s in stations().values():
+        for e in s["elements"]:
+            if e["id"] == code.strip():
+                return e["lat"], e["lon"]
+    return float("nan"), float("nan")
+
+
+def _single(code: str, chan: str, t0: np.datetime64, fs: float, x: np.ndarray, note: str) -> Trace:
+    lat, lon = _element_position(code)
+    return Trace(station=code, channels=[f"{code}.{chan}"], lat=np.array([lat]), lon=np.array([lon]), t0=t0, fs=fs,
+                 p=np.asarray(x, float)[None, :], note=note)
+
+
+def _epoch(seconds: float) -> np.datetime64:
+    return np.datetime64(int(round(seconds * 1e6)), "us").astype("datetime64[ns]")
+
+
+CSS_TYPES = {"s4": ">i4", "i4": "<i4", "s2": ">i2", "i2": "<i2", "t4": ">f4", "f4": "<f4", "t8": ">f8", "f8": "<f8"}
+
+
+def read_css(wfdisc: Path, pa_per_unit: float = 1.0) -> list[Trace]:
+    """CSS3.0 wfdisc rows (whitespace-separated fields 1-18) and their binary .w files."""
+    out = []
+    for line in Path(wfdisc).read_text().splitlines():
+        f = line.split()
+        if len(f) < 18:
+            continue
+        sta, chan, time, nsamp, rate, calib, dtype, folder, dfile, foff = (
+            f[0], f[1], float(f[2]), int(f[7]), float(f[8]), float(f[9]), f[13], f[15], f[16], int(f[17]))
+        if dtype == "s3":
+            raw = np.frombuffer((Path(wfdisc).parent / folder / dfile).read_bytes()[foff:foff + 3 * nsamp], np.uint8)
+            b = raw.reshape(-1, 3).astype(np.int32)
+            counts = ((b[:, 0] << 24) | (b[:, 1] << 16) | (b[:, 2] << 8)) >> 8
+        elif dtype in CSS_TYPES:
+            size = np.dtype(CSS_TYPES[dtype]).itemsize
+            counts = np.frombuffer((Path(wfdisc).parent / folder / dfile).read_bytes()[foff:foff + size * nsamp],
+                                   CSS_TYPES[dtype])
+        else:
+            raise ValueError(f"{wfdisc}: datatype {dtype} not supported (CSS e1/compressed formats)")
+        calib = calib if calib != 0 else 1.0
+        out.append(_single(sta, chan, _epoch(time), rate, counts * calib * pa_per_unit,
+                           f"CSS3.0 {Path(wfdisc).name}: {sta} {chan} {dtype}, calib {calib} x {pa_per_unit} Pa/unit"))
+    return out
+
+
+CM6 = "+-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
+
+
+def decode_cm6(text: str, n: int) -> np.ndarray:
+    """GSE2/IMS2.0 CM6: 6-bit characters, first with continuation, sign and 4 bits, the rest with
+    continuation and 5 bits; the values are second differences."""
+    code = {c: i for i, c in enumerate(CM6)}
+    values, k = [], 0
+    chars = [code[c] for c in text if c in code]
+    while len(values) < n:
+        first = chars[k]
+        v, sign, more = first & 0x0F, first & 0x10, first & 0x20
+        k += 1
+        while more:
+            nxt = chars[k]
+            v, more = (v << 5) | (nxt & 0x1F), nxt & 0x20
+            k += 1
+        values.append(-v if sign else v)
+    return np.cumsum(np.cumsum(np.array(values, dtype=np.int64)))
+
+
+def gse_checksum(x: np.ndarray) -> int:
+    """CHK2 of the integer samples: running sum, both kept to magnitude below 1e8 (GSE2.1)."""
+    modulo, total = 100_000_000, 0
+    for s in x.tolist():
+        s = s - int(s / modulo) * modulo if abs(s) >= modulo else s
+        total += s
+        total = total - int(total / modulo) * modulo if abs(total) >= modulo else total
+    return abs(total)
+
+
+def read_gse(path: Path, pa_per_unit: float = 1.0) -> list[Trace]:
+    """IMS2.0 / GSE2 waveforms: WID2 header, optional STA2, DAT2 block (INT or CM6), CHK2."""
+    lines = Path(path).read_text(errors="replace").splitlines()
+    out, k = [], 0
+    while k < len(lines):
+        if not lines[k].startswith("WID2"):
+            k += 1
+            continue
+        tokens = lines[k].split()
+        d = next(i for i, t in enumerate(tokens) if t in ("INT", "CM6", "CM8", "AU6", "AU8"))
+        day, clock, sta, chan, dtype = tokens[1], tokens[2], tokens[3], tokens[4], tokens[d]
+        nsamp, rate, calib = int(tokens[d + 1]), float(tokens[d + 2]), float(tokens[d + 3])
+        k += 1
+        while not lines[k].startswith("DAT2"):
+            k += 1
+        body = []
+        k += 1
+        while not lines[k].startswith("CHK2"):
+            body.append(lines[k].strip())
+            k += 1
+        checksum = int(lines[k].split()[1])
+        if dtype == "CM6":
+            counts = decode_cm6("".join(body), nsamp)
+        elif dtype == "INT":
+            counts = np.array(" ".join(body).split(), dtype=np.int64)[:nsamp]
+        else:
+            raise ValueError(f"{path}: {dtype} not supported")
+        if gse_checksum(counts) != checksum:
+            raise ValueError(f"{path}: {sta} {chan} fails its CHK2 checksum; the data are not decoded correctly")
+        t0 = np.datetime64(f"{day.replace('/', '-')}T{clock}", "ns")
+        calib = calib if calib != 0 else 1.0
+        out.append(_single(sta, chan, t0, rate, counts * calib * pa_per_unit,
+                           f"IMS2.0 {Path(path).name}: {sta} {chan} {dtype}, CHK2 ok, calib {calib} x {pa_per_unit} Pa/unit"))
+    return out
+
+
+def _steim(words: np.ndarray, n: int, level: int) -> np.ndarray:
+    """Steim-1/2 frames (16 big-endian words each) to n integers, checked against the reverse constant."""
+    frames = words.reshape(-1, 16).astype(np.int64)
+    x0, xn = int(np.int32(frames[0, 1])), int(np.int32(frames[0, 2]))
+
+    def signed(v: int, bits: int) -> int:
+        return v - (1 << bits) if v & (1 << (bits - 1)) else v
+
+    diffs: list[int] = []
+    for f, frame in enumerate(frames):
+        nibbles = int(frame[0])
+        for i in range(1, 16):
+            c, w = (nibbles >> (30 - 2 * i)) & 3, int(frame[i]) & 0xFFFFFFFF
+            if c == 0 or (f == 0 and i < 3):
+                continue
+            if c == 1:
+                diffs += [signed((w >> s) & 0xFF, 8) for s in (24, 16, 8, 0)]
+            elif level == 1:
+                layout = (2, 16) if c == 2 else (1, 32)
+                diffs += [signed((w >> (32 - layout[1] * (j + 1))) & ((1 << layout[1]) - 1), layout[1]) for j in range(layout[0])]
+            else:
+                dnib = w >> 30
+                count, bits = {(2, 1): (1, 30), (2, 2): (2, 15), (2, 3): (3, 10),
+                               (3, 0): (5, 6), (3, 1): (6, 5), (3, 2): (7, 4)}[(c, dnib)]
+                diffs += [signed((w >> (bits * (count - 1 - j))) & ((1 << bits) - 1), bits) for j in range(count)]
+    x = x0 + np.concatenate([[0], np.cumsum(diffs[1:n])])
+    if x[-1] != xn:
+        raise ValueError("Steim reverse integration constant does not match; record not decoded correctly")
+    return x
+
+
+def read_mseed(path: Path, pa_per_count: float) -> list[Trace]:
+    """miniSEED (SEED 2.4 data records with blockette 1000): int16/int32/float32/float64 and Steim-1/2.
+    miniSEED carries no calibration, so `pa_per_count` must come from the station response."""
+    raw = Path(path).read_bytes()
+    pieces: dict[tuple, list] = {}
+    offset = 0
+    while offset + 48 <= len(raw):
+        head = raw[offset:offset + 48]
+        order = ">" if 1900 <= int.from_bytes(head[20:22], "big") <= 2100 else "<"
+        u16 = lambda b: int.from_bytes(b, "big" if order == ">" else "little")
+        year, day = u16(head[20:22]), u16(head[22:24])
+        hour, minute, second, frac = head[24], head[25], head[26], u16(head[28:30])
+        nsamp, factor, mult = u16(head[30:32]), np.int16(u16(head[32:34])), np.int16(u16(head[34:36]))
+        correction = int.from_bytes(head[40:44], "big" if order == ">" else "little", signed=True)
+        data_start, blockette = u16(head[44:46]), u16(head[46:48])
+        encoding, length, micro = None, None, 0
+        while blockette:
+            kind, following = u16(raw[offset + blockette:offset + blockette + 2]), u16(raw[offset + blockette + 2:offset + blockette + 4])
+            if kind == 1000:
+                encoding, length = raw[offset + blockette + 4], 1 << raw[offset + blockette + 6]
+            elif kind == 1001:
+                micro = int(np.int8(raw[offset + blockette + 5]))
+            blockette = following
+        if length is None:
+            raise ValueError(f"{path}: record at byte {offset} has no blockette 1000")
+        rate = (factor * mult if mult > 0 else -factor / mult) if factor > 0 else (-mult / factor if mult > 0 else 1 / (factor * mult))
+        data = raw[offset + data_start:offset + length]
+        if encoding in (10, 11):
+            counts = _steim(np.frombuffer(data[: len(data) // 64 * 64], ">u4"), nsamp, 1 if encoding == 10 else 2)
+        else:
+            dtype = {1: "i2", 3: "i4", 4: "f4", 5: "f8"}[encoding]
+            counts = np.frombuffer(data, order + dtype, nsamp)
+        start = (np.datetime64(f"{year:04d}-01-01", "ns") + np.timedelta64(day - 1, "D") + np.timedelta64(hour, "h")
+                 + np.timedelta64(minute, "m") + np.timedelta64(second, "s") + np.timedelta64(frac * 100_000 + micro * 1000, "ns"))
+        if not head[36] & 0x02:
+            start += np.timedelta64(correction * 100_000, "ns")
+        code = (head[8:13].decode().strip(), head[15:18].decode().strip())
+        pieces.setdefault(code, []).append((start, float(rate), np.asarray(counts, float)))
+        offset += length
+    out = []
+    for (sta, chan), records in pieces.items():
+        records.sort(key=lambda r: r[0])
+        start, rate, parts = records[0][0], records[0][1], [records[0][2]]
+        for t, r, x in records[1:]:
+            expected = start + np.timedelta64(int(round(sum(p.size for p in parts) / rate * 1e9)), "ns")
+            if abs((t - expected) / np.timedelta64(1, "ns")) > 0.5e9 / rate:
+                out.append(_single(sta, chan, start, rate, np.concatenate(parts) * pa_per_count, f"miniSEED {Path(path).name}"))
+                start, parts = t, []
+            parts.append(x)
+        out.append(_single(sta, chan, start, rate, np.concatenate(parts) * pa_per_count,
+                           f"miniSEED {Path(path).name}: {sta} {chan}, {pa_per_count} Pa/count"))
+    return out
+
+
+def triad(traces: list[Trace], station: str) -> Trace:
+    """Stack three element traces (same rate) on their common time span into one triad Trace."""
+    fs = traces[0].fs
+    start = max(t.t0 for t in traces)
+    stop = min(t.t0 + np.timedelta64(int(t.p.shape[1] / fs * 1e9), "ns") for t in traces)
+    parts = [t.window(start, stop) for t in traces]
+    n = min(p.p.shape[1] for p in parts)
+    if max(abs((p.t0 - start) / np.timedelta64(1, "ns")) for p in parts) > 0.5e9 / fs:
+        raise ValueError(f"{station}: element start times are not sample-aligned")
+    return Trace(station=station, channels=[c for p in parts for c in p.channels],
+                 lat=np.concatenate([p.lat for p in parts]), lon=np.concatenate([p.lon for p in parts]),
+                 t0=start, fs=fs, p=np.vstack([p.p[:, :n] for p in parts]), note="; ".join(p.note for p in parts))
