+    ax.set_xlabel("Injected broadband 2-40 Hz exposure (dB re 1 uPa^2 s)")
+    ax.set_ylabel("P_D (D1, any band, +/-9 s)")
+    ax.set_title("Injection-recovery into real IMOS background (200 per point)")
+    ax.grid(alpha=0.3)
+    ax.legend()
+    figs.append(fig)
+    return figs
+
+
+def main() -> None:
+    OUT.mkdir(parents=True, exist_ok=True)
+    rng = np.random.default_rng(20260926)
+    results = [analyse_logger(logger, rng) for logger in LOGGERS]
+    (OUT / "detection-control.json").write_text(json.dumps(results, indent=1))
+    figs = figures(results)
+    with PdfPages(OUT / "detection-control.pdf") as pdf:
