@@ -0,0 +1,74 @@
+#!/usr/bin/env python3
+"""Other-night backgrounds for Perth Canyon logger 3376 (preregistration.toml [backgrounds]).
+
+Streams every 3376 record starting 22:00-02:00 UTC on the nights of 1-14 March 2014 from
+AODN (PAPCA/3376), except the MH370 night, and never stores the raw records. For each record
+it keeps the band-power distribution and every D1 peak (time, band, S). With the thresholds
+from imos_analysis.py, these give the detection rate in the same UTC window on other nights,
+and 22:00-02:00 noise percentiles. Output: runs/hydroacoustics/imos/other-nights.json.
+
+    .venv/bin/python hypotheses/hydroacoustics/prepare/other_nights.py
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import urllib.request
+
+import numpy as np
+
+import detect
+import waveforms as w
+from measure import bandpass
+
+BUCKET = "https://imos-data.s3-ap-southeast-2.amazonaws.com"
+PREFIX = "IMOS/ANMN/Acoustic/PAPCA/3376"
+OUT = w.HERE.parents[2] / "runs/hydroacoustics/imos/other-nights.json"
+MH370_EVENING = np.datetime64("2014-03-07")
+
+
+def keys(day: str) -> list[tuple[str, np.datetime64]]:
+    """(URL, instrument-clock open time from the hex file name) for one AODN day folder."""
+    with urllib.request.urlopen(f"{BUCKET}/?list-type=2&prefix={PREFIX}/{day}/raw/", timeout=120) as r:
+        listing = r.read().decode()
+    names = re.findall(r"<Key>([^<]+\.DAT)</Key>", listing)
+    return [(f"{BUCKET}/{k}", np.datetime64(int(k.rsplit("/", 1)[1][:8], 16), "s").astype("datetime64[ns]")) for k in names]
+
+
+def main() -> None:
+    first, last = (np.datetime64(d) for d in detect.PREREG["backgrounds"]["other_nights"])
+    records = []
+    day = first - np.timedelta64(1, "D")
+    while day <= last + np.timedelta64(1, "D"):
+        records += keys(str(day).replace("-", ""))
+        day += np.timedelta64(1, "D")
+    rows = []
+    for url, opened in sorted(records, key=lambda r: r[1]):
+        hour = (opened - opened.astype("datetime64[D]")) / np.timedelta64(1, "h")
+        evening = opened.astype("datetime64[D]") - (np.timedelta64(1, "D") if hour < 12 else np.timedelta64(0, "D"))
+        if not (hour >= 21.9 or hour < 2.0) or not (first <= evening <= last):
+            continue
+        if evening == MH370_EVENING:
+            continue  # the MH370 night is the search itself, not a background; its quarantine is never opened
+        trace = w.read_imos_aodn("3376", url)
+        row = {"url": url, "start_utc": str(trace.t0), "evening": str(evening), "bands": {}}
+        if trace.quality or trace.p.shape[1] < 120 * trace.fs:
+            row["unusable"] = trace.quality or f"{trace.p.shape[1] / trace.fs:.0f} s of data"
+            rows.append(row)
+            print(row["start_utc"], "unusable:", row["unusable"], flush=True)
+            continue
+        for band in detect.BANDS:
+            t, e, s = detect.statistic(bandpass(trace.p[0], trace.fs, *band), trace.fs, trace.edge_s)
+            row["bands"][f"{band[0]:g}-{band[1]:g}"] = {
+                "power_db_percentiles": [float(np.percentile(10 * np.log10(e[np.isfinite(s)] / 1e-12), q)) for q in (5, 50, 95)],
+                "peaks": [[round(tp, 1), round(smax, 2), round(snr, 2)] for tp, smax, snr in detect.peaks(t, s, e)],
+                "searched_s": float(np.isfinite(s).sum() * detect.STEP_S)}
+        rows.append(row)
+        print(row["start_utc"], {b: round(v["power_db_percentiles"][1], 1) for b, v in row["bands"].items()}, flush=True)
+    OUT.write_text(json.dumps(rows, indent=1))
+    print(f"{len(rows)} records, {len({r['evening'] for r in rows})} nights -> {OUT}")
+
+
+if __name__ == "__main__":
+    main()
