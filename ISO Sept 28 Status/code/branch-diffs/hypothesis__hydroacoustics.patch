index 0000000..5022cb6
--- /dev/null
+++ b/hypotheses/hydroacoustics/prepare/detect.py
@@ -0,0 +1,114 @@
+"""The pre-registered detector D1 (preregistration.toml [detector]) and the measurements built
+on it: noise statistics, thresholds at a fixed false-alarm rate, positive controls and
+injection-recovery.
+
+D1 works on a 0.5 s grid:
+- E is the band power averaged over energy_window_s;
+- B is the median of E over the two background flanks, 10-60 s either side;
+- S = 10 log10(E / B), in dB.
+Detections are local maxima of S at or above the band threshold, each at least separation_s
+from a larger one.
+"""
+
+from __future__ import annotations
+
+import tomllib
+from pathlib import Path
+
+import numpy as np
+
+from measure import bandpass
+
+HERE = Path(__file__).resolve().parent
+PREREG = tomllib.loads((HERE.parent / "preregistration.toml").read_text())
+DET = PREREG["detector"]
+BANDS = [tuple(b) for b in PREREG["bands"]["hz"]]
+STEP_S = 0.5
+
+
+def statistic(x: np.ndarray, fs: float, edge_s: float) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    """Grid times (s), E (Pa^2) and S (dB) for one band-passed channel. Grid points without the
+    whole energy window inside the usable record, or with less than 25 s of background, are NaN."""
+    half = DET["energy_window_s"] / 2
+    edge = max(edge_s, DET["edge_s"])
+    duration = x.size / fs
+    t = np.arange(edge + half, duration - edge - half, STEP_S)
+    cumulative = np.concatenate([[0.0], np.cumsum(x * x)])
+    lo, hi = np.round((t - half) * fs).astype(int), np.round((t + half) * fs).astype(int)
+    e = (cumulative[hi] - cumulative[lo]) / (hi - lo)
+    inner, outer = DET["background_s"]
+    offsets = np.concatenate([np.arange(-outer, -inner + 1e-9, STEP_S), np.arange(inner, outer + 1e-9, STEP_S)])
+    index = np.arange(t.size)[:, None] + np.round(offsets / STEP_S).astype(int)[None, :]
+    inside = (index >= 0) & (index < t.size)
+    flank = np.where(inside, e[np.clip(index, 0, t.size - 1)], np.nan)
+    enough = inside.sum(axis=1) >= 25.0 / STEP_S
+    with np.errstate(invalid="ignore", divide="ignore"):
+        b = np.where(enough, np.nanmedian(flank, axis=1), np.nan)
+        s = 10 * np.log10(e / b)
+    return t, e, s
+
+
+def peaks(t: np.ndarray, s: np.ndarray, e: np.ndarray) -> list[tuple[float, float, float]]:
+    """D1 peaks as (time, S maximum, SNR). The S maximum is a local maximum of S at least
+    separation_s from any larger one; the threshold applies to it. As pre-registered, the time
+    is that of the largest E within half an energy window of it, and the SNR is S at that time."""
+    finite = np.isfinite(s)
+    candidates = [k for k in range(1, s.size - 1)
+                  if finite[k] and s[k] >= s[k - 1] and s[k] >= s[k + 1] and np.isfinite(s[k - 1]) and np.isfinite(s[k + 1])]
+    kept: list[int] = []
+    for k in sorted(candidates, key=lambda k: -s[k]):
+        if all(abs(t[k] - t[j]) >= DET["separation_s"] for j in kept):
+            kept.append(k)
+    half = int(round(DET["energy_window_s"] / 2 / STEP_S))
+    out = []
+    for k in sorted(kept):
+        lo = max(0, k - half)
+        m = lo + int(np.argmax(e[lo:k + half + 1]))
+        out.append((float(t[m]), float(s[k]), float(s[m]) if np.isfinite(s[m]) else float(s[k])))
+    return out
+
+
+def threshold(values: list[float], hours: float, rate: float = PREREG["threshold"]["false_alarms_per_hour_per_band"]) -> float:
+    """The S level exceeded `rate` times per hour by background peaks. With fewer background
+    hours than 1/rate, this is the largest peak, extrapolated by the empirical log-slope."""
+    v = np.sort(np.asarray(values))[::-1]
+    k = rate * hours  # expected number of exceedances
+    if k >= 1:
+        return float(np.interp(k, np.arange(1, v.size + 1), v))
+    slope = (v[0] - v[min(9, v.size - 1)]) / np.log(min(10, v.size))  # dB per e-fold in count
+    return float(v[0] - slope * np.log(k))
+
+
+def triad_detections(p: np.ndarray, fs: float, lat: np.ndarray, lon: np.ndarray, band: tuple[float, float],
+                     bearings: tuple[float, float], threshold_db: float, edge_s: float = 0.0) -> list[dict]:
+    """D2 (preregistration.toml [detector]): D1 on delay-and-sum beams steered every 0.5 deg across
+    `bearings` at 1.485 km/s. Each detection keeps its best beam and is then tested by a plane-wave
+    fit to the element lags over +/- energy_window_s. It passes if the apparent speed is in
+    apparent_speed_km_s and the closure is at most closure_s."""
+    from measure import delay, local_xy, plane_wave, plane_wave_delays
+
+    x = bandpass(p, fs, *band)
+    found: list[dict] = []
+    for azimuth in np.arange(bearings[0], bearings[1] + 1e-9, 0.5):
+        lags = plane_wave_delays(lat, lon, azimuth)
+        beam = np.mean([delay(x[i], fs, -lags[i]) for i in range(3)], axis=0)
+        t, e, s = statistic(beam, fs, edge_s)
+        for tp, smax, snr in peaks(t, s, e):
+            if smax < threshold_db:
+                continue
+            twin = next((d for d in found if abs(d["time_s"] - tp) < DET["separation_s"]), None)
+            if twin is None or smax > twin["s_max_db"]:
+                if twin is not None:
+                    found.remove(twin)
+                found.append({"time_s": tp, "s_max_db": smax, "snr_db": snr, "beam_deg": float(azimuth)})
+    half = DET["energy_window_s"]
+    for d in found:
+        i, j = int(round((d["time_s"] - half) * fs)), int(round((d["time_s"] + half) * fs))
+        baz, speed, closure = plane_wave(x[:, max(0, i):j], fs, local_xy(lat, lon))
+        # A strong arrival from outside the window leaks into edge beams through the sidelobes of a
+        # three-element array; its fitted bearing gives it away, and the match rule rejects it.
+        d.update(back_azimuth_deg=float(baz), apparent_speed_km_s=float(speed), closure_s=float(closure),
+                 plane_wave_ok=bool(DET["apparent_speed_km_s"][0] <= speed <= DET["apparent_speed_km_s"][1]
+                                    and abs(closure) <= DET["closure_s"]),
+                 in_window=bool(bearings[0] <= baz <= bearings[1]))
+    return sorted(found, key=lambda d: d["time_s"])
