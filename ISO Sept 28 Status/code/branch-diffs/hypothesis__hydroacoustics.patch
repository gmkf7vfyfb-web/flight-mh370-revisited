+    ax.axis("off")
+    lines = ["(b) D1 and measure.py on Figure 9 traces (one plotted channel per panel; no bearings)", ""]
+    for p in results["measurement"]["panels"]:
+        lines.append(f"panel {p['panel']} {p['station']} {p['start_utc'][11:16]}: top D1 peaks " +
