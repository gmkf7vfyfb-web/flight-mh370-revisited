+# Metadata for this hypothesis. Keep it current; the report prints it.
+question = "Where, when and how loudly would a 7th-arc impact have reached H01W, H08S and the IMOS loggers, and does any detection or its absence constrain the impact once detector performance is measured?"
+# open | supported | not-supported | inconclusive
+status = "open"
+# One line, written when the question is answered, citing the run that answered it.
+summary = "Predictive only (zero log-likelihood). Pre-registered IMOS search on the stand-in windows (evaluate on core/stages 197fd64): 0 detections at 3315/3376/3274/3275 (0.12-0.23 expected each), 1 at blocked Scott Reef (0.72 expected, p = 0.51). With a nominal 4 GJ and 15 +/- 10 dB site coupling, P(any IMOS logger detects) is 0.24 at the F-35 anchor eta (8.7e-3), 0.095 at eta/10 and 0.005 at eta/1000, so the silence weighs at most about 0.76 against the loudest scenarios. Single-logger thresholds (0.25/h/band) exceed Curtin's control arrivals (S 9-17 dB); H01W needs Kadri's data."
+# Changes needed in the core (new hooks, new state fields). Leave empty if none.
+# A hypothesis agent writes requests here and stops; it never edits core code.
+core_requests = []
