+++ b/hypotheses/hydroacoustics/prepare/digitise_blackman.py
@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+"""Digitise the air9 transmission loss from Blackman et al. (2004), UCRL-TR-207323, Fig. 23.
+
+Fig. 23 plots the median observed loss (dB) against frequency for each shot site, only where
+the signal exceeded noise by 3 dB. air9 (27 deg 33.6' S, 98 deg 52.6' E, 19 Oct 2001) is the
+solid black curve in the DGS (H08S) and CL (H01) panels. This reads the embedded raster
+(351 x 458 px), traces the darkest curve column by column, and writes
+../blackman-air9-tl.csv. Axes: 0-100 Hz over x = 51-339 px; 150-115 dB over each panel's
+125 px height (the panel tops are y = 149 and 289).
+
+    .venv/bin/python hypotheses/hydroacoustics/prepare/digitise_blackman.py
+"""
+
+from __future__ import annotations
+
+import io
+from pathlib import Path
+
+import numpy as np
+import pymupdf
+from PIL import Image
+
+HERE = Path(__file__).resolve().parent
+PDF = HERE.parents[2] / "data/external/papers/hydroacoustics/ucrl-tr-207323.pdf"
+PANELS = {"h08s_db": 149, "h01w_db": 289}  # top edge (150 dB) of the DGS and CL panels
+X0, PX_PER_HZ, PX_PER_DB, DARK = 51, 2.88, 125 / 35, 135
+
+
+def main() -> None:
+    doc = pymupdf.open(PDF)
+    xref = doc[22].get_images(full=True)[1][0]  # report page 21: Fig. 22 map, then Fig. 23
+    image = np.asarray(Image.open(io.BytesIO(doc.extract_image(xref)["image"])).convert("L")).astype(int)
+    assert image.shape == (458, 351), image.shape
+    columns = range(X0 + 2, 338)
+    table = {"frequency_hz": [(x - X0) / PX_PER_HZ for x in columns]}
+    for name, top in PANELS.items():
+        values = []
+        for x in columns:
+            rows = np.nonzero(image[top + 2 : top + 124, x] < DARK)[0] + top + 2
+            rows = rows[~((x >= 225) & (x <= 315) & (rows >= top + 75))]  # legend
+            rows = rows[~((x <= 106) & (rows <= top + 24))]  # panel label
+            values.append(150 - (np.median(rows) - top) / PX_PER_DB if rows.size else np.nan)
+        table[name] = values
+    lines = ["# Blackman et al. (2004) UCRL-TR-207323 Fig. 23: observed transmission loss, site air9,",
+             "# median over shots, only where signal exceeded noise by 3 dB. Digitised by prepare/digitise_blackman.py.",
+             "frequency_hz,h08s_db,h01w_db"]
+    for f, a, b in zip(*table.values()):
+        if np.isfinite(a) or np.isfinite(b):
+            lines.append(f"{f:.2f},{'' if np.isnan(a) else f'{a:.1f}'},{'' if np.isnan(b) else f'{b:.1f}'}")
+    (HERE.parent / "blackman-air9-tl.csv").write_text("\n".join(lines) + "\n")
+    print(f"wrote {len(lines) - 3} rows")
+
+
+if __name__ == "__main__":
+    main()
