+/// Stage 4 for one case: every data option's evidence, then every evidence set composed.
+#[allow(clippy::too_many_arguments)]
+fn compose_case(
+    case: &str,
+    config: &config::Config,
+    columns: &[String],
+    families: &[String],
+    reference_unix_s: f64,
+    terminal_module: &str,
+    modules: &[impacts::Module],
+    replicates: &[sets::ReplicateImpacts],
+) -> Result<serde_json::Value, String> {
+    let declarations = modules
+        .iter()
+        .map(|m| (m.name.clone(), sets::Declaration { alternatives: m.hypothesis.alternatives(), absolute: m.hypothesis.absolute_scale(), predictions: m.predictions.clone() }))
+        .collect();
+    let placeholder = impacts::is_placeholder(terminal_module);
+    let composer = sets::Stage4 {
+        columns,
+        terminal: config.terminal.as_ref().ok_or("no [terminal]")?,
+        terminal_module,
+        families,
+        declarations: &declarations,
+        placeholder,
+        reference_unix_s,
+    };
+    let sets = config.compose.iter().map(|set| composer.set(set, replicates)).collect::<Result<Vec<_>, _>>()?;
+    Ok(serde_json::json!({"case": case, "options": composer.options(replicates)?, "sets": sets}))
+}
