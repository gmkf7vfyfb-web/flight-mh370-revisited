+def cell_centres(cells, grid):
+    """Latitude, longitude and probability of the equal-area map cells [x, y, p]."""
+    cells = np.array(cells, dtype=float).reshape(-1, 3)
+    x, y = (cells[:, 0] + 0.5) * grid["cell_km"], (cells[:, 1] + 0.5) * grid["cell_km"]
+    lat = np.degrees(y / EARTH_RADIUS_KM)
+    lon = grid["central_meridian_deg"] + np.degrees(x / (EARTH_RADIUS_KM * np.cos(np.radians(lat))))
+    return lat, lon, cells[:, 2]
