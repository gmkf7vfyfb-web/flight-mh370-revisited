+    p.iter().map(|(cell, a)| a.min(*q.get(cell).unwrap_or(&0.0))).sum()
+}
+
+/// Weighted 2.5%, 50% and 97.5% quantiles of the finite values (None if there are none).
+pub fn weighted_quantiles(mut pairs: Vec<(f64, f64)>) -> Option<[f64; 3]> {
+    pairs.retain(|(v, w)| v.is_finite() && *w > 0.0);
+    pairs.sort_by(|a, b| a.0.total_cmp(&b.0));
+    let total: f64 = pairs.iter().map(|p| p.1).sum();
+    let at = |q: f64| {
+        let mut acc = 0.0;
+        pairs.iter().find(|(_, w)| {
+            acc += w;
+            acc >= q * total
+        })
+    };
+    Some([at(0.025)?.0, at(0.5)?.0, at(0.975)?.0])
+}
