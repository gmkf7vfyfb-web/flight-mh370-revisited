+    /// A Gaussian factor N(y; x, s^2) on a Gaussian prior x ~ N(m, t^2): posterior mean and
+    /// variance and the evidence N(y; m, t^2 + s^2), all analytic. Then the region beyond
+    /// c = m + 2t is not computed: its prior share is Phi(-2) and it keeps that share (neutral
+    /// fill), while the evidence is that of the computed domain, conditional on it (not zero
+    /// beyond it): ln Z = ln N(y; m, t^2 + s^2) + ln Phi((c - mu1) / sd1) - ln Phi(2).
+    #[test]
+    fn a_gaussian_factor_on_a_gaussian_prior_composes_analytically() {
+        let (m, t, y, s) = (-37.0, 1.5, -36.0, 1.0);
+        let x = normal_sample(m, t, 200_000);
+        let n = x.len();
+        let weights = vec![1.0 / n as f64; n];
+        let (strata, parents): (Vec<usize>, Vec<usize>) = ((0..n).map(|_| 0).collect(), (0..n).collect());
+        let replica = Replica { weights: &weights, strata: &strata, parents: &parents, filter_log_z: &[0.0] };
+        let loglik: Vec<f64> = x.iter().map(|&x| log_normal(y, x, s * s)).collect();
+        let c = compose(&[replica], &[loglik.clone()], &[1.0], &[1.0]);
+        let posterior_variance = 1.0 / (1.0 / (t * t) + 1.0 / (s * s));
+        let posterior_mean = posterior_variance * (m / (t * t) + y / (s * s));
+        let mean: f64 = c.weights[0].iter().zip(&x).map(|(w, x)| w * x).sum();
+        let variance: f64 = c.weights[0].iter().zip(&x).map(|(w, x)| w * (x - mean).powi(2)).sum();
+        assert!((mean - posterior_mean).abs() < 1e-4, "{mean} vs {posterior_mean}");
+        assert!((variance - posterior_variance).abs() < 1e-4, "{variance} vs {posterior_variance}");
+        assert!((c.log_evidence - log_normal(y, m, t * t + s * s)).abs() < 1e-4);
+        assert_eq!(c.uncomputed, 0.0);
+
+        let cut = m + 2.0 * t;
+        let censored: Vec<f64> = x.iter().zip(&loglik).map(|(&x, &l)| if x > cut { f64::NAN } else { l }).collect();
+        let replica = Replica { weights: &weights, strata: &strata, parents: &parents, filter_log_z: &[0.0] };
+        let c = compose(&[replica], &[censored], &[1.0], &[1.0]);
+        assert!((c.uncomputed - phi(-2.0)).abs() < 1e-4, "{}", c.uncomputed);
+        let sd1 = posterior_variance.sqrt();
+        let expected = log_normal(y, m, t * t + s * s) + phi((cut - posterior_mean) / sd1).ln() - phi(2.0).ln();
+        assert!((c.log_evidence - expected).abs() < 1e-4, "{} vs {expected}", c.log_evidence);
+        let beyond: f64 = x.iter().zip(&c.weights[0]).filter(|(&x, _)| x > cut).map(|(_, w)| w).sum();
+        assert!((beyond - phi(-2.0)).abs() < 1e-4, "uncovered region keeps its prior share: {beyond}");
+        assert!((c.weights[0].iter().sum::<f64>() - 1.0).abs() < 1e-12);
+    }
+
+    /// Two strata (prior 0.3/0.7, filter evidence e^-1/e^-2, x ~ N(0, 1) and N(2, 1)) and one
+    /// alternative, the likelihood's width (s = 0.5 or 2, prior 0.4/0.6), with y = 1, over two
+    /// identical replicates: P(stratum | D), P(width | D) and the evidence follow from
+    /// Z_s(a) = N(y; mean_s, 1 + s_a^2).
+    #[test]
+    fn strata_and_alternatives_follow_the_analytic_evidence() {
+        let (means, strata_prior, filter_log_z) = ([0.0, 2.0], [0.3, 0.7], [-1.0, -2.0]);
+        let (sds, alternative_prior, y) = ([0.5, 2.0], [0.4, 0.6], 1.0);
+        let n = 100_000;
+        let mut x = Vec::new();
+        let mut strata = Vec::new();
+        for (s, &mean) in means.iter().enumerate() {
+            x.extend(normal_sample(mean, 1.0, n));
+            strata.extend(std::iter::repeat_n(s, n));
+        }
+        // Within a replicate, each stratum's rows carry its posterior mass under the filter.
+        let filter_mass: Vec<f64> = (0..2).map(|s| strata_prior[s] * f64::exp(filter_log_z[s])).collect();
+        let weights: Vec<f64> = strata.iter().map(|&s| filter_mass[s] / filter_mass.iter().sum::<f64>() / n as f64).collect();
+        let parents: Vec<usize> = (0..2 * n).collect();
+        let loglik: Vec<f64> = x.iter().flat_map(|&x| sds.map(|sd| log_normal(y, x, sd * sd))).collect();
+        let replica = || Replica { weights: &weights, strata: &strata, parents: &parents, filter_log_z: &filter_log_z };
+        let c = compose(&[replica(), replica()], &[loglik.clone(), loglik], &strata_prior, &alternative_prior);
+
+        let z = |s: usize, a: usize| log_normal(y, means[s], 1.0 + sds[a] * sds[a]).exp();
+        let joint = |s: usize, a: usize| filter_mass[s] * alternative_prior[a] * z(s, a);
+        let total: f64 = (0..2).flat_map(|s| (0..2).map(move |a| (s, a))).map(|(s, a)| joint(s, a)).sum();
+        for s in 0..2 {
+            let expected = (joint(s, 0) + joint(s, 1)) / total;
+            assert!((c.stratum_probability[s] - expected).abs() < 1e-5, "stratum {s}: {} vs {expected}", c.stratum_probability[s]);
+        }
+        for a in 0..2 {
+            let expected = (joint(0, a) + joint(1, a)) / total;
+            assert!((c.combination_probability[a] - expected).abs() < 1e-5, "width {a}: {} vs {expected}", c.combination_probability[a]);
+        }
+        let expected = (total / filter_mass.iter().sum::<f64>()).ln();
+        assert!((c.log_evidence - expected).abs() < 1e-5, "{} vs {expected}", c.log_evidence);
+        assert!((c.replicate_log_evidence[1] - expected).abs() < 1e-5);
+        let pooled: f64 = c.weights.iter().flatten().sum();
+        assert!((pooled - 1.0).abs() < 1e-12);
+    }
+}
