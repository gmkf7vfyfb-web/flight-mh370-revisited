+
+/// What a module declared.
+pub struct Declaration {
+    pub alternatives: Vec<Alternatives>,
+    pub absolute: bool,
+    pub predictions: Vec<String>,
+}
+
+/// One replicate's impact samples and module outputs.
+pub struct ReplicateImpacts {
+    pub seed: u64,
+    /// impacts.npy rows.
+    pub values: Vec<f64>,
+    /// Per module: its output columns and values (modules/<name>.npy), row-aligned.
+    pub modules: BTreeMap<String, (Vec<String>, Vec<f64>)>,
+    pub filter_log_z: Vec<f64>,
+    pub strata_prior: Vec<f64>,
+}
+
+/// What stage 4 shares across a case's sets.
+pub struct Stage4<'a> {
+    pub columns: &'a [String],
+    pub terminal: &'a TerminalConfig,
+    pub terminal_module: &'a str,
+    pub families: &'a [String],
+    pub declarations: &'a BTreeMap<String, Declaration>,
+    /// The terminal module is a placeholder: every page says "not a result".
+    pub placeholder: bool,
+    /// Impact times are reported in minutes after this (the last 00:19 burst).
+    pub reference_unix_s: f64,
+}
+
+/// One discrete alternative of a set: the 00:19 BFO model, or a module's (joined by name across
+/// modules); `eof` if it is the terminal module's (part of an end-of-flight hypothesis).
+struct Dim {
+    name: String,
+    labels: Vec<String>,
+    priors: Vec<f64>,
+    eof: bool,
+    given: Option<usize>,
+    absolute: bool,
+    modules: Vec<String>,
+}
+
+/// Per replicate, rows x combinations of log-likelihood: the data option's, and each module's.
+struct Logliks {
+    combos: usize,
+    option: Vec<Vec<f64>>,
+    modules: Vec<(String, Vec<Vec<f64>>)>,
+}
+
+impl Stage4<'_> {
+    fn column(&self, name: &str) -> Result<usize, String> {
+        self.columns.iter().position(|c| c == name).ok_or_else(|| format!("impacts.npy has no column {name}"))
+    }
+
+    fn rows(&self, r: &ReplicateImpacts) -> usize {
+        r.values.len() / self.columns.len()
+    }
+
+    /// Every data option's evidence and ESS against the flight posterior, so that a collapse
+    /// shows as evidence, not only as a small ESS.
+    pub fn options(&self, replicates: &[ReplicateImpacts]) -> Result<Value, String> {
+        let all: Vec<Vec<usize>> = replicates.iter().map(|r| (0..self.rows(r)).collect()).collect();
+        let mut out = Vec::new();
+        for (k, name) in self.columns.iter().enumerate().filter(|(_, c)| c.starts_with("loglik:")) {
+            let width = self.columns.len();
+            let c = self.compose(replicates, &all, 1, &|i, j, _| replicates[i].values[j * width + k], &[1.0])?;
+            out.push(json!({"column": &name["loglik:".len()..], "log_evidence_increment": finite(c.log_evidence),
+                            "replicate_log_evidence": c.replicate_log_evidence.iter().map(|l| finite(*l)).collect::<Vec<_>>(),
+                            "ess_rows": round(c.ess_rows), "ess_parents": round(c.ess_parents)}));
+        }
+        Ok(Value::Array(out))
+    }
+
+    /// One set: per end-of-flight hypothesis, then the prior sensitivity of their average.
+    pub fn set(&self, set: &ComposeSet, replicates: &[ReplicateImpacts]) -> Result<Value, String> {
+        let dims = self.dims(set)?;
+        let combos = combinations(&dims)?;
+        let logliks = self.logliks(set, &dims, &combos, replicates)?;
+        let family = self.column("family")?;
+        let width = self.columns.len();
+        let eof: Vec<usize> = (0..dims.len()).filter(|&d| dims[d].eof && dims[d].given.is_none()).collect();
+        let all: Vec<Vec<usize>> = replicates.iter().map(|r| (0..self.rows(r)).collect()).collect();
+        let prior_weights = self.compose(replicates, &all, 1, &|_, _, _| 0.0, &[1.0])?.weights;
+
+        let mut hypotheses = Vec::new();
+        for (f, name) in self.families.iter().enumerate() {
+            let rows: Vec<Vec<usize>> = replicates.iter().map(|r| (0..self.rows(r)).filter(|&j| r.values[j * width + family] as usize == f).collect()).collect();
+            if rows.iter().all(Vec::is_empty) {
+                continue;
+            }
+            let family_share: f64 = prior_weights.iter().zip(&rows).map(|(w, rows)| rows.iter().map(|&j| w[j]).sum::<f64>()).sum();
+            for e in cartesian(&eof.iter().map(|&d| dims[d].labels.len()).collect::<Vec<_>>()) {
+                let keep: Vec<usize> = (0..combos.len()).filter(|&c| eof.iter().zip(&e).all(|(&d, &o)| combos[c][d] == o)).collect();
+                let labels: BTreeMap<&str, &str> = eof.iter().zip(&e).map(|(&d, &o)| (dims[d].name.as_str(), dims[d].labels[o].as_str())).collect();
+                let prior = family_share * eof.iter().zip(&e).map(|(&d, &o)| dims[d].priors[o]).product::<f64>();
+                let result = self.hypothesis(set, replicates, &rows, &logliks, &keep, &dims, &combos)?;
+                hypotheses.push((name.clone(), labels, prior, result));
+            }
+        }
+        let evidence: Vec<f64> = hypotheses.iter().map(|h| h.3.log_evidence).collect();
+        let sensitivity: Vec<Value> = [("terminal module", hypotheses.iter().map(|h| h.2).collect::<Vec<_>>()), ("uniform", vec![1.0; hypotheses.len()])]
+            .into_iter()
+            .map(|(label, prior)| {
+                let weights = posterior(&prior, &evidence);
+                json!({"prior": label, "hypothesis_prior": round_all(&normalise(&prior)), "hypothesis_posterior": round_all(&weights),
+                       "points": {"contact": mixture(&hypotheses.iter().map(|h| &h.3).collect::<Vec<_>>(), &weights)}})
+            })
+            .collect();
+        Ok(json!({
+            "id": set.id, "option": set.option, "modules": set.modules, "given": set.given, "tolerance": set.tolerance,
+            "placeholder": self.placeholder,
+            "alternatives": dims.iter().filter(|d| !d.eof).map(|d| json!({"name": d.name, "labels": d.labels, "prior": d.priors,
+                "given": d.given.map(|g| &d.labels[g]), "modules": d.modules, "absolute": d.absolute})).collect::<Vec<_>>(),
+            "end_of_flight": hypotheses.iter().map(|(family, labels, prior, result)| json!({
+                "family": family, "alternatives": labels, "prior": round(*prior), "result": result.json})).collect::<Vec<_>>(),
+            "prior_sensitivity": sensitivity,
+        }))
+    }
+
+    /// The set's alternatives: the 00:19 BFO model if its option uses a BFO, then every
+    /// module's, joined by name, with the set's prior overrides and fixed options.
+    fn dims(&self, set: &ComposeSet) -> Result<Vec<Dim>, String> {
+        let mut dims: Vec<Dim> = Vec::new();
+        let option = self.terminal.options.iter().find(|o| o.id == set.option).ok_or_else(|| format!("set {}: no terminal option {}", set.id, set.option))?;
+        if option.observations.iter().any(|id| id.ends_with(".bfo")) {
+            let (labels, priors) = self.terminal.bfo_models.iter().map(|(l, m)| (l.clone(), m.prior)).unzip();
+            dims.push(Dim { name: BFO_MODEL.into(), labels, priors, eof: false, given: None, absolute: true, modules: Vec::new() });
+        }
+        for module in &set.modules {
+            let d = &self.declarations[module];
+            for a in &d.alternatives {
+                let (labels, priors): (Vec<String>, Vec<f64>) = a.options.iter().cloned().unzip();
+                match dims.iter_mut().find(|x| x.name == a.name) {
+                    Some(x) if x.labels != labels => return Err(format!("set {}: alternative {} has different options in {module}", set.id, a.name)),
+                    Some(x) if x.priors.iter().zip(&priors).any(|(p, q)| (p - q).abs() > 1e-9) && !set.priors.contains_key(&a.name) => {
+                        return Err(format!("set {}: modules declare different priors for {}; set them in the set's priors", set.id, a.name))
+                    }
+                    Some(x) => {
+                        x.modules.push(module.clone());
+                        x.absolute &= d.absolute;
+                    }
+                    None => dims.push(Dim {
+                        name: a.name.clone(),
+                        labels,
+                        priors,
+                        eof: module == self.terminal_module,
+                        given: None,
+                        absolute: d.absolute,
+                        modules: vec![module.clone()],
+                    }),
+                }
+            }
+        }
+        for (name, priors) in &set.priors {
+            let d = dims.iter_mut().find(|d| &d.name == name).ok_or_else(|| format!("set {}: priors for unknown alternative {name}", set.id))?;
+            if priors.len() != d.labels.len() || !priors.iter().all(|p| *p > 0.0) || (priors.iter().sum::<f64>() - 1.0).abs() > 1e-6 {
+                return Err(format!("set {}: priors for {name} need {} positive values summing to one", set.id, d.labels.len()));
+            }
+            d.priors = priors.clone();
+        }
+        for (name, label) in &set.given {
+            let d = dims.iter_mut().find(|d| &d.name == name).ok_or_else(|| format!("set {}: given for unknown alternative {name}", set.id))?;
+            d.given = Some(d.labels.iter().position(|l| l == label).ok_or_else(|| format!("set {}: {name} has no option {label}", set.id))?);
+        }
+        if let Some(d) = dims.iter().find(|d| !d.absolute && d.given.is_none() && d.labels.len() > 1) {
+            return Err(format!(
+                "set {}: {} of {} is not on an absolute scale, so its options cannot be mixed: fix it with `given` (one set per option)",
+                set.id, d.name, d.modules.join(", ")
+            ));
+        }
+        Ok(dims)
+    }
+
+    /// The option's and each module's log-likelihood, per replicate, rows x combinations.
+    fn logliks(&self, set: &ComposeSet, dims: &[Dim], combos: &[Vec<usize>], replicates: &[ReplicateImpacts]) -> Result<Logliks, String> {
+        let width = self.columns.len();
+        let bfo = dims.iter().position(|d| d.name == BFO_MODEL);
+        let option_columns = combos
+            .iter()
+            .map(|c| self.column(&match bfo {
+                Some(b) => format!("loglik:{}/{}", set.option, dims[b].labels[c[b]]),
+                None => format!("loglik:{}", set.option),
+            }))
+            .collect::<Result<Vec<_>, _>>()?;
+        let option = replicates
+            .iter()
+            .map(|r| (0..self.rows(r)).flat_map(|j| option_columns.iter().map(move |&k| r.values[j * width + k])).collect())
+            .collect();
+        let mut modules = Vec::new();
+        for module in &set.modules {
+            let declared = &self.declarations[module].alternatives;
+            let names: Vec<String> = combos
+                .iter()
+                .map(|combo| {
+                    let labels: Vec<&str> = declared.iter().map(|a| {
+                        let d = dims.iter().position(|d| d.name == a.name).unwrap();
+                        dims[d].labels[combo[d]].as_str()
+                    }).collect();
+                    if labels.is_empty() { format!("{module}:loglik") } else { format!("{module}:loglik:{}", labels.join("/")) }
+                })
+                .collect();
+            let mut per_replicate = Vec::new();
+            for r in replicates {
+                let (columns, values) = r.modules.get(module).ok_or_else(|| format!("seed {}: no outputs of {module}", r.seed))?;
+                let ks = names.iter().map(|n| columns.iter().position(|c| c == n).ok_or_else(|| format!("{module} has no column {n}"))).collect::<Result<Vec<_>, _>>()?;
+                per_replicate.push((0..self.rows(r)).flat_map(|j| ks.iter().map(move |&k| values[j * columns.len() + k])).collect());
+            }
+            modules.push((module.clone(), per_replicate));
+        }
+        Ok(Logliks { combos: combos.len(), option, modules })
+    }
+
+    /// Compose the rows `rows` under `n` combinations whose log-likelihood `value(i, j, c)`
+    /// gives for replicate i, row j and the c-th combination; `priors` has one entry per c.
+    fn compose(&self, replicates: &[ReplicateImpacts], rows: &[Vec<usize>], n: usize, value: &dyn Fn(usize, usize, usize) -> f64, priors: &[f64]) -> Result<Composition, String> {
+        let width = self.columns.len();
+        let (w, s, p) = (self.column("weight")?, self.column("mode")?, self.column("parent")?);
+        let mut parts: Vec<(Vec<f64>, Vec<usize>, Vec<usize>, Vec<f64>)> = replicates
+            .iter()
+            .enumerate()
+            .map(|(i, r)| {
+                let get = |k: usize| rows[i].iter().map(|&j| r.values[j * width + k]).collect::<Vec<f64>>();
+                let index = |k: usize| get(k).into_iter().map(|x| x as usize).collect::<Vec<usize>>();
+                let values = rows[i].iter().flat_map(|&j| (0..n).map(move |c| value(i, j, c))).collect();
+                (get(w), index(s), index(p), values)
+            })
+            .collect();
+        let loglik: Vec<Vec<f64>> = parts.iter_mut().map(|p| std::mem::take(&mut p.3)).collect();
+        let replicas: Vec<Replica> = parts
+            .iter()
+            .zip(replicates)
+            .map(|((weights, strata, parents, _), r)| Replica { weights, strata, parents, filter_log_z: &r.filter_log_z })
+            .collect();
+        Ok(compose(&replicas, &loglik, &replicates[0].strata_prior, priors))
+    }
+
+    fn hypothesis(&self, set: &ComposeSet, replicates: &[ReplicateImpacts], rows: &[Vec<usize>], l: &Logliks, keep: &[usize], dims: &[Dim], combos: &[Vec<usize>]) -> Result<Hypothesis, String> {
+        let priors = combination_priors(dims, combos, keep);
+        let n = keep.len();
+        let at = |m: &[Vec<f64>], i: usize, j: usize, c: usize| m[i][j * l.combos + keep[c]];
+        let combined = |i: usize, j: usize, c: usize| at(&l.option, i, j, c) + l.modules.iter().map(|(_, m)| at(m, i, j, c)).sum::<f64>();
+        let c = self.compose(replicates, rows, n, &combined, &priors)?;
+        // Each factor on its own, for the effective sample sizes; the option alone is also the
+        // posterior before the modules, against which uncomputed shares are measured.
+        let option_only = self.compose(replicates, rows, n, &|i, j, c| at(&l.option, i, j, c), &priors)?;
+        let mut ess = BTreeMap::new();
+        ess.insert("option".to_string(), json!({"rows": round(option_only.ess_rows), "parents": round(option_only.ess_parents)}));
+        let mut uncomputed = serde_json::Map::new();
+        uncomputed.insert("set".into(), json!(round(c.uncomputed)));
+        for (module, m) in &l.modules {
+            let alone = self.compose(replicates, rows, n, &|i, j, c| at(m, i, j, c), &priors)?;
+            ess.insert(module.clone(), json!({"rows": round(alone.ess_rows), "parents": round(alone.ess_parents)}));
+            let missing: f64 = (0..replicates.len())
+                .map(|i| rows[i].iter().zip(&option_only.weights[i]).filter(|(&j, _)| (0..n).any(|c| at(m, i, j, c).is_nan())).map(|(_, w)| w).sum::<f64>())
+                .sum();
+            uncomputed.insert(module.clone(), json!(round(missing)));
+        }
+        ess.insert("combined".to_string(), json!({"rows": round(c.ess_rows), "parents": round(c.ess_parents)}));
+
+        let (lat, lon) = (self.column("latitude_deg")?, self.column("longitude_deg")?);
+        let width = self.columns.len();
+        let positions = |reps: &[ReplicateImpacts], rows: &[Vec<usize>], weights: &[Vec<f64>]| -> Vec<(f64, f64, f64)> {
+            reps.iter()
+                .zip(rows)
+                .zip(weights)
+                .flat_map(|((r, rows), w)| rows.iter().zip(w).map(move |(&j, &w)| (w, r.values[j * width + lat], r.values[j * width + lon])))
+                .collect()
+        };
+        let (density, map) = impact_density(positions(replicates, rows, &c.weights).into_iter());
+        // Split-half agreement: the first half of the replicates against the second.
+        let half = replicates.len() / 2;
+        let split = if half > 0 {
+            let part = |a: usize, b: usize| -> Result<(Vec<f64>, BTreeMap<(i32, i32), f64>), String> {
+                let shifted = |i: usize, j: usize, c: usize| combined(i + a, j, c);
+                let p = self.compose(&replicates[a..b], &rows[a..b], n, &shifted, &priors)?;
+                Ok(impact_density(positions(&replicates[a..b], &rows[a..b], &p.weights).into_iter()))
+            };
+            let (first, second) = (part(0, half)?, part(half, replicates.len())?);
+            Some((overlap(&first.0, &second.0), map_overlap(&first.1, &second.1)))
+        } else {
+            None
+        };
+        let alternatives: Vec<Value> = dims
+            .iter()
+            .enumerate()
+            .filter(|(_, d)| !d.eof && d.given.is_none() && d.labels.len() > 1)
+            .map(|(k, d)| {
+                let marginal: Vec<f64> =
+                    (0..d.labels.len()).map(|o| keep.iter().zip(&c.combination_probability).filter(|(&cb, _)| combos[cb][k] == o).map(|(_, p)| p).sum()).collect();
+                // ln Z(o): the evidence under option o, the other alternatives averaged with their
+                // priors. Differences between options are log Bayes factors, free of this prior.
+                let evidence: Vec<Value> = (0..d.labels.len())
+                    .map(|o| {
+                        let terms: Vec<(f64, f64)> = (0..keep.len()).filter(|&cb| combos[keep[cb]][k] == o).map(|cb| (priors[cb], c.combination_log_evidence[cb])).collect();
+                        let max = terms.iter().map(|t| t.1).fold(f64::NEG_INFINITY, f64::max);
+                        let mass: f64 = terms.iter().map(|t| t.0).sum();
+                        finite(max + (terms.iter().map(|(p, l)| p * (l - max).exp()).sum::<f64>() / mass).ln())
+                    })
+                    .collect();
+                json!({"name": d.name, "labels": d.labels, "posterior": round_all(&marginal), "log_evidence": evidence})
+            })
+            .collect();
+        let json = json!({
+            "log_evidence": finite(c.log_evidence),
+            "replicate_log_evidence": c.replicate_log_evidence.iter().map(|l| finite(*l)).collect::<Vec<_>>(),
+            "stratum_probability": round_all(&c.stratum_probability),
+            "ess": ess,
+            "uncomputed": uncomputed,
+            "incomplete": c.uncomputed > set.tolerance,
+            "unconverged": split.is_some_and(|(lat, _)| lat < 0.9),
+            "alternatives": alternatives,
+            "predictions": self.predictions(set, replicates, rows, &c.weights),
+            "points": {"contact": {
+                "latitude": {"density": round_all(&density), "stats": stats(&density), "split_half_overlap": split.map(|s| round(s.0))},
+                "map": map.iter().map(|(&(x, y), &p)| json!([x, y, round(p)])).collect::<Vec<_>>(),
+                "map_split_half_overlap": split.map(|s| round(s.1)),
+            }},
+            "histograms": self.histograms(replicates, rows, &c.weights)?,
+        });
+        Ok(Hypothesis { log_evidence: c.log_evidence, density, map, json })
+    }
+
+    fn histograms(&self, replicates: &[ReplicateImpacts], rows: &[Vec<usize>], weights: &[Vec<f64>]) -> Result<Value, String> {
+        let width = self.columns.len();
+        let (t, e, a) = (self.column("unix_s")?, self.column("kinetic_energy_j")?, self.column("arc_distance_nm")?);
+        let mut time = Histogram::new(-10.0, 50.0, 60);
+        let mut energy = Histogram::new(6.0, 12.0, 60);
+        let mut arc = Histogram::new(-200.0, 200.0, 80);
+        for (i, r) in replicates.iter().enumerate() {
+            for (&j, &w) in rows[i].iter().zip(&weights[i]) {
+                let row = &r.values[j * width..(j + 1) * width];
+                time.add((row[t] - self.reference_unix_s) / 60.0, w);
+                if row[e] > 0.0 {
+                    energy.add(row[e].log10(), w);
+                }
+                arc.add(row[a], w);
+            }
+        }
+        Ok(json!({"impact_minutes_after_last_burst": time.json(), "log10_kinetic_energy_j": energy.json(), "arc_distance_nm": arc.json()}))
+    }
+
+    /// Weighted 2.5/50/97.5% quantiles of every prediction of the set's modules.
+    fn predictions(&self, set: &ComposeSet, replicates: &[ReplicateImpacts], rows: &[Vec<usize>], weights: &[Vec<f64>]) -> Value {
+        let mut out = serde_json::Map::new();
+        for module in &set.modules {
+            for name in &self.declarations[module].predictions {
+                let column = format!("{module}:{name}");
+                let mut pairs = Vec::new();
+                let mut missing = 0.0;
+                for (i, r) in replicates.iter().enumerate() {
+                    let (columns, values) = &r.modules[module];
+                    let Some(k) = columns.iter().position(|c| *c == column) else { continue };
+                    for (&j, &w) in rows[i].iter().zip(&weights[i]) {
+                        let v = values[j * columns.len() + k];
+                        if v.is_nan() {
+                            missing += w;
+                        } else {
+                            pairs.push((v, w));
+                        }
+                    }
+                }
+                let q = weighted_quantiles(pairs);
+                out.insert(column, json!({"q025": q.map(|q| q[0]), "median": q.map(|q| q[1]), "q975": q.map(|q| q[2]), "uncomputed": round(missing)}));
+            }
+        }
+        Value::Object(out)
+    }
+}
+
+/// One end-of-flight hypothesis composed.
+struct Hypothesis {
+    log_evidence: f64,
+    density: Vec<f64>,
+    map: BTreeMap<(i32, i32), f64>,
+    json: Value,
+}
+
+/// The average of per-hypothesis results with the given posterior weights.
+fn mixture(results: &[&Hypothesis], weights: &[f64]) -> Value {
+    let n = results.first().map_or(0, |h| h.density.len());
+    let mut density = vec![0.0; n];
+    let mut map = BTreeMap::new();
+    for (h, &w) in results.iter().zip(weights) {
+        for (d, x) in density.iter_mut().zip(&h.density) {
+            *d += w * x;
+        }
+        for (cell, p) in &h.map {
+            *map.entry(*cell).or_insert(0.0) += w * p;
+        }
+    }
+    json!({"latitude": {"density": round_all(&density), "stats": stats(&density)},
+           "map": map.iter().map(|(&(x, y), &p)| json!([x, y, round(p)])).collect::<Vec<_>>()})
+}
+
+fn posterior(prior: &[f64], log_evidence: &[f64]) -> Vec<f64> {
+    let max = log_evidence.iter().copied().filter(|l| l.is_finite()).fold(f64::NEG_INFINITY, f64::max);
+    let w: Vec<f64> = prior.iter().zip(log_evidence).map(|(p, l)| if l.is_finite() { p * (l - max).exp() } else { 0.0 }).collect();
+    normalise(&w)
+}
+
+fn normalise(v: &[f64]) -> Vec<f64> {
+    let total: f64 = v.iter().sum();
+    v.iter().map(|x| if total > 0.0 { x / total } else { 0.0 }).collect()
+}
+
+/// JSON cannot carry infinities: an impossible evidence is written as null.
+fn finite(v: f64) -> Value {
+    if v.is_finite() { json!(v) } else { Value::Null }
+}
+
+/// Every combination of the dimensions' options; a fixed dimension keeps its given option.
+fn combinations(dims: &[Dim]) -> Result<Vec<Vec<usize>>, String> {
+    let sizes: Vec<usize> = dims.iter().map(|d| if d.given.is_some() { 1 } else { d.labels.len() }).collect();
+    sizes.iter().try_fold(1usize, |n, s| n.checked_mul(*s)).filter(|&n| n <= 4096).ok_or("more than 4096 combinations of alternatives")?;
+    let mut out = cartesian(&sizes);
+    for combo in &mut out {
+        for (d, dim) in dims.iter().enumerate() {
+            if let Some(g) = dim.given {
+                combo[d] = g;
