+    let out = PathBuf::from(&args[args.len() - 1]);
+    let config_paths: Vec<PathBuf> = args[1..args.len() - 1].iter().map(PathBuf::from).collect();
+    let config = config::load(&config_paths)?;
+    config.roles()?; // every module a set names must be enabled
+    let text = std::fs::read_to_string(run_dir.join("run.json")).map_err(|e| format!("{}: {e}", run_dir.display()))?;
+    let manifest: serde_json::Value = serde_json::from_str(&text).map_err(|e| format!("{}: {e}", run_dir.display()))?;
+    let strings = |v: &serde_json::Value| -> Vec<String> { v.as_array().into_iter().flatten().filter_map(|s| s.as_str().map(str::to_string)).collect() };
+    let columns = strings(&manifest["impact_columns"]);
+    if columns.is_empty() || config.compose.is_empty() {
+        return Err(format!("{}: needs a run with impacts and a configuration with [[compose]] sets", run_dir.display()));
+    }
+    let families = strings(&manifest["terminal"]["module_families"]);
+    let reference = manifest["terminal"]["epochs"].as_array().and_then(|e| e.last()).and_then(|e| e["logged_unix_s"].as_f64()).unwrap_or(f64::NAN);
+    let terminal_module = manifest["config"]["terminal"]["module"].as_str().unwrap_or_default().to_string();
+    let listed: BTreeSet<&String> = config.compose.iter().flat_map(|s| &s.modules).collect();
+    let modules: Vec<impacts::Module> = listed.into_iter().map(|name| impacts::module(&config, name, *name == terminal_module, &columns)).collect::<Result<_, _>>()?;
