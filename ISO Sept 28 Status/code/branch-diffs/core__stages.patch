@@ -0,0 +1,270 @@
+//! The composer's arithmetic: one evidence set's data combined with the impact samples.
+//!
+//! Every replicate carries prior weights w (its impact samples, summing to one), each row's
+//! stratum and parent trajectory, and the filter's evidence per stratum. A set supplies, per
+//! row, the log-likelihood of its data under each combination a of its alternatives (NaN: not
+//! computed). With P(a) the combination prior and L_r = sum_a P(a) exp(l_r(a)):
+//! - Z_is(a) = sum over computed rows of (i, s) of w_r exp(l_r(a)), over their prior mass;
+//! - strata and replicates pool as in summary.rs (the island estimator), on the filter's
+//!   evidence times Z_is = sum_a P(a) Z_is(a);
+//! - within (i, s), rows share the stratum's pooled mass in proportion to w_r L_r;
+//! - P(a | D) is proportional to P(a) sum_s prior(s) mean_i(Z_filter,is Z_is(a)).
+//!
+//! A row not computed is filled neutrally: it takes the mean likelihood of the computed rows of
+//! its replicate and stratum (of its replicate, or of all replicates, if none of those is
+//! computed). So the evidence is that of the computed domain, a region the module cannot
+//! cover is never scored as impossible, and uncomputed rows keep their prior share instead of
+//! being renormalised onto the covered rows. Their share of the prior mass is reported.
+
+/// One replicate's impact samples.
+pub struct Replica<'a> {
+    /// Prior row weights; a replicate's sum to one.
+    pub weights: &'a [f64],
+    pub strata: &'a [usize],
+    pub parents: &'a [usize],
+    /// ln Z of the filter per stratum, relative within the replicate (minus infinity if not run).
+    pub filter_log_z: &'a [f64],
+}
+
+/// One composition's result, pooled over replicates.
+pub struct Composition {
+    /// Posterior weight of every row, per replicate; zero for rows not computed.
+    pub weights: Vec<Vec<f64>>,
+    /// Share of the prior (the pooled posterior before this data) on rows not computed.
+    pub uncomputed: f64,
+    pub stratum_probability: Vec<f64>,
+    /// P(a | D) per combination of alternatives.
+    pub combination_probability: Vec<f64>,
+    /// ln of the evidence of this data under each combination, relative to the prior.
+    pub combination_log_evidence: Vec<f64>,
+    /// ln of the evidence of this data, alternatives marginalised: the log-evidence increment.
+    pub log_evidence: f64,
+    /// The same, per replicate (each pooled over its own strata).
+    pub replicate_log_evidence: Vec<f64>,
+    pub ess_rows: f64,
+    pub ess_parents: f64,
+}
+
+/// Compose one set. `loglik[i]` holds, for replicate i, `combinations` values per row.
+pub fn compose(replicas: &[Replica], loglik: &[Vec<f64>], strata_prior: &[f64], combination_prior: &[f64]) -> Composition {
+    let (n_strata, n_comb) = (strata_prior.len(), combination_prior.len());
+    let computed = |i: usize, r: usize| loglik[i][r * n_comb..(r + 1) * n_comb].iter().all(|l| !l.is_nan());
+    // One shift for all likelihoods and one for the filter evidence keep every exp() in range.
+    let shift = loglik.iter().flatten().copied().filter(|l| l.is_finite()).fold(f64::NEG_INFINITY, f64::max);
+    let shift = if shift.is_finite() { shift } else { 0.0 };
+    let filter_shift = replicas.iter().flat_map(|r| r.filter_log_z.iter().copied()).filter(|z| z.is_finite()).fold(f64::NEG_INFINITY, f64::max);
+
+    // Per replicate and stratum: prior mass (all rows, and computed rows), and the likelihood
+    // sums per combination.
+    let mut mass = vec![vec![0.0; n_strata]; replicas.len()];
+    let mut computed_mass = vec![vec![0.0; n_strata]; replicas.len()];
+    let mut sums = vec![vec![vec![0.0; n_comb]; n_strata]; replicas.len()];
+    let mut mixed = vec![vec![0.0; n_strata]; replicas.len()];
+    for (i, rep) in replicas.iter().enumerate() {
+        for (r, (&w, &s)) in rep.weights.iter().zip(rep.strata).enumerate() {
+            mass[i][s] += w;
+            if computed(i, r) {
+                computed_mass[i][s] += w;
+                for a in 0..n_comb {
+                    let term = w * (loglik[i][r * n_comb + a] - shift).exp();
+                    sums[i][s][a] += term;
+                    mixed[i][s] += combination_prior[a] * term;
+                }
+            }
+        }
+    }
+    let filter = |i: usize, s: usize| (replicas[i].filter_log_z[s] - filter_shift).exp();
+    // Mean likelihood of the computed rows: of (i, s), else of replicate i, else of all.
+    let mean = |sum: &dyn Fn(usize, usize) -> f64, i: usize, s: usize| -> f64 {
+        let over = |pairs: &mut dyn Iterator<Item = (usize, usize)>| {
+            let (num, den) = pairs.fold((0.0, 0.0), |(n, d), (i, s)| (n + sum(i, s), d + computed_mass[i][s]));
+            (den > 0.0).then(|| num / den)
+        };
+        over(&mut std::iter::once((i, s)))
+            .or_else(|| over(&mut (0..n_strata).map(|s| (i, s))))
+            .or_else(|| over(&mut (0..replicas.len()).flat_map(|i| (0..n_strata).map(move |s| (i, s)))))
+            .unwrap_or((-shift).exp()) // nothing computed anywhere: no information, likelihood one
+    };
+    let z = |i: usize, s: usize, a: Option<usize>| match a {
+        Some(a) => mean(&|i, s| sums[i][s][a], i, s),
+        None => mean(&|i, s| mixed[i][s], i, s),
+    };
+    let n = replicas.len() as f64;
+    let pooled = |a: Option<usize>| -> Vec<f64> {
+        (0..n_strata).map(|s| strata_prior[s] * (0..replicas.len()).map(|i| filter(i, s) * z(i, s, a)).sum::<f64>() / n).collect()
+    };
+    let before: f64 = (0..n_strata).map(|s| strata_prior[s] * (0..replicas.len()).map(|i| filter(i, s)).sum::<f64>() / n).sum();
+    let after = pooled(None);
+    let total: f64 = after.iter().sum();
+    let stratum_probability: Vec<f64> = after.iter().map(|p| if total > 0.0 { p / total } else { 0.0 }).collect();
+    let combination_log_evidence: Vec<f64> = (0..n_comb).map(|a| (pooled(Some(a)).iter().sum::<f64>() / before).ln() + shift).collect();
+    let weighted: Vec<f64> = combination_log_evidence.iter().zip(combination_prior).map(|(l, p)| p * (l - shift).exp()).collect();
+    let weighted_total: f64 = weighted.iter().sum();
+    let combination_probability = weighted.iter().map(|w| w / weighted_total).collect();
+    let replicate_log_evidence = (0..replicas.len())
+        .map(|i| {
+            let prior: f64 = (0..n_strata).map(|s| strata_prior[s] * filter(i, s)).sum();
+            ((0..n_strata).map(|s| strata_prior[s] * filter(i, s) * z(i, s, None)).sum::<f64>() / prior).ln() + shift
+        })
+        .collect();
+
+    // Row weights: the stratum's pooled mass, split between replicates by their evidence and
+    // within a replicate by w_r L_r, where an uncomputed row's L_r is the neutral fill.
+    let column: Vec<f64> = (0..n_strata).map(|s| (0..replicas.len()).map(|i| filter(i, s) * z(i, s, None)).sum()).collect();
+    let mut uncomputed = 0.0;
+    let mut weights = Vec::with_capacity(replicas.len());
+    for (i, rep) in replicas.iter().enumerate() {
+        let mut row_weights = vec![0.0; rep.weights.len()];
+        for (r, (&w, &s)) in rep.weights.iter().zip(rep.strata).enumerate() {
+            let fill = z(i, s, None);
+            if !(fill > 0.0 && column[s] > 0.0) {
+                continue;
+            }
+            let mix = if computed(i, r) {
+                (0..n_comb).map(|a| combination_prior[a] * (loglik[i][r * n_comb + a] - shift).exp()).sum()
+            } else {
+                uncomputed += strata_prior[s] * filter(i, s) / (n * before) * w / mass[i][s];
+                fill
+            };
+            // Sum of w L over the whole (i, s), filled rows included, is mass * fill.
+            row_weights[r] = stratum_probability[s] * filter(i, s) * fill / column[s] * w * mix / (mass[i][s] * fill);
+        }
+        weights.push(row_weights);
+    }
+    let ess_rows = 1.0 / weights.iter().flatten().map(|w| w * w).sum::<f64>();
+    let mut by_parent = std::collections::BTreeMap::new();
+    for (i, (rep, row_weights)) in replicas.iter().zip(&weights).enumerate() {
+        for (&p, &w) in rep.parents.iter().zip(row_weights) {
+            *by_parent.entry((i, p)).or_insert(0.0) += w;
+        }
+    }
+    let ess_parents = 1.0 / by_parent.values().map(|w: &f64| w * w).sum::<f64>();
+    Composition {
+        weights,
+        uncomputed,
+        stratum_probability,
+        combination_probability,
+        combination_log_evidence,
+        log_evidence: (total / before).ln() + shift,
+        replicate_log_evidence,
+        ess_rows,
+        ess_parents,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Quantile points of N(mean, sd): an equally weighted sample whose moments converge fast.
+    fn normal_sample(mean: f64, sd: f64, n: usize) -> Vec<f64> {
+        (0..n).map(|k| mean + sd * inverse_normal((k as f64 + 0.5) / n as f64)).collect()
+    }
+
+    /// Acklam's rational approximation to the standard normal quantile (relative error < 1.2e-9).
+    fn inverse_normal(p: f64) -> f64 {
+        let a = [-3.969683028665376e1, 2.209460984245205e2, -2.759285104469687e2, 1.383577518672690e2, -3.066479806614716e1, 2.506628277459239];
+        let b = [-5.447609879822406e1, 1.615858368580409e2, -1.556989798598866e2, 6.680131188771972e1, -1.328068155288572e1];
+        let c = [-7.784894002430293e-3, -3.223964580411365e-1, -2.400758277161838, -2.549732539343734, 4.374664141464968, 2.938163982698783];
+        let d = [7.784695709041462e-3, 3.224671290700398e-1, 2.445134137142996, 3.754408661907416];
+        let tail = |q: f64| (((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) / ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1.0);
+        if p < 0.02425 {
+            tail((-2.0 * p.ln()).sqrt())
+        } else if p > 1.0 - 0.02425 {
+            -tail((-2.0 * (1.0 - p).ln()).sqrt())
+        } else {
+            let (q, r) = (p - 0.5, (p - 0.5) * (p - 0.5));
+            (((((a[0] * r + a[1]) * r + a[2]) * r + a[3]) * r + a[4]) * r + a[5]) * q / (((((b[0] * r + b[1]) * r + b[2]) * r + b[3]) * r + b[4]) * r + 1.0)
+        }
+    }
+
+    fn log_normal(x: f64, mean: f64, variance: f64) -> f64 {
+        -0.5 * ((x - mean).powi(2) / variance + (std::f64::consts::TAU * variance).ln())
+    }
+
+    /// The standard normal cdf, by the erfc series of Abramowitz & Stegun 7.1.26 (|error| < 1.5e-7).
+    fn phi(x: f64) -> f64 {
+        let t = 1.0 / (1.0 + 0.327_591_1 * x.abs() / std::f64::consts::SQRT_2);
+        let poly = t * (0.254_829_592 + t * (-0.284_496_736 + t * (1.421_413_741 + t * (-1.453_152_027 + t * 1.061_405_429))));
+        let erfc = poly * (-(x * x) / 2.0).exp();
+        if x >= 0.0 { 1.0 - 0.5 * erfc } else { 0.5 * erfc }
+    }
+
+    /// A Gaussian factor N(y; x, s^2) on a Gaussian prior x ~ N(m, t^2): posterior mean and
+    /// variance and the evidence N(y; m, t^2 + s^2), all analytic. Then the region beyond
+    /// c = m + 2t is not computed: its prior share is Phi(-2) and it keeps that share (neutral
+    /// fill), while the evidence is that of the computed domain, conditional on it (not zero
+    /// beyond it): ln Z = ln N(y; m, t^2 + s^2) + ln Phi((c - mu1) / sd1) - ln Phi(2).
+    #[test]
+    fn a_gaussian_factor_on_a_gaussian_prior_composes_analytically() {
+        let (m, t, y, s) = (-37.0, 1.5, -36.0, 1.0);
+        let x = normal_sample(m, t, 200_000);
+        let n = x.len();
+        let weights = vec![1.0 / n as f64; n];
+        let (strata, parents): (Vec<usize>, Vec<usize>) = ((0..n).map(|_| 0).collect(), (0..n).collect());
+        let replica = Replica { weights: &weights, strata: &strata, parents: &parents, filter_log_z: &[0.0] };
+        let loglik: Vec<f64> = x.iter().map(|&x| log_normal(y, x, s * s)).collect();
+        let c = compose(&[replica], &[loglik.clone()], &[1.0], &[1.0]);
+        let posterior_variance = 1.0 / (1.0 / (t * t) + 1.0 / (s * s));
+        let posterior_mean = posterior_variance * (m / (t * t) + y / (s * s));
+        let mean: f64 = c.weights[0].iter().zip(&x).map(|(w, x)| w * x).sum();
+        let variance: f64 = c.weights[0].iter().zip(&x).map(|(w, x)| w * (x - mean).powi(2)).sum();
+        assert!((mean - posterior_mean).abs() < 1e-4, "{mean} vs {posterior_mean}");
+        assert!((variance - posterior_variance).abs() < 1e-4, "{variance} vs {posterior_variance}");
+        assert!((c.log_evidence - log_normal(y, m, t * t + s * s)).abs() < 1e-4);
+        assert_eq!(c.uncomputed, 0.0);
+
+        let cut = m + 2.0 * t;
+        let censored: Vec<f64> = x.iter().zip(&loglik).map(|(&x, &l)| if x > cut { f64::NAN } else { l }).collect();
+        let replica = Replica { weights: &weights, strata: &strata, parents: &parents, filter_log_z: &[0.0] };
+        let c = compose(&[replica], &[censored], &[1.0], &[1.0]);
+        assert!((c.uncomputed - phi(-2.0)).abs() < 1e-4, "{}", c.uncomputed);
+        let sd1 = posterior_variance.sqrt();
+        let expected = log_normal(y, m, t * t + s * s) + phi((cut - posterior_mean) / sd1).ln() - phi(2.0).ln();
+        assert!((c.log_evidence - expected).abs() < 1e-4, "{} vs {expected}", c.log_evidence);
+        let beyond: f64 = x.iter().zip(&c.weights[0]).filter(|(&x, _)| x > cut).map(|(_, w)| w).sum();
+        assert!((beyond - phi(-2.0)).abs() < 1e-4, "uncovered region keeps its prior share: {beyond}");
+        assert!((c.weights[0].iter().sum::<f64>() - 1.0).abs() < 1e-12);
+    }
+
+    /// Two strata (prior 0.3/0.7, filter evidence e^-1/e^-2, x ~ N(0, 1) and N(2, 1)) and one
+    /// alternative, the likelihood's width (s = 0.5 or 2, prior 0.4/0.6), with y = 1, over two
+    /// identical replicates: P(stratum | D), P(width | D) and the evidence follow from
+    /// Z_s(a) = N(y; mean_s, 1 + s_a^2).
+    #[test]
+    fn strata_and_alternatives_follow_the_analytic_evidence() {
+        let (means, strata_prior, filter_log_z) = ([0.0, 2.0], [0.3, 0.7], [-1.0, -2.0]);
+        let (sds, alternative_prior, y) = ([0.5, 2.0], [0.4, 0.6], 1.0);
+        let n = 100_000;
+        let mut x = Vec::new();
+        let mut strata = Vec::new();
+        for (s, &mean) in means.iter().enumerate() {
+            x.extend(normal_sample(mean, 1.0, n));
+            strata.extend(std::iter::repeat_n(s, n));
+        }
+        // Within a replicate, each stratum's rows carry its posterior mass under the filter.
+        let filter_mass: Vec<f64> = (0..2).map(|s| strata_prior[s] * f64::exp(filter_log_z[s])).collect();
+        let weights: Vec<f64> = strata.iter().map(|&s| filter_mass[s] / filter_mass.iter().sum::<f64>() / n as f64).collect();
+        let parents: Vec<usize> = (0..2 * n).collect();
+        let loglik: Vec<f64> = x.iter().flat_map(|&x| sds.map(|sd| log_normal(y, x, sd * sd))).collect();
+        let replica = || Replica { weights: &weights, strata: &strata, parents: &parents, filter_log_z: &filter_log_z };
+        let c = compose(&[replica(), replica()], &[loglik.clone(), loglik], &strata_prior, &alternative_prior);
+
+        let z = |s: usize, a: usize| log_normal(y, means[s], 1.0 + sds[a] * sds[a]).exp();
+        let joint = |s: usize, a: usize| filter_mass[s] * alternative_prior[a] * z(s, a);
+        let total: f64 = (0..2).flat_map(|s| (0..2).map(move |a| (s, a))).map(|(s, a)| joint(s, a)).sum();
+        for s in 0..2 {
+            let expected = (joint(s, 0) + joint(s, 1)) / total;
+            assert!((c.stratum_probability[s] - expected).abs() < 1e-5, "stratum {s}: {} vs {expected}", c.stratum_probability[s]);
+        }
+        for a in 0..2 {
+            let expected = (joint(0, a) + joint(1, a)) / total;
+            assert!((c.combination_probability[a] - expected).abs() < 1e-5, "width {a}: {} vs {expected}", c.combination_probability[a]);
+        }
+        let expected = (total / filter_mass.iter().sum::<f64>()).ln();
+        assert!((c.log_evidence - expected).abs() < 1e-5, "{} vs {expected}", c.log_evidence);
+        assert!((c.replicate_log_evidence[1] - expected).abs() < 1e-5);
+        let pooled: f64 = c.weights.iter().flatten().sum();
+        assert!((pooled - 1.0).abs() < 1e-12);
