+/// Weighted impact positions summarised on the shared grids: the smoothed latitude density
+/// (with `stats`) and the equal-area map (probability per cell; the cells sum to one).
+pub fn impact_density(samples: impl Iterator<Item = (f64, f64, f64)>) -> (Vec<f64>, std::collections::BTreeMap<(i32, i32), f64>) {
+    let mut hist = vec![0.0; points()];
+    let mut map = std::collections::BTreeMap::new();
+    let mut total = 0.0;
+    for (w, lat, lon) in samples {
+        if w > 0.0 {
+            if let Some(bin) = grid_bin(lat) {
+                hist[bin] += w;
+            }
+            *map.entry(impact_cell(lat, lon)).or_insert(0.0) += w;
+            total += w;
+        }
+    }
+    for v in map.values_mut() {
+        *v /= total;
+    }
+    (smooth_to_density(&hist), map)
