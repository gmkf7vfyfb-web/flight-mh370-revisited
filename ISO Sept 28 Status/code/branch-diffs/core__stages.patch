+/// The equal-area map of impact densities: a sinusoidal projection on the authalic sphere,
+/// x = R (lon - 95E) cos(lat), y = R lat, cut into 10 km squares.
+pub const IMPACT_MAP: (f64, f64) = (95.0, 10.0);
+const AUTHALIC_RADIUS_KM: f64 = 6_371.007_2;
+
+pub fn impact_cell(lat: f64, lon: f64) -> (i32, i32) {
+    let (phi, dlambda) = (lat.to_radians(), (lon - IMPACT_MAP.0).to_radians());
+    let (x, y) = (AUTHALIC_RADIUS_KM * dlambda * phi.cos(), AUTHALIC_RADIUS_KM * phi);
