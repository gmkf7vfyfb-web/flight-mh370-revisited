+/// Stages 3 and 4 again on a finished run's impacts, in seconds: the modules and evidence sets
+/// come from the configuration given, whose `[terminal]` must be the one the run was made with
+/// (the impact columns are the run's). Writes modules/ per replicate, summary.json with the
+/// composer's section, and run.json.
+fn recompose(args: &[String]) -> Result<(), String> {
+    if args.len() < 3 {
+        return Err("usage: mh370 compose <run-dir> <config.toml> [<override.toml>...] <out-dir>".into());
+    }
+    let started = Instant::now();
+    let run_dir = PathBuf::from(&args[0]);
+    let out = PathBuf::from(&args[args.len() - 1]);
+    let config_paths: Vec<PathBuf> = args[1..args.len() - 1].iter().map(PathBuf::from).collect();
+    let config = config::load(&config_paths)?;
+    config.roles()?; // every module a set names must be enabled
+    let text = std::fs::read_to_string(run_dir.join("run.json")).map_err(|e| format!("{}: {e}", run_dir.display()))?;
+    let manifest: serde_json::Value = serde_json::from_str(&text).map_err(|e| format!("{}: {e}", run_dir.display()))?;
+    let strings = |v: &serde_json::Value| -> Vec<String> { v.as_array().into_iter().flatten().filter_map(|s| s.as_str().map(str::to_string)).collect() };
+    let columns = strings(&manifest["impact_columns"]);
+    if columns.is_empty() || config.compose.is_empty() {
+        return Err(format!("{}: needs a run with impacts and a configuration with [[compose]] sets", run_dir.display()));
+    }
+    let families = strings(&manifest["terminal"]["module_families"]);
+    let reference = manifest["terminal"]["epochs"].as_array().and_then(|e| e.last()).and_then(|e| e["logged_unix_s"].as_f64()).unwrap_or(f64::NAN);
+    let terminal_module = manifest["config"]["terminal"]["module"].as_str().unwrap_or_default().to_string();
+    let listed: BTreeSet<&String> = config.compose.iter().flat_map(|s| &s.modules).collect();
+    let modules: Vec<impacts::Module> = listed.into_iter().map(|name| impacts::module(&config, name, *name == terminal_module, &columns)).collect::<Result<_, _>>()?;
+
+    let mut cases = Vec::new();
+    for case in &config.cases {
+        let mut replicates = Vec::new();
+        for &seed in case.seeds.as_ref().unwrap_or(&config.seeds) {
+            let source = run_dir.join(&case.id).join(format!("seed-{seed}"));
+            if !source.join("impacts.npy").is_file() {
+                continue;
+            }
+            let mut values = Vec::new();
+            output::read_npy_rows(&source.join("impacts.npy"), |row| values.extend_from_slice(row))?;
+            let text = std::fs::read_to_string(source.join("diagnostics.json")).map_err(|e| format!("{}: {e}", source.display()))?;
+            let filtered: filter::Replicate = serde_json::from_str(&text).map_err(|e| format!("{}: {e}", source.display()))?;
+            let dir = out.join(&case.id).join(format!("seed-{seed}"));
+            let module_outputs = impacts::evaluate_modules(&dir, &columns, &values, &modules)?;
+            replicates.push(sets::ReplicateImpacts {
+                seed,
+                values,
+                modules: module_outputs,
+                filter_log_z: filtered.modes.iter().map(|m| m.log_evidence).collect(),
+                strata_prior: filtered.modes.iter().map(|m| m.prior_weight).collect(),
+            });
+        }
+        if !replicates.is_empty() {
+            cases.push(compose_case(&case.id, &config, &columns, &families, reference, &terminal_module, &modules, &replicates)?);
+        }
+    }
+    write_json(&out.join("summary.json"), &serde_json::json!({"impacts": {"grid": sets::grid(), "cases": cases}}))?;
+    write_json(
+        &out.join("run.json"),
+        &serde_json::json!({
+            "source_run": run_dir,
+            "config": config,
+            "config_paths": config_paths,
+            "code_revision": code_revision(),
+            "impact_columns": columns,
+            "terminal": manifest["terminal"],
+            "hypotheses": config.hypotheses.iter().map(|(name, params)| serde_json::json!({
+                "name": name, "parameters": params, "metadata": hypotheses::metadata(name)})).collect::<Vec<_>>(),
+            "runtime_s": started.elapsed().as_secs_f64(),
+        }),
+    )?;
+    eprintln!("composed {} in {:.1} s", out.display(), started.elapsed().as_secs_f64());
+    Ok(())
+}
