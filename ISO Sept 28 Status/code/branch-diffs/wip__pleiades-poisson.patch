+    #[test]
+    fn kernels_are_normalised_with_the_calibrated_spread() {
+        let t = Kernel::StudentT { nu: 4.0, scale_km: 100.0 };
+        // Hand value: at r = scale, p = (1 + 1/4)^-3 / (2π · 100²).
+        let hand = 1.25f64.powi(-3) / (2.0 * std::f64::consts::PI * 1.0e4);
+        assert!((t.ln_density(100.0) - hand.ln()).abs() < 1e-12);
+        let g = Kernel::Gaussian { sigma_km: 146.0 };
+        assert!((g.ln_density(146.0) - ((-0.5f64).exp() / (2.0 * std::f64::consts::PI * 146.0 * 146.0)).ln()).abs() < 1e-12);
+        // Radial quadrature against the closed-form tail P(|e| > r): (1 + r²/(ν s²))^(−ν/2) for the
+        // bivariate Student-t, exp(−r²/2σ²) for the Gaussian; mass 1 overall.
+        let primary = Kernel::StudentT { nu: 2.624, scale_km: 72.32 };
+        for k in [t, primary, g] {
+            let tail = |r: f64| match k {
+                Kernel::StudentT { nu, scale_km: s } => (1.0 + r * r / (nu * s * s)).powf(-nu / 2.0),
+                Kernel::Gaussian { sigma_km: s } => (-r * r / (2.0 * s * s)).exp(),
+            };
+            let (dr, mut mass, mut r) = (0.05, 0.0, 0.025);
+            for probe in [50.0, 150.0, 500.0, 2_000.0, 20_000.0] {
+                while r < probe {
+                    mass += k.ln_density(r).exp() * 2.0 * std::f64::consts::PI * r * dr;
+                    r += dr;
+                }
+                assert!((1.0 - mass - tail(probe)).abs() < 1e-5, "{k:?} at {probe} km: {} vs {}", 1.0 - mass, tail(probe));
+            }
+        }
+    }
