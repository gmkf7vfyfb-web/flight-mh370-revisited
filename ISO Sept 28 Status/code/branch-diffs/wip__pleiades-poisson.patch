+    /// Synthetic recovery of the data model itself: draw an impact from a uniform prior, drift it
+    /// through a known map and add a Student-t error. The item counts as imaged only if it lands in
+    /// the footprint F (otherwise the draw is rejected, the selection behind the real data). A
+    /// second cluster is background, uniform in F. The posterior of the impact under H must cover
+    /// the truth at the nominal rates.
+    #[test]
+    fn synthetic_recovery_covers_the_true_impact() {
+        let kernel = Kernel::StudentT { nu: 4.0, scale_km: 60.0 };
+        let map = affine_map("synthetic", |la, lo| (la + 0.9 + 0.25 * (lo - 91.0), lo - 1.8 + 0.15 * (la + 36.0)));
+        let mut rng = SplitMix(20_140_323);
+        let (grid_n, lat_range, lon_range) = (61, (-38.0, -33.0), (88.0, 94.0));
+        let cell = |k: usize, (a, b): (f64, f64)| a + (b - a) * (k as f64 + 0.5) / grid_n as f64;
+        let footprint = [-35.0, -34.0, 89.3, 90.5];
+        let inside = |(la, lo): (f64, f64)| la > footprint[0] && la < footprint[1] && lo > footprint[2] && lo < footprint[3];
+        let (mut hit50, mut hit90, reps) = (0usize, 0usize, 400usize);
+        for _ in 0..reps {
+            let (i0, j0, debris) = loop {
+                let (i0, j0) = ((rng.uniform() * grid_n as f64) as usize, (rng.uniform() * grid_n as f64) as usize);
+                let (ela, elo) = map.endpoint(0, cell(i0, lat_range), cell(j0, lon_range)).unwrap();
+                // Student-t (ν = 4) error: Gaussian / sqrt(χ²₄ / 4).
+                let chi2: f64 = (0..4).map(|_| rng.normal().powi(2)).sum();
+                let f = kernel_scale(kernel) / (chi2 / 4.0).sqrt();
+                let (de, dn) = (rng.normal() * f, rng.normal() * f);
+                let item = (ela + dn / 111.195, elo + de / (111.195 * ela.to_radians().cos()));
+                if inside(item) {
+                    break (i0, j0, item);
+                }
+            };
+            let background = (footprint[0] + rng.uniform() * 1.0, footprint[2] + rng.uniform() * 1.2);
+            let obs = if rng.uniform() < 0.5 { [debris, background] } else { [background, debris] };
+            let post: Vec<f64> = (0..grid_n * grid_n)
+                .map(|k| {
+                    let (la, lo) = (cell(k / grid_n, lat_range), cell(k % grid_n, lon_range));
+                    let (xa, xo) = map.endpoint(0, la, lo).unwrap();
+                    let ln_a: Vec<f64> = obs.iter().map(|(ya, yo)| kernel.ln_density(distance_km(*ya, *yo, xa, xo))).collect();
+                    combine(&ln_a, Association::Single).exp()
+                })
+                .collect();
+            let truth = post[i0 * grid_n + j0];
+            let total: f64 = post.iter().sum();
+            let above: f64 = post.iter().filter(|p| **p > truth).sum::<f64>() / total;
+            hit50 += usize::from(above < 0.5);
+            hit90 += usize::from(above < 0.9);
+        }
+        let (c50, c90) = (hit50 as f64 / reps as f64, hit90 as f64 / reps as f64);
+        // Binomial 3σ: ±0.075 at 50%, ±0.045 at 90%.
+        assert!((c50 - 0.5).abs() < 0.075 && (c90 - 0.9).abs() < 0.045, "coverage {c50} {c90}");
+    }
+
+    fn kernel_scale(k: Kernel) -> f64 {
+        match k {
+            Kernel::StudentT { scale_km, .. } => scale_km,
+            Kernel::Gaussian { sigma_km } => sigma_km,
+        }
+    }
+
+    /// SplitMix64 with Box-Muller normals (tests only; hypotheses have no rand dependency).
+    struct SplitMix(u64);
+    impl SplitMix {
+        fn uniform(&mut self) -> f64 {
+            self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
+            let mut z = self.0;
+            z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+            z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+            ((z ^ (z >> 31)) >> 11) as f64 / (1u64 << 53) as f64
+        }
+        fn normal(&mut self) -> f64 {
+            let (u, v) = (self.uniform().max(1e-300), self.uniform());
+            (-2.0 * u.ln()).sqrt() * (std::f64::consts::TAU * v).cos()
+        }
+    }
+}
