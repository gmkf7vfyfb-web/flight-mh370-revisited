+    fn affine_map_on(model: &str, [lat0, lon0, step]: [f64; 3], [nlat, nlon]: [usize; 2], f: impl Fn(f64, f64) -> (f64, f64)) -> DriftMap {
+        let mut la = vec![0f32; nlat * nlon];
+        let mut lo = la.clone();
+        for i in 0..nlat {
+            for j in 0..nlon {
+                let (a, b) = f(lat0 + step * i as f64, lon0 + step * j as f64);
+                la[i * nlon + j] = a as f32;
+                lo[i * nlon + j] = b as f32;
+            }
+        }
+        DriftMap::new(model.into(), [lat0, lon0, step], [nlat, nlon], vec![0.0], vec![(la, lo)]).unwrap()
+    }
