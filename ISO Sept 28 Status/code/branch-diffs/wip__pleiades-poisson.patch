+# The integrated estimate plus the Pleiades conditional alternative, as an impact module.
+# Until the composer is merged, `make evaluate H=pleiades` runs the module on the fixture's impacts.
+base = "../../config/integrated.toml"
+name = "pleiades"
+seeds = [1, 2, 3, 4]
+
+[[cases]]
+id = "bto-bfo"
+use_bfo = true
+
+# Evidence sets, all with every 00:19 datum. The flight alone; the flight and Pleiades, with H
+# against not-H at prior odds 1 (the composer sweeps them); and Pleiades given H, the conditional
+# posterior p(x | D, H).
+[[compose]]
+id = "flight"
+option = "all"
+
+[[compose]]
+id = "pleiades"
+option = "all"
+modules = ["pleiades"]
+
+[[compose]]
+id = "pleiades-given-h"
+option = "all"
+modules = ["pleiades"]
+given = { pleiades-origin = "H" }
+
+[hypotheses.pleiades]
+# One list per ocean model: the 0.0125 deg map over 42-32S 82-96E, then the 0.05 deg map over
+# 50-15S 70-115E. Paths are relative to the repository root, where `make` runs.
+drift_maps = [
+  ["data/external/drift/pleiades-map-fine/glorys12", "data/external/drift/pleiades-map/glorys12"],
+  ["data/external/drift/pleiades-map-fine/oscar2", "data/external/drift/pleiades-map/oscar2"],
+  ["data/external/drift/pleiades-map-fine/bran2016", "data/external/drift/pleiades-map/bran2016"],
+]
+# Primary: the four rating-5 clusters, single association (exactly one cluster is MRO debris).
+min_rating = 5
+association = { kind = "single" }
+
+# 15-day transport error per ocean model, from the crates/ocean GDP replay (rev 2724f57; 2014,
+# 25-45S 60-115E): undrogued drifters with current + 1.2% ERA5 wind (lib.rs).
+[hypotheses.pleiades.kernel.glorys12]
+form = "student-t"
+nu = 2.725
+scale_km = 77.27
+
+[hypotheses.pleiades.kernel.oscar2]
+form = "student-t"
+nu = 2.624
+scale_km = 72.32
+
+[hypotheses.pleiades.kernel.bran2016]
+form = "student-t"
+nu = 3.684
+scale_km = 94.1
