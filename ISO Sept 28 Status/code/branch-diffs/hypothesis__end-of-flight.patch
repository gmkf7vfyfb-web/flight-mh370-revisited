@@ -0,0 +1,109 @@
+//! Two-pass sampling of one trajectory's descents: pilot rounds, scored, adapt the proposal;
+//! then the final draws come fresh from the fixed proposal. Pilot draws never enter the final
+//! weights. Generic in what is simulated, so it assumes nothing about the flight after the
+//! takeover (unpowered, still powered, or anything a later family adds).
+
+use super::proposal::BoxMixture;
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Settings {
+    /// Pilot draws per adaptation round.
+    pub pilots: usize,
+    /// Adaptation rounds; 0 draws the finals from the plain prior.
+    pub rounds: usize,
+    pub finals: usize,
+    pub centres: usize,
+    /// Largest half-width of a proposal box in any coordinate.
+    pub half_width: f64,
+    /// Share of plain prior draws in the final proposal.
+    pub prior_share: f64,
+}
+
+/// Final draws of one stratum on the unit cube of dimension `dim`. `simulate(u)` returns a
+/// candidate and the share of ln(prior/proposal) that is not the cube's own (a prior that is not
+/// uniform in u). `target` is the log-likelihood the proposal adapts to: the configured data
+/// scores and this module's own terms. Each final comes with its exact ln(prior/proposal).
+pub fn sample<C>(
+    settings: &Settings,
+    dim: usize,
+    uniform: &mut dyn FnMut() -> f64,
+    simulate: &dyn Fn(&[f64]) -> (C, f64),
+    target: &dyn Fn(&C) -> f64,
+) -> Vec<(C, f64)> {
+    let mut proposal = BoxMixture::prior();
+    for _ in 0..settings.rounds {
+        let (mut points, mut log_weights) = (Vec::with_capacity(settings.pilots), Vec::with_capacity(settings.pilots));
+        for _ in 0..settings.pilots {
+            let (u, cube) = proposal.draw(dim, uniform);
+            let (candidate, prior) = simulate(&u);
+            log_weights.push(cube + prior + target(&candidate));
+            points.push(u);
+        }
+        proposal = BoxMixture::fit(&points, &log_weights, settings.centres, settings.half_width, settings.prior_share, uniform());
+    }
+    (0..settings.finals)
+        .map(|_| {
+            let (u, cube) = proposal.draw(dim, uniform);
+            let (candidate, prior) = simulate(&u);
+            (candidate, cube + prior)
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Simulation-based calibration: truths drawn from the prior, data drawn from the model
+    /// given each truth; the weighted 10-90% interval of the finals must cover the truth about
+    /// 80% of the time, and the proposal must beat plain prior draws. Enough finals are drawn
+    /// for a large effective sample: weighted quantiles from a small one are biased inwards.
+    #[test]
+    fn final_intervals_cover_the_truth() {
+        let mut seed = 0x5EED_u64;
+        let mut uniform = move || {
+            seed = seed.wrapping_add(0x9E37_79B9_7F4A_7C15);
+            let mut z = seed;
+            z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+            z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+            (((z ^ (z >> 31)) >> 11) as f64 + 0.5) / (1u64 << 53) as f64
+        };
+        let settings = Settings { pilots: 64, rounds: 2, finals: 2000, centres: 16, half_width: 0.1, prior_share: 0.5 };
+        let sd = 0.03;
+        let (trials, mut covered, mut ess_total) = (200, 0, 0.0);
+        for _ in 0..trials {
+            let truth = [uniform(), uniform(), uniform()];
+            // Two noisy observations of the first two coordinates; the third is unobserved.
+            let normal = |u: &mut dyn FnMut() -> f64| (-2.0 * u().ln()).sqrt() * (std::f64::consts::TAU * u()).cos();
+            let data = [truth[0] + sd * normal(&mut uniform), truth[1] + sd * normal(&mut uniform)];
+            let finals = sample(&settings, 3, &mut uniform, &|u| (u.to_vec(), 0.0), &|x: &Vec<f64>| {
+                -0.5 * (((x[0] - data[0]) / sd).powi(2) + ((x[1] - data[1]) / sd).powi(2))
+            });
+            let mut draws: Vec<(f64, f64)> = finals
+                .iter()
+                .map(|(x, c)| (x[0], c - 0.5 * (((x[0] - data[0]) / sd).powi(2) + ((x[1] - data[1]) / sd).powi(2))))
+                .collect();
+            draws.sort_by(|a, b| a.0.total_cmp(&b.0));
+            let top = draws.iter().map(|d| d.1).fold(f64::MIN, f64::max);
+            let w: Vec<f64> = draws.iter().map(|d| (d.1 - top).exp()).collect();
+            let total: f64 = w.iter().sum();
+            ess_total += total * total / w.iter().map(|w| w * w).sum::<f64>();
+            let (mut cum, mut lo, mut hi) = (0.0, f64::NAN, f64::NAN);
+            for ((x, _), w) in draws.iter().zip(&w) {
+                cum += w / total;
+                if lo.is_nan() && cum >= 0.1 {
+                    lo = *x;
+                }
+                if hi.is_nan() && cum >= 0.9 {
+                    hi = *x;
+                }
+            }
+            covered += usize::from(lo <= truth[0] && truth[0] <= hi);
+        }
+        let rate = covered as f64 / trials as f64;
+        println!("coverage {rate}, mean ESS {:.0} of {}", ess_total / trials as f64, settings.finals);
+        assert!((rate - 0.8).abs() < 0.08, "coverage {rate}");
+        // Plain prior draws would give an ESS of about 2000 * 2 pi 0.03^2, about 11.
+        assert!(ess_total / trials as f64 > 100.0, "mean ESS {}", ess_total / trials as f64);
+    }
+}
