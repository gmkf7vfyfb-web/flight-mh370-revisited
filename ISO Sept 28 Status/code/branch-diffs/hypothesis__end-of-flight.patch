index 0000000..4499ac6
--- /dev/null
+++ b/hypotheses/end-of-flight/sampling.rs
@@ -0,0 +1,118 @@
+//! Gamma-distribution helpers for the log-on lag (no statistics crate is available to a
+//! hypothesis).
+
+use std::f64::consts::PI;
+
+/// ln Gamma(x), Lanczos approximation (g = 7, 9 terms; relative error below 1e-13).
+pub fn ln_gamma(x: f64) -> f64 {
+    const C: [f64; 9] = [
+        0.999_999_999_999_809_9,
+        676.520_368_121_885_1,
+        -1_259.139_216_722_402_8,
+        771.323_428_777_653_1,
+        -176.615_029_162_140_6,
+        12.507_343_278_686_905,
+        -0.138_571_095_265_720_12,
+        9.984_369_578_019_572e-6,
+        1.505_632_735_149_311_6e-7,
+    ];
+    if x < 0.5 {
+        return (PI / (PI * x).sin()).ln() - ln_gamma(1.0 - x);
+    }
+    let x = x - 1.0;
+    let a = C[1..].iter().enumerate().fold(C[0], |a, (i, c)| a + c / (x + i as f64 + 1.0));
+    let t = x + 7.5;
+    0.5 * (2.0 * PI).ln() + (x + 0.5) * t.ln() - t + a.ln()
+}
+
+/// log density of Gamma(shape, scale) at x; minus infinity for x <= 0.
+pub fn gamma_log_pdf(x: f64, shape: f64, scale: f64) -> f64 {
+    if x <= 0.0 {
+        return f64::NEG_INFINITY;
+    }
+    (shape - 1.0) * x.ln() - x / scale - ln_gamma(shape) - shape * scale.ln()
+}
+
+/// Regularised lower incomplete gamma P(shape, x): series below shape + 1, Lentz continued
+/// fraction above.
+pub fn standard_gamma_cdf(shape: f64, x: f64) -> f64 {
+    if x <= 0.0 {
+        return 0.0;
+    }
+    let log_prefix = -x + shape * x.ln() - ln_gamma(shape);
+    if x < shape + 1.0 {
+        let (mut term, mut sum, mut a) = (1.0 / shape, 1.0 / shape, shape);
+        for _ in 0..1000 {
+            a += 1.0;
+            term *= x / a;
+            sum += term;
+            if term < sum * 1e-16 {
+                break;
+            }
+        }
+        (sum.ln() + log_prefix).exp()
+    } else {
+        let tiny = 1e-300;
+        let mut b = x + 1.0 - shape;
+        let (mut c, mut d) = (1.0 / tiny, 1.0 / b);
+        let mut h = d;
+        for i in 1..1000 {
+            let an = -(i as f64) * (i as f64 - shape);
+            b += 2.0;
+            d = an * d + b;
+            d = if d.abs() < tiny { tiny } else { d };
+            c = b + an / c;
+            c = if c.abs() < tiny { tiny } else { c };
+            d = 1.0 / d;
+            let delta = d * c;
+            h *= delta;
+            if (delta - 1.0).abs() < 1e-16 {
+                break;
+            }
+        }
+        1.0 - (h.ln() + log_prefix).exp()
+    }
+}
+
+/// x with P(shape, x) = u: Newton steps kept inside a shrinking bracket.
+pub fn standard_gamma_quantile(shape: f64, u: f64) -> f64 {
+    let (mut lo, mut hi) = (0.0, shape + 50.0 * shape.sqrt() + 50.0);
+    let mut x = shape;
+    for _ in 0..200 {
+        let f = standard_gamma_cdf(shape, x) - u;
+        if f.abs() < 1e-14 || hi - lo < 1e-13 * hi {
+            break;
+        }
+        if f > 0.0 {
+            hi = x;
+        } else {
+            lo = x;
+        }
+        let newton = x - f / gamma_log_pdf(x, shape, 1.0).exp();
+        x = if newton > lo && newton < hi { newton } else { 0.5 * (lo + hi) };
+    }
+    x
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn gamma_functions_match_closed_forms() {
+        // Gamma(n) = (n-1)!, Gamma(1/2) = sqrt(pi); the shape-1 gamma is the exponential.
+        assert!((ln_gamma(10.0) - 362_880f64.ln()).abs() < 1e-12);
+        assert!((ln_gamma(0.5) - PI.sqrt().ln()).abs() < 1e-12);
+        for x in [0.1, 1.0, 3.0, 20.0] {
+            assert!((standard_gamma_cdf(1.0, x) - (1.0 - (-x as f64).exp())).abs() < 1e-14);
+        }
+        // Shape 2: P = 1 - (1 + x) e^-x, on both sides of the series/fraction switch.
+        for x in [0.5, 2.9, 3.1, 12.0] {
+            assert!((standard_gamma_cdf(2.0, x) - (1.0 - (1.0 + x) * (-x as f64).exp())).abs() < 1e-14);
+        }
+        for (shape, u) in [(36.0, 0.5), (8.16, 0.01), (36.0, 0.999)] {
+            let x = standard_gamma_quantile(shape, u);
+            assert!((standard_gamma_cdf(shape, x) - u).abs() < 1e-12, "{shape} {u}");
+        }
+    }
+}
diff --git a/hypotheses/end-of-flight/timing.rs b/hypotheses/end-of-flight/timing.rs
new file mode 100644
index 0000000..9639da9
--- /dev/null
+++ b/hypotheses/end-of-flight/timing.rs
@@ -0,0 +1,167 @@
+//! Flame-out timing and the 00:19:29.416 log-on, the one observation this module consumes.
+//!
+//! Chain (ATSB 2015, AE-2014-054, pp. 9-10 and footnote 6): the second engine flames out,
+//! both AC transfer buses drop, the SDU loses power and the APU auto-starts; its generator
+//! comes on line after about 60 s; the SDU then needs about 60 s to request log-on. No
+//! scatter was published for either interval, so the lag L = A + S is a gamma density with a
+//! stated mean and standard deviation (defaults 120 s and 20 s). The archive's Erlang(8,
+//! 14.875 s) is the same family with sd 42 s and is kept as a sensitivity, not a default.
+
+use super::sampling::{gamma_log_pdf, standard_gamma_quantile};
+
+/// 2014-03-08 00:19:29.416 UTC: the R600 log-on request (ground-station log time).
+pub const LOGON_UNIX_S: f64 = 1_394_237_969.416;
+/// 2014-03-08 00:19:37.443 UTC: the R1200 log-on acknowledgement.
+pub const ACK_UNIX_S: f64 = 1_394_237_977.443;
+/// 2014-03-08 00:10:59 UTC: the last powered exchange and the core's hand-off.
+pub const HANDOFF_UNIX_S: f64 = 1_394_237_459.0;
+/// What caused the 00:19 log-on.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Cause {
+    /// Fuel exhaustion: the second flame-out cut the SDU's power and the APU restored it.
+    Exhaustion,
+    /// An unrelated interruption of the SDU's power (see `Logon`).
+    Other,
+}
+
+/// The log-on likelihood's inputs: the exhaustion lag, and the declared rate of other-cause
+/// log-ons. Those are a Poisson process in time: the density of the first after the 00:10:59
+/// hand-off, at the observed time, is rate * exp(-rate * elapsed). The rate is not known; it
+/// is swept (0.1, 0.3 and 1 per hour; this flight had one such log-on, at 18:25, in about
+/// seven hours) and the endings' evidence reported against it.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Logon {
+    pub lag: Lag,
+    pub other_per_hour: f64,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Lag {
+    pub mean_s: f64,
+    pub sd_s: f64,
+}
+
+impl Lag {
+    fn shape_scale(&self) -> (f64, f64) {
+        let shape = (self.mean_s / self.sd_s).powi(2);
+        (shape, self.mean_s / shape)
+    }
+
+    /// log density (per second) of observing the log-on `lag_s` after the second flame-out.
+    pub fn log_likelihood(&self, lag_s: f64) -> f64 {
+        let (shape, scale) = self.shape_scale();
+        gamma_log_pdf(lag_s, shape, scale)
+    }
+
+    /// The lag at probability `u`.
+    pub fn quantile(&self, u: f64) -> f64 {
+        let (shape, scale) = self.shape_scale();
+        scale * standard_gamma_quantile(shape, u)
+    }
+}
+
+/// The two flame-outs without fuel from the core. Prior: the second (total exhaustion) flat
+/// on [hand-off, log-on]; the right engine first by a gap flat on [0, min(max gap, second -
+/// hand-off)] (Rolls-Royce: its fuel consumption was slightly higher, SIR App. 1.6E; the core
+/// flies normal cruise to 00:11, so a single-engine phase before it is outside this model).
+///
+/// Sampling follows the terminal hook: the takeover draws the first flame-out flat on the
+/// window, and the descent draws the second given it from a unit coordinate. The two ln(p/q)
+/// shares, `first` and `second`, add up to the exact correction.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct FlameoutTimes {
+    pub max_gap_s: f64,
+}
+
+impl FlameoutTimes {
+    const WINDOW_S: f64 = LOGON_UNIX_S - HANDOFF_UNIX_S;
+
+    /// First flame-out and its share of ln(p/q): minus ln of its proposal density.
+    pub fn first(&self, u: f64) -> (f64, f64) {
+        (HANDOFF_UNIX_S + u * Self::WINDOW_S, Self::WINDOW_S.ln())
+    }
+
+    /// Second flame-out from the unit coordinate `u`, and its share of ln(p/q): the joint prior
+    /// density minus ln of the proposal density of the second given the first, for u uniform.
+    /// The caller adds -ln q(u) when u comes from an adapted proposal.
+    pub fn second(&self, first_unix_s: f64, u: f64) -> (f64, f64) {
+        let last = (first_unix_s + self.max_gap_s).min(LOGON_UNIX_S);
+        let second = first_unix_s + u * (last - first_unix_s);
+        let joint = -Self::WINDOW_S.ln() - self.max_gap_s.min(second - HANDOFF_UNIX_S).ln();
+        (second, joint + (last - first_unix_s).ln())
+    }
+}
+
+impl Logon {
+    /// log p(the 00:19:29.416 log-on and its 00:19:37.443 acknowledgement | a flight, cause),
+    /// per second of log-on time, on one absolute scale for both causes. Under both, no
+    /// other-cause log-on came between the hand-off and the observed one, and the aircraft was
+    /// still flying at the acknowledgement: a transmission cannot come from an aircraft that has
+    /// already struck the sea. Under exhaustion the time is the lag after the second flame-out;
+    /// otherwise it is the other-cause rate.
+    pub fn log_likelihood(&self, cause: Cause, second_unix_s: f64, impact_unix_s: Option<f64>) -> f64 {
+        let rate = self.other_per_hour / 3600.0;
+        let quiet = -rate * (LOGON_UNIX_S - HANDOFF_UNIX_S);
+        match (impact_unix_s, cause) {
+            (Some(t), _) if t < ACK_UNIX_S => f64::NEG_INFINITY,
+            (_, Cause::Exhaustion) => self.lag.log_likelihood(LOGON_UNIX_S - second_unix_s) + quiet,
+            (_, Cause::Other) => rate.ln() + quiet,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn lag_density_is_a_normalised_gamma_with_the_stated_moments() {
+        let lag = Lag { mean_s: 120.0, sd_s: 20.0 };
+        let (mut mass, mut mean, mut var) = (0.0, 0.0, 0.0);
+        let dx = 0.01;
+        for i in 1..40_000 {
+            let x = i as f64 * dx;
+            let p = lag.log_likelihood(x).exp() * dx;
+            mass += p;
+            mean += p * x;
+            var += p * (x - 120.0).powi(2);
+        }
+        assert!((mass - 1.0).abs() < 1e-6, "{mass}");
+        assert!((mean - 120.0).abs() < 1e-3, "{mean}");
+        assert!((var.sqrt() - 20.0).abs() < 1e-3, "{}", var.sqrt());
+        assert!((lag.quantile(0.5) - 118.89).abs() < 0.05, "{}", lag.quantile(0.5));
+        // Other cause: the first-event density of a Poisson process, which integrates to one
+        // over the log-on time (here checked in closed form at the observed time).
+        let logon = Logon { lag, other_per_hour: 0.3 };
+        let rate: f64 = 0.3 / 3600.0;
+        let other = logon.log_likelihood(Cause::Other, LOGON_UNIX_S - 120.0, None);
+        assert!((other - (rate.ln() - rate * (LOGON_UNIX_S - HANDOFF_UNIX_S))).abs() < 1e-12);
+        let late = logon.log_likelihood(Cause::Exhaustion, LOGON_UNIX_S - 120.0, Some(ACK_UNIX_S - 1.0));
+        assert_eq!(late, f64::NEG_INFINITY);
+    }
+
+    /// The two-step draw (first flat, second given first) with its ln(p/q) reproduces the
+    /// prior: the second flame-out flat over the window and the gap never above its maximum.
+    #[test]
+    fn two_step_draw_reproduces_the_flat_prior() {
+        let times = FlameoutTimes { max_gap_s: 900.0 };
+        let (mut seed, n, bins) = (0x9E37_79B9_7F4A_7C15_u64, 400_000, 10);
+        let mut uniform = || {
+            seed ^= seed << 13;
+            seed ^= seed >> 7;
+            seed ^= seed << 17;
+            (seed >> 11) as f64 / (1u64 << 53) as f64
+        };
+        let mut mass = vec![0.0; bins];
+        for _ in 0..n {
+            let (first, a) = times.first(uniform());
+            let (second, b) = times.second(first, uniform());
+            assert!(second - first <= 900.0 + 1e-9 && second <= LOGON_UNIX_S);
+            let bin = ((second - HANDOFF_UNIX_S) / (LOGON_UNIX_S - HANDOFF_UNIX_S) * bins as f64) as usize;
+            mass[bin.min(bins - 1)] += (a + b).exp() / n as f64;
+        }
+        for m in &mass {
+            assert!((m * bins as f64 - 1.0).abs() < 0.02, "{mass:?}");
+        }
+    }
+}
