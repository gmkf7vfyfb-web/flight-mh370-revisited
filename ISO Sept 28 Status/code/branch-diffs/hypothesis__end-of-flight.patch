+++ b/hypotheses/end-of-flight/descent.rs
@@ -0,0 +1,187 @@
+//! One descent from the takeover to the sea: after a flame-out, the autopilot's single-engine
+//! phase and then a family's flight from the second flame-out; before exhaustion, a powered
+//! family's flight from the start of the powered descent.
+//!
+//! Single-engine phase (the right engine fails first; Boeing's long runs): the autopilot holds
+//! altitude and heading with the left engine at maximum continuous thrust; once the speed has
+//! decayed to its floor it holds that speed and lets the aircraft drift down.
+
+use super::aero::Increments;
+use super::endings::{Ending, Takeover};
+use super::families::{Family, Start, POWERED, REFERENCE_MASS_KG};
+use super::flight::{Aircraft, Envelope, Flight, Phase, Pitch, Roll, Snapshot, State, FT};
+use super::timing::{ACK_UNIX_S, LOGON_UNIX_S};
+#[cfg(test)]
+use super::{aero::B772, flight::StillIsa};
+
+const KT: f64 = 1852.0 / 3600.0;
+/// Operating limits for `envelope_exceedance`: MMO 0.87 and VMO 330 kt (777-200ER; VMO is a
+/// calibrated airspeed, compared here with the equivalent airspeed, slightly lenient at
+/// altitude) and the 2.5 g limit manoeuvring load (14 CFR 25.337). The design dive limits and
+/// the ultimate load lie beyond them and are not public, so exceeding these is where breakup
+/// becomes possible, not where it happens.
+const MMO: f64 = 0.87;
+const VMO_KT: f64 = 330.0;
+const LIMIT_LOAD_FACTOR: f64 = 2.5;
+/// Autopilot speed floor with one engine out, at the reference mass (Boeing's long runs reach
+/// the second flame-out at 157-165 KEAS).
+const AUTOPILOT_FLOOR_KEAS: f64 = 165.0;
+/// Longest flight after the second flame-out before the descent is reported as not ending.
+const MAX_FLIGHT_S: f64 = 3.0 * 3600.0;
+
+#[derive(Debug, Clone)]
+pub struct Descent {
+    pub ending: Ending,
+    pub family: Family,
+    pub first_unix_s: f64,
+    pub second_unix_s: f64,
+    pub at_second: Snapshot,
+    /// From the second flame-out: impact, states at the requested epochs, envelope.
+    pub flight: Flight,
+    pub single_engine: Envelope,
+    /// Control lost at the first flame-out, in an electrical configuration where one engine's
+    /// loss takes the autopilot (stick-fixed family); otherwise the autopilot flies on one engine.
+    pub autopilot_lost_at_first: bool,
+}
+
+/// What each descent records besides its impact, in `Descent::latents` order. Attitude (deg) at
+/// the 00:19 log-on and acknowledgement where this module flew them (NaN where the core did or
+/// the aircraft was down) and at impact; pitch and angle of attack come from an assumed
+/// lift-curve slope (`aero`). The envelope covers the single-engine phase too.
+pub const LATENT_COLUMNS: [&str; 17] = [
+    "second_flameout_unix_s",
+    "autopilot_lost_at_first_flameout",
+    "bank_deg_logon",
+    "pitch_deg_logon",
+    "bank_deg_ack",
+    "pitch_deg_ack",
+    "bank_deg_impact",
+    "pitch_deg_impact",
+    "alpha_deg_impact",
+    "max_mach",
+    "max_keas",
+    "max_descent_fpm",
+    "max_load_factor",
+    "extrapolated_s",
+    "above_grid_s",
+    "stalled_s",
+    "envelope_exceedance",
+];
+
+impl Descent {
+    /// A powered impact must come before exhaustion; every other ending is unpowered by then.
+    pub fn powered_in_time(&self) -> bool {
+        !POWERED.contains(&self.family) || self.flight.impact.is_some_and(|i| i.unix_s <= self.second_unix_s)
+    }
+
+    /// The `LATENT_COLUMNS`, given the epochs passed to `descend`. For a powered impact the
+    /// second flame-out is the exhaustion it came before, and the autopilot column is NaN.
+    pub fn latents(&self, epochs: &[f64]) -> Vec<f64> {
+        let at = |t: f64| epochs.iter().position(|&e| (e - t).abs() < 1e-3).and_then(|i| self.flight.epochs[i]);
+        let attitude = |s: Option<Snapshot>| s.map_or([f64::NAN; 3], |s| [s.bank, s.pitch, s.alpha].map(f64::to_degrees));
+        let (logon, ack, impact) = (attitude(at(LOGON_UNIX_S)), attitude(at(ACK_UNIX_S)), attitude(self.flight.impact));
+        let (e, s) = (self.flight.envelope, self.single_engine);
+        let max_mach = e.max_mach.max(s.max_mach);
+        let max_keas = e.max_eas.max(s.max_eas) / KT;
+        let max_load_factor = e.max_load_factor.max(s.max_load_factor);
+        let autopilot = if POWERED.contains(&self.family) { f64::NAN } else { f64::from(u8::from(self.autopilot_lost_at_first)) };
+        vec![
+            self.second_unix_s,
+            autopilot,
+            logon[0],
+            logon[1],
+            ack[0],
+            ack[1],
+            impact[0],
+            impact[1],
+            impact[2],
+            max_mach,
+            max_keas,
+            e.max_descent.max(s.max_descent) / FT * 60.0,
+            max_load_factor,
+            e.extrapolated_s + s.extrapolated_s,
+            e.above_grid_s + s.above_grid_s,
+            e.stalled_s + s.stalled_s,
+            (max_mach / MMO).max(max_keas / VMO_KT).max(max_load_factor / LIMIT_LOAD_FACTOR),
+        ]
+    }
+}
+
+/// The autopilot on one engine from the first flame-out: one windmilling engine, no ram-air
+/// turbine yet.
+pub fn single_engine_phase(aircraft: &Aircraft, first: &State) -> Phase {
+    Phase {
+        pitch: Pitch::AltitudeHold { alt_m: first.alt_m, floor_eas: AUTOPILOT_FLOOR_KEAS * KT * (aircraft.mass_kg / REFERENCE_MASS_KG).sqrt() },
+        roll: Roll::Heading { target: first.heading, max_bank: 25f64.to_radians() },
+        thrust: 1.0,
+        increments: Increments { windmill_cd: 0.001, transonic_scale: 1.0, separation_k: 1.4 },
+    }
+}
+
+/// From the takeover state to the sea. After a flame-out the autopilot flies the single-engine
+/// phase to the second flame-out, unless the family takes over at the first; a powered family
+/// starts at once. For a powered family `second_unix_s` in the takeover is the exhaustion time
+/// that its impact must precede (`Descent::powered_in_time`).
+pub fn descend(aircraft: &Aircraft, first: State, takeover: &Takeover, family: Family, u: &[f64], epochs: &[f64], dt: f64) -> Descent {
+    let second_unix_s = takeover.second_unix_s;
+    let powered = POWERED.contains(&family);
+    let autopilot_lost_at_first = family.from_first(u);
+    let (start, single_engine) = if powered || autopilot_lost_at_first {
+        (first, Envelope::default())
+    } else {
+        let single = single_engine_phase(aircraft, &first);
+        let before = aircraft.fly(first, &[(first.unix_s, single)], &[], second_unix_s, dt, None);
+        (before.last, before.envelope)
+    };
+    let (eas, mach, q) = aircraft.airspeeds(&start);
+    let at = Start {
+        unix_s: start.unix_s,
+        second_unix_s,
+        eas,
+        cl_1g: aircraft.mass_kg * super::aero::G * start.gamma.cos() / (q * aircraft.aero.wing_area_m2()),
+        mach,
+        heading: start.heading,
+        mass_kg: aircraft.mass_kg,
+        single_engine_s: start.unix_s - first.unix_s,
+    };
+    let phases = family.phases(u, &at);
+    // When the family starts before the second flame-out, record the state there too.
+    let mut all_epochs = epochs.to_vec();
+    let later = !powered && start.unix_s < second_unix_s;
+    if later {
+        all_epochs.push(second_unix_s);
+    }
+    let mut flight = aircraft.fly(start, &phases, &all_epochs, start.unix_s + MAX_FLIGHT_S, dt, None);
+    let at_second = if later { flight.epochs.pop().flatten() } else { Some(aircraft.snapshot(&start, None)) };
+    Descent {
+        ending: takeover.ending,
+        family,
+        first_unix_s: first.unix_s,
+        second_unix_s,
+        // Down before the second flame-out: the impact stands in for it.
+        at_second: at_second.or(flight.impact).unwrap_or_else(|| aircraft.snapshot(&flight.last, None)),
+        flight,
+        single_engine,
+        autopilot_lost_at_first,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// With no gap between the flame-outs, losing control at the first flame-out and at the
+    /// second are the same flight.
+    #[test]
+    fn control_lost_at_either_flame_out_agrees_when_they_coincide() {
+        let aircraft = Aircraft { aero: &B772, mass_kg: REFERENCE_MASS_KG, weather: &StillIsa, stall_factor: 1.5, protected_factor: 1.15 };
+        let first = State { unix_s: 0.0, lat_deg: -35.0, lon_deg: 90.0, alt_m: 11_000.0, tas: 240.0, gamma: 0.0, heading: 3.3, bank: 0.0, sensed_eas: f64::NAN, reference_eas: f64::NAN };
+        let mut u = [0.4, 0.6, 0.3, 0.8, 0.5, 0.5, 0.5, 0.25, 0.7, 0.6];
+        let takeover = Takeover { ending: Ending::ExhaustedBeforeLogon, unix_s: 0.0, second_unix_s: 0.0 };
+        let a = descend(&aircraft, first, &takeover, Family::StickFixed, &u, &[], 0.5);
+        u[7] = 0.75;
+        let b = descend(&aircraft, first, &takeover, Family::StickFixed, &u, &[], 0.5);
+        assert_eq!(a.flight.impact, b.flight.impact);
+        assert!(a.flight.impact.is_some());
+    }
+}
diff --git a/hypotheses/end-of-flight/endings.rs b/hypotheses/end-of-flight/endings.rs
new file mode 100644
index 0000000..9e7415c
--- /dev/null
+++ b/hypotheses/end-of-flight/endings.rs
@@ -0,0 +1,244 @@
+//! How the flight ended, relative to fuel exhaustion and the 00:19 log-on: the hypotheses above
+//! the descent families (Pete, 28 Sep 2026). Exhaustion causing the log-on is one hypothesis,
+//! not an axiom.
+//!
+//! - `exhausted-before-logon`: both engines flamed out before 00:19:29.416 and the log-on is the
+//!   APU restoring the SDU's power (lag density). The takeover is the first flame-out.
+//! - `exhausted-after-logon`: powered through 00:19, the SDU's power interrupted by something
+//!   else; exhaustion later, then an unpowered descent. The takeover is the first flame-out,
+//!   before or after the 00:19 epochs.
+//! - `powered-impact`: the aircraft reached the sea with engines running, before exhaustion.
+//!   The takeover is the start of the powered descent.
+//! Under the last two the log-on comes at a declared other-cause rate (`timing::Logon`, swept);
+//! under all three the aircraft was still flying at 00:19:37.443.
+//!
+//! Until the core models fuel, exhaustion after the log-on, and a powered impact, are bounded by
+//! a PLACEHOLDER window ending at 01:16:05: the longest endurance in Boeing's Table 4 (SIR App.
+//! 1.6E), 6.8 h from arc 1 at 18:28:05.9. With the core's fuel state, each path's own exhaustion
+//! time replaces it (`with_fuel`).
+//!
+//! Sampling follows the terminal hook, which passes nothing from the takeover draw to the
+//! descent: the takeover draws its time from a mixture over the endings; the descent draws the
+//! ending given that time with probability proportional to its share of the mixture density,
+//! then the second flame-out given the takeover. The ln(prior/proposal) shares add up exactly.
+
+use super::timing::{Cause, Logon, ACK_UNIX_S, HANDOFF_UNIX_S, LOGON_UNIX_S};
+
+/// Placeholder end of any powered flight until the core models fuel (01:16:05 UTC).
+pub const PLACEHOLDER_LATEST_UNIX_S: f64 = 1_394_241_365.0;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Ending {
+    ExhaustedBeforeLogon,
+    ExhaustedAfterLogon,
+    PoweredImpact,
+}
+
+pub const ENDINGS: [Ending; 3] = [Ending::ExhaustedBeforeLogon, Ending::ExhaustedAfterLogon, Ending::PoweredImpact];
+
+impl Ending {
+    pub fn name(self) -> &'static str {
+        match self {
+            Ending::ExhaustedBeforeLogon => "exhausted-before-logon",
+            Ending::ExhaustedAfterLogon => "exhausted-after-logon",
+            Ending::PoweredImpact => "powered-impact",
+        }
+    }
+
+    fn index(self) -> usize {
+        ENDINGS.iter().position(|&e| e == self).unwrap()
+    }
+
+    /// What caused the SDU's power interruption behind the 00:19 log-on.
+    pub fn cause(self) -> Cause {
+        if self == Ending::ExhaustedBeforeLogon { Cause::Exhaustion } else { Cause::Other }
+    }
+}
+
+/// Endings' prior weights and timing. `exhaustion_unix_s` is the path's exhaustion time from
+/// the core's fuel state, NaN until the core models fuel.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Timing {
+    pub priors: [f64; 3],
+    pub max_gap_s: f64,
+    pub exhaustion_unix_s: f64,
+}
+
+/// The takeover and what the descent needs of it.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Takeover {
+    pub ending: Ending,
+    pub unix_s: f64,
+    /// The second flame-out; for a powered impact, the (placeholder or fuel) exhaustion time
+    /// that bounds it.
+    pub second_unix_s: f64,
+}
+
+impl Timing {
+    fn latest(&self) -> f64 {
+        if self.exhaustion_unix_s.is_finite() { self.exhaustion_unix_s } else { PLACEHOLDER_LATEST_UNIX_S }
+    }
+
+    /// The ending's window for the takeover time, if the ending is possible. With a fuel
+    /// exhaustion time, the takeover is the first flame-out, a flat gap before it; exhaustion
+    /// must precede the log-on for the first ending and follow the acknowledgement for the
+    /// second (the SDU loses power within seconds of the second flame-out).
+    fn window(&self, e: Ending) -> Option<(f64, f64)> {
+        let fuel = self.exhaustion_unix_s;
+        let (lo, hi) = match e {
+            Ending::ExhaustedBeforeLogon | Ending::ExhaustedAfterLogon if fuel.is_finite() => {
+                let possible = if e == Ending::ExhaustedBeforeLogon { fuel < LOGON_UNIX_S } else { fuel > ACK_UNIX_S };
+                if !possible {
+                    return None;
+                }
+                ((fuel - self.max_gap_s).max(HANDOFF_UNIX_S), fuel)
+            }
+            Ending::ExhaustedBeforeLogon => (HANDOFF_UNIX_S, LOGON_UNIX_S),
+            Ending::ExhaustedAfterLogon => ((ACK_UNIX_S - self.max_gap_s).max(HANDOFF_UNIX_S), self.latest()),
+            Ending::PoweredImpact => (HANDOFF_UNIX_S, self.latest()),
+        };
+        (hi > lo && self.priors[e.index()] > 0.0).then_some((lo, hi))
+    }
+
+    /// Mixture density of the takeover time.
+    fn density(&self, t: f64) -> f64 {
+        ENDINGS
+            .iter()
+            .filter_map(|&e| self.window(e).map(|(lo, hi)| if t >= lo && t <= hi { self.priors[e.index()] / (hi - lo) } else { 0.0 }))
+            .sum::<f64>()
+            / self.total()
+    }
+
+    fn total(&self) -> f64 {
+        ENDINGS.iter().filter(|&&e| self.window(e).is_some()).map(|&e| self.priors[e.index()]).sum()
+    }
+
+    /// Takeover time from two uniforms, and its share of ln(prior/proposal).
+    pub fn takeover_time(&self, pick: f64, u: f64) -> (f64, f64) {
+        let total = self.total();
+        let mut cum = 0.0;
+        for &e in &ENDINGS {
+            if let Some((lo, hi)) = self.window(e) {
+                cum += self.priors[e.index()] / total;
+                if pick < cum || cum >= 1.0 - 1e-12 {
+                    let t = lo + u * (hi - lo);
+                    return (t, -self.density(t).ln());
+                }
+            }
+        }
+        unreachable!("no ending is possible")
+    }
+
+    /// Given the takeover time, the ending (by its share of the mixture density at that time)
+    /// and the second flame-out from two uniforms; and the rest of ln(prior/proposal), for `u`
+    /// uniform (the caller adds -ln q(u) when `u` comes from an adapted proposal).
+    pub fn takeover(&self, t: f64, pick: f64, u: f64) -> (Takeover, f64) {
+        let q = self.density(t);
+        let mut cum = 0.0;
+        let mut chosen = None;
+        for &e in &ENDINGS {
+            if let Some((lo, hi)) = self.window(e) {
+                if t >= lo && t <= hi {
+                    cum += self.priors[e.index()] / (hi - lo) / self.total() / q;
+                    if chosen.is_none() && (pick < cum || cum >= 1.0 - 1e-12) {
+                        chosen = Some((e, lo, hi));
+                    }
+                }
+            }
+        }
+        let (ending, lo, hi) = chosen.expect("the takeover time lies in some ending's window");
+        let prior = self.priors[ending.index()] / self.total();
+        // ln(prior / proposal) of the ending and its takeover time, given the mixture draw:
+        // prior P(e) p_e(t, ...) against P(e) q_e(t) / q(t) q(e | t); q(t) comes back from the
+        // takeover's share.
+        let q_e = 1.0 / (hi - lo);
+        let fuel = self.exhaustion_unix_s.is_finite();
+        let (second, prior_density, proposal_density) = match ending {
+            Ending::PoweredImpact => (self.latest(), 1.0 / (self.latest() - HANDOFF_UNIX_S), q_e),
+            _ if fuel => {
+                // The second flame-out is the path's exhaustion; the gap is flat on its range.
+                (self.exhaustion_unix_s, 1.0 / self.max_gap_s.min(self.exhaustion_unix_s - HANDOFF_UNIX_S), q_e)
+            }
+            _ => {
+                let (first_lo, last) = match ending {
+                    Ending::ExhaustedBeforeLogon => (t, (t + self.max_gap_s).min(LOGON_UNIX_S)),
+                    _ => (t.max(ACK_UNIX_S), (t + self.max_gap_s).min(self.latest())),
+                };
+                let second = first_lo + u * (last - first_lo);
+                let window = match ending {
+                    Ending::ExhaustedBeforeLogon => LOGON_UNIX_S - HANDOFF_UNIX_S,
+                    _ => self.latest() - ACK_UNIX_S,
+                };
+                let joint = 1.0 / window / self.max_gap_s.min(second - HANDOFF_UNIX_S);
+                (second, joint, q_e / (last - first_lo))
+            }
+        };
+        let log_correction = prior.ln() + prior_density.ln() - (prior * proposal_density).ln() + q.ln();
+        (Takeover { ending, unix_s: t, second_unix_s: second }, log_correction)
+    }
+
+    /// log p(log-on data | ending, flight), per second of log-on time.
+    pub fn logon_log_likelihood(&self, logon: &Logon, takeover: &Takeover, impact_unix_s: Option<f64>) -> f64 {
+        logon.log_likelihood(takeover.ending.cause(), takeover.second_unix_s, impact_unix_s)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Weighted draws reproduce the prior: each ending's share, and for the two exhaustion
+    /// endings a flat second flame-out over its window (placeholder, no fuel).
+    #[test]
+    fn mixture_draws_reproduce_the_prior() {
+        let timing = Timing { priors: [1.0, 1.0, 1.0], max_gap_s: 900.0, exhaustion_unix_s: f64::NAN };
+        let mut seed = 0x1234_5678_u64;
+        let mut uniform = move || {
+            seed = seed.wrapping_add(0x9E37_79B9_7F4A_7C15);
+            let mut z = seed;
+            z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+            z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+            (((z ^ (z >> 31)) >> 11) as f64 + 0.5) / (1u64 << 53) as f64
+        };
+        let n = 600_000;
+        let (mut share, mut before, mut after) = ([0.0; 3], [0.0; 5], [0.0; 5]);
+        for _ in 0..n {
+            let (t, a) = timing.takeover_time(uniform(), uniform());
+            let (tk, b) = timing.takeover(t, uniform(), uniform());
+            let w = (a + b).exp() / n as f64;
+            share[tk.ending.index()] += w;
+            let bin = |lo: f64, hi: f64| (((tk.second_unix_s - lo) / (hi - lo)) * 5.0).clamp(0.0, 4.0) as usize;
+            match tk.ending {
+                Ending::ExhaustedBeforeLogon => before[bin(HANDOFF_UNIX_S, LOGON_UNIX_S)] += w,
+                Ending::ExhaustedAfterLogon => after[bin(ACK_UNIX_S, PLACEHOLDER_LATEST_UNIX_S)] += w,
+                Ending::PoweredImpact => assert_eq!(tk.second_unix_s, PLACEHOLDER_LATEST_UNIX_S),
+            }
+        }
+        for s in share {
+            assert!((s - 1.0 / 3.0).abs() < 0.01, "{share:?}");
+        }
+        for b in before.iter().chain(&after) {
+            assert!((b * 15.0 - 1.0).abs() < 0.05, "{before:?} {after:?}");
+        }
+        // With a fuel exhaustion time before the log-on, only two endings remain, the second
+        // flame-out is the exhaustion and the first is flat over the possible gap before it.
+        let fuel = LOGON_UNIX_S - 150.0;
+        let timing = Timing { exhaustion_unix_s: fuel, ..timing };
+        let (mut share, mut first) = ([0.0; 3], [0.0; 5]);
+        for _ in 0..n {
+            let (t, a) = timing.takeover_time(uniform(), uniform());
+            let (tk, b) = timing.takeover(t, uniform(), uniform());
+            let w = (a + b).exp() / n as f64;
+            share[tk.ending.index()] += w;
+            if tk.ending == Ending::ExhaustedBeforeLogon {
+                assert_eq!(tk.second_unix_s, fuel);
+                // The gap cannot exceed the time since the hand-off (360 s here).
+                first[(((fuel - t) / (fuel - HANDOFF_UNIX_S).min(900.0)) * 5.0).clamp(0.0, 4.0) as usize] += w;
+            }
+        }
+        assert!((share[0] - 0.5).abs() < 0.01 && share[1] == 0.0 && (share[2] - 0.5).abs() < 0.01, "{share:?}");
+        for f in first {
+            assert!((f * 10.0 - 1.0).abs() < 0.05, "{first:?}");
+        }
+    }
+}
diff --git a/hypotheses/end-of-flight/families.rs b/hypotheses/end-of-flight/families.rs
new file mode 100644
index 0000000..27c3bcb
--- /dev/null
+++ b/hypotheses/end-of-flight/families.rs
@@ -0,0 +1,232 @@
+//! What happened after the second flame-out, as families of flight plans.
+//!
+//! Each family maps independent uniforms to the flight from the second flame-out, so its
+//! parameter prior is uniform on its unit cube and any proposal can be corrected exactly.
+//! Family prior weights are declared in run.toml; results are always shown per family.
+//! Nobody is assumed to have flown the aircraft, nor assumed not to have.
+//!
+//! Unpiloted, with the residual asymmetry an explicit input:
+//! - `normal-law`: pitch as in Boeing's six long runs (speed stability about a reference
+//!   moving to a floor, sensed through a lag) with bank-angle protection. The asymmetry is the
+//!   rudder that thrust-asymmetry compensation leaves behind when the second engine spools
+//!   down after a single-engine phase (Boeing 2014, SIR App. 1.6E: about 0.2 deg, a slow left
+//!   roll), plus a trim asymmetry either way.
+//! - `stick-fixed`: no protections; Mach tuck, trim offset and a divergent spiral in either
+//!   direction, bounded by Boeing's four short runs. Control is lost at the second flame-out, or
+//!   at the first in an electrical configuration where one engine's loss takes the autopilot
+//!   (ATSB 2016, the short runs): then the other engine runs on, uncompensated, until the second.
+//! Piloted:
+//! - `glide`: wings level at a chosen speed, with up to two turns to any heading, into the sea.
+//! - `ditching`: the same at a lower speed, flared to a low sink rate.
+//! - `dive`: a push-over to a chosen flight-path angle after a delay.
+//!
+//! The families above follow a flame-out. Before exhaustion, with engines running (the
+//! `powered-impact` ending), from the start of the powered descent:
+//! - `powered-upset` (unpiloted): control lost with thrust set, stick-fixed as above.
+//! - `powered-dive`, `powered-descent` (a held flight-path angle, with up to two turns, into the
+//!   sea) and `powered-ditching` (flared) (piloted).
+//! Running engines windmill no drag. Within each ending, piloted and unpiloted families share
+//! the prior equally, each half split evenly among its families.
+
+use super::aero::Increments;
+use super::flight::{Phase, Pitch, Roll};
+
+const KT: f64 = 1852.0 / 3600.0;
+const FT: f64 = 0.3048;
+/// Speeds below are for this mass and scale with the square root of the actual mass.
+pub const REFERENCE_MASS_KG: f64 = 174_500.0;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Family {
+    NormalLaw,
+    StickFixed,
+    Glide,
+    Ditching,
+    Dive,
+    PoweredUpset,
+    PoweredDive,
+    PoweredDescent,
+    PoweredDitching,
+}
+
+/// After a flame-out.
+pub const UNPOWERED: [Family; 5] = [Family::NormalLaw, Family::StickFixed, Family::Glide, Family::Ditching, Family::Dive];
+/// Before exhaustion, engines running.
+pub const POWERED: [Family; 4] = [Family::PoweredUpset, Family::PoweredDive, Family::PoweredDescent, Family::PoweredDitching];
+
+/// The aircraft where the family's flight starts (the second flame-out, or the first for a
+/// family that takes over there), as the families need it.
+#[derive(Debug, Clone, Copy)]
+pub struct Start {
+    pub unix_s: f64,
+    pub second_unix_s: f64,
+    pub eas: f64,
+    /// Lift coefficient for one g at the current speed and flight-path angle.
+    pub cl_1g: f64,
+    pub mach: f64,
+    pub heading: f64,
+    pub mass_kg: f64,
+    /// Length of the autopilot's single-engine phase before it (s).
+    pub single_engine_s: f64,
+}
+
+fn lerp(u: f64, a: f64, b: f64) -> f64 {
+    a + u * (b - a)
+}
+
+/// Log-uniform between a and b.
+fn log_lerp(u: f64, a: f64, b: f64) -> f64 {
+    (a.ln() + u * (b.ln() - a.ln())).exp()
+}
+
+impl Family {
+    pub fn name(self) -> &'static str {
+        match self {
+            Family::NormalLaw => "normal-law",
+            Family::StickFixed => "stick-fixed",
+            Family::Glide => "glide",
+            Family::Ditching => "ditching",
+            Family::Dive => "dive",
+            Family::PoweredUpset => "powered-upset",
+            Family::PoweredDive => "powered-dive",
+            Family::PoweredDescent => "powered-descent",
+            Family::PoweredDitching => "powered-ditching",
+        }
+    }
+
+    pub fn piloted(self) -> bool {
+        !matches!(self, Family::NormalLaw | Family::StickFixed | Family::PoweredUpset)
+    }
+
+    /// Prior weight within its set (`UNPOWERED` or `POWERED`): piloted and unpiloted halves,
+    /// each split evenly.
+    pub fn prior_within(self, set: &[Family]) -> f64 {
+        let alike = set.iter().filter(|f| f.piloted() == self.piloted()).count();
+        0.5 / alike as f64
+    }
+
+    /// Number of uniform coordinates the family consumes.
+    pub fn dimension(self) -> usize {
+        match self {
+            Family::StickFixed => 10,
+            Family::NormalLaw | Family::Glide | Family::PoweredUpset | Family::PoweredDescent => 7,
+            Family::Ditching | Family::PoweredDitching => 9,
+            Family::Dive => 6,
+            Family::PoweredDive => 5,
+        }
+    }
+
+    /// Whether the family's flight starts at the first flame-out instead of the second.
+    pub fn from_first(self, u: &[f64]) -> bool {
+        self == Family::StickFixed && u[7] < 0.5
+    }
+
+    /// Phases from `at`, from `dimension()` uniforms.
+    pub fn phases(self, u: &[f64], at: &Start) -> Vec<(f64, Phase)> {
+        assert_eq!(u.len(), self.dimension());
+        let speed = |kt: f64| kt * KT * (at.mass_kg / REFERENCE_MASS_KG).sqrt();
+        let t0 = at.unix_s;
+        // Windmilling engines and ram-air turbine: Boeing's driftdown figure (read as a steady
+        // glide from FL350) and the long simulator spirals both give about 0.004 (calibrate.rs).
+        let increments = |u: f64, transonic_scale: f64| Increments { windmill_cd: lerp(u, 0.0025, 0.0055), transonic_scale, separation_k: 1.4 };
+        let running = |transonic_scale: f64| Increments { windmill_cd: 0.0, transonic_scale, separation_k: 1.4 };
+        let pilot_speed = |ref_eas: f64| Pitch::Speed { ref_eas, ref_tau_s: 20.0, stiffness: 2.0, damping: 1.0, lag_s: 0.0 };
+        let turns = |n: f64, times: [f64; 2], headings: [f64; 2], max_bank: f64| {
+            let count = (3.0 * n).floor().min(2.0) as usize;
+            let mut t: Vec<(f64, f64)> = (0..count).map(|i| (t0 + lerp(times[i], 0.0, 1200.0), lerp(headings[i], 0.0, std::f64::consts::TAU))).collect();
+            t.sort_by(|a, b| a.0.total_cmp(&b.0));
+            let mut rolls = vec![(t0, Roll::Heading { target: at.heading, max_bank })];
+            rolls.extend(t.into_iter().map(|(time, target)| (time, Roll::Heading { target, max_bank })));
+            rolls
+        };
+        match self {
+            Family::NormalLaw => {
+                let tac = if at.single_engine_s > 30.0 { -lerp(u[0], 0.0, 1.0) } else { 0.0 };
+                let turn_rate = (tac + lerp(u[1], -0.3, 0.3)).to_radians();
+                let floor = speed(lerp(u[4], 185.0, 205.0));
+                vec![(t0, Phase {
+                    pitch: Pitch::Speed { ref_eas: at.eas.max(floor), ref_tau_s: lerp(u[5], 30.0, 120.0), stiffness: 0.8, damping: 0.0, lag_s: lerp(u[3], 0.7, 1.0) },
+                    roll: Roll::Asymmetry { turn_rate, spiral: -1.0 / lerp(u[2], 40.0, 90.0), protect: true, max_bank: 1.5 },
+                    thrust: 0.0,
+                    increments: increments(u[6], 1.0),
+                })]
+            }
+            Family::StickFixed => {
+                let pitch = Pitch::Trim { cl_trim: (1.0 - lerp(u[1], -0.05, 0.1)) * at.cl_1g, mach_trim: at.mach, tuck: lerp(u[0], 1.0, 3.5) };
+                let (turn, spiral, max_bank) = (lerp(u[3], -1.2, 1.2), 1.0 / lerp(u[2], 40.0, 150.0), lerp(u[4], 45.0, 75.0).to_radians());
+                let increments = increments(u[6], log_lerp(u[5], 0.3, 2.0));
+                let roll = |turn_deg_s: f64| Roll::Asymmetry { turn_rate: turn_deg_s.to_radians(), spiral, protect: false, max_bank };
+                let unpowered = Phase { pitch, roll: roll(turn), thrust: 0.0, increments };
+                if self.from_first(u) {
+                    // The running engine's thrust, uncompensated, rolls the aircraft hard in the
+                    // same direction; one engine windmills and the ram-air turbine is stowed.
+                    let one_engine = Phase {
+                        pitch,
+                        roll: roll(turn.signum() * lerp(u[9], 0.5, 2.5)),
+                        thrust: lerp(u[8], 0.5, 1.0),
+                        increments: Increments { windmill_cd: 0.001, ..increments },
+                    };
+                    vec![(t0, one_engine), (at.second_unix_s, unpowered)]
+                } else {
+                    vec![(t0, unpowered)]
+                }
+            }
+            Family::Glide | Family::Ditching => {
+                let pitch = if self == Family::Glide {
+                    pilot_speed(speed(lerp(u[0], 195.0, 260.0)))
+                } else {
+                    Pitch::Ditch { ref_eas: speed(lerp(u[0], 165.0, 200.0)), flare_alt_m: lerp(u[6], 30.0, 150.0) * FT, touchdown_vs: lerp(u[7], -4.0, -0.5) }
+                };
+                let increments = increments(if self == Family::Glide { u[6] } else { u[8] }, 1.0);
+                turns(u[1], [u[2], u[4]], [u[3], u[5]], 25f64.to_radians())
+                    .into_iter()
+                    .map(|(time, roll)| (time, Phase { pitch, roll, thrust: 0.0, increments }))
+                    .collect()
+            }
+            Family::Dive => {
+                let increments = increments(u[4], log_lerp(u[5], 0.3, 2.0));
+                let glide = Phase { pitch: pilot_speed(at.eas), roll: Roll::Hold { bank: 0.0 }, thrust: 0.0, increments };
+                let dive = Phase {
+                    pitch: Pitch::Path { gamma: lerp(u[1], -70.0, -10.0).to_radians(), tau_s: 5.0, n_min: lerp(u[2], 0.0, 0.8), n_max: 2.5 },
+                    roll: Roll::Hold { bank: lerp(u[3], -30.0, 30.0).to_radians() },
+                    thrust: 0.0,
+                    increments,
+                };
+                vec![(t0, glide), (t0 + lerp(u[0], 0.0, 600.0), dive)]
+            }
+            Family::PoweredUpset => vec![(t0, Phase {
+                pitch: Pitch::Trim { cl_trim: (1.0 - lerp(u[1], -0.05, 0.1)) * at.cl_1g, mach_trim: at.mach, tuck: lerp(u[0], 1.0, 3.5) },
+                roll: Roll::Asymmetry {
+                    turn_rate: lerp(u[3], -1.2, 1.2).to_radians(),
+                    spiral: 1.0 / lerp(u[2], 40.0, 150.0),
+                    protect: false,
+                    max_bank: lerp(u[4], 45.0, 75.0).to_radians(),
+                },
+                thrust: lerp(u[6], 0.5, 2.0),
+                increments: running(log_lerp(u[5], 0.3, 2.0)),
+            })],
+            Family::PoweredDive => vec![(t0, Phase {
+                pitch: Pitch::Path { gamma: lerp(u[1], -70.0, -10.0).to_radians(), tau_s: 5.0, n_min: lerp(u[2], 0.0, 0.8), n_max: 2.5 },
+                roll: Roll::Hold { bank: lerp(u[3], -30.0, 30.0).to_radians() },
+                thrust: lerp(u[0], 0.1, 2.0),
+                increments: running(log_lerp(u[4], 0.3, 2.0)),
+            })],
+            Family::PoweredDescent => {
+                let pitch = Pitch::Path { gamma: lerp(u[0], -10.0, -1.0).to_radians(), tau_s: 10.0, n_min: 0.5, n_max: 1.5 };
+                let thrust = lerp(u[6], 0.1, 1.0);
+                turns(u[1], [u[2], u[4]], [u[3], u[5]], 25f64.to_radians())
+                    .into_iter()
+                    .map(|(time, roll)| (time, Phase { pitch, roll, thrust, increments: running(1.0) }))
+                    .collect()
+            }
+            Family::PoweredDitching => {
+                let pitch = Pitch::Ditch { ref_eas: speed(lerp(u[0], 150.0, 200.0)), flare_alt_m: lerp(u[6], 30.0, 150.0) * FT, touchdown_vs: lerp(u[7], -4.0, -0.5) };
+                let thrust = lerp(u[8], 0.1, 0.6);
+                turns(u[1], [u[2], u[4]], [u[3], u[5]], 25f64.to_radians())
+                    .into_iter()
+                    .map(|(time, roll)| (time, Phase { pitch, roll, thrust, increments: running(1.0) }))
+                    .collect()
+            }
+        }
+    }
+}
diff --git a/hypotheses/end-of-flight/flight.rs b/hypotheses/end-of-flight/flight.rs
new file mode 100644
index 0000000..6d00854
--- /dev/null
+++ b/hypotheses/end-of-flight/flight.rs
@@ -0,0 +1,636 @@
+//! Point-mass flight from the first flame-out to the sea: air-relative speed, flight-path
+//! angle, heading and bank over the WGS-84 ellipsoid, in the runner's wind and temperature.
+//!
+//! Lift and bank come from control laws (`Pitch`, `Roll`), so one integrator serves the
+//! autopilot's single-engine phase, the unpiloted families and the piloted ones.
+
+use super::aero::{isa_pressure, isa_temperature, Aerodynamics, Air, Increments, EXTRAPOLATION_MACH, G, SEA_LEVEL_DENSITY};
+
+pub const FT: f64 = 0.3048;
+/// The ERA5 grid tops out here; above it the runner clamps to the 43,000 ft level.
+pub const GRID_TOP_M: f64 = 43_000.0 * FT;
+
+/// Wind and temperature along the flight. The runner implements it over ERA5.
+pub trait Weather: Sync {
+    /// Temperature (K), wind towards the east and towards the north (m/s).
+    fn sample(&self, unix_s: f64, alt_ft: f64, lat_deg: f64, lon_deg: f64) -> (f64, f64, f64);
+
+    /// Pressure altitude of the sea surface (ft), where a descent ends; the runner derives it
+    /// from ERA5 mean-sea-level pressure. ISA sea level by default.
+    fn surface_ft(&self, _unix_s: f64, _lat_deg: f64, _lon_deg: f64) -> f64 {
+        0.0
+    }
+}
+
+/// ISA temperature and still air, for tests and calibration.
+pub struct StillIsa;
+
+impl Weather for StillIsa {
+    fn sample(&self, _: f64, alt_ft: f64, _: f64, _: f64) -> (f64, f64, f64) {
+        (isa_temperature(alt_ft * FT), 0.0, 0.0)
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct State {
+    pub unix_s: f64,
+    pub lat_deg: f64,
+    pub lon_deg: f64,
+    /// Pressure altitude (m).
+    pub alt_m: f64,
+    /// True airspeed (m/s).
+    pub tas: f64,
+    /// Air-relative flight-path angle (rad), negative when descending.
+    pub gamma: f64,
+    /// Direction of the air-relative velocity (rad, clockwise from north).
+    pub heading: f64,
+    /// Bank (rad), positive right wing down.
+    pub bank: f64,
+    /// Equivalent airspeed as seen by the speed-stability law, lagging the true value (m/s).
+    /// NaN at a start means "equal to the current EAS".
+    pub sensed_eas: f64,
+    /// The speed-stability law's reference (m/s), moving from the speed at the start of the
+    /// phase towards the law's target. NaN means "the EAS when the phase begins".
+    pub reference_eas: f64,
+}
+
+/// How lift is commanded, as a load factor n = L/W or a trimmed lift coefficient.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Pitch {
+    /// Autopilot altitude hold with an engine out: hold `alt_m`; once the equivalent airspeed
+    /// falls to `floor_eas`, hold that speed instead and let the aircraft descend.
+    AltitudeHold { alt_m: f64, floor_eas: f64 },
+    /// Hold the flight path (n = cos(gamma), turn-compensated up to 30 deg of bank) plus speed
+    /// stability about a reference that moves from the phase's initial EAS to `ref_eas` (m/s)
+    /// with time constant `ref_tau_s` (0: at once), acting on the EAS sensed through a lag of
+    /// `lag_s`. Unpiloted: the 777 normal-mode C*U-like law, no damping; the lag is what lets
+    /// its phugoid grow as in Boeing's runs. Piloted: a pilot flying a speed, `damping` > 0.
+    Speed { ref_eas: f64, ref_tau_s: f64, stiffness: f64, damping: f64, lag_s: f64 },
+    /// Stick-fixed trim, no protections: the lift coefficient trimmed at `mach_trim`, reduced
+    /// above Mach 0.75 by the tuck, a fraction `tuck` per unit Mach (never below zero).
+    Trim { cl_trim: f64, mach_trim: f64, tuck: f64 },
+    /// Pilot tracking a flight-path angle (rad) with a time constant (s), load factor limited.
+    Path { gamma: f64, tau_s: f64, n_min: f64, n_max: f64 },
+    /// Pilot gliding at `ref_eas`, then below `flare_alt_m` flaring to a sink rate of
+    /// `touchdown_vs` (m/s, negative) for a ditching.
+    Ditch { ref_eas: f64, flare_alt_m: f64, touchdown_vs: f64 },
+}
+
+/// How the bank angle evolves.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Roll {
+    /// Hands off with a residual asymmetry. The forcing is the bank of a steady turn at
+    /// `turn_rate` (rad/s) at the reference roll-in rate 1/60 s; `spiral` (1/s) is the spiral
+    /// mode: negative settles on a bank, positive diverges towards `max_bank`. `protect`
+    /// adds normal-mode bank-angle protection (rolled back towards 30 deg above 35 deg).
+    Asymmetry { turn_rate: f64, spiral: f64, protect: bool, max_bank: f64 },
+    /// Pilot or autopilot holding a heading (rad), banking up to `max_bank`.
+    Heading { target: f64, max_bank: f64 },
+    /// Pilot holding a bank angle (rad).
+    Hold { bank: f64 },
+}
+
+pub const ROLL_IN_PER_S: f64 = 1.0 / 60.0;
+/// Where the stick-fixed trimmed lift starts to fall with Mach (the tuck).
+const TUCK_MACH: f64 = 0.75;
+/// The point mass is not flown through the vertical.
+const MAX_GAMMA: f64 = 88.0 * std::f64::consts::PI / 180.0;
+const MAX_ROLL_RATE: f64 = 5.0 * std::f64::consts::PI / 180.0;
+
+/// Everything that stays fixed during one phase of flight.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Phase {
+    pub pitch: Pitch,
+    pub roll: Roll,
+    /// Total thrust, in units of one engine's maximum continuous thrust: 0 with both engines
+    /// out, up to 1 with one running, up to 2 with both (flight idle is a few hundredths each).
+    pub thrust: f64,
+    pub increments: Increments,
+}
+
+/// Air data derived from the state.
+struct AirData {
+    air: Air,
+    mach: f64,
+    q: f64,
+    eas: f64,
+    wind_east: f64,
+    wind_north: f64,
+}
+
+/// What the integrator needs besides the state.
+pub struct Aircraft<'a> {
+    pub aero: &'a dyn Aerodynamics,
+    pub mass_kg: f64,
+    pub weather: &'a dyn Weather,
+    /// Lift coefficient where attached flow ends (stall/buffet), as a multiple of the usable CL.
+    pub stall_factor: f64,
+    /// Normal-mode stall protection: the protected lift coefficient as a multiple of the usable CL.
+    pub protected_factor: f64,
+}
+
+#[derive(Debug, Clone, Copy, Default)]
+struct Rates {
+    lat: f64,
+    lon: f64,
+    alt: f64,
+    tas: f64,
+    gamma: f64,
+    heading: f64,
+    bank: f64,
+    sensed_eas: f64,
+    reference_eas: f64,
+}
+
+/// Diagnostics accumulated along one flight.
+#[derive(Debug, Clone, Copy, Default, PartialEq)]
+pub struct Envelope {
+    pub max_mach: f64,
+    pub max_eas: f64,
+    pub max_descent: f64,
+    /// Largest lift over weight.
+    pub max_load_factor: f64,
+    pub max_alt_m: f64,
+    /// Seconds with the lift coefficient at the stall limit (beyond attached flow).
+    pub stalled_s: f64,
+    /// Seconds above `EXTRAPOLATION_MACH`.
+    pub extrapolated_s: f64,
+    /// Seconds above the top of the weather grid.
+    pub above_grid_s: f64,
+}
+
+/// A state reported to the runner: position and ground-relative velocity.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Snapshot {
+    pub unix_s: f64,
+    pub lat_deg: f64,
+    pub lon_deg: f64,
+    pub alt_ft: f64,
+    pub velocity_east: f64,
+    pub velocity_north: f64,
+    pub velocity_up: f64,
+    pub tas: f64,
+    pub gamma: f64,
+    /// Attitude (rad) and load factor where the control law is known, NaN elsewhere.
+    pub bank: f64,
+    pub alpha: f64,
+    pub pitch: f64,
+    pub load_factor: f64,
+}
+
+impl<'a> Aircraft<'a> {
+    fn air_data(&self, s: &State) -> AirData {
+        let (temperature_k, wind_east, wind_north) = self.weather.sample(s.unix_s, s.alt_m / FT, s.lat_deg, s.lon_deg);
+        let air = Air { pressure_pa: isa_pressure(s.alt_m), temperature_k };
+        let rho = air.density();
+        AirData {
+            mach: s.tas / air.speed_of_sound(),
+            q: 0.5 * rho * s.tas * s.tas,
+            eas: s.tas * (rho / SEA_LEVEL_DENSITY).sqrt(),
+            air,
+            wind_east,
+            wind_north,
+        }
+    }
+
+    /// Lift coefficient demanded by the pitch law, before limits, and whether the law is
+    /// protected (normal mode or autopilot).
+    fn commanded_cl(&self, s: &State, d: &AirData, phase: &Phase) -> (f64, bool) {
+        let weight = self.mass_kg * G;
+        let qs = d.q * self.aero.wing_area_m2();
+        let (cos_g, cos_b) = (s.gamma.cos(), s.bank.cos());
+        let compensated = cos_g / cos_b.max(30f64.to_radians().cos());
+        let sensed = if s.sensed_eas.is_nan() { d.eas } else { s.sensed_eas };
+        let speed_law = |ref_eas: f64, stiffness: f64, damping: f64| {
+            let mut n = compensated + stiffness * (sensed - ref_eas) / ref_eas;
+            if damping > 0.0 {
+                // Damp towards the equilibrium glide: -dV/dt/g = sin(gamma) + (D - T)/W.
+                let cl = n * weight / qs;
+                let drag = self.aero.drag_coefficient(d.mach, cl, &d.air, &phase.increments) * qs;
+                let thrust = phase.thrust * self.aero.engine_thrust(d.mach, &d.air);
+                n -= damping * (s.gamma.sin() + (drag - thrust) / weight);
+            }
+            n
+        };
+        let path_law = |gamma: f64, tau_s: f64| (cos_g + s.tas / G * (gamma - s.gamma) / tau_s) / cos_b.max(0.1);
+        match phase.pitch {
+            Pitch::AltitudeHold { alt_m, floor_eas } => {
+                let target = (0.1 * (alt_m - s.alt_m) / s.tas).clamp(-0.05, 0.05);
+                let n = path_law(target, 5.0).min(speed_law(floor_eas, 2.0, 1.0));
+                (n * weight / qs, true)
+            }
+            Pitch::Speed { ref_eas, ref_tau_s, stiffness, damping, .. } => {
+                let reference = if ref_tau_s > 0.0 && !s.reference_eas.is_nan() { s.reference_eas } else { ref_eas };
+                (speed_law(reference, stiffness, damping) * weight / qs, damping == 0.0)
+            }
+            Pitch::Trim { cl_trim, mach_trim, tuck } => {
+                let factor = |m: f64| (1.0 - tuck * (m - TUCK_MACH).max(0.0)).max(0.0);
+                (cl_trim * factor(d.mach) / factor(mach_trim).max(1e-3), false)
+            }
+            Pitch::Path { gamma, tau_s, n_min, n_max } => (path_law(gamma, tau_s).clamp(n_min, n_max) * weight / qs, false),
+            Pitch::Ditch { ref_eas, flare_alt_m, touchdown_vs } => {
+                let n = if s.alt_m > flare_alt_m {
+                    speed_law(ref_eas, 2.0, 1.0)
+                } else {
+                    path_law((touchdown_vs / s.tas.max(1.0)).clamp(-1.0, 0.0).asin(), 2.0).clamp(0.5, 2.0)
+                };
+                (n * weight / qs, false)
+            }
+        }
+    }
+
+    fn bank_rate(&self, s: &State, phase: &Phase) -> f64 {
+        match phase.roll {
+            Roll::Asymmetry { turn_rate, spiral, protect, max_bank } => {
+                let forcing = ROLL_IN_PER_S * (s.tas * turn_rate / G).atan();
+                let mut rate = forcing + spiral * s.bank;
+                if rate * s.bank > 0.0 {
+                    rate *= (1.0 - (s.bank / max_bank).powi(2)).max(0.0);
+                }
+                let excess = s.bank.abs() - 35f64.to_radians();
+                if protect && excess > 0.0 {
+                    rate -= s.bank.signum() * (0.2 * (excess + 5f64.to_radians()));
+                }
+                rate
+            }
+            Roll::Heading { target, max_bank } => {
+                let error = geo::wrap_pi(target - s.heading);
+                let wanted = (2.0 * error).clamp(-max_bank, max_bank);
+                ((wanted - s.bank) / 2.0).clamp(-MAX_ROLL_RATE, MAX_ROLL_RATE)
+            }
+            Roll::Hold { bank } => ((bank - s.bank) / 2.0).clamp(-MAX_ROLL_RATE, MAX_ROLL_RATE),
+        }
+    }
+
+    /// Rates of change, plus the air data, whether lift is at the stall limit, and the lift
+    /// coefficient applied.
+    fn rates(&self, s: &State, phase: &Phase) -> (Rates, AirData, bool, f64) {
+        let d = self.air_data(s);
+        let (demand, protected) = self.commanded_cl(s, &d, phase);
+        let usable = self.aero.usable_cl(d.mach);
+        let limit = usable * if protected { self.protected_factor } else { self.stall_factor };
+        let cl = demand.clamp(-0.5 * usable, limit);
+        let qs = d.q * self.aero.wing_area_m2();
+        let lift = cl * qs;
+        let drag = self.aero.drag_coefficient(d.mach, cl, &d.air, &phase.increments) * qs;
+        let thrust = if phase.thrust > 0.0 { phase.thrust * self.aero.engine_thrust(d.mach, &d.air) } else { 0.0 };
+        let m = self.mass_kg;
+        let v = s.tas.max(20.0);
+        let cos_g = s.gamma.cos();
+        let horizontal = s.tas * cos_g;
+        let north = horizontal * s.heading.cos() + d.wind_north;
+        let east = horizontal * s.heading.sin() + d.wind_east;
+        let (rm, rn) = geo::radii_of_curvature_km(s.lat_deg);
+        let r = Rates {
+            lat: (north / (rm * 1000.0 + s.alt_m)).to_degrees(),
+            lon: (east / ((rn * 1000.0 + s.alt_m) * s.lat_deg.to_radians().cos())).to_degrees(),
+            alt: s.tas * s.gamma.sin(),
+            tas: (thrust - drag) / m - G * s.gamma.sin(),
+            gamma: (lift * s.bank.cos() - m * G * cos_g) / (m * v),
+            heading: lift * s.bank.sin() / (m * v * cos_g.max(0.05)),
+            bank: self.bank_rate(s, phase),
+            sensed_eas: match phase.pitch {
+                Pitch::Speed { lag_s, .. } if lag_s > 0.0 => (d.eas - s.sensed_eas) / lag_s,
+                _ => 0.0,
+            },
+            reference_eas: match phase.pitch {
+                Pitch::Speed { ref_eas, ref_tau_s, .. } if ref_tau_s > 0.0 => (ref_eas - s.reference_eas) / ref_tau_s,
+                _ => 0.0,
+            },
+        };
+        (r, d, !protected && demand >= limit, cl)
+    }
+
+    fn advance(&self, s: &State, r: &Rates, dt: f64) -> State {
+        State {
+            unix_s: s.unix_s + dt,
+            lat_deg: s.lat_deg + r.lat * dt,
+            lon_deg: s.lon_deg + r.lon * dt,
+            alt_m: s.alt_m + r.alt * dt,
+            tas: s.tas + r.tas * dt,
+            gamma: s.gamma + r.gamma * dt,
+            heading: s.heading + r.heading * dt,
+            bank: s.bank + r.bank * dt,
+            sensed_eas: s.sensed_eas + r.sensed_eas * dt,
+            reference_eas: s.reference_eas + r.reference_eas * dt,
+        }
+    }
+
+    /// One classical Runge-Kutta step; also returns the air data, stall flag and lift
+    /// coefficient at the start.
+    fn step(&self, s: &State, phase: &Phase, dt: f64) -> (State, AirData, bool, f64) {
+        let (k1, d, stalled, cl) = self.rates(s, phase);
+        let k2 = self.rates(&self.advance(s, &k1, 0.5 * dt), phase).0;
+        let k3 = self.rates(&self.advance(s, &k2, 0.5 * dt), phase).0;
+        let k4 = self.rates(&self.advance(s, &k3, dt), phase).0;
+        let avg = |f: fn(&Rates) -> f64| (f(&k1) + 2.0 * f(&k2) + 2.0 * f(&k3) + f(&k4)) / 6.0;
+        let r = Rates {
+            lat: avg(|r| r.lat),
+            lon: avg(|r| r.lon),
+            alt: avg(|r| r.alt),
+            tas: avg(|r| r.tas),
+            gamma: avg(|r| r.gamma),
+            heading: avg(|r| r.heading),
+            bank: avg(|r| r.bank),
+            sensed_eas: avg(|r| r.sensed_eas),
+            reference_eas: avg(|r| r.reference_eas),
+        };
+        let mut next = self.advance(s, &r, dt);
+        if !matches!(phase.pitch, Pitch::Speed { lag_s, .. } if lag_s > 0.0) {
+            next.sensed_eas = self.air_data(&next).eas;
+        }
+        next.lon_deg = geo::wrap_longitude(next.lon_deg);
+        next.tas = next.tas.max(1.0);
+        next.gamma = next.gamma.clamp(-MAX_GAMMA, MAX_GAMMA);
+        (next, d, stalled, cl)
+    }
+
+    /// Position and ground-relative velocity for the runner; attitude and load factor too when
+    /// the phase (hence the lift) is known.
+    pub fn snapshot(&self, s: &State, phase: Option<&Phase>) -> Snapshot {
+        let d = self.air_data(s);
+        let horizontal = s.tas * s.gamma.cos();
+        let (alpha, pitch, load_factor) = match phase {
+            Some(phase) => {
+                let cl = self.rates(s, phase).3;
+                let alpha = self.aero.alpha(d.mach, cl);
+                // Body pitch from path, incidence and bank, with no sideslip.
+                let pitch = (s.gamma.sin() * alpha.cos() + s.gamma.cos() * alpha.sin() * s.bank.cos()).asin();
+                (alpha, pitch, cl * d.q * self.aero.wing_area_m2() / (self.mass_kg * G))
+            }
+            None => (f64::NAN, f64::NAN, f64::NAN),
+        };
+        Snapshot {
+            unix_s: s.unix_s,
+            lat_deg: s.lat_deg,
+            lon_deg: s.lon_deg,
+            alt_ft: s.alt_m / FT,
+            velocity_east: horizontal * s.heading.sin() + d.wind_east,
+            velocity_north: horizontal * s.heading.cos() + d.wind_north,
+            velocity_up: s.tas * s.gamma.sin(),
+            tas: s.tas,
+            gamma: s.gamma,
+            bank: s.bank,
+            alpha,
+            pitch,
+            load_factor,
+        }
+    }
+
+    /// Height (m) above the sea surface's pressure altitude.
+    fn above_surface(&self, s: &State) -> f64 {
+        s.alt_m - self.weather.surface_ft(s.unix_s, s.lat_deg, s.lon_deg) * FT
+    }
+
+    /// Equivalent airspeed (m/s) of a state.
+    pub fn eas(&self, s: &State) -> f64 {
+        self.air_data(s).eas
+    }
+
+    /// Equivalent airspeed (m/s), Mach number and dynamic pressure (Pa) of a state.
+    pub fn airspeeds(&self, s: &State) -> (f64, f64, f64) {
+        let d = self.air_data(s);
+        (d.eas, d.mach, d.q)
+    }
+
+    /// Fly `phases` in turn, switching at the given times, until the sea or `until_s`.
+    /// Records a snapshot at each `epochs` time reached, and one every `trace_s` if set.
+    pub fn fly(&self, start: State, phases: &[(f64, Phase)], epochs: &[f64], until_s: f64, dt: f64, trace_s: Option<f64>) -> Flight {
+        let mut s = start;
+        if s.sensed_eas.is_nan() {
+            s.sensed_eas = self.air_data(&s).eas;
+        }
+        let mut out = Flight { epochs: vec![None; epochs.len()], ..Flight::default() };
+        let mut next_trace = trace_s.map(|_| s.unix_s);
+        let mut k = 0;
+        s.reference_eas = self.air_data(&s).eas;
+        loop {
+            while k + 1 < phases.len() && s.unix_s >= phases[k + 1].0 - 1e-9 {
+                k += 1;
+                s.reference_eas = self.air_data(&s).eas;
+            }
+            let phase = &phases[k];
+            if let (Some(t), Some(every)) = (next_trace, trace_s) {
+                if s.unix_s >= t - 1e-9 {
+                    out.trace.push(self.snapshot(&s, Some(&phase.1)));
+                    next_trace = Some(t + every);
+                }
+            }
+            if s.unix_s >= until_s {
+                out.last = s;
+                return out;
+            }
+            // Stop exactly at the next phase switch, epoch or trace time.
+            let mut h = dt.min(until_s - s.unix_s);
+            if k + 1 < phases.len() {
+                h = h.min(phases[k + 1].0 - s.unix_s);
+            }
+            for (i, &e) in epochs.iter().enumerate() {
+                if out.epochs[i].is_none() && e > s.unix_s + 1e-9 {
+                    h = h.min(e - s.unix_s);
+                }
+            }
+            let h = h.max(1e-6);
+            let (next, d, stalled, cl) = self.step(&s, &phase.1, h);
+            let e = &mut out.envelope;
+            e.max_mach = e.max_mach.max(d.mach);
+            e.max_eas = e.max_eas.max(d.eas);
+            e.max_alt_m = e.max_alt_m.max(s.alt_m);
+            e.max_descent = e.max_descent.max(-s.tas * s.gamma.sin());
+            e.max_load_factor = e.max_load_factor.max(cl * d.q * self.aero.wing_area_m2() / (self.mass_kg * G));
+            e.stalled_s += if stalled { h } else { 0.0 };
+            e.extrapolated_s += if d.mach > EXTRAPOLATION_MACH { h } else { 0.0 };
+            e.above_grid_s += if s.alt_m > GRID_TOP_M { h } else { 0.0 };
+            if self.above_surface(&next) <= 0.0 {
+                // Land on the surface: secant iterations on the length of the last step.
+                let (mut f0, mut a0, mut f1, mut a1) = (0.0, self.above_surface(&s), 1.0, self.above_surface(&next));
+                let mut at = next;
+                for _ in 0..8 {
+                    let f = (f1 - a1 * (f1 - f0) / (a1 - a0)).clamp(1e-9, 1.0);
+                    at = self.step(&s, &phase.1, f * h).0;
+                    let height = self.above_surface(&at);
+                    if height.abs() < 1e-4 {
+                        break;
+                    }
+                    (f0, a0, f1, a1) = (f1, a1, f, height);
+                }
+                at.alt_m -= self.above_surface(&at);
+                out.impact = Some(self.snapshot(&at, Some(&phase.1)));
+                out.last = at;
+                return out;
+            }
+            s = next;
+            for (i, &e) in epochs.iter().enumerate() {
+                if out.epochs[i].is_none() && (s.unix_s - e).abs() < 1e-6 {
+                    out.epochs[i] = Some(self.snapshot(&s, Some(&phase.1)));
+                }
+            }
+        }
+    }
+}
+
+/// The outcome of one flight.
+#[derive(Debug, Clone, Default)]
+pub struct Flight {
+    /// At the sea surface, if reached before the time limit.
+    pub impact: Option<Snapshot>,
+    /// States at the requested epochs (None if the flight ended first).
+    pub epochs: Vec<Option<Snapshot>>,
+    pub trace: Vec<Snapshot>,
+    pub envelope: Envelope,
+    /// Final state (at impact or at the time limit).
+    pub last: State,
+}
+
+impl Default for State {
+    fn default() -> Self {
+        State { unix_s: 0.0, lat_deg: 0.0, lon_deg: 0.0, alt_m: 0.0, tas: 0.0, gamma: 0.0, heading: 0.0, bank: 0.0, sensed_eas: f64::NAN, reference_eas: f64::NAN }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::f64::consts::PI;
+
+    /// A fixed parabolic polar, thrust per engine, no Mach or Reynolds effects and no lift limit.
+    struct Parabolic {
+        cd0: f64,
+        k: f64,
+        thrust: f64,
+    }
+
+    impl Aerodynamics for Parabolic {
+        fn wing_area_m2(&self) -> f64 {
+            100.0
+        }
+        fn drag_coefficient(&self, _: f64, cl: f64, _: &Air, _: &Increments) -> f64 {
+            self.cd0 + self.k * cl * cl
+        }
+        fn usable_cl(&self, _: f64) -> f64 {
+            10.0
+        }
+        fn engine_thrust(&self, _: f64, _: &Air) -> f64 {
+            self.thrust
+        }
+    }
+
+    const MASS: f64 = 100_000.0;
+
+    fn aircraft(aero: &Parabolic) -> Aircraft<'_> {
+        Aircraft { aero, mass_kg: MASS, weather: &StillIsa, stall_factor: 1.0, protected_factor: 1.0 }
+    }
+
+    fn start(alt_m: f64, tas: f64, gamma: f64) -> State {
+        State { unix_s: 0.0, lat_deg: 0.0, lon_deg: 90.0, alt_m, tas, gamma, heading: 0.0, bank: 0.0, sensed_eas: f64::NAN, reference_eas: f64::NAN }
+    }
+
+    fn phase(pitch: Pitch, thrust: f64) -> Phase {
+        Phase { pitch, roll: Roll::Hold { bank: 0.0 }, thrust, increments: Increments::CLEAN }
+    }
+
+    fn density(alt_m: f64) -> f64 {
+        Air { pressure_pa: isa_pressure(alt_m), temperature_k: isa_temperature(alt_m) }.density()
+    }
+
+    /// Lift coefficient that balances weight at `tas` and `alt_m`.
+    fn level_cl(alt_m: f64, tas: f64) -> f64 {
+        MASS * G / (0.5 * density(alt_m) * tas * tas * 100.0)
+    }
+
+    /// Still ISA air over a sea surface at -500 ft pressure altitude (high pressure).
+    struct HighPressure;
+
+    impl Weather for HighPressure {
+        fn sample(&self, _: f64, alt_ft: f64, _: f64, _: f64) -> (f64, f64, f64) {
+            (isa_temperature(alt_ft * FT), 0.0, 0.0)
+        }
+        fn surface_ft(&self, _: f64, _: f64, _: f64) -> f64 {
+            -500.0
+        }
+    }
+
+    /// No lift and no drag: kinetic plus potential energy is conserved down to the surface,
+    /// wherever the surface lies.
+    #[test]
+    fn ballistic_flight_conserves_mechanical_energy() {
+        let aero = Parabolic { cd0: 0.0, k: 0.0, thrust: 0.0 };
+        let coast = phase(Pitch::Trim { cl_trim: 0.0, mach_trim: 1.0, tuck: 0.0 }, 0.0);
+        for (weather, surface_m) in [(&StillIsa as &dyn Weather, 0.0), (&HighPressure, -500.0 * FT)] {
+            let a = Aircraft { weather, ..aircraft(&aero) };
+            let flight = a.fly(start(1000.0, 200.0, -10f64.to_radians()), &[(0.0, coast)], &[], 600.0, 0.5, None);
+            let impact = flight.impact.expect("reaches the sea");
+            assert!((impact.alt_ft * FT - surface_m).abs() < 1e-6);
+            let v2 = impact.velocity_east.powi(2) + impact.velocity_north.powi(2) + impact.velocity_up.powi(2);
+            let (before, after) = (0.5 * 200.0f64.powi(2) + G * (1000.0 - surface_m), 0.5 * v2);
+            assert!((after - before).abs() / before < 1e-8, "{before} {after}");
+        }
+    }
+
+    #[test]
+    fn level_flight_is_an_equilibrium_under_every_pitch_law() {
+        let (alt, tas) = (3000.0, 150.0);
+        let cl = level_cl(alt, tas);
+        let drag = (0.02 + 0.05 * cl * cl) * 0.5 * density(alt) * tas * tas * 100.0;
+        let aero = Parabolic { cd0: 0.02, k: 0.05, thrust: drag };
+        let a = aircraft(&aero);
+        let eas = a.eas(&start(alt, tas, 0.0));
+        let mach = tas / Air { pressure_pa: isa_pressure(alt), temperature_k: isa_temperature(alt) }.speed_of_sound();
+        for pitch in [
+            Pitch::Speed { ref_eas: eas, ref_tau_s: 60.0, stiffness: 1.0, damping: 0.0, lag_s: 10.0 },
+            Pitch::Speed { ref_eas: eas, ref_tau_s: 0.0, stiffness: 2.0, damping: 1.0, lag_s: 0.0 },
+            Pitch::Trim { cl_trim: cl, mach_trim: mach, tuck: 2.0 },
+            Pitch::AltitudeHold { alt_m: alt, floor_eas: 0.5 * eas },
+        ] {
+            let end = a.fly(start(alt, tas, 0.0), &[(0.0, phase(pitch, 1.0))], &[], 600.0, 0.5, None).last;
+            assert!((end.alt_m - alt).abs() < 1e-6 && (end.tas - tas).abs() < 1e-9, "{pitch:?}: {end:?}");
+            // 150 m/s north for 600 s along the meridian at 3 km.
+            let (rm, _) = geo::radii_of_curvature_km(0.0);
+            let expected = (90_000.0 / (rm * 1000.0 + alt)).to_degrees();
+            assert!((end.lat_deg - expected).abs() < 1e-6, "{}", end.lat_deg);
+        }
+    }
+
+    /// Small-amplitude phugoid at constant lift coefficient, no drag: the linear theory gives
+    /// w^2 = 2 (g/V)^2 + g beta, beta = -(1/rho) d(rho)/dh = (g/R - lapse)/T in the ISA
+    /// troposphere. Without the density term it is Lanchester's period pi sqrt(2) V/g.
+    #[test]
+    fn phugoid_period_matches_linear_theory() {
+        let (alt, v) = (5000.0, 128.0);
+        let aero = Parabolic { cd0: 0.0, k: 0.0, thrust: 0.0 };
+        let trim = phase(Pitch::Trim { cl_trim: level_cl(alt, v), mach_trim: 0.5, tuck: 0.0 }, 0.0);
+        let flight = aircraft(&aero).fly(start(alt, 1.005 * v, 0.0), &[(0.0, trim)], &[], 600.0, 0.1, Some(0.1));
+        let h: Vec<f64> = flight.trace.iter().map(|s| s.alt_ft).collect();
+        let peaks: Vec<f64> = (1..h.len() - 1).filter(|&i| h[i] > h[i - 1] && h[i] >= h[i + 1]).map(|i| flight.trace[i].unix_s).collect();
+        let period = (peaks[peaks.len() - 1] - peaks[0]) / (peaks.len() - 1) as f64;
+        let t = isa_temperature(alt);
+        let beta = (G / 287.052_87 - 0.0065) / t;
+        let theory = 2.0 * PI / (2.0 * (G / v).powi(2) + G * beta).sqrt();
+        assert!((period - theory).abs() / theory < 0.005, "period {period:.2} s, theory {theory:.2} s");
+        assert!((period / (PI * 2f64.sqrt() * v / G) - 0.957).abs() < 0.01);
+    }
+
+    /// Wings-level glide at the best lift coefficient of a fixed polar: the still-air distance
+    /// is L/D times the loss of energy height (altitude plus the small change in V^2/2g).
+    #[test]
+    fn still_air_glide_distance_is_altitude_times_lift_to_drag() {
+        let (cd0, k) = (0.02, 0.04);
+        let cl = (cd0 / k as f64).sqrt();
+        let ld = cl / (2.0 * cd0);
+        let aero = Parabolic { cd0, k, thrust: 0.0 };
+        let a = aircraft(&aero);
+        let (alt, gamma) = (10_000.0, -(1.0 / ld).atan());
+        let v0 = (2.0 * MASS * G * gamma.cos() / (density(alt) * 100.0 * cl)).sqrt();
+        let eas = a.eas(&start(alt, v0, gamma));
+        let glide = phase(Pitch::Speed { ref_eas: eas, ref_tau_s: 0.0, stiffness: 2.0, damping: 1.0, lag_s: 0.0 }, 0.0);
+        let flight = a.fly(start(alt, v0, gamma), &[(0.0, glide)], &[], 7200.0, 0.5, None);
+        let impact = flight.impact.expect("reaches the sea");
+        let v1 = flight.last.tas;
+        let energy = alt + (v0 * v0 - v1 * v1) / (2.0 * G);
+        let (rm, _) = geo::radii_of_curvature_km(impact.lat_deg / 2.0);
+        let distance = impact.lat_deg.to_radians() * rm * 1000.0;
+        // Along the arc at mean height about alt/2: ground distance is shorter by (1 - h/2R).
+        let expected = ld * energy * (1.0 - 0.5 * alt / (rm * 1000.0));
+        assert!((distance - expected).abs() / expected < 0.003, "{distance:.0} m vs {expected:.0} m (L/D {ld:.2})");
+    }
+}
