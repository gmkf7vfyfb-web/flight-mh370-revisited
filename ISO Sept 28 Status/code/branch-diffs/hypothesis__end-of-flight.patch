+"""Hand-off states for the standalone preview, until the terminal hook supplies real ones.
+
+The base run keeps 2,000 resampled (equally weighted) routes per replicate as positions every
+600 s from 18:01:49; the last two points are 00:01:49 and 00:11:49. Each preview hand-off is
+a route's position at 00:11:49 with its track and ground speed over the last ten minutes. The
+routes carry no altitude or airspeed, so altitude is drawn from the replicate's weighted final
+altitudes and the airspeed is taken as the ground speed: the preview flies in still air. It is
+a physics preview, not a posterior; the terminal hook will hand over full states and ERA5 wind.
+
+Writes runs/end-of-flight/preview/handoffs.csv. Run from the repository root.
+"""
+
+import pathlib
+
+import numpy as np
+
+ROOT = pathlib.Path(__file__).resolve().parents[3]
+BASE = ROOT / "runs/davey2016/bto-bfo"
+OUT = ROOT / "runs/end-of-flight/preview"
+PER_SEED, SEEDS = 50, [1, 2, 3, 4]
+T_ROUTE_END = 1_394_215_309.0 + 37 * 600.0  # 00:11:49 UTC
+
+
+def main():
+    rng = np.random.default_rng(1)
+    rows = []
+    for seed in SEEDS:
+        routes = np.load(BASE / f"seed-{seed}/routes.npy")
+        final = np.load(BASE / f"seed-{seed}/final.npy", mmap_mode="r")
+        pick = rng.choice(len(routes), PER_SEED, replace=False)
+        rows_final = rng.choice(len(final), 200_000, replace=False)
+        weights = np.asarray(final[rows_final, 0], dtype=float)
+        altitudes = np.asarray(final[rows_final, 3], dtype=float)
+        alt = rng.choice(altitudes, PER_SEED, p=weights / weights.sum())
+        for i, a in zip(pick, alt):
+            (lat0, lon0), (lat1, lon1) = routes[i, -2], routes[i, -1]
+            north = np.radians(lat1 - lat0) * 6_356_752.0
+            east = np.radians(lon1 - lon0) * 6_378_137.0 * np.cos(np.radians(0.5 * (lat0 + lat1)))
+            rows.append((seed, int(i), T_ROUTE_END, lat1, lon1, a, np.degrees(np.arctan2(east, north)) % 360,
+                         np.hypot(north, east) / 600.0))
+    OUT.mkdir(parents=True, exist_ok=True)
+    with open(OUT / "handoffs.csv", "w") as f:
+        f.write("seed,route,unix_s,lat_deg,lon_deg,alt_ft,track_deg,ground_speed_m_s\n")
+        for r in rows:
+            f.write(",".join(f"{v:.6f}" if isinstance(v, float) else str(v) for v in r) + "\n")
+    speeds = np.array([r[-1] for r in rows]) / (1852 / 3600)
+    print(f"{len(rows)} hand-offs; ground speed {np.percentile(speeds, [5, 50, 95]).round(0)} kt; "
+          f"altitude {np.percentile([r[5] for r in rows], [5, 50, 95]).round(-2)} ft")
+
+
+if __name__ == "__main__":
+    main()
