new file mode 100644
index 0000000..2905d56
--- /dev/null
+++ b/hypotheses/end-of-flight/aero.rs
@@ -0,0 +1,227 @@
+//! Air data and the Poll-Schumann B777-200 point-mass aerodynamics, with the uncertain
+//! post-flame-out drag increments. Sources and departures are in the crate doc comment.
+
+use std::f64::consts::PI;
+
+pub const G: f64 = 9.806_65;
+const KAPPA: f64 = 1.4;
+const R_AIR: f64 = 287.052_87;
+pub const SEA_LEVEL_DENSITY: f64 = 1.225;
+
+/// ISA static pressure (Pa) at a pressure altitude (m).
+pub fn isa_pressure(alt_m: f64) -> f64 {
+    if alt_m <= 11_000.0 {
+        101_325.0 * (1.0 - 2.255_77e-5 * alt_m).powf(5.255_88)
+    } else {
+        22_632.06 * (-G * (alt_m - 11_000.0) / (R_AIR * 216.65)).exp()
+    }
+}
+
+pub fn isa_temperature(alt_m: f64) -> f64 {
+    (288.15 - 0.0065 * alt_m).max(216.65)
+}
+
+/// Static pressure and temperature of the air around the aircraft.
+#[derive(Debug, Clone, Copy)]
+pub struct Air {
+    pub pressure_pa: f64,
+    pub temperature_k: f64,
+}
+
+impl Air {
+    pub fn density(&self) -> f64 {
+        self.pressure_pa / (R_AIR * self.temperature_k)
+    }
+    pub fn speed_of_sound(&self) -> f64 {
+        (KAPPA * R_AIR * self.temperature_k).sqrt()
+    }
+}
+
+/// Poll-Schumann parameters: pycontrails `ps-aircraft-params-20250328.csv`, row B772
+/// (Apache-2.0), equations from Poll & Schumann (2021) as implemented in pycontrails
+/// `ps_model.py` and `ps_operational_limits.py`.
+#[derive(Debug, Clone, Copy)]
+pub struct Airframe {
+    pub wing_area_m2: f64,
+    aspect_ratio: f64,
+    cos_sweep: f64,
+    psi_0: f64,
+    delta_2: f64,
+    x_ref: f64,
+    wing_constant: f64,
+    j_1: f64,
+    j_2: f64,
+    j_3: f64,
+    cl_design: f64,
+    mach_design: f64,
+    thrust_coefficient_design: f64,
+    tr_ec: f64,
+    m_ec: f64,
+    /// Turbine entry temperature at maximum continuous climb (K): 0.92 of the take-off value
+    /// 2000 (1 - exp(62.8 - 0.0325 * 1994)) for a 1994 first flight.
+    tet_mcc: f64,
+}
+
+pub const B772: Airframe = Airframe {
+    wing_area_m2: 427.8,
+    aspect_ratio: 8.678_038_569,
+    cos_sweep: 0.851_726_902,
+    psi_0: 6.461_822_217,
+    delta_2: 0.020_708_613,
+    x_ref: 0.987_569_999,
+    wing_constant: 0.767_369_197,
+    j_1: 0.078_399_473,
+    j_2: 0.873_764_241,
+    j_3: 70.0,
+    cl_design: 0.495_253_823,
+    mach_design: 0.8106,
+    thrust_coefficient_design: 0.024_180_523,
+    tr_ec: 5.716_123_93,
+    m_ec: 0.730_970_427,
+    tet_mcc: 1_592.225_056,
+};
+
+/// Where every public model (Poll-Schumann's MMO for the B772, the NASA CRM wind-tunnel
+/// data, which stop at M 0.87) runs out. Drag beyond it is extrapolated.
+pub const EXTRAPOLATION_MACH: f64 = 0.89;
+
+/// Uncertain additions to the clean polar once both engines have failed.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Increments {
+    /// Two windmilling Trent 892s plus the deployed ram-air turbine, as a drag coefficient
+    /// on the wing area.
+    pub windmill_cd: f64,
+    /// Multiplier on the growth of wave drag beyond `EXTRAPOLATION_MACH` (1 keeps
+    /// Poll-Schumann's own form).
+    pub transonic_scale: f64,
+    /// Drag rise k * (CL - CL_usable)^2 above the usable lift coefficient, where the
+    /// parabolic polar no longer holds.
+    pub separation_k: f64,
+}
+
+impl Increments {
+    pub const CLEAN: Increments = Increments { windmill_cd: 0.0, transonic_scale: 1.0, separation_k: 0.0 };
+}
+
+/// What the flight integrator needs from an aerodynamic model.
+pub trait Aerodynamics: Sync {
+    fn wing_area_m2(&self) -> f64;
+    /// Drag coefficient at a Mach number and lift coefficient.
+    fn drag_coefficient(&self, mach: f64, cl: f64, air: &Air, inc: &Increments) -> f64;
+    /// Operating limit on the lift coefficient (about 1.3 times the stall speed at low Mach).
+    fn usable_cl(&self, mach: f64) -> f64;
+    /// Maximum continuous thrust of one engine (N).
+    fn engine_thrust(&self, mach: f64, air: &Air) -> f64;
+
+    /// Angle of attack (rad) for a lift coefficient, where the model knows it; for attitude
+    /// latents only, never for forces.
+    fn alpha(&self, _mach: f64, _cl: f64) -> f64 {
+        f64::NAN
+    }
+}
+
+impl Aerodynamics for Airframe {
+    fn wing_area_m2(&self) -> f64 {
+        self.wing_area_m2
+    }
+
+    fn drag_coefficient(&self, mach: f64, cl: f64, air: &Air, inc: &Increments) -> f64 {
+        let t = air.temperature_k;
+        let viscosity = 1.458e-6 * t.powf(1.5) / (110.4 + t);
+        let reynolds = self.wing_area_m2.sqrt() * mach.max(0.05) * air.pressure_pa / viscosity * (KAPPA / (R_AIR * t)).sqrt();
+        let cd0 = 0.0269 / reynolds.powf(0.14) * self.psi_0;
+        let k1 = 0.8 * (1.0 - 0.53 * self.cos_sweep) * cd0;
+        let oswald = 1.0 / (1.0 + 0.03 + self.delta_2 + k1 * PI * self.aspect_ratio);
+        let induced = cl * cl / (PI * self.aspect_ratio * oswald);
+        let wave = if mach <= EXTRAPOLATION_MACH {
+            self.wave_drag(mach, cl)
+        } else {
+            let edge = self.wave_drag(EXTRAPOLATION_MACH, cl);
+            edge + inc.transonic_scale * (self.wave_drag(mach, cl) - edge)
+        };
+        let separation = inc.separation_k * (cl - self.usable_cl(mach)).max(0.0).powi(2);
+        cd0 + induced + wave + separation + inc.windmill_cd
+    }
+
+    /// Poll-Schumann maximum usable lift coefficient (buffet-margin operating limit). Its
+    /// cubic turns negative just above Mach 1, so it is held at its Mach 0.95 value beyond.
+    fn usable_cl(&self, mach: f64) -> f64 {
+        let m = mach.min(0.95) / self.mach_design;
+        let ratio = if m < 0.70 {
+            1.8 + 0.160 * m - 1.085 * m * m
+        } else {
+            13.272 - 42.262 * m + 49.883 * m * m - 19.683 * m * m * m
+        };
+        ratio * self.cl_design
+    }
+
+    /// Angle of attack of the fuselage datum: lift-curve slope from the Helmbold/DATCOM relation
+    /// on Poll-Schumann's aspect ratio and sweep, compressible up to Mach 0.95, and a zero-lift
+    /// angle of -2 deg (camber and wing incidence of a typical transport; an assumption, as
+    /// neither is published for the 777). About 3 deg in cruise at CL 0.5 and Mach 0.8.
+    fn alpha(&self, mach: f64, cl: f64) -> f64 {
+        let a = self.aspect_ratio;
+        let beta2 = 1.0 - mach.min(0.95).powi(2);
+        let tan2 = 1.0 / (self.cos_sweep * self.cos_sweep) - 1.0;
+        let slope = 2.0 * PI * a / (2.0 + (4.0 + a * a * beta2 * (1.0 + tan2 / beta2) / 0.95f64.powi(2)).sqrt());
+        -2f64.to_radians() + cl / slope
+    }
+
+    /// Poll-Schumann maximum continuous thrust of ONE engine (N), no throttle buffer.
+    fn engine_thrust(&self, mach: f64, air: &Air) -> f64 {
+        let m = mach.max(0.2);
+        let tr_max = (self.tet_mcc / air.temperature_k)
+            / (self.tr_ec * (1.0 - 0.53 * (m - self.m_ec).powi(2)) * (1.0 + 0.2 * m * m));
+        let h2 = ((1.0 + 0.55 * m) / (1.0 + 0.55 * self.mach_design)) / (m / self.mach_design).powi(2);
+        let ct = (1.0 + 2.5 * (tr_max - 1.0)) * h2 * self.thrust_coefficient_design;
+        0.5 * ct * 0.5 * KAPPA * air.pressure_pa * m * m * self.wing_area_m2
+    }
+}
+
+impl Airframe {
+    fn wave_drag(&self, mach: f64, cl: f64) -> f64 {
+        let m_cc = self.wing_constant - 0.10 * cl / (self.cos_sweep * self.cos_sweep);
+        let x = mach * self.cos_sweep / m_cc;
+        let a = (x - self.j_2).max(0.0);
+        let b = (x - self.x_ref).max(0.0);
+        self.cos_sweep.powi(3) * self.j_1 * a * a + self.j_3 * b.powi(4)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn isa(alt_ft: f64) -> Air {
+        let h = alt_ft * 0.3048;
+        Air { pressure_pa: isa_pressure(h), temperature_k: isa_temperature(h) }
+    }
+
+    /// Lift-to-drag ratios from pycontrails' own equations (data/external/papers/aero/ps_ld.py,
+    /// an independent Python implementation), 174 t, ISA, clean.
+    #[test]
+    fn polar_matches_the_independent_python_implementation() {
+        let cases = [
+            (35_000.0, 0.68, 20.82),
+            (25_000.0, 0.54, 21.01),
+            (15_000.0, 0.44, 21.19),
+            (5_000.0, 0.365, 21.36),
+            (35_000.0, 0.87, 17.4),
+            (35_000.0, 0.95, 8.2),
+        ];
+        for (alt, mach, expected) in cases {
+            let air = isa(alt);
+            let cl = 174_000.0 * G / (0.5 * KAPPA * air.pressure_pa * mach * mach * B772.wing_area_m2);
+            let ld = cl / B772.drag_coefficient(mach, cl, &air, &Increments::CLEAN);
+            assert!((ld - expected).abs() < 0.051, "FL{} M{mach}: L/D {ld:.3} vs {expected}", alt / 100.0);
+        }
+    }
+
+    /// Poll-Schumann thrust (pycontrails formula, computed in Python): 60.3 kN per engine at
+    /// FL400/M0.81, which is also the thrust implied by Boeing's single-engine deceleration.
+    #[test]
+    fn engine_thrust_matches_the_python_formula() {
+        let thrust = B772.engine_thrust(0.81, &isa(40_000.0));
+        assert!((thrust - 60_300.0).abs() < 100.0, "{thrust}");
+    }
+}
diff --git a/hypotheses/end-of-flight/calibrate.rs b/hypotheses/end-of-flight/calibrate.rs
