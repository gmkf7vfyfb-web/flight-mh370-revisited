@@ -0,0 +1,199 @@
+//! Calibration flights against Boeing's ten engineering-simulator exports.
+//!
+//! `cargo test --release -p mh370-hypotheses end_of_flight::calibrate -- --ignored` flies each
+//! case from its onset state (prepare/boeing-runs-targets.csv) in the simulator's fitted wind,
+//! over a small grid of the uncertain parameters, and writes 1 Hz X/Y/altitude traces in the
+//! exports' own form to runs/end-of-flight/prepare/calibration-traces.csv. The script
+//! prepare/boeing_runs.py then measures model and runs with the same code.
+
+use super::aero::{isa_temperature, Increments, B772};
+use super::flight::{Aircraft, Phase, Pitch, Roll, State, Weather, FT};
+use std::fmt::Write as _;
+
+const KT: f64 = 1852.0 / 3600.0;
+pub const MASS_KG: f64 = 174_500.0;
+
+/// The wind fitted to the long runs' loops: from 246 deg, 23.5 kt at sea level plus
+/// 0.79 kt per 1,000 ft up to 25,000 ft; ISA temperature.
+pub struct SimulatorWind;
+
+impl Weather for SimulatorWind {
+    fn sample(&self, _: f64, alt_ft: f64, _: f64, _: f64) -> (f64, f64, f64) {
+        let speed = (23.5 + 0.79 * alt_ft.clamp(0.0, 25_000.0) / 1000.0) * KT;
+        let towards = 66f64.to_radians();
+        (isa_temperature(alt_ft * FT), speed * towards.sin(), speed * towards.cos())
+    }
+}
+
+pub struct Case {
+    pub name: String,
+    pub long: bool,
+    /// Cruise state at the first flame-out, and the single-engine phase's length (s).
+    pub cruise: State,
+    pub single_engine_s: f64,
+    /// State at the second flame-out (long cases) or at the loss of control (short cases).
+    pub start: State,
+    pub eas_kt: f64,
+}
+
+pub fn cases() -> Vec<Case> {
+    let text = include_str!("prepare/boeing-runs-targets.csv");
+    let mut lines = text.lines().filter(|l| !l.starts_with('#'));
+    let header: Vec<&str> = lines.next().unwrap().split(',').collect();
+    let col = |row: &[&str], key: &str| row[header.iter().position(|h| *h == key).unwrap()].to_string();
+    lines
+        .map(|l| {
+            let row: Vec<&str> = l.split(',').collect();
+            let num = |k: &str| col(&row, k).parse::<f64>().unwrap();
+            Case {
+                name: col(&row, "case"),
+                long: col(&row, "regime") == "long",
+                cruise: State {
+                    unix_s: 0.0,
+                    lat_deg: 0.0,
+                    lon_deg: 90.0,
+                    alt_m: num("start_alt_ft") * FT,
+                    tas: num("start_tas_kt") * KT,
+                    gamma: 0.0,
+                    heading: num("heading_at_second_deg").to_radians(),
+                    bank: 0.0,
+                    sensed_eas: f64::NAN,
+                    reference_eas: f64::NAN,
+                },
+                single_engine_s: num("t_second_flameout_s") - num("t_first_flameout_s"),
+                start: State {
+                    unix_s: 0.0,
+                    lat_deg: 0.0,
+                    lon_deg: 90.0,
+                    alt_m: num("alt_at_second_ft") * FT,
+                    tas: num("tas_at_second_kt") * KT,
+                    gamma: num("gamma_at_second_deg").to_radians(),
+                    heading: num("heading_at_second_deg").to_radians(),
+                    bank: 0.0,
+                    sensed_eas: f64::NAN,
+                    reference_eas: f64::NAN,
+                },
+                eas_kt: num("eas_at_second_kt"),
+            }
+        })
+        .collect()
+}
+
+/// One uncontrolled descent from the onset state.
+pub fn fly(case: &Case, phase: Phase, trace: bool) -> super::flight::Flight {
+    let aircraft = Aircraft { aero: &B772, mass_kg: MASS_KG, weather: &SimulatorWind, stall_factor: 1.5, protected_factor: 1.15 };
+    aircraft.fly(case.start, &[(0.0, phase)], &[], 3600.0, 0.5, trace.then_some(1.0))
+}
+
+pub fn normal_law(case: &Case, floor_eas_kt: f64, ref_tau_s: f64, stiffness: f64, lag_s: f64, windmill_cd: f64, turn_rate_deg_s: f64) -> Phase {
+    Phase {
+        pitch: Pitch::Speed { ref_eas: case.eas_kt.max(floor_eas_kt) * KT, ref_tau_s, stiffness, damping: 0.0, lag_s },
+        roll: Roll::Asymmetry { turn_rate: turn_rate_deg_s.to_radians(), spiral: -1.0 / 60.0, protect: true, max_bank: 1.5 },
+        thrust: 0.0,
+        increments: Increments { windmill_cd, transonic_scale: 1.0, separation_k: 1.4 },
+    }
+}
+
+/// Stick-fixed trim from the loss of control, trimmed `offset` below one g, bank diverging in
+/// the direction of `turn_rate`.
+pub fn stick_fixed(case: &Case, tuck: f64, offset: f64, spiral: f64, turn_rate_deg_s: f64, transonic_scale: f64) -> Phase {
+    let air = super::aero::Air { pressure_pa: super::aero::isa_pressure(case.start.alt_m), temperature_k: isa_temperature(case.start.alt_m) };
+    let q = 0.5 * air.density() * case.start.tas * case.start.tas;
+    Phase {
+        pitch: Pitch::Trim {
+            cl_trim: (1.0 - offset) * MASS_KG * super::aero::G * case.start.gamma.cos() / (q * B772.wing_area_m2),
+            mach_trim: case.start.tas / air.speed_of_sound(),
+            tuck,
+        },
+        roll: Roll::Asymmetry { turn_rate: turn_rate_deg_s.to_radians(), spiral, protect: false, max_bank: 60f64.to_radians() },
+        thrust: 0.0,
+        increments: Increments { windmill_cd: 0.0045, transonic_scale, separation_k: 1.4 },
+    }
+}
+
+/// Boeing's driftdown figure (SIR App. 1.6E): "0.0034 nm per foot of altitude", 120 NM from
+/// FL350, with both engines windmilling and wings held level. Prints the model's best
+/// still-air glide from FL350 at the reference mass, started steady at the glide speed, as
+/// NM per foot of altitude and as L/D over the energy height lost (altitude plus V^2/2g).
+#[test]
+#[ignore]
+fn driftdown() {
+    let aircraft = Aircraft { aero: &B772, mass_kg: MASS_KG, weather: &super::flight::StillIsa, stall_factor: 1.5, protected_factor: 1.15 };
+    let alt = 35_000.0 * FT;
+    let sigma = (super::aero::isa_pressure(alt) / (287.052_87 * isa_temperature(alt)) / super::aero::SEA_LEVEL_DENSITY).sqrt();
+    for cd in [0.0, 0.001, 0.002, 0.003, 0.004, 0.005] {
+        let (nm, keas, ld) = (180..=260).step_by(5).map(|keas| {
+            let eas = f64::from(keas) * KT;
+            let start = State { unix_s: 0.0, lat_deg: 0.0, lon_deg: 90.0, alt_m: alt, tas: eas / sigma, gamma: -0.055, heading: 0.0, bank: 0.0, sensed_eas: f64::NAN, reference_eas: f64::NAN };
+            let glide = Phase {
+                pitch: Pitch::Speed { ref_eas: eas, ref_tau_s: 0.0, stiffness: 2.0, damping: 1.0, lag_s: 0.0 },
+                roll: Roll::Hold { bank: 0.0 },
+                thrust: 0.0,
+                increments: Increments { windmill_cd: cd, transonic_scale: 1.0, separation_k: 1.4 },
+            };
+            let f = aircraft.fly(start, &[(0.0, glide)], &[], 7200.0, 0.5, None);
+            let (rm, _) = geo::radii_of_curvature_km(0.0);
+            let metres = f.impact.unwrap().lat_deg.to_radians() * rm * 1000.0;
+            let energy = alt + (start.tas.powi(2) - f.last.tas.powi(2)) / (2.0 * super::aero::G);
+            (metres / 1852.0, keas, metres / energy)
+        }).fold((0.0, 0, 0.0), |a, b| if b.0 > a.0 { b } else { a });
+        println!("dCD {cd:.3}: best glide from FL350 {nm:.1} NM at {keas} KEAS = {:.5} NM/ft; L/D over energy height {ld:.1}", nm / 35_000.0);
+    }
+}
+
+#[test]
+#[ignore]
+fn calibration_traces() {
+    let mut out = String::from("set,case,t,x_nm,y_nm,alt_ft\n");
+    let mut record = |label: &str, case: &Case, flight: &super::flight::Flight| {
+        let (rm, rn) = geo::radii_of_curvature_km(0.0);
+        for s in &flight.trace {
+            let x = (s.lon_deg - 90.0).to_radians() * rn * 1000.0 / 1852.0;
+            let y = s.lat_deg.to_radians() * rm * 1000.0 / 1852.0;
+            writeln!(out, "{label},{},{:.0},{x:.4},{y:.4},{:.0}", case.name, s.unix_s, s.alt_ft).unwrap();
+        }
+        match (flight.impact, flight.trace.last()) {
+            (Some(s), Some(last)) if s.unix_s > last.unix_s + 0.5 => {
+                let x = (s.lon_deg - 90.0).to_radians() * rn * 1000.0 / 1852.0;
+                let y = s.lat_deg.to_radians() * rm * 1000.0 / 1852.0;
+                writeln!(out, "{label},{},{:.2},{x:.4},{y:.4},0", case.name, s.unix_s).unwrap();
+            }
+            _ => {}
+        }
+    };
+    let cases = cases();
+    // The autopilot's single-engine phase, from the first to the second flame-out.
+    for case in cases.iter().filter(|c| c.long) {
+        let aircraft = Aircraft { aero: &B772, mass_kg: MASS_KG, weather: &SimulatorWind, stall_factor: 1.5, protected_factor: 1.15 };
+        let phase = super::descent::single_engine_phase(&aircraft, &case.cruise);
+        record("single-engine", case, &aircraft.fly(case.cruise, &[(0.0, phase)], &[], case.single_engine_s, 0.5, Some(1.0)));
+    }
+    // The reference moves to the 195 KEAS floor with a 60 s time constant (Boeing's smooth
+    // approach after the disconnect); the lag sets how fast the phugoid grows, and linear
+    // theory makes that very sensitive near 1 s, so it is swept finely.
+    let mut sets = vec![];
+    for lag in [0.7, 0.8, 0.85, 0.9, 1.0] {
+        sets.push((0.0045, 0.8, lag, 195.0, 60.0));
+    }
+    for (cd, stiffness, lag, floor, tau) in sets {
+        let label = format!("normal cd{cd} k{stiffness} lag{lag} floor{floor} tau{tau}");
+        for case in cases.iter().filter(|c| c.long) {
+            record(&label, case, &fly(case, normal_law(case, floor, tau, stiffness, lag, cd, -0.7), true));
+        }
+    }
+    // Short runs: bank sign from the run (03 and 06 roll left, 04 and 10 right).
+    for tuck in [1.0, 2.0, 3.0] {
+        for offset in [0.0, 0.05, 0.1] {
+            for (spiral, scale) in [(1.0 / 120.0, 1.0), (1.0 / 60.0, 1.0), (1.0 / 120.0, 0.3)] {
+                let label = format!("trim tuck{tuck} offset{offset} spiral{:.0} wave{scale}", 1.0 / spiral);
+                for case in cases.iter().filter(|c| !c.long) {
+                    let sign = if case.name.ends_with("03") || case.name.ends_with("06") { -1.0 } else { 1.0 };
+                    record(&label, case, &fly(case, stick_fixed(case, tuck, offset, spiral, sign * 0.5, scale), true));
+                }
+            }
+        }
+    }
+    let dir = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../runs/end-of-flight/prepare");
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(dir.join("calibration-traces.csv"), out).unwrap();
+}
