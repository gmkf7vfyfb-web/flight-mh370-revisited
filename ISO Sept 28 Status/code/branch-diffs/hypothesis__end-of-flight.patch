@@ -0,0 +1,193 @@
+"""Per-hypothesis results of the standalone preview ensemble (preview.rs), as figures and a table.
+
+Hypotheses first: each ending's evidence from the log-on alone, per second of log-on time on one
+absolute scale, against the declared rate of other-cause log-ons (swept 0.1, 0.3, 1 per hour):
+the flame-out -> APU -> SDU lag under exhaustion before the log-on, the other-cause rate
+otherwise, no other-cause log-on before 00:19:29.416, and the aircraft still flying at 00:19:37.443.
+The posterior from equal priors is shown beside it; any other prior follows from the evidence.
+Then each ending's impact distance from the arc, and per ending each family, normalised on its own. Positions are measured from the aircraft's position at 00:19:29.416,
+which lies on the 7th arc: 'across' is the component towards (+) or away from (-) the
+satellite's sub-point (0 N, 64.5 E), i.e. inside or outside the arc. Where the core flew that
+epoch (takeover after it), the position comes from the hand-off's cruise, dead-reckoned. For a
+powered impact, 'from the flame-out point' is from the start of the powered descent.
+
+A physics preview and NOT EVIDENCE: still air, hand-offs from the base run's routes, the
+placeholder exhaustion window (to 01:16:05) and the log-on term only. Descents faster than
+Mach 0.89 (red) are extrapolated in every model, Boeing's included.
+
+Writes runs/end-of-flight/preview/preview-<ending>.png and preview-summary.csv. Run from the
+repository root.
+"""
+
+import pathlib
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
+
+ROOT = pathlib.Path(__file__).resolve().parents[3]
+DIR = ROOT / "runs/end-of-flight/preview"
+MASS_KG, NM, FPM = 174_500.0, 1852.0, 0.3048 / 60.0
+R_EARTH = 6_371_000.0
+LOGON = 1_394_237_969.416
+HANDOFF = 1_394_237_459.0
+RATES_PER_HOUR = [0.1, 0.3, 1.0]
+FINALS = 4
+ENDINGS = {
+    "exhausted-before-logon": ["normal-law", "stick-fixed", "glide", "ditching", "dive"],
+    "exhausted-after-logon": ["normal-law", "stick-fixed", "glide", "ditching", "dive"],
+    "powered-impact": ["powered-upset", "powered-dive", "powered-descent", "powered-ditching"],
+}
+
+
+def enu_offset(lat0, lon0, lat1, lon1):
+    """Local east/north offset (m) of point 1 from point 0 on a sphere."""
+    east = np.radians(lon1 - lon0) * R_EARTH * np.cos(np.radians(lat0))
+    north = np.radians(lat1 - lat0) * R_EARTH
+    return east, north
+
+
+def weighted_quantiles(x, w, q):
+    order = np.argsort(x)
+    c = np.cumsum(w[order]) / w.sum()
+    return np.interp(q, c, x[order])
+
+
+def logon_positions(d, handoffs):
+    """Position at 00:19:29.416: the descent's own, else the hand-off's cruise dead-reckoned."""
+    lat, lon = d["logon_lat"].astype(float), d["logon_lon"].astype(float)
+    h = handoffs[d["handoff"]]
+    dt = LOGON - h["unix_s"]
+    north = h["ground_speed_m_s"] * np.cos(np.radians(h["track_deg"])) * dt
+    east = h["ground_speed_m_s"] * np.sin(np.radians(h["track_deg"])) * dt
+    cruise_lat = h["lat_deg"] + np.degrees(north / R_EARTH)
+    cruise_lon = h["lon_deg"] + np.degrees(east / (R_EARTH * np.cos(np.radians(h["lat_deg"]))))
+    missing = ~np.isfinite(lat)
+    lat[missing], lon[missing] = cruise_lat[missing], cruise_lon[missing]
+    return lat, lon
+
+
+def logon_log_likelihood(d, rate_per_hour):
+    """The log-on term at a given other-cause rate, from the parts the preview stored."""
+    rate = rate_per_hour / 3600.0
+    quiet = -rate * (LOGON - HANDOFF)
+    ll = np.where(d["ending"] == "exhausted-before-logon", d["lag_log_density"], np.log(rate)) + quiet
+    return np.where(d["flying_at_ack"] == 1, ll, -np.inf)
+
+
+def main():
+    d = np.genfromtxt(DIR / "descents.csv", delimiter=",", names=True, dtype=None, encoding=None)
+    handoffs = np.genfromtxt(DIR / "handoffs.csv", delimiter=",", names=True)
+    children = len(set(zip(d["handoff"], d["child"])))
+    per_child = np.array([len(ENDINGS[e]) * FINALS for e in d["ending"]], dtype=float)
+    ok = np.isfinite(d["impact_unix_s"])
+
+    # Evidence per ending: the importance weights estimate P(e) Z_e; equal priors here.
+    lines = ["other_per_hour,ending,log_evidence_per_s,posterior_equal_priors"]
+    evidence = {}
+    for rate in RATES_PER_HOUR:
+        logw = d["log_proposal_correction"] + logon_log_likelihood(d, rate)
+        joint = {e: np.exp(logw[(d["ending"] == e) & ok] - 0.0) / per_child[(d["ending"] == e) & ok] for e in ENDINGS}
+        z = {e: w[np.isfinite(w)].sum() / children / (1 / 3) for e, w in joint.items()}
+        total = sum(z.values())
+        evidence[rate] = z
+        for e in ENDINGS:
+            lines.append(f"{rate},{e},{np.log(z[e]):.3f},{z[e] / total:.3f}")
+    (DIR / "preview-evidence.csv").write_text("\n".join(lines) + "\n")
+    print("\n".join(lines))
+
+    # Weights within each ending do not depend on the rate (a constant factor there).
+    logw = d["log_proposal_correction"] + logon_log_likelihood(d, 0.3)
+    good = ok & np.isfinite(logw)
+    weight = np.where(good, np.exp(np.where(good, logw, 0.0) - logw[good].max()) / per_child, 0.0)
+    logon_lat, logon_lon = logon_positions(d, handoffs)
+    e1, n1 = enu_offset(logon_lat, logon_lon, d["impact_lat"], d["impact_lon"])
+    se, sn = enu_offset(logon_lat, logon_lon, 0.0 * logon_lat, 64.5 + 0.0 * logon_lon)
+    unit = np.hypot(se, sn)
+    across_all = (e1 * se + n1 * sn) / unit / NM
+    along_all = (e1 * sn - n1 * se) / unit / NM
+
+    # Domain sizing: impact distance from the 00:19:29 position on the arc, per ending.
+    fig, axes = plt.subplots(2, 3, figsize=(16, 8))
+    rows_domain = ["ending,quantity,p01,p05,p50,p95,p99"]
+    for j, ending in enumerate(ENDINGS):
+        m = good & (d["ending"] == ending)
+        w = weight[m]
+        post = {r: evidence[r][ending] / sum(evidence[r].values()) for r in RATES_PER_HOUR}
+        ax = axes[0, j]
+        ax.hist(across_all[m], bins=60, weights=w / w.sum())
+        ax.set_xlabel("NM across the 7th arc from the 00:19:29 position (+ inside)")
+        ax.set_title(f"{ending}\nposterior (equal priors, log-on only) " + ", ".join(f"{p:.2f}@{r}/h" for r, p in post.items()), fontsize=9)
+        axes[1, j].hist((d["impact_unix_s"][m] - 1_394_236_800) / 60.0, bins=60, weights=w / w.sum(), color="C1")
+        axes[1, j].set_xlabel("impact time, minutes after 00:00 UTC")
+        for name, v in [("across_arc_nm", across_all[m]), ("distance_from_logon_position_nm", np.hypot(across_all[m], along_all[m])),
+                        ("impact_minutes_after_0000", (d["impact_unix_s"][m] - 1_394_236_800) / 60.0)]:
+            q = weighted_quantiles(v, w, [0.01, 0.05, 0.5, 0.95, 0.99])
+            rows_domain.append(f"{ending},{name}," + ",".join(f"{x:.1f}" for x in q))
+    fig.suptitle("PREVIEW, NOT EVIDENCE: impact distance from the arc and impact time per ending "
+                 "(still air, placeholder exhaustion window to 01:16:05, families at their priors)", fontsize=11)
+    fig.tight_layout(rect=(0, 0, 1, 0.95))
+    fig.savefig(DIR / "preview-endings.png", dpi=65)
+    plt.close(fig)
+    (DIR / "preview-domain.csv").write_text("\n".join(rows_domain) + "\n")
+    print("\n".join(rows_domain))
+
+    rows = []
+    for ending, families in ENDINGS.items():
+        in_ending = d["ending"] == ending
+        fig, axes = plt.subplots(6, len(families), figsize=(4.2 * len(families), 20))
+        for j, fam in enumerate(families):
+            m = in_ending & (d["family"] == fam) & good
+            w = weight[m]
+            x = d[m]
+            ess = w.sum() ** 2 / (w ** 2).sum() if w.sum() > 0 else 0.0
+            minutes = (x["impact_unix_s"] - np.where(fam.startswith("powered"), x["first_unix_s"], x["second_unix_s"])) / 60.0
+            e0, n0 = enu_offset(x["second_lat"], x["second_lon"], x["impact_lat"], x["impact_lon"])
+            from_start = np.hypot(e0, n0) / NM
+            across, along = across_all[m], along_all[m]
+            v2 = x["impact_v_east"] ** 2 + x["impact_v_north"] ** 2 + x["impact_v_up"] ** 2
+            ke_total = 0.5 * MASS_KG * v2 / 1e9
+            sink = -x["impact_v_up"] / FPM
+            hot = x["extrapolated_s"] > 0
+            row = {"ending": ending, "family": fam, "family_weight_within_ending": round(w.sum() / weight[in_ending & good].sum(), 3),
+                   "descents": int(m.sum()), "ess": round(ess, 1),
+                   "share_extrapolated": round(float(np.average(hot, weights=w)), 3)}
+            stats = {"minutes": minutes, "from_start_nm": from_start, "across_arc_nm": across, "along_arc_nm": along,
+                     "ke_total_gj": ke_total, "impact_sink_fpm": sink}
+            for k, v in stats.items():
+                q = weighted_quantiles(v, w, [0.05, 0.5, 0.95])
+                row.update({f"{k}_p05": round(q[0], 2), f"{k}_p50": round(q[1], 2), f"{k}_p95": round(q[2], 2)})
+            rows.append(row)
+            ax = axes[:, j]
+            ax[0].set_title(f"{fam}: ESS {ess:.0f} of {m.sum()}\n{row['share_extrapolated']:.0%} extrapolated (above M0.89, red)", fontsize=10)
+            ax[0].scatter(along[~hot], across[~hot], s=3, c="C0", alpha=0.5)
+            ax[0].scatter(along[hot], across[hot], s=3, c="C3", alpha=0.5)
+            ax[0].axhline(0, color="k", lw=0.5)
+            ax[0].set_xlabel("along the arc from the 00:19:29 position, NM")
+            ax[0].set_ylabel("across the arc, NM (+ towards the satellite)")
+            start = "start of powered descent" if fam.startswith("powered") else "2nd flame-out"
+            for a, (v, label) in zip(ax[1:], [(minutes, f"minutes from {start} to the sea"),
+                                              (from_start, f"NM from the {start} point"),
+                                              (across, "NM across the 7th arc (+ inside)"),
+                                              (ke_total, "kinetic energy at impact, GJ"),
+                                              (sink, "descent rate at impact, fpm")]):
+                a.hist([v[~hot], v[hot]], bins=40, weights=[w[~hot] / w.sum(), w[hot] / w.sum()], color=["C0", "C3"], stacked=True)
+                a.set_xlabel(label)
+                for qq in weighted_quantiles(v, w, [0.05, 0.5, 0.95]):
+                    a.axvline(qq, color="k", lw=0.6, ls=":")
+        fig.suptitle(f"PREVIEW, NOT EVIDENCE. Hypothesis {ending}, its families (still air, placeholder exhaustion window). "
+                     "Red: above Mach 0.89, extrapolated in every model.", fontsize=12)
+        fig.tight_layout(rect=(0, 0, 1, 0.975))
+        fig.savefig(DIR / f"preview-{ending}.png", dpi=55)
+        plt.close(fig)
+    keys = list(rows[0])
+    with open(DIR / "preview-summary.csv", "w") as f:
+        f.write(",".join(keys) + "\n")
+        for r in rows:
+            f.write(",".join(str(r[k]) for k in keys) + "\n")
+
+
+if __name__ == "__main__":
+    main()
