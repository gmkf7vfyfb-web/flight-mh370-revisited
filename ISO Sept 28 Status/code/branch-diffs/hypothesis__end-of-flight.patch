+++ b/hypotheses/end-of-flight/preview.rs
@@ -0,0 +1,129 @@
+//! Standalone preview ensemble until the terminal hook exists (ignored test):
+//! `cargo test --release -p mh370-hypotheses end_of_flight::preview -- --ignored`.
+//!
+//! Follows the hook's shape. From each hand-off in runs/end-of-flight/preview/handoffs.csv
+//! (prepare/handoffs.py) it draws several children; each draws the takeover time from the
+//! mixture over the endings, dead-reckons the cruise to it, picks the ending given that time,
+//! and samples every family of that ending with the two-pass sampler (stratified, with the
+//! family prior as a correction). Epochs at or before the takeover belong to the core and are
+//! left out. The proposal adapts to the log-on term only; the runner will add the 00:19
+//! BTO/BFO options. Still ISA air; placeholder exhaustion window. Writes one row per final
+//! descent to runs/end-of-flight/preview/descents.csv for prepare/preview.py.
+
+use super::aero::B772;
+use super::descent::{descend, Descent, LATENT_COLUMNS};
+use super::endings::{Ending, Takeover, Timing};
+use super::families::{POWERED, UNPOWERED};
+use super::flight::{Aircraft, State, StillIsa, FT};
+use super::sampler::{sample, Settings};
+use super::timing::{Lag, Logon, ACK_UNIX_S, LOGON_UNIX_S};
+use std::fmt::Write as _;
+
+const HANDOFFS: usize = 100;
+const CHILDREN: usize = 8;
+const MASS_KG: f64 = 174_500.0;
+
+/// splitmix64: the runner will supply uniforms; the preview makes its own.
+struct Uniforms(u64);
+
+impl Uniforms {
+    fn next(&mut self) -> f64 {
+        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        (((z ^ (z >> 31)) >> 11) as f64 + 0.5) / (1u64 << 53) as f64
+    }
+}
+
+#[test]
+#[ignore]
+fn preview_ensemble() {
+    let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../runs/end-of-flight/preview");
+    let text = std::fs::read_to_string(root.join("handoffs.csv")).expect("run prepare/handoffs.py first");
+    let handoffs: Vec<Vec<f64>> = text.lines().skip(1).take(HANDOFFS).map(|l| l.split(',').map(|v| v.parse().unwrap()).collect()).collect();
+    // The proposal adapts at a middle other-cause rate; the weights stay exact whatever the
+    // rate, and prepare/preview.py recomputes the log-on term across the sweep.
+    let logon = Logon { lag: Lag { mean_s: 120.0, sd_s: 20.0 }, other_per_hour: 0.3 };
+    let timing = Timing { priors: [1.0, 1.0, 1.0], max_gap_s: 900.0, exhaustion_unix_s: f64::NAN };
+    let settings = Settings { pilots: 12, rounds: 1, finals: 4, centres: 8, half_width: 0.1, prior_share: 0.5 };
+    let aircraft = Aircraft { aero: &B772, mass_kg: MASS_KG, weather: &StillIsa, stall_factor: 1.5, protected_factor: 1.15 };
+    let threads = std::thread::available_parallelism().map_or(4, |n| n.get());
+    let chunks: Vec<String> = std::thread::scope(|scope| {
+        let workers: Vec<_> = (0..threads)
+            .map(|w| {
+                let (handoffs, aircraft) = (&handoffs, &aircraft);
+                scope.spawn(move || {
+                    let mut out = String::new();
+                    for (h, row) in handoffs.iter().enumerate().skip(w).step_by(threads) {
+                        let mut rng = Uniforms(0xD1CE_0000 + h as u64);
+                        let (t0, lat, lon, alt_ft, track, speed) = (row[2], row[3], row[4], row[5], row[6].to_radians(), row[7]);
+                        for child in 0..CHILDREN {
+                            let (t, takeover_share) = timing.takeover_time(rng.next(), rng.next());
+                            let (lat1, lon1) = geo::advance(lat, lon, alt_ft, speed * track.cos() * 3600.0 / 1852.0, speed * track.sin() * 3600.0 / 1852.0, t - t0);
+                            let start = State { unix_s: t, lat_deg: lat1, lon_deg: lon1, alt_m: alt_ft * FT, tas: speed, gamma: 0.0, heading: track, bank: 0.0, sensed_eas: f64::NAN, reference_eas: f64::NAN };
+                            let pick = rng.next();
+                            let ending = timing.takeover(t, pick, 0.5).0.ending;
+                            let set: &[_] = if ending == Ending::PoweredImpact { &POWERED } else { &UNPOWERED };
+                            let epochs: Vec<f64> = [LOGON_UNIX_S, ACK_UNIX_S].into_iter().filter(|&e| e > t).collect();
+                            for &family in set {
+                                let stratum = (family.prior_within(set) * set.len() as f64).ln();
+                                let simulate = |u: &[f64]| {
+                                    let (takeover, share) = timing.takeover(t, pick, u[0]);
+                                    let d = descend(aircraft, start, &takeover, family, &u[1..], &epochs, 0.5);
+                                    let valid = if d.powered_in_time() { 0.0 } else { f64::NEG_INFINITY };
+                                    (d, share + stratum + valid)
+                                };
+                                let own = |d: &Descent| {
+                                    let takeover = Takeover { ending: d.ending, unix_s: d.first_unix_s, second_unix_s: d.second_unix_s };
+                                    timing.logon_log_likelihood(&logon, &takeover, d.flight.impact.map(|i| i.unix_s))
+                                };
+                                for (d, correction) in sample(&settings, 1 + family.dimension(), &mut || rng.next(), &simulate, &own) {
+                                    write_row(&mut out, h, child, &d, takeover_share + correction, &logon, &epochs);
+                                }
+                            }
+                        }
+                    }
+                    out
+                })
+            })
+            .collect();
+        workers.into_iter().map(|w| w.join().unwrap()).collect()
+    });
+    let mut out = String::from("handoff,child,ending,family,log_proposal_correction,lag_log_density,flying_at_ack,first_unix_s,second_unix_s,second_lat,second_lon,second_alt_ft");
+    for tag in ["logon", "ack"] {
+        for c in ["lat", "lon", "alt_ft", "v_east", "v_north", "v_up"] {
+            write!(out, ",{tag}_{c}").unwrap();
+        }
+    }
+    out.push_str(",impact_unix_s,impact_lat,impact_lon,impact_v_east,impact_v_north,impact_v_up,impact_tas,impact_gamma");
+    for c in LATENT_COLUMNS {
+        write!(out, ",{c}").unwrap();
+    }
+    out.push('\n');
+    out.extend(chunks);
+    std::fs::write(root.join("descents.csv"), out).unwrap();
+}
+
+/// One row: the log-on term is stored in parts (the exhaustion lag density and whether the
+/// aircraft was still flying at the acknowledgement) so that any other-cause rate can be applied.
+fn write_row(out: &mut String, handoff: usize, child: usize, d: &Descent, log_correction: f64, logon: &Logon, epochs: &[f64]) {
+    let flying = d.flight.impact.is_none_or(|i| i.unix_s >= ACK_UNIX_S);
+    let lag = logon.lag.log_likelihood(LOGON_UNIX_S - d.second_unix_s);
+    write!(out, "{handoff},{child},{},{},{:.6},{:.6},{},{:.2},{:.2},{:.5},{:.5},{:.0}", d.ending.name(), d.family.name(), log_correction, lag, u8::from(flying), d.first_unix_s, d.second_unix_s, d.at_second.lat_deg, d.at_second.lon_deg, d.at_second.alt_ft).unwrap();
+    // One column group per 00:19 epoch; empty where the core flew it or the aircraft was down.
+    for target in [LOGON_UNIX_S, ACK_UNIX_S] {
+        match epochs.iter().position(|&x| x == target).and_then(|i| d.flight.epochs[i]) {
+            Some(s) => write!(out, ",{:.5},{:.5},{:.0},{:.2},{:.2},{:.2}", s.lat_deg, s.lon_deg, s.alt_ft, s.velocity_east, s.velocity_north, s.velocity_up).unwrap(),
+            None => out.push_str(",,,,,,"),
+        }
+    }
+    match d.flight.impact {
+        Some(i) => write!(out, ",{:.2},{:.5},{:.5},{:.2},{:.2},{:.2},{:.2},{:.4}", i.unix_s, i.lat_deg, i.lon_deg, i.velocity_east, i.velocity_north, i.velocity_up, i.tas, i.gamma).unwrap(),
+        None => out.push_str(",,,,,,,,"),
+    }
+    for v in d.latents(epochs) {
+        write!(out, ",{v:.4}").unwrap();
+    }
+    out.push('\n');
+}
