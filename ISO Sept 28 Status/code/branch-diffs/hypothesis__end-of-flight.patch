--- /dev/null
+++ b/hypotheses/end-of-flight/proposal.rs
@@ -0,0 +1,161 @@
+//! Adaptive defensive proposal on a unit cube, for descents consistent with the 00:19 data.
+//!
+//! Two passes, as agreed with the architecture: pilot draws from the prior are scored with the
+//! runner's callback; the proposal is then fixed and every final draw comes from it fresh.
+//! Pilot draws never enter the final weights. The proposal stays defensive: a share of plain
+//! prior draws (at least half by default) keeps every 00:19 data option, including none,
+//! weighted from the same draws.
+//!
+//! q(x) = s + (1 - s) * mean over centres of the uniform density on a box about the centre,
+//! clipped to the cube. The prior is uniform on the cube, so ln(p/q) = -ln q(x). Boxes span
+//! only the coordinates the pilots constrain (weighted spread under 0.2, against 0.289 for a
+//! uniform); the others keep their full prior range, so parameters the data do not see are not
+//! narrowed around a few pilot values. In a constrained coordinate the half-width is three
+//! weighted standard deviations of the pilots, but never less than half the pilots' spacing in
+//! the constrained subspace (a few heavy pilots can understate the spread) nor more than a set
+//! maximum.
+
+/// Proposal on [0, 1]^d.
+#[derive(Debug, Clone)]
+pub struct BoxMixture {
+    prior_share: f64,
+    /// Per coordinate; 0.5 or more spans the whole range (inactive).
+    half_widths: Vec<f64>,
+    centres: Vec<Vec<f64>>,
+}
+
+impl BoxMixture {
+    /// The plain prior.
+    pub fn prior() -> Self {
+        BoxMixture { prior_share: 1.0, half_widths: Vec::new(), centres: Vec::new() }
+    }
+
+    /// Fit to pilot draws with log target weights: `n_centres` centres resampled in proportion
+    /// to weight (systematic, from one uniform), boxes at most `max_half_width` wide each way,
+    /// prior share `prior_share`. Falls back to the prior when no pilot has finite weight.
+    pub fn fit(points: &[Vec<f64>], log_weights: &[f64], n_centres: usize, max_half_width: f64, prior_share: f64, u: f64) -> Self {
+        let top = log_weights.iter().copied().filter(|w| w.is_finite()).fold(f64::NEG_INFINITY, f64::max);
+        if !top.is_finite() || n_centres == 0 {
+            return Self::prior();
+        }
+        let w: Vec<f64> = log_weights.iter().map(|l| if l.is_finite() { (l - top).exp() } else { 0.0 }).collect();
+        let total: f64 = w.iter().sum();
+        let mut centres = Vec::with_capacity(n_centres);
+        let (mut cum, mut i) = (w[0] / total, 0);
+        for k in 0..n_centres {
+            let target = (k as f64 + u) / n_centres as f64;
+            while cum < target && i + 1 < w.len() {
+                i += 1;
+                cum += w[i] / total;
+            }
+            centres.push(points[i].clone());
+        }
+        let spread: Vec<f64> = (0..points[0].len())
+            .map(|j| {
+                let mean = points.iter().zip(&w).map(|(p, w)| p[j] * w).sum::<f64>() / total;
+                (points.iter().zip(&w).map(|(p, w)| (p[j] - mean).powi(2) * w).sum::<f64>() / total).sqrt()
+            })
+            .collect();
+        let constrained = spread.iter().filter(|&&sd| sd < 0.2).count().max(1);
+        let spacing = 0.5 * (points.len() as f64).powf(-1.0 / constrained as f64);
+        let half_widths = spread.iter().map(|&sd| if sd < 0.2 { (3.0 * sd).max(spacing).min(max_half_width) } else { 1.0 }).collect();
+        BoxMixture { prior_share, half_widths, centres }
+    }
+
+    fn bounds(&self, j: usize, c: f64) -> (f64, f64) {
+        let h = self.half_widths[j];
+        ((c - h).max(0.0), (c + h).min(1.0))
+    }
+
+    /// Density on the unit cube.
+    pub fn density(&self, x: &[f64]) -> f64 {
+        if self.centres.is_empty() {
+            return 1.0;
+        }
+        let boxes: f64 = self
+            .centres
+            .iter()
+            .map(|c| {
+                c.iter().zip(x).enumerate().map(|(j, (&ci, &xi))| {
+                    let (lo, hi) = self.bounds(j, ci);
+                    if xi >= lo && xi <= hi { 1.0 / (hi - lo) } else { 0.0 }
+                })
+                .product::<f64>()
+            })
+            .sum::<f64>()
+            / self.centres.len() as f64;
+        self.prior_share + (1.0 - self.prior_share) * boxes
+    }
+
+    /// A draw of dimension `d` and its ln(prior / proposal).
+    pub fn draw(&self, d: usize, uniform: &mut dyn FnMut() -> f64) -> (Vec<f64>, f64) {
+        let x: Vec<f64> = if self.centres.is_empty() || uniform() < self.prior_share {
+            (0..d).map(|_| uniform()).collect()
+        } else {
+            let k = ((uniform() * self.centres.len() as f64) as usize).min(self.centres.len() - 1);
+            self.centres[k].iter().enumerate().map(|(j, &c)| {
+                let (lo, hi) = self.bounds(j, c);
+                lo + uniform() * (hi - lo)
+            })
+            .collect()
+        };
+        let log_correction = -self.density(&x).ln();
+        (x, log_correction)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn stream(seed: u64) -> impl FnMut() -> f64 {
+        let mut s = seed;
+        move || {
+            s = s.wrapping_add(0x9E37_79B9_7F4A_7C15);
+            let mut z = s;
+            z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+            z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+            (((z ^ (z >> 31)) >> 11) as f64 + 0.5) / (1u64 << 53) as f64
+        }
+    }
+
+    /// A narrow likelihood on the first two coordinates, standing in for the runner's 00:19
+    /// score; the third coordinate is a parameter the data do not see.
+    fn target(x: &[f64]) -> f64 {
+        -0.5 * (((x[0] - 0.3) / 0.03).powi(2) + ((x[1] - 0.8) / 0.03).powi(2))
+    }
+
+    /// The proposal is a density (integrates to one), its weights are exact (weighted mean of
+    /// x0 against the known 0.3), the free coordinate keeps its uniform spread, and it is far
+    /// more efficient than drawing from the prior.
+    #[test]
+    fn adapted_weights_are_exact_and_efficient() {
+        let mut uniform = stream(7);
+        let pilots: Vec<Vec<f64>> = (0..400).map(|_| (0..3).map(|_| uniform()).collect()).collect();
+        let logw: Vec<f64> = pilots.iter().map(|x| target(x)).collect();
+        let q = BoxMixture::fit(&pilots, &logw, 32, 0.1, 0.5, uniform());
+        assert!(q.half_widths[0] < 0.2 && q.half_widths[1] < 0.2 && q.half_widths[2] >= 0.5, "{:?}", q.half_widths);
+        // Draws and density agree: E_q[p/q] = 1 (the prior is uniform on the cube).
+        let n = 200_000;
+        let mean_ratio = (0..n).map(|_| q.draw(3, &mut uniform).1.exp()).sum::<f64>() / n as f64;
+        assert!((mean_ratio - 1.0).abs() < 0.02, "E_q[p/q] = {mean_ratio}");
+        let estimate = |q: &BoxMixture, uniform: &mut dyn FnMut() -> f64| {
+            let draws: Vec<(Vec<f64>, f64)> = (0..4000).map(|_| {
+                let (x, c) = q.draw(3, uniform);
+                let lw = c + target(&x);
+                (x, lw)
+            }).collect();
+            let top = draws.iter().map(|d| d.1).fold(f64::MIN, f64::max);
+            let w: Vec<f64> = draws.iter().map(|d| (d.1 - top).exp()).collect();
+            let s: f64 = w.iter().sum();
+            let mean = |j: usize| draws.iter().zip(&w).map(|(d, w)| d.0[j] * w).sum::<f64>() / s;
+            let (m2, free) = (mean(2), draws.iter().zip(&w).map(|(d, w)| d.0[2] * d.0[2] * w).sum::<f64>() / s);
+            (mean(0), (free - m2 * m2).sqrt(), s * s / w.iter().map(|w| w * w).sum::<f64>())
+        };
+        let (mean, free_sd, ess) = estimate(&q, &mut uniform);
+        let (_, _, ess_prior) = estimate(&BoxMixture::prior(), &mut uniform);
+        assert!((mean - 0.3).abs() < 0.005, "{mean}");
+        assert!((free_sd - 12f64.sqrt().recip()).abs() < 0.02, "free coordinate sd {free_sd}");
+        assert!(ess > 10.0 * ess_prior, "adapted ESS {ess:.0}, prior {ess_prior:.1}");
+    }
+}
