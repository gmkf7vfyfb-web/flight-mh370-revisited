+# Ocean models and shared inputs for drift products (crates/ocean, `mh370 drift`).
+# Each model key below is a current field and is also the model's name in the shared
+# 'ocean-model' alternative. The fields live outside git (data/external is
+# /jackbox/home/MH370-inputs); README (Data) gives their provenance, and
+# .sources/ocean-drift/ holds the scripts that build them.
+
+[inputs]
+# CMEMS GLORYS12V1 surface (0.494 m) currents, 1/12 deg, daily means stamped at 12:00 UTC.
+glorys12 = "../data/external/ocean/glorys12/glorys12-surface-currents.mhgrid"
+# OSCAR v2.0 Final total current (top 30 m mean; includes a wind-driven Ekman term), 0.25 deg,
+# daily means stamped at 12:00 UTC, 2014-03-07 to 2016-08-31, 0-180E, 55S-15N. Its coast
+# includes near-shore cells it leaves undefined on some days (see oscar.py).
+oscar2 = "../data/external/ocean/oscar2/oscar2-currents-20140307-20160831.mhgrid"
+# CSIRO BRAN2016 (OFAM3) surface (2.5 m) current, 0.1 deg, daily means stamped at 12:00 UTC,
+# 2014-03-07 to 2016-08-31 (BRAN2016 ends in August 2016), 20-150E, 55S-5N. Free to use with
+# CSIRO Bluelink's acknowledgement.
+bran2016 = "../data/external/ocean/bran2016/bran2016-currents-20140307-20160831.mhgrid"
+# CMEMS WAVERYS surface Stokes drift, 0.2 deg, 3-hourly.
+waverys = "../data/external/ocean/waverys/waverys-stokes.mhgrid"
+# ERA5 10 m wind, 0.25 deg, hourly, 2014-03-07 to 2014-05-31, 50-135E, 55S-5N.
+era5_wind_hourly = "../data/external/ocean/era5-wind10/era5-wind10-hourly-20140307-20140531.mhgrid"
+# ERA5 10 m wind, 0.5 deg, 3-hourly, 2014-03-07 to 2016-08-31, 0-180E, 55S-15N (long runs).
+era5_wind_3h = "../data/external/ocean/era5-wind10/era5-wind10-3h-0p5-20140307-20160831.mhgrid"
+# NOAA Global Drifter Program 6-hourly positions, 30-115E, 50S-5N, with drogue-loss times.
+gdp_2014 = "../data/external/ocean/gdp/gdp_6hour_2014.csv"
+gdp_2015 = "../data/external/ocean/gdp/gdp_6hour_2015.csv"
+gdp_2016 = "../data/external/ocean/gdp/gdp_6hour_2016.csv"
+# SATCOM observations and ephemeris, to place the 7th arc for ensemble source grids.
+satcom_observations = "../data/satcom-observations.csv"
+satcom_ephemeris = "../data/satellite-ephemeris.csv"
+# GSHHG 2.3.7 full-resolution land, 30 arc-second raster, 0-180E, 55S-15N.
+gshhg_land = "../data/external/ocean/gshhg/gshhg-f-land-30s.mhland"
