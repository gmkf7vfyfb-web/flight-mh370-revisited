+++ b/.sources/ocean-drift/cmems.py
@@ -0,0 +1,214 @@
+#!/usr/bin/env python3
+"""Copernicus Marine surface fields for crates/ocean: retrieval and conversion to MHGRID.
+
+Datasets (0-180E, 55S-15N, 2014-03-07 to 2017-01-31):
+  glorys12  GLOBAL_MULTIYEAR_PHY_001_030 / cmems_mod_glo_phy_my_0.083deg_P1D-m,
+            uo/vo at the top level (0.494 m), 1/12 deg, daily means.
+  waverys   GLOBAL_MULTIYEAR_WAV_001_032 / cmems_mod_glo_wav_my_0.2deg_PT3H-i
+            (version 202411), surface Stokes drift VSDX/VSDY, 0.2 deg, 3-hourly
+            instantaneous.
+
+  cmems.py retrieve glorys12 --raw <dir>     monthly netCDF files via the copernicusmarine
+                                             toolbox; needs COPERNICUSMARINE_SERVICE_USERNAME
+                                             and _PASSWORD (Pete's login; ask before use)
+  cmems.py convert glorys12 --raw <dir> --output <file.mhgrid>
+  cmems.py check glorys12 --raw <dir> --against <file.mhgrid> [--every 29]
+
+Conversion reads the packed int16 values directly (h5py) and treats only _FillValue
+as absent. netCDF4's automatic valid_min/valid_max masking must not be used: the
+previous converter lost every GLORYS12 current beyond -1.91/+2.63 m/s that way (the
+Agulhas and Somali currents). Cells absent at every time in both components are
+written as land; any other absent value stays missing. GLORYS12 daily means are
+stamped at 00:00 of their day upstream; they are written at 12:00, the centre of
+the averaging day. WAVERYS fields are instantaneous and keep their stamps.
+`check` compares sampled slices with an existing file, e.g. the previous conversion.
+"""
+
+import argparse
+import calendar
+import json
+import os
+import subprocess
+import sys
+from datetime import date, datetime, timedelta, timezone
+from pathlib import Path
+
+import h5py
+import numpy as np
+
+import mhgrid
+
+EPOCH_1950 = datetime(1950, 1, 1, tzinfo=timezone.utc).timestamp()
+DATASETS = {
+    "glorys12": {
+        "product": "GLOBAL_MULTIYEAR_PHY_001_030",
+        "dataset": "cmems_mod_glo_phy_my_0.083deg_P1D-m",
+        "toolbox_extra": ["--minimum-depth", "0.49402499198913574", "--maximum-depth", "0.49402499198913574"],
+        "variables": ("uo", "vo"),
+        "pattern": "cmems-glorys12-surface-{:%Y-%m}.nc",
+        "time_shift_s": 43_200.0,
+        "name": "CMEMS GLORYS12V1 surface current (0.494 m), daily mean",
+    },
+    "waverys": {
+        "product": "GLOBAL_MULTIYEAR_WAV_001_032",
+        "dataset": "cmems_mod_glo_wav_my_0.2deg_PT3H-i",
+        "toolbox_extra": ["--dataset-version", "202411", "--dataset-part", "default"],
+        "variables": ("VSDX", "VSDY"),
+        "pattern": "cmems-waverys-stokes-{:%Y-%m}.nc",
+        "time_shift_s": 0.0,
+        "name": "CMEMS WAVERYS surface Stokes drift, 3-hourly instantaneous",
+    },
+}
+FIRST, LAST = date(2014, 3, 7), date(2017, 1, 31)
+BOUNDS = {"west": 0.0, "east": 180.0, "south": -55.0, "north": 15.0}
+SCALE = 0.001
+
+
+def months():
+    first = FIRST
+    while first <= LAST:
+        last = min(LAST, date(first.year, first.month, calendar.monthrange(first.year, first.month)[1]))
+        yield first, last
+        first = last + timedelta(1)
+
+
+def retrieve(spec, raw):
+    for user in ("COPERNICUSMARINE_SERVICE_USERNAME", "COPERNICUSMARINE_SERVICE_PASSWORD"):
+        if user not in os.environ:
+            sys.exit(f"{user} is not set")
+    raw.mkdir(parents=True, exist_ok=True)
+    for first, last in months():
+        name = spec["pattern"].format(first)
+        if (raw / name).exists():
+            continue
+        command = ["copernicusmarine", "subset", "--dataset-id", spec["dataset"], *spec["toolbox_extra"],
+                   *sum((["--variable", v] for v in spec["variables"]), []),
+                   "--start-datetime", f"{first}T00:00:00Z", "--end-datetime", f"{last}T23:59:59Z",
+                   "--minimum-longitude", str(BOUNDS["west"]), "--maximum-longitude", str(BOUNDS["east"]),
+                   "--minimum-latitude", str(BOUNDS["south"]), "--maximum-latitude", str(BOUNDS["north"]),
+                   "--coordinates-selection-method", "outside", "--output-directory", str(raw),
+                   "--output-filename", name, "--file-format", "netcdf", "--disable-progress-bar"]
+        subprocess.run(command, check=True)
+
+
+class Source:
+    """The monthly files of one dataset, read slice by slice as float (NaN = _FillValue)."""
+
+    def __init__(self, spec, raw):
+        self.spec, self.files = spec, [raw / spec["pattern"].format(first) for first, _ in months()]
+        self.times, self.index = [], []
+        for n, path in enumerate(self.files):
+            with h5py.File(path, "r") as f:
+                if n == 0:
+                    self.latitudes = f["latitude"][:].astype(np.float64)
+                    self.longitudes = f["longitude"][:].astype(np.float64)
+                elif not (np.array_equal(f["latitude"][:], self.latitudes) and np.array_equal(f["longitude"][:], self.longitudes)):
+                    raise ValueError(f"{path.name}: grid differs")
+                if f["time"].attrs["units"] not in (b"hours since 1950-01-01", "hours since 1950-01-01"):
+                    raise ValueError(f"{path.name}: unexpected time units")
+                hours = f["time"][:].astype(np.float64)
+                self.times.extend(EPOCH_1950 + 3600.0 * hours + spec["time_shift_s"])
+                self.index.extend((n, k) for k in range(len(hours)))
+        if not np.all(np.diff(self.times) > 0):
+            raise ValueError("times overlap or repeat")
+
+    def slice(self, t):
+        n, k = self.index[t]
+        with h5py.File(self.files[n], "r") as f:
+            out = []
+            for name in self.spec["variables"]:
+                var = f[name]
+                packed = var[k, 0] if var.ndim == 4 else var[k]
+                scale = float(np.ravel(var.attrs["scale_factor"])[0])
+                offset = float(np.ravel(var.attrs.get("add_offset", [0.0]))[0])
+                fill = np.ravel(var.attrs["_FillValue"])[0]
+                out.append(np.where(packed == fill, np.nan, packed * scale + offset))
+            return out
+
+
+def convert(spec, raw, output):
+    source = Source(spec, raw)
+    # Land: absent in both components at every time. First pass over the absent-value masks.
+    absent_always = None
+    for t in range(len(source.times)):
+        u, v = source.slice(t)
+        absent = np.isnan(u) & np.isnan(v)
+        absent_always = absent if absent_always is None else absent_always & absent
+    writer = mhgrid.Writer(output, source.times, source.latitudes, source.longitudes, ["u", "v"], SCALE)
+    missing_counts = [0, 0]
+    for t in range(len(source.times)):
+        for c, values in enumerate(source.slice(t)):
+            missing_counts[c] += int(np.count_nonzero(np.isnan(values) & ~absent_always))
+            writer.write(t, c, writer.pack(values, land=absent_always))
+    digest = writer.close()
+    manifest = {
+        "name": spec["name"],
+        "product": spec["product"],
+        "dataset": spec["dataset"],
+        "variables": list(spec["variables"]),
+        "time": {"first_utc": iso(source.times[0]), "last_utc": iso(source.times[-1]), "count": len(source.times),
+                 "shift_applied_s": spec["time_shift_s"]},
+        "grid": {"latitude": [source.latitudes[0], source.latitudes[-1], len(source.latitudes)],
+                 "longitude": [source.longitudes[0], source.longitudes[-1], len(source.longitudes)]},
+        "packing": {"scale": SCALE, "offset": 0.0, "missing": mhgrid.MISSING, "land": mhgrid.LAND},
+        "land_cells": int(absent_always.sum()),
+        "missing_values_off_land": {"u": missing_counts[0], "v": missing_counts[1]},
+        "sources": {p.name: mhgrid.sha256(p) for p in source.files},
+        "sha256": digest,
+        "created_utc": datetime.now(timezone.utc).isoformat(timespec="seconds"),
+    }
+    Path(str(output) + ".json").write_text(json.dumps(manifest, indent=1) + "\n")
+    print(json.dumps({k: manifest[k] for k in ("time", "land_cells", "missing_values_off_land", "sha256")}))
+
+
+def check(spec, raw, against, every):
+    """Compare sampled slices of `against` with a fresh read of the raw files."""
+    source = Source(spec, raw)
+    with open(against, "rb") as f:
+        head = f.read(32)
+        nt, ny, nx, nc = (int(n) for n in np.frombuffer(head[16:32], "<u4"))
+        times = np.fromfile(f, "<f8", nt)
+    base = 32 + 8 * (nt + ny + nx)
+    offsets = [base + 40 + c * (40 + 2 * nt * ny * nx) for c in range(nc)]
+    shift = np.round(times - np.asarray(source.times))
+    print(f"time stamps: {sorted(set(shift.tolist()))} s from the fresh read")
+    old = [np.memmap(against, "<i2", "r", offset=o, shape=(nt, ny, nx)) for o in offsets]
+    writer = mhgrid.Writer.__new__(mhgrid.Writer)
+    writer.scale, writer.offset, writer.path = SCALE, 0.0, Path(against)
+    for t in range(0, nt, every):
+        for c, values in enumerate(source.slice(t)):
+            fresh = writer.pack(values)
+            stored = np.asarray(old[c][t])
+            differ = fresh != stored
+            recovered = differ & (stored == mhgrid.MISSING) & np.isfinite(values)
+            land = differ & (stored == mhgrid.LAND) & ~np.isfinite(values)
+            other = differ & ~recovered & ~land
+            extreme = np.abs(values[recovered]).min() if recovered.any() else float("nan")
+            print(f"{iso(source.times[t])} {spec['variables'][c]}: {int(recovered.sum())} values recovered "
+                  f"(|v| >= {extreme:.2f} m/s), {int(other.sum())} other differences")
+
+
+def iso(t):
+    return datetime.fromtimestamp(t, timezone.utc).isoformat()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("action", choices=("retrieve", "convert", "check"))
+    parser.add_argument("dataset", choices=DATASETS)
+    parser.add_argument("--raw", type=Path, required=True)
+    parser.add_argument("--output")
+    parser.add_argument("--against")
+    parser.add_argument("--every", type=int, default=29)
+    args = parser.parse_args()
+    spec = DATASETS[args.dataset]
+    if args.action == "retrieve":
+        retrieve(spec, args.raw)
+    elif args.action == "convert":
+        convert(spec, args.raw, args.output)
+    else:
+        check(spec, args.raw, args.against, args.every)
+
+
+if __name__ == "__main__":
+    main()
