+#!/usr/bin/env python3
+"""Drifter-replay statistics: how far each ocean model and object response misses GDP drifters.
+
+Reads <run>/<model>/replay.csv written by `mh370 drift` with a [replay] table. For every
+model, response class and drogue state it gives the number of segments, the RMS error per
+component, the median distance error, the mean east/north bias, the skill against a
+no-motion forecast (1 - MSE_model / MSE_no_motion), and the maximum-likelihood isotropic
+bivariate Student-t (nu, scale) of the error vectors, with its gain over a Gaussian in
+log-likelihood per segment. Every segment counts, including paths that stopped early (they
+keep their last position). Errors are east/north distances on the WGS-84 ellipsoid at the
+observed end. The dispersion ratio is the variance of modelled displacements (start to
+predicted end) over that of observed ones: below 1, the model spreads objects too little.
+
+    drift_replay.py <run-dir> [--png <file.png>]    writes <run-dir>/replay-summary.toml
+"""
+
+import argparse
+import csv
+import math
+from pathlib import Path
+
+import numpy as np
+
+A, E2 = 6378.137, 0.00669437999014
+
+
+def errors_km(lat, lon, lat_obs, lon_obs):
+    phi = np.radians(lat_obs)
+    w = np.sqrt(1 - E2 * np.sin(phi) ** 2)
+    m, n = A * (1 - E2) / w**3, A / w
+    return np.radians(lon - lon_obs) * n * np.cos(phi), np.radians(lat - lat_obs) * m
+
+
+def student_t_fit(east, north):
+    """ML isotropic bivariate t: f(e) = (1 / 2 pi s^2) (1 + r^2 / (nu s^2))^-(nu/2 + 1)."""
+    r2 = east**2 + north**2
+    best = (-np.inf, None, None)
+    for nu in np.exp(np.linspace(np.log(0.5), np.log(200.0), 160)):
+        for s in np.linspace(5.0, 400.0, 400):
+            ll = np.sum(-np.log(2 * np.pi * s * s) - (nu / 2 + 1) * np.log1p(r2 / (nu * s * s)))
+            if ll > best[0]:
+                best = (ll, nu, s)
+    s2 = r2.mean() / 2
+    gaussian = np.sum(-np.log(2 * np.pi * s2) - r2 / (2 * s2))
+    return best[1], best[2], (best[0] - gaussian) / len(r2)
+
+
+def summarise(path):
+    rows = list(csv.DictReader(open(path)))
+    classes = [k[:-4] for k in rows[0] if k.endswith("_lat") and k not in ("start_lat", "end_lat")]
+    col = lambda key: np.array([float(r[key]) for r in rows])
+    drogue = np.array([r["drogue"] for r in rows])
+    lat_obs, lon_obs = col("end_lat"), col("end_lon")
+    rest_e, rest_n = errors_km(col("start_lat"), col("start_lon"), lat_obs, lon_obs)
+    # Displacements from the start, in the same east/north metric.
+    obs_e, obs_n = -rest_e, -rest_n
+    out = {}
+    for c in classes:
+        e, n = errors_km(col(f"{c}_lat"), col(f"{c}_lon"), lat_obs, lon_obs)
+        stopped = np.array([r[f"{c}_fate"] != "afloat" for r in rows])
+        for state in ("drogued", "undrogued", "transition"):
+            k = drogue == state
+            if k.sum() < 10:
+                continue
+            nu, scale, gain = student_t_fit(e[k], n[k])
+            model_e, model_n = obs_e[k] + e[k], obs_n[k] + n[k]
+            dispersion = (np.var(model_e) + np.var(model_n)) / (np.var(obs_e[k]) + np.var(obs_n[k]))
+            mse, mse_rest = np.mean(e[k] ** 2 + n[k] ** 2), np.mean(rest_e[k] ** 2 + rest_n[k] ** 2)
+            out[(c, state)] = {
+                "n": int(k.sum()),
+                "stopped": int(stopped[k].sum()),
+                "rms_per_component_km": float(np.sqrt(mse / 2)),
+                "median_error_km": float(np.median(np.hypot(e[k], n[k]))),
+                "bias_east_km": float(e[k].mean()),
+                "bias_north_km": float(n[k].mean()),
+                "skill_vs_no_motion": float(1 - mse / mse_rest),
+                "student_t_nu": float(nu),
+                "student_t_scale_km": float(scale),
+                "student_t_gain_per_segment": float(gain),
+                "dispersion_ratio": float(dispersion),
+            }
+    return out
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("run")
+    parser.add_argument("--png")
+    args = parser.parse_args()
+    run = Path(args.run)
+    results = {model.name: summarise(model / "replay.csv") for model in sorted(run.iterdir()) if (model / "replay.csv").exists()}
+    lines = ["# Drifter replay statistics (report/drift_replay.py). Errors in km.\n"]
+    for model, table in results.items():
+        for (c, state), stats in table.items():
+            lines.append(f'[{model}."{c}".{state}]')
+            lines += [f"{k} = {v:.4g}" if isinstance(v, float) else f"{k} = {v}" for k, v in stats.items()]
+            lines.append("")
+    (run / "replay-summary.toml").write_text("\n".join(lines))
+    header = f"{'model':9s} {'class':10s} {'state':10s} {'n':>5s} {'rms/comp':>8s} {'median':>7s} {'biasE':>6s} {'biasN':>6s} {'skill':>6s} {'t nu':>5s} {'t scale':>7s} {'disp':>5s}"
+    print(header)
+    for model, table in results.items():
+        for (c, state), s in table.items():
+            print(f"{model:9s} {c:10s} {state:10s} {s['n']:5d} {s['rms_per_component_km']:8.1f} {s['median_error_km']:7.1f} "
+                  f"{s['bias_east_km']:6.1f} {s['bias_north_km']:6.1f} {s['skill_vs_no_motion']:6.2f} {s['student_t_nu']:5.2f} {s['student_t_scale_km']:7.1f} {s['dispersion_ratio']:5.2f}")
+    if args.png:
+        import matplotlib
+
+        matplotlib.use("Agg")
+        import matplotlib.pyplot as plt
+
+        fig, axes = plt.subplots(1, 2, figsize=(11, 4.2), sharey=True)
+        for ax, state in zip(axes, ("drogued", "undrogued")):
+            labels, rms, med = [], [], []
+            for model, table in results.items():
+                for (c, st), s in table.items():
+                    if st == state:
+                        labels.append(f"{model}\n{c}")
+                        rms.append(s["rms_per_component_km"])
+                        med.append(s["median_error_km"])
+            x = np.arange(len(labels))
+            ax.bar(x - 0.2, med, 0.4, label="median distance error", color="#4C78A8")
+            ax.bar(x + 0.2, rms, 0.4, label="RMS error per component", color="#F58518")
+            ax.set_xticks(x, labels, fontsize=7)
+            ax.set_title(f"{state} drifters")
+            ax.set_ylabel("km")
+            ax.grid(axis="y", alpha=0.3)
+        axes[0].legend(fontsize=8)
+        fig.suptitle(f"GDP drifter replay: {run.name}")
+        fig.tight_layout()
+        fig.savefig(args.png, dpi=130)
+
+
+if __name__ == "__main__":
+    main()
