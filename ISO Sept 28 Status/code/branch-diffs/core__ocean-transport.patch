index 0000000..7bbbf04
--- /dev/null
+++ b/crates/ocean/src/land.rs
@@ -0,0 +1,88 @@
+//! High-resolution land mask: a bit raster built from the GSHHG shoreline, so that small
+//! islands on the drift paths (Réunion, Mauritius, Rodrigues, Nosy Boraha) are land even
+//! where an ocean model's own grid does not resolve them.
+//!
+//! Layout (little-endian): `MHLAND1\0`, f64 south and west edges (deg), f64 cell size (deg),
+//! u32 ny, u32 nx, then ny rows (south first) of ceil(nx / 8) bytes; bit `x % 8` of byte
+//! `x / 8` is set when the centre of cell (y, x) is on land. Written by
+//! `.sources/ocean-drift/gshhg_land.py`. Points outside the raster are water.
+
+use std::path::Path;
+
+pub struct Land {
+    south: f64,
+    west: f64,
+    cell: f64,
+    ny: usize,
+    nx: usize,
+    row_bytes: usize,
+    bits: Vec<u8>,
+}
+
+impl Land {
+    pub fn open(path: &Path) -> Result<Self, String> {
+        let bytes = std::fs::read(path).map_err(|e| format!("{}: {e}", path.display()))?;
+        let f64_at = |i: usize| f64::from_le_bytes(bytes[i..i + 8].try_into().unwrap());
+        let u32_at = |i: usize| u32::from_le_bytes(bytes[i..i + 4].try_into().unwrap()) as usize;
+        if bytes.len() < 40 || &bytes[..8] != b"MHLAND1\0" {
+            return Err(format!("{}: not an MHLAND1 raster", path.display()));
+        }
+        let (ny, nx) = (u32_at(32), u32_at(36));
+        let row_bytes = nx.div_ceil(8);
+        if bytes.len() != 40 + ny * row_bytes {
+            return Err(format!("{}: raster size does not match its header", path.display()));
+        }
+        Ok(Self { south: f64_at(8), west: f64_at(16), cell: f64_at(24), ny, nx, row_bytes, bits: bytes[40..].to_vec() })
+    }
+
+    pub fn is_land(&self, lat: f64, lon: f64) -> bool {
+        let y = ((lat - self.south) / self.cell).floor();
+        let x = ((lon - self.west) / self.cell).floor();
+        if !(y >= 0.0 && x >= 0.0 && (y as usize) < self.ny && (x as usize) < self.nx) {
+            return false;
+        }
+        let (y, x) = (y as usize, x as usize);
+        self.bits[y * self.row_bytes + x / 8] >> (x % 8) & 1 == 1
+    }
+
+    /// Walking the straight segment from `a` to `b` (lat, lon) at a third of a cell, the last
+    /// point at sea before the first land point, or `None` if the whole segment is at sea.
+    pub fn landfall(&self, a: (f64, f64), b: (f64, f64)) -> Option<(f64, f64)> {
+        let span = (b.0 - a.0).abs().max((b.1 - a.1).abs() * a.0.to_radians().cos());
+        let n = ((3.0 * span / self.cell).ceil() as usize).max(1);
+        let at = |k: usize| {
+            let s = k as f64 / n as f64;
+            (a.0 + s * (b.0 - a.0), a.1 + s * (b.1 - a.1))
+        };
+        (1..=n).find(|&k| self.is_land(at(k).0, at(k).1)).map(|k| at(k - 1))
+    }
+
+    #[cfg(test)]
+    pub(crate) fn from_fn(south: f64, west: f64, cell: f64, ny: usize, nx: usize, land: impl Fn(usize, usize) -> bool) -> Self {
+        let row_bytes = nx.div_ceil(8);
+        let mut bits = vec![0u8; ny * row_bytes];
+        for y in 0..ny {
+            for x in 0..nx {
+                if land(y, x) {
+                    bits[y * row_bytes + x / 8] |= 1 << (x % 8);
+                }
+            }
+        }
+        Self { south, west, cell, ny, nx, row_bytes, bits }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_thin_island_between_two_points_is_found() {
+        // A one-cell-wide north-south strip of land at x = 50 on a 0.01-degree raster.
+        let land = Land::from_fn(-1.0, 0.0, 0.01, 200, 100, |_, x| x == 50);
+        assert!(land.is_land(0.0, 0.505) && !land.is_land(0.0, 0.495));
+        let (lat, lon) = land.landfall((0.0, 0.40), (0.0, 0.60)).unwrap();
+        assert!(lat == 0.0 && (0.496..0.5).contains(&lon), "{lon}");
+        assert_eq!(land.landfall((0.0, 0.40), (0.0, 0.49)), None);
+    }
+}
