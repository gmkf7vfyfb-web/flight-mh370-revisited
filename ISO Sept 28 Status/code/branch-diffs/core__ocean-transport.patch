@@ -0,0 +1,190 @@
+#!/usr/bin/env python3
+"""ERA5 10 m wind (u10, v10) from the public ARCO ERA5 bucket to MHGRID schema 3.
+
+Source: gs://gcp-public-data-arco-era5/raw/date-variable-single_level/YYYY/MM/DD/
+10m_{u,v}_component_of_wind/surface.nc, the original ECMWF daily netCDF3 files
+(24 hourly fields on the 0.25 deg global grid, int16 packed per file). No login is
+needed. Only the requested latitude rows of the requested hours are fetched, by
+HTTP range request, then unpacked with each file's own scale and offset and
+repacked at 0.005 m/s. Latitude is flipped to ascending order.
+
+    era5_wind.py --start 2014-03-07 --end 2014-05-31 --step-hours 1 \
+        --south -55 --north 5 --west 50 --east 135 --output <file.mhgrid>
+
+--stride 2 keeps every second row and column (0.5 deg), for long runs where windage needs
+only synoptic-scale wind.
+
+Writes <file.mhgrid> and <file.mhgrid.json> (provenance: every source file's
+generation and etag, the packing, and the output sha256).
+"""
+
+import argparse
+import json
+import struct
+import time
+import urllib.request
+from concurrent.futures import ThreadPoolExecutor
+from datetime import date, datetime, timedelta, timezone
+
+import numpy as np
+
+import mhgrid
+
+BUCKET = "https://storage.googleapis.com/gcp-public-data-arco-era5/raw/date-variable-single_level"
+VARIABLES = {"u": "10m_u_component_of_wind", "v": "10m_v_component_of_wind"}
+SCALE = 0.005  # m/s per packed unit: +/-150 m/s range
+
+
+def fetch(url, first=None, last=None, attempts=6):
+    request = urllib.request.Request(url)
+    if first is not None:
+        request.add_header("Range", f"bytes={first}-{last}")
+    for attempt in range(attempts):
+        try:
+            with urllib.request.urlopen(request, timeout=60) as response:
+                return response.read(), dict(response.headers)
+        except Exception:
+            if attempt == attempts - 1:
+                raise
+            time.sleep(2**attempt)
+
+
+def netcdf3_header(blob):
+    """Dimensions and variables (type, shape, attributes, begin) of a classic/64-bit-offset file."""
+    if blob[:3] != b"CDF" or blob[3] not in (1, 2):
+        raise ValueError("not a netCDF3 file")
+    offset_size = 8 if blob[3] == 2 else 4
+    at = 8
+    sizes = {1: 1, 2: 1, 3: 2, 4: 4, 5: 4, 6: 8}
+    codes = {1: "b", 2: "c", 3: ">i2", 4: ">i4", 5: ">f4", 6: ">f8"}
+
+    def u32():
+        nonlocal at
+        at += 4
+        return struct.unpack(">I", blob[at - 4 : at])[0]
+
+    def name():
+        nonlocal at
+        n = u32()
+        s = blob[at : at + n].decode()
+        at += (n + 3) // 4 * 4
+        return s
+
+    def attributes():
+        nonlocal at
+        tag, count = u32(), u32()
+        out = {}
+        for _ in range(count if tag else 0):
+            key, kind, n = name(), u32(), u32()
+            raw = blob[at : at + n * sizes[kind]]
+            at += (n * sizes[kind] + 3) // 4 * 4
+            out[key] = raw.decode(errors="replace") if kind == 2 else np.frombuffer(raw, codes[kind]).tolist()
+        return out
+
+    dims = []
+    tag, count = u32(), u32()
+    for _ in range(count if tag else 0):
+        dims.append((name(), u32()))
+    attributes()
+    variables = {}
+    tag, count = u32(), u32()
+    for _ in range(count if tag else 0):
+        key = name()
+        shape = [dims[u32()][1] for _ in range(u32())]
+        attrs = attributes()
+        kind, _vsize = u32(), u32()
+        begin = struct.unpack(">Q" if offset_size == 8 else ">I", blob[at : at + offset_size])[0]
+        at += offset_size
+        variables[key] = {"dtype": codes[kind], "shape": shape, "attrs": attrs, "begin": begin}
+    return dict(dims), variables
+
+
+def one_value(attrs, key):
+    value = attrs[key]
+    return float(value[0] if isinstance(value, list) else value)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--start", type=date.fromisoformat, required=True)
+    parser.add_argument("--end", type=date.fromisoformat, required=True, help="last day, inclusive")
+    parser.add_argument("--step-hours", type=int, default=1)
+    parser.add_argument("--south", type=float, required=True)
+    parser.add_argument("--north", type=float, required=True)
+    parser.add_argument("--west", type=float, required=True)
+    parser.add_argument("--east", type=float, required=True)
+    parser.add_argument("--stride", type=int, default=1, help="keep every n-th row and column")
+    parser.add_argument("--workers", type=int, default=12)
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    if 24 % args.step_hours:
+        raise SystemExit("--step-hours must divide 24")
+
+    days = [args.start + timedelta(d) for d in range((args.end - args.start).days + 1)]
+    hours = list(range(0, 24, args.step_hours))
+    url = lambda day, var: f"{BUCKET}/{day:%Y/%m/%d}/{VARIABLES[var]}/surface.nc"
+    head, _ = fetch(url(days[0], "u"), 0, 65535)
+    dims, variables = netcdf3_header(head)
+    nlat, nlon = dims["latitude"], dims["longitude"]
+    latitudes = 90.0 - 0.25 * np.arange(nlat)
+    longitudes = 0.25 * np.arange(nlon)
+    rows = np.flatnonzero((latitudes >= args.south - 1e-9) & (latitudes <= args.north + 1e-9))
+    cols = np.flatnonzero((longitudes >= args.west - 1e-9) & (longitudes <= args.east + 1e-9))[:: args.stride]
+    times = [datetime(d.year, d.month, d.day, h, tzinfo=timezone.utc).timestamp() for d in days for h in hours]
+    keep = np.arange(len(rows))[:: args.stride]
+    writer = mhgrid.Writer(args.output, times, latitudes[rows[keep]][::-1], longitudes[cols], ["u", "v"], SCALE)
+    sources = {}
+
+    def convert(task):
+        day_index, day, var = task
+        blob, headers = fetch(url(day, var), 0, 65535)
+        file_dims, file_vars = netcdf3_header(blob)
+        key = "u10" if var == "u" else "v10"
+        info = file_vars[key]
+        if file_dims["latitude"] != nlat or file_dims["longitude"] != nlon or info["shape"] != [24, nlat, nlon]:
+            raise ValueError(f"{day} {var}: unexpected grid {info['shape']}")
+        attrs = info["attrs"]
+        scale, offset, fill = one_value(attrs, "scale_factor"), one_value(attrs, "add_offset"), one_value(attrs, "_FillValue")
+        record = 2 * nlat * nlon
+        for k, hour in enumerate(hours):
+            first = info["begin"] + hour * record + 2 * rows[0] * nlon
+            raw, _ = fetch(url(day, var), first, first + 2 * len(rows) * nlon - 1)
+            packed = np.frombuffer(raw, ">i2").reshape(len(rows), nlon)[np.ix_(keep, cols)]
+            values = np.where(packed == fill, np.nan, packed * scale + offset)[::-1]
+            if np.isnan(values).any():
+                raise ValueError(f"{day} {var} {hour:02d}h: missing values")
+            writer.write(day_index * len(hours) + k, 0 if var == "u" else 1, writer.pack(values))
+        return f"{day}/{var}", {"generation": headers.get("x-goog-generation"), "etag": headers.get("ETag"),
+                                "scale_factor": scale, "add_offset": offset}
+
+    tasks = [(i, day, var) for i, day in enumerate(days) for var in ("u", "v")]
+    started = time.time()
+    with ThreadPoolExecutor(args.workers) as pool:
+        for n, (key, info) in enumerate(pool.map(convert, tasks), 1):
+            sources[key] = info
+            if n % 20 == 0:
+                print(f"{n}/{len(tasks)} files, {time.time() - started:.0f} s", flush=True)
+    digest = writer.close()
+    manifest = {
+        "name": "ERA5 10 m wind (u10, v10), hourly analyses",
+        "source": f"{BUCKET}/YYYY/MM/DD/{{10m_u,10m_v}}_component_of_wind/surface.nc",
+        "source_note": "ECMWF ERA5 reanalysis (Hersbach et al. 2020), public ARCO ERA5 copy; Copernicus licence",
+        "components": {"u": "m/s eastward", "v": "m/s northward"},
+        "time": {"first_utc": datetime.fromtimestamp(times[0], timezone.utc).isoformat(),
+                 "last_utc": datetime.fromtimestamp(times[-1], timezone.utc).isoformat(),
+                 "step_hours": args.step_hours, "meaning": "instantaneous analysis at the stamped hour"},
+        "grid": {"latitude": [float(latitudes[rows[keep]].min()), float(latitudes[rows[keep]].max()), 0.25 * args.stride],
+                 "longitude": [float(longitudes[cols].min()), float(longitudes[cols].max()), 0.25 * args.stride]},
+        "packing": {"scale": SCALE, "offset": 0.0, "missing": mhgrid.MISSING, "land": mhgrid.LAND},
+        "sha256": digest,
+        "created_utc": datetime.now(timezone.utc).isoformat(timespec="seconds"),
+        "sources": dict(sorted(sources.items())),
+    }
+    with open(args.output + ".json", "w") as stream:
+        json.dump(manifest, stream, indent=1)
+        stream.write("\n")
+    print(f"wrote {args.output} ({digest}) in {time.time() - started:.0f} s")
+
+
+if __name__ == "__main__":
+    main()
