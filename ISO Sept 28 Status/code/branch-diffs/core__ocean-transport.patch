+++ b/crates/ocean/src/field.rs
@@ -0,0 +1,360 @@
+//! Gridded surface vector fields (current, Stokes drift, 10 m wind) in the MHGRID layout,
+//! read one time slice at a time.
+//!
+//! Layout (little-endian, C order, longitude fastest; every axis strictly increasing):
+//! `MHGRID1\0`, u32 schema = 3, u32 time axis = 0 (Unix seconds), u32 nt/ny/nx/nc, f64 times,
+//! latitudes (deg N) and longitudes (deg E), then for each component a 16-byte NUL-padded name,
+//! u32 encoding = 1 (packed i16), f64 scale, f64 offset, i16 missing, i16 land, and i16 values
+//! [time][latitude][longitude]; a value is offset + scale * packed. `land` marks a cell that is
+//! dry at every time (the model's own coast), `missing` any other absent value. A field has the
+//! two components `u` (east) and `v` (north), in m/s. Written by `.sources/ocean-drift/mhgrid.py`.
+//!
+//! [`Field::load`] reads the slices that bracket an interval and drops the others, so a
+//! multi-gigabyte series never sits in memory; sampling uses only loaded slices. Interpolation
+//! is bilinear in space and linear in time. Dry corners are dropped and the remaining weights
+//! renormalised; a point whose corners are all dry is on land. A missing corner makes the
+//! value missing. Nothing is ever filled with zero.
+
+use std::fs::File;
+use std::os::unix::fs::FileExt;
+use std::path::{Path, PathBuf};
+
+/// Why a field has no value at a point.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Miss {
+    /// Outside the field's latitude/longitude domain.
+    Outside,
+    /// Every surrounding grid node is dry: the model's coast.
+    Land,
+    /// A surrounding wet node has no value at this time.
+    Missing,
+}
+
+pub struct Field {
+    pub path: PathBuf,
+    file: File,
+    times: Vec<f64>,
+    lat: Vec<f64>,
+    lon: Vec<f64>,
+    scale: [f64; 2],
+    offset: [f64; 2],
+    missing: [i16; 2],
+    land: [i16; 2],
+    values_at: [u64; 2],
+    /// Loaded slices: time index and interleaved (u, v) packed values.
+    slices: Vec<(usize, Vec<[i16; 2]>)>,
+}
+
+impl Field {
+    pub fn open(path: &Path) -> Result<Self, String> {
+        let err = |e: String| format!("{}: {e}", path.display());
+        let file = File::open(path).map_err(|e| err(e.to_string()))?;
+        let mut at = 0u64;
+        let take = |at: &mut u64, n: usize| -> Result<Vec<u8>, String> {
+            let mut buf = vec![0; n];
+            file.read_exact_at(&mut buf, *at).map_err(|e| err(format!("truncated header ({e})")))?;
+            *at += n as u64;
+            Ok(buf)
+        };
+        let head = take(&mut at, 32)?;
+        let word = |i: usize| u32::from_le_bytes(head[8 + 4 * i..12 + 4 * i].try_into().unwrap()) as usize;
+        if &head[..8] != b"MHGRID1\0" || word(0) != 3 || word(1) != 0 {
+            return Err(err("not an MHGRID schema-3 file with a Unix-time axis".into()));
+        }
+        let (nt, ny, nx, nc) = (word(2), word(3), word(4), word(5));
+        let f64s = |bytes: Vec<u8>| -> Vec<f64> {
+            bytes.chunks_exact(8).map(|c| f64::from_le_bytes(c.try_into().unwrap())).collect()
+        };
+        let times = f64s(take(&mut at, 8 * nt)?);
+        let lat = f64s(take(&mut at, 8 * ny)?);
+        let lon = f64s(take(&mut at, 8 * nx)?);
+        for axis in [&times, &lat, &lon] {
+            if axis.len() < 2 || axis.windows(2).any(|w| !(w[1] > w[0])) {
+                return Err(err("axes must have two or more strictly increasing values".into()));
+            }
+        }
+        let slab = 2 * (nt * ny * nx) as u64;
+        let (mut scale, mut offset, mut missing, mut land, mut values_at) = ([0.0; 2], [0.0; 2], [0; 2], [0; 2], [0; 2]);
+        let mut names = Vec::new();
+        for _ in 0..nc {
+            let meta = take(&mut at, 40)?;
+            let name = String::from_utf8_lossy(&meta[..16]).trim_end_matches('\0').to_string();
+            let c = match name.as_str() {
+                "u" => 0,
+                "v" => 1,
+                other => return Err(err(format!("unexpected component `{other}`"))),
+            };
+            if u32::from_le_bytes(meta[16..20].try_into().unwrap()) != 1 {
+                return Err(err("components must be packed i16".into()));
+            }
+            scale[c] = f64::from_le_bytes(meta[20..28].try_into().unwrap());
+            offset[c] = f64::from_le_bytes(meta[28..36].try_into().unwrap());
+            missing[c] = i16::from_le_bytes(meta[36..38].try_into().unwrap());
+            land[c] = i16::from_le_bytes(meta[38..40].try_into().unwrap());
+            values_at[c] = at;
+            at += slab;
+            names.push(c);
+        }
+        if names.len() != 2 || names[0] == names[1] {
+            return Err(err("a field needs exactly the components u and v".into()));
+        }
+        let size = file.metadata().map_err(|e| err(e.to_string()))?.len();
+        if size != at {
+            return Err(err(format!("file is {size} bytes, header implies {at}")));
+        }
+        Ok(Self { path: path.to_path_buf(), file, times, lat, lon, scale, offset, missing, land, values_at, slices: Vec::new() })
+    }
+
+    /// First and last time (Unix s).
+    pub fn time_range(&self) -> (f64, f64) {
+        (self.times[0], self.times[self.times.len() - 1])
+    }
+
+    /// South, north, west, east (degrees).
+    pub fn bounds(&self) -> [f64; 4] {
+        [self.lat[0], self.lat[self.lat.len() - 1], self.lon[0], self.lon[self.lon.len() - 1]]
+    }
+
+    /// Make the slices that bracket every time in [t0, t1] resident, and drop the others.
+    pub fn load(&mut self, t0: f64, t1: f64) -> Result<(), String> {
+        let (start, end) = self.time_range();
+        if !(t0 >= start && t1 <= end && t0 <= t1) {
+            return Err(format!("{}: {t0}..{t1} lies outside the field's time range {start}..{end}", self.path.display()));
+        }
+        let first = locate(&self.times, t0).map(|(i, _)| i).unwrap();
+        let last = (locate(&self.times, t1).map(|(i, _)| i).unwrap() + 1).min(self.times.len() - 1);
+        self.slices.retain(|(i, _)| (first..=last).contains(i));
+        let cells = self.lat.len() * self.lon.len();
+        for i in first..=last {
+            if self.slices.iter().any(|(j, _)| *j == i) {
+                continue;
+            }
+            let mut bytes = vec![0u8; 2 * cells];
+            let mut slice = vec![[0i16; 2]; cells];
+            for c in 0..2 {
+                self.file
+                    .read_exact_at(&mut bytes, self.values_at[c] + 2 * (i * cells) as u64)
+                    .map_err(|e| format!("{}: {e}", self.path.display()))?;
+                for (k, pair) in slice.iter_mut().enumerate() {
+                    pair[c] = i16::from_le_bytes([bytes[2 * k], bytes[2 * k + 1]]);
+                }
+            }
+            self.slices.push((i, slice));
+        }
+        Ok(())
+    }
+
+    /// East and north components (m/s) at a time within a loaded interval.
+    pub fn sample(&self, unix_s: f64, lat: f64, lon: f64) -> Result<[f64; 2], Miss> {
+        let (y, x) = match (locate(&self.lat, lat), locate(&self.lon, lon)) {
+            (Some(y), Some(x)) => (y, x),
+            _ => return Err(Miss::Outside),
+        };
+        let (i, f) = locate(&self.times, unix_s).expect("sample time outside the field; the runner checks spans");
+        let a = self.spatial(i, y, x)?;
+        if f == 0.0 {
+            return Ok(a);
+        }
+        let b = self.spatial(i + 1, y, x)?;
+        Ok([a[0] + f * (b[0] - a[0]), a[1] + f * (b[1] - a[1])])
+    }
+
+    /// As [`Field::sample`], but a point on this field's land takes the value of the nearest wet
+    /// node within `reach` nodes. Used for Stokes drift: the wave model's coast is coarser than
+    /// the current model's, and near it the offshore wave forcing is the better estimate. A zero
+    /// there would stall exactly the onshore transport that beaches debris.
+    pub fn sample_extended(&self, unix_s: f64, lat: f64, lon: f64, reach: usize) -> Result<[f64; 2], Miss> {
+        match self.sample(unix_s, lat, lon) {
+            Err(Miss::Land) => {}
+            other => return other,
+        }
+        let (y, x) = (locate(&self.lat, lat).unwrap(), locate(&self.lon, lon).unwrap());
+        let (i, f) = locate(&self.times, unix_s).unwrap();
+        let (cy, cx) = (y.0 as f64 + y.1, x.0 as f64 + x.1);
+        let lo = |c: usize| c.saturating_sub(reach);
+        let nearest = (lo(y.0)..=(y.0 + 1 + reach).min(self.lat.len() - 1))
+            .flat_map(|j| (lo(x.0)..=(x.0 + 1 + reach).min(self.lon.len() - 1)).map(move |k| (j, k)))
+            .filter(|&(j, k)| self.node(i, j, k).is_some_and(|p| p[0] != self.land[0]))
+            .min_by(|a, b| {
+                let d = |(j, k): (usize, usize)| (j as f64 - cy).powi(2) + (k as f64 - cx).powi(2);
+                d(*a).total_cmp(&d(*b))
+            })
+            .ok_or(Miss::Land)?;
+        let at = |t: usize| -> Result<[f64; 2], Miss> {
+            let p = self.node(t, nearest.0, nearest.1).unwrap();
+            if p[0] == self.missing[0] || p[1] == self.missing[1] {
+                return Err(Miss::Missing);
+            }
+            Ok([0, 1].map(|c| self.offset[c] + self.scale[c] * f64::from(p[c])))
+        };
+        let a = at(i)?;
+        if f == 0.0 {
+            return Ok(a);
+        }
+        let b = at(i + 1)?;
+        Ok([a[0] + f * (b[0] - a[0]), a[1] + f * (b[1] - a[1])])
+    }
+
+    fn node(&self, time: usize, y: usize, x: usize) -> Option<[i16; 2]> {
+        self.slices.iter().find(|(i, _)| *i == time).map(|(_, s)| s[y * self.lon.len() + x])
+    }
+
+    fn spatial(&self, time: usize, (iy, fy): (usize, f64), (ix, fx): (usize, f64)) -> Result<[f64; 2], Miss> {
+        let slice = &self
+            .slices
+            .iter()
+            .find(|(i, _)| *i == time)
+            .expect("field slice not loaded; call Field::load for the step first")
+            .1;
+        let nx = self.lon.len();
+        let (mut sum, mut weight) = ([0.0; 2], 0.0);
+        for (dy, wy) in [(0, 1.0 - fy), (1, fy)] {
+            for (dx, wx) in [(0, 1.0 - fx), (1, fx)] {
+                let w = wy * wx;
+                if w == 0.0 {
+                    continue;
+                }
+                let p = slice[(iy + dy) * nx + ix + dx];
+                if p[0] == self.land[0] || p[1] == self.land[1] {
+                    continue;
+                }
+                if p[0] == self.missing[0] || p[1] == self.missing[1] {
+                    return Err(Miss::Missing);
+                }
+                for c in 0..2 {
+                    sum[c] += w * (self.offset[c] + self.scale[c] * f64::from(p[c]));
+                }
+                weight += w;
+            }
+        }
+        if weight == 0.0 {
+            return Err(Miss::Land);
+        }
+        Ok([sum[0] / weight, sum[1] / weight])
+    }
+}
+
+/// Lower index and fraction of `v` on a strictly increasing axis; `None` outside it.
+pub(crate) fn locate(axis: &[f64], v: f64) -> Option<(usize, f64)> {
+    let n = axis.len();
+    if !(v >= axis[0] && v <= axis[n - 1]) {
+        return None;
+    }
+    // Near-regular axes: the arithmetic guess is exact or off by one; a short walk corrects it.
+    let mut i = (((v - axis[0]) / (axis[n - 1] - axis[0]) * (n - 1) as f64) as usize).min(n - 2);
+    while i > 0 && v < axis[i] {
+        i -= 1;
+    }
+    while i < n - 2 && v >= axis[i + 1] {
+        i += 1;
+    }
+    Some((i, ((v - axis[i]) / (axis[i + 1] - axis[i])).clamp(0.0, 1.0)))
+}
+
+#[cfg(test)]
+pub(crate) mod tests {
+    use super::*;
+
+    /// Write a small MHGRID file: `values(t, y, x) -> (u, v)`, NaN = missing, None = land.
+    pub fn write_field(
+        path: &Path,
+        times: &[f64],
+        lat: &[f64],
+        lon: &[f64],
+        values: impl Fn(usize, usize, usize) -> Option<(f64, f64)>,
+    ) {
+        let scale = 0.001_f64;
+        let mut bytes = b"MHGRID1\0".to_vec();
+        for n in [3, 0, times.len(), lat.len(), lon.len(), 2] {
+            bytes.extend((n as u32).to_le_bytes());
+        }
+        for axis in [times, lat, lon] {
+            axis.iter().for_each(|v| bytes.extend(v.to_le_bytes()));
+        }
+        for (c, name) in ["u", "v"].iter().enumerate() {
+            let mut label = [0u8; 16];
+            label[..1].copy_from_slice(name.as_bytes());
+            bytes.extend(label);
+            bytes.extend(1u32.to_le_bytes());
+            bytes.extend(scale.to_le_bytes());
+            bytes.extend(0.0f64.to_le_bytes());
+            bytes.extend((-30000i16).to_le_bytes());
+            bytes.extend((-29999i16).to_le_bytes());
+            for t in 0..times.len() {
+                for y in 0..lat.len() {
+                    for x in 0..lon.len() {
+                        let packed = match values(t, y, x) {
+                            None => -29999,
+                            Some(uv) => {
+                                let v = if c == 0 { uv.0 } else { uv.1 };
+                                if v.is_nan() { -30000 } else { (v / scale).round() as i16 }
+                            }
+                        };
+                        bytes.extend(packed.to_le_bytes());
+                    }
+                }
+            }
+        }
+        std::fs::write(path, bytes).unwrap();
+    }
+
+    #[test]
+    fn interpolation_matches_hand_values_and_never_fills_land_with_zero() {
+        let path = std::env::temp_dir().join(format!("mh370-field-{}.mhgrid", std::process::id()));
+        // u = 1 + t/10 + lat + 2 lon on a 2x2 grid over two times; node (lat 1, lon 1) is dry.
+        write_field(&path, &[0.0, 10.0], &[0.0, 1.0], &[0.0, 1.0], |t, y, x| {
+            (y == 1 && x == 1).then_some(()).map_or(Some((1.0 + t as f64 + y as f64 + 2.0 * x as f64, -0.5)), |_| None)
+        });
+        let mut f = Field::open(&path).unwrap();
+        f.load(0.0, 10.0).unwrap();
+        // At (0.25, 0.5), t = 5: weights 0.375, 0.375, 0.125 (0.125 on the dry node dropped).
+        let expected = (0.375 * 1.0 + 0.375 * 3.0 + 0.125 * 2.0) / 0.875 + 0.5;
+        let [u, v] = f.sample(5.0, 0.25, 0.5).unwrap();
+        assert!((u - expected).abs() < 1e-9, "{u} vs {expected}");
+        assert!((v + 0.5).abs() < 1e-9);
+        assert_eq!(f.sample(5.0, 1.0, 1.0), Err(Miss::Land));
+        assert_eq!(f.sample(5.0, 1.5, 0.5), Err(Miss::Outside));
+        std::fs::remove_file(&path).unwrap();
+    }
+
+    #[test]
+    fn extended_sampling_takes_the_nearest_wet_node_on_land_only() {
+        let path = std::env::temp_dir().join(format!("mh370-field-extend-{}.mhgrid", std::process::id()));
+        // 4 x 4 nodes at 1-degree spacing; only the column x = 3 is wet, with u = 0.1 * (y + 1).
+        let axis = [0.0, 1.0, 2.0, 3.0];
+        write_field(&path, &[0.0, 10.0], &axis, &axis, |_, y, x| (x == 3).then_some((0.1 * (y + 1) as f64, 0.0)));
+        let mut f = Field::open(&path).unwrap();
+        f.load(0.0, 10.0).unwrap();
+        assert_eq!(f.sample(0.0, 1.2, 0.9), Err(Miss::Land));
+        // Nearest wet node to (1.2, 0.9) within two nodes is (y 1, x 3): u = 0.2.
+        let [u, _] = f.sample_extended(0.0, 1.2, 0.9, 2).unwrap();
+        assert!((u - 0.2).abs() < 1e-9, "{u}");
+        assert_eq!(f.sample_extended(0.0, 1.2, 0.2, 1), Err(Miss::Land));
+        // Where the field is wet, extended sampling is ordinary sampling.
+        assert_eq!(f.sample_extended(0.0, 1.5, 2.5, 2), f.sample(0.0, 1.5, 2.5));
+        std::fs::remove_file(&path).unwrap();
+    }
+
+    #[test]
+    fn a_missing_wet_value_is_missing_not_zero() {
+        let path = std::env::temp_dir().join(format!("mh370-field-missing-{}.mhgrid", std::process::id()));
+        write_field(&path, &[0.0, 10.0], &[0.0, 1.0], &[0.0, 1.0], |t, y, x| {
+            Some(if t == 1 && y == 0 && x == 0 { (f64::NAN, 0.0) } else { (0.2, 0.1) })
+        });
+        let mut f = Field::open(&path).unwrap();
+        f.load(0.0, 10.0).unwrap();
+        assert_eq!(f.sample(0.0, 0.5, 0.5), Ok([0.2, 0.1]));
+        assert_eq!(f.sample(5.0, 0.5, 0.5), Err(Miss::Missing));
+        std::fs::remove_file(&path).unwrap();
+    }
+
+    #[test]
+    fn locate_handles_near_regular_axes() {
+        let axis: Vec<f64> = (0..841).map(|i| -55.0 + f64::from(i as f32 * 0.083_333_33)).collect();
+        for v in [-55.0, -54.99, -30.04, 14.9] {
+            let (i, f) = locate(&axis, v).unwrap();
+            assert!(axis[i] <= v && v <= axis[i + 1] && (0.0..=1.0).contains(&f));
+        }
+        assert_eq!(locate(&axis, 20.0), None);
+    }
+}
