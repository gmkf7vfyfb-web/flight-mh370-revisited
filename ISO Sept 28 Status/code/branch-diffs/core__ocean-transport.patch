new file mode 100644
index 0000000..19b52b7
--- /dev/null
+++ b/.sources/ocean-drift/oscar.py
@@ -0,0 +1,149 @@
+#!/usr/bin/env python3
+"""OSCAR v2.0 Final surface currents to MHGRID schema 3 (crates/ocean/src/field.rs).
+
+Source: NASA PO.DAAC OSCAR_L4_OC_FINAL_V2.0 (doi:10.5067/OSCAR-25F20), daily global 0.25 deg
+netCDF granules. Total current (u, v): geostrophic (DUACS altimetry) + Ekman (ERA5 wind) +
+buoyancy (CMC SST), averaged over the top 30 m. Needs an Earthdata login in ~/.netrc.
+
+Each day is downloaded, checked against its published md5, cut to 0-180E, 55S-15N and
+written; the global granule is then deleted, so only the subset uses disk. Granules are
+daily means over 00:00-23:59:59 UTC (stored with a 00:00 stamp and a "julian" calendar label,
+but their time_bounds are Gregorian days); they are stamped at 12:00 here.
+
+Missing values (-999) are missing, except that OSCAR's coast is written as land: cells missing
+on every day, plus cells within two cells of those that are missing on any day. OSCAR leaves
+some near-shore currents undefined on some days (about 860 such cells in the drift domain,
+mostly in the Indonesian archipelago, each undefined on about a fifth of days); an object
+there is at OSCAR's coast, not in a data gap. Other gaps (the sea-ice edge south of 45S) stay
+missing.
+
+    oscar.py --start 2014-03-07 --end 2014-03-24 --output <file.mhgrid>
+    oscar.py --relabel-land <file.mhgrid>     apply the coast rule to an existing file
+"""
+
+import argparse
+import hashlib
+import json
+import subprocess
+import tempfile
+import time
+from datetime import date, datetime, timedelta, timezone
+from pathlib import Path
+
+import h5py
+import numpy as np
+
+import mhgrid
+
+URL = "https://archive.podaac.earthdata.nasa.gov/podaac-ops-cumulus-{}/OSCAR_L4_OC_FINAL_V2.0/oscar_currents_final_{:%Y%m%d}.nc"
+SCALE = 0.001
+SOUTH, NORTH, WEST, EAST = -55.0, 15.0, 0.0, 180.0
+
+
+def download(day, target, cookies):
+    for attempt in range(5):
+        try:
+            subprocess.run(["curl", "-sfL", "-n", "-c", cookies, "-b", cookies, "-o", str(target),
+                            URL.format("protected", day)], check=True)
+            expected = subprocess.run(["curl", "-sfL", URL.format("public", day) + ".md5"], check=True,
+                                      capture_output=True, text=True).stdout.split()[0]
+            if hashlib.md5(target.read_bytes()).hexdigest() == expected:
+                return expected
+        except subprocess.CalledProcessError:
+            pass
+        time.sleep(2**attempt)
+    raise RuntimeError(f"could not download OSCAR for {day}")
+
+
+def label_land(path):
+    """Write OSCAR's coast as land (see the module note); returns the number of land cells."""
+    with open(path, "rb") as f:
+        head = f.read(32)
+    nt, ny, nx, _ = (int(n) for n in np.frombuffer(head[16:32], "<u4"))
+    base = 32 + 8 * (nt + ny + nx)
+    values = [np.memmap(path, "<i2", "r+", offset=base + 40 + c * (40 + 2 * nt * ny * nx), shape=(nt, ny, nx)) for c in range(2)]
+    absent_count = np.zeros((ny, nx), np.int64)
+    for t in range(nt):
+        absent_count += (values[0][t] <= mhgrid.LAND) | (values[1][t] <= mhgrid.LAND)
+    always = absent_count == nt
+    padded = np.pad(always, 2)
+    near = np.zeros_like(always)
+    for dy in range(5):
+        for dx in range(5):
+            near |= padded[dy : dy + ny, dx : dx + nx]
+    land = always | (near & (absent_count > 0))
+    for c in range(2):
+        for t in range(nt):
+            values[c][t][land] = mhgrid.LAND
+        values[c].flush()
+    return int(land.sum())
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--start", type=date.fromisoformat)
+    parser.add_argument("--end", type=date.fromisoformat, help="last day, inclusive")
+    parser.add_argument("--output")
+    parser.add_argument("--relabel-land", metavar="FILE")
+    args = parser.parse_args()
+    if args.relabel_land:
+        cells = label_land(args.relabel_land)
+        sidecar = Path(args.relabel_land + ".json")
+        manifest = json.loads(sidecar.read_text())
+        manifest.update(land_cells=cells, land_rule="missing every day, or within two cells of that and missing any day",
+                        sha256=mhgrid.sha256(args.relabel_land))
+        sidecar.write_text(json.dumps(manifest, indent=1) + "\n")
+        print(json.dumps({k: manifest[k] for k in ("land_cells", "sha256")}))
+        return
+    if not (args.start and args.end and args.output):
+        parser.error("--start, --end and --output are required")
+    days = [args.start + timedelta(d) for d in range((args.end - args.start).days + 1)]
+    lat = -89.75 + 0.25 * np.arange(719)
+    lon = 0.25 * np.arange(1440)
+    rows = np.flatnonzero((lat >= SOUTH - 1e-9) & (lat <= NORTH + 1e-9))
+    cols = np.flatnonzero((lon >= WEST - 1e-9) & (lon <= EAST + 1e-9))
+    times = [datetime(d.year, d.month, d.day, 12, tzinfo=timezone.utc).timestamp() for d in days]
+    writer = mhgrid.Writer(args.output, times, lat[rows], lon[cols], ["u", "v"], SCALE)
+    sources = {}
+    with tempfile.TemporaryDirectory() as scratch:
+        granule, cookies = Path(scratch) / "granule.nc", str(Path(scratch) / "cookies")
+        for t, day in enumerate(days):
+            sources[f"{day}"] = download(day, granule, cookies)
+            with h5py.File(granule, "r") as f:
+                if not (np.allclose(f["lat"][:], lat) and np.allclose(f["lon"][:], lon)):
+                    raise ValueError(f"{day}: unexpected grid")
+                bounds = f["time"].attrs["time_bounds"].decode()
+                if not bounds.startswith(f"{day:%Y-%m-%d} 00:00:00"):
+                    raise ValueError(f"{day}: time bounds {bounds}")
+                for c, name in enumerate(("u", "v")):
+                    values = f[name][0][np.ix_(cols, rows)].T.astype(np.float64)  # [lon, lat] -> [lat, lon]
+                    values[values == -999.0] = np.nan
+                    writer.write(t, c, writer.pack(values))
+            granule.unlink()
+            if t % 50 == 0:
+                print(f"{day}", flush=True)
+    writer.close()
+    land_cells = label_land(args.output)
+    manifest = {
+        "name": "OSCAR v2.0 Final total surface current (top 30 m mean), daily",
+        "product": "OSCAR_L4_OC_FINAL_V2.0",
+        "dataset": "doi:10.5067/OSCAR-25F20",
+        "source": URL.format("protected", date(1, 1, 1)).replace("00010101", "YYYYMMDD"),
+        "time": {"first_utc": datetime.fromtimestamp(times[0], timezone.utc).isoformat(),
+                 "last_utc": datetime.fromtimestamp(times[-1], timezone.utc).isoformat(), "count": len(times),
+                 "stamp": "12:00 UTC, centre of the averaged day"},
+        "grid": {"latitude": [float(lat[rows][0]), float(lat[rows][-1]), len(rows)],
+                 "longitude": [float(lon[cols][0]), float(lon[cols][-1]), len(cols)]},
+        "packing": {"scale": SCALE, "offset": 0.0, "missing": mhgrid.MISSING, "land": mhgrid.LAND},
+        "land_cells": land_cells,
+        "land_rule": "missing every day, or within two cells of that and missing any day",
+        "md5": sources,
+        "sha256": mhgrid.sha256(args.output),
+        "created_utc": datetime.now(timezone.utc).isoformat(timespec="seconds"),
+    }
+    Path(args.output + ".json").write_text(json.dumps(manifest, indent=1) + "\n")
+    print(json.dumps({k: manifest[k] for k in ("time", "land_cells", "sha256")}))
+
+
+if __name__ == "__main__":
+    main()
