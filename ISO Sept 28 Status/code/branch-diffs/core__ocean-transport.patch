+//! Surface drift of floating objects: gridded current, Stokes-drift and 10 m wind fields, a
+//! high-resolution land mask, and a midpoint transport step on WGS-84.
+//!
+//! One transport law serves every drift-dependent module (debris finds, Pleiades imagery,
+//! aerial search). The runner advances all particles of a product in lockstep: it loads the
+//! field slices that bracket a step, then steps every particle in parallel.
+
+pub mod field;
+pub mod land;
+pub mod transport;
+
+pub use field::{Field, Miss};
+pub use land::Land;
+pub use transport::{displace, gaussian_pair, uniform, Environment, Fate, Particle, Response};
diff --git a/crates/ocean/src/transport.rs b/crates/ocean/src/transport.rs
new file mode 100644
index 0000000..00d1b76
--- /dev/null
+++ b/crates/ocean/src/transport.rs
@@ -0,0 +1,258 @@
+//! One transport step for a floating object: explicit midpoint (RK2) on the WGS-84 ellipsoid.
+//!
+//! Velocity (m/s) = current + s * Stokes + w * wind10 + a fixed leeway speed along the wind
+//! direction turned `leeway_left_deg` to the left of downwind. Every response term is the
+//! object's, stated explicitly, and zero by default. An optional random walk adds an
+//! independent Gaussian displacement of variance 2 K dt to each component (K = diffusivity).
+//!
+//! A particle stops, and records why, when it reaches land (the high-resolution mask, or a
+//! point where the ocean model has no wet grid node), leaves a field's domain, or meets a
+//! missing value. Stopped particles are kept, never dropped, so that statistics over an
+//! ensemble count every release.
+
+use crate::field::{Field, Miss};
+use crate::land::Land;
+
+/// How an object moves relative to the surface current.
+#[derive(Debug, Clone, Copy, Default, PartialEq)]
+pub struct Response {
+    /// Multiplier on the surface Stokes drift.
+    pub stokes: f64,
+    /// Fraction of the 10 m wind vector (direct windage).
+    pub windage: f64,
+    /// Fixed wind-relative leeway speed (m/s), independent of wind speed.
+    pub leeway_mps: f64,
+    /// Direction of the fixed leeway, degrees to the left of downwind.
+    pub leeway_left_deg: f64,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Fate {
+    Afloat,
+    /// Reached land; the position is the last point at sea.
+    Beached,
+    /// Left the domain of a field it needs.
+    LeftDomain,
+    /// A field it needs has a missing value there.
+    NoData,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Particle {
+    pub lat: f64,
+    pub lon: f64,
+    pub fate: Fate,
+    /// When the particle stopped (Unix s); meaningless while afloat.
+    pub stopped_unix_s: f64,
+    pub response: Response,
+}
+
+impl Particle {
+    pub fn new(lat: f64, lon: f64, response: Response) -> Self {
+        Self { lat, lon, fate: Fate::Afloat, stopped_unix_s: f64::NAN, response }
+    }
+
+    fn stop(&mut self, fate: Fate, unix_s: f64) {
+        self.fate = fate;
+        self.stopped_unix_s = unix_s;
+    }
+}
+
+/// The fields a drift needs. Stokes and wind may be absent when no object responds to them.
+pub struct Environment<'a> {
+    pub current: &'a Field,
+    pub stokes: Option<&'a Field>,
+    pub wind: Option<&'a Field>,
+    pub land: Option<&'a Land>,
+}
+
+impl Environment<'_> {
+    /// Velocity (east, north; m/s) of an object with response `r`.
+    pub fn velocity(&self, unix_s: f64, lat: f64, lon: f64, r: &Response) -> Result<[f64; 2], Fate> {
+        let fate = |m: Miss| match m {
+            Miss::Outside => Fate::LeftDomain,
+            Miss::Land => Fate::Beached,
+            Miss::Missing => Fate::NoData,
+        };
+        let mut v = self.current.sample(unix_s, lat, lon).map_err(fate)?;
+        if r.stokes != 0.0 {
+            let field = self.stokes.expect("a Stokes response needs a Stokes field");
+            // The wave model's coast is not the current model's: where only the wave model is dry,
+            // the nearest wet wave node within two nodes stands in. Beyond that, the particle is
+            // treated as on land.
+            let s = field.sample_extended(unix_s, lat, lon, 2).map_err(fate)?;
+            v = [v[0] + r.stokes * s[0], v[1] + r.stokes * s[1]];
+        }
+        if r.windage != 0.0 || r.leeway_mps != 0.0 {
+            let w = self.wind.expect("a wind response needs a wind field").sample(unix_s, lat, lon).map_err(fate)?;
+            v = [v[0] + r.windage * w[0], v[1] + r.windage * w[1]];
+            let speed = w[0].hypot(w[1]);
+            if r.leeway_mps != 0.0 && speed > 0.0 {
+                let (sin, cos) = r.leeway_left_deg.to_radians().sin_cos();
+                let (e, n) = (w[0] / speed, w[1] / speed);
+                // Rotate the downwind unit vector counter-clockwise (to the left) by the angle.
+                v = [v[0] + r.leeway_mps * (e * cos - n * sin), v[1] + r.leeway_mps * (e * sin + n * cos)];
+            }
+        }
+        Ok(v)
+    }
+
+    /// Advance an afloat particle from `unix_s` by `dt_s`. `noise` holds two standard normal
+    /// deviates for the random walk (ignored when `diffusivity_m2_s` is zero).
+    pub fn step(&self, p: &mut Particle, unix_s: f64, dt_s: f64, diffusivity_m2_s: f64, noise: [f64; 2]) {
+        if p.fate != Fate::Afloat {
+            return;
+        }
+        let v1 = match self.velocity(unix_s, p.lat, p.lon, &p.response) {
+            Ok(v) => v,
+            Err(fate) => return p.stop(fate, unix_s),
+        };
+        let mid = displace(p.lat, p.lon, v1[0] * dt_s / 2.0, v1[1] * dt_s / 2.0);
+        if self.reaches_land(p, mid, unix_s + dt_s / 2.0) {
+            return;
+        }
+        let v2 = match self.velocity(unix_s + dt_s / 2.0, mid.0, mid.1, &p.response) {
+            Ok(v) => v,
+            Err(fate) => return p.stop(fate, unix_s + dt_s / 2.0),
+        };
+        let sd = (2.0 * diffusivity_m2_s * dt_s).sqrt();
+        let end = displace(p.lat, p.lon, v2[0] * dt_s + sd * noise[0], v2[1] * dt_s + sd * noise[1]);
+        if !self.reaches_land(p, end, unix_s + dt_s) {
+            (p.lat, p.lon) = end;
+        }
+    }
+
+    /// Stop the particle at its landfall if the segment to `to` crosses the land mask.
+    fn reaches_land(&self, p: &mut Particle, to: (f64, f64), unix_s: f64) -> bool {
+        let Some(landfall) = self.land.and_then(|land| land.landfall((p.lat, p.lon), to)) else {
+            return false;
+        };
+        (p.lat, p.lon) = landfall;
+        p.stop(Fate::Beached, unix_s);
+        true
+    }
+}
+
+/// Move a point by an east/north displacement (m), using the ellipsoid's radii of curvature
+/// at the start point.
+pub fn displace(lat: f64, lon: f64, east_m: f64, north_m: f64) -> (f64, f64) {
+    geo::advance(lat, lon, 0.0, north_m / geo::M_PER_KT_S, east_m / geo::M_PER_KT_S, 1.0)
+}
+
+/// Two independent standard normal deviates determined by `key` alone (e.g. seed, particle,
+/// step), so results do not depend on thread scheduling. SplitMix64 hashing and Box-Muller.
+pub fn gaussian_pair(key: [u64; 3]) -> [f64; 2] {
+    let a = splitmix64(splitmix64(splitmix64(key[0]) ^ key[1]) ^ key[2]);
+    let b = splitmix64(a);
+    let u1 = ((a >> 11) as f64 + 0.5) / (1u64 << 53) as f64;
+    let u2 = (b >> 11) as f64 / (1u64 << 53) as f64;
+    let r = (-2.0 * u1.ln()).sqrt();
+    let (sin, cos) = (std::f64::consts::TAU * u2).sin_cos();
+    [r * cos, r * sin]
+}
+
+/// A uniform deviate in [0, 1) determined by `key` alone.
+pub fn uniform(key: [u64; 3]) -> f64 {
+    (splitmix64(splitmix64(splitmix64(key[0]) ^ key[1]) ^ key[2] ^ 0x5bd1_e995) >> 11) as f64 / (1u64 << 53) as f64
+}
+
+fn splitmix64(x: u64) -> u64 {
+    let mut z = x.wrapping_add(0x9e37_79b9_7f4a_7c15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+    z ^ (z >> 31)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::field::tests::write_field;
+
+    fn constant_field(name: &str, u: f64, v: f64) -> Field {
+        let path = std::env::temp_dir().join(format!("mh370-{name}-{}.mhgrid", std::process::id()));
+        write_field(&path, &[0.0, 1e6], &[-60.0, 10.0], &[0.0, 180.0], |_, _, _| Some((u, v)));
+        let mut field = Field::open(&path).unwrap();
+        field.load(0.0, 1e6).unwrap();
+        std::fs::remove_file(&path).unwrap();
+        field
+    }
+
+    fn drift(env: &Environment, start: (f64, f64), r: Response, days: f64, dt: f64) -> Particle {
+        let mut p = Particle::new(start.0, start.1, r);
+        let mut t = 0.0;
+        while t < days * 86_400.0 {
+            env.step(&mut p, t, dt, 0.0, [0.0; 2]);
+            t += dt;
+        }
+        p
+    }
+
+    #[test]
+    fn constant_current_displacement_matches_the_ellipsoid() {
+        // 0.1 m/s for one day in 3-hour midpoint steps. Independent values: WGS-84 meridional
+        // radius M and prime-vertical radius N at 35 S, from the textbook formulas.
+        let (a, e2, phi) = (6_378_137.0_f64, 0.006_694_379_990_14_f64, (-35.0_f64).to_radians());
+        let w = (1.0 - e2 * phi.sin().powi(2)).sqrt();
+        let (m, n) = (a * (1.0 - e2) / w.powi(3), a / w);
+        let east = constant_field("east", 0.1, 0.0);
+        let env = Environment { current: &east, stokes: None, wind: None, land: None };
+        let p = drift(&env, (-35.0, 90.0), Response::default(), 1.0, 10_800.0);
+        let east_m = (p.lon - 90.0).to_radians() * n * phi.cos();
+        assert!((east_m - 8_640.0).abs() < 20.0 && p.lat == -35.0, "{east_m}");
+        let north = constant_field("north", 0.0, 0.1);
+        let env = Environment { current: &north, stokes: None, wind: None, land: None };
+        let p = drift(&env, (-35.0, 90.0), Response::default(), 1.0, 10_800.0);
+        let north_m = (p.lat + 35.0).to_radians() * m;
+        assert!((north_m - 8_640.0).abs() < 20.0, "{north_m}");
+    }
+
+    #[test]
+    fn stokes_windage_and_leeway_add_as_stated() {
+        let still = constant_field("still", 0.0, 0.0);
+        let waves = constant_field("waves", 0.1, 0.0);
+        let wind = constant_field("wind", 0.0, 10.0);
+        let env = Environment { current: &still, stokes: Some(&waves), wind: Some(&wind), land: None };
+        // 0.5 x Stokes east, 2% of a 10 m/s northerly-blowing wind, and 0.1 m/s leeway 16 deg
+        // left of downwind (north), i.e. towards 344 deg true.
+        let r = Response { stokes: 0.5, windage: 0.02, leeway_mps: 0.1, leeway_left_deg: 16.0 };
+        let [e, n] = env.velocity(0.0, -30.0, 90.0, &r).unwrap();
+        let (sin, cos) = 16f64.to_radians().sin_cos();
+        assert!((e - (0.05 - 0.1 * sin)).abs() < 1e-9 && (n - (0.2 + 0.1 * cos)).abs() < 1e-9, "{e} {n}");
+        assert_eq!(env.velocity(0.0, -30.0, 90.0, &Response::default()), Ok([0.0, 0.0]));
+    }
+
+    #[test]
+    fn random_walk_has_the_declared_daily_rms() {
+        // CSIRO's 5 NM/day two-dimensional RMS: per-component variance 2 K dt with
+        // K = (5 NM / sqrt 2)^2 / (2 days) = 248.2 m2/s.
+        let still = constant_field("walk", 0.0, 0.0);
+        let env = Environment { current: &still, stokes: None, wind: None, land: None };
+        let k = (5.0 * 1852.0 / 2f64.sqrt()).powi(2) / (2.0 * 86_400.0);
+        let n = 20_000;
+        let mut sum_sq = 0.0;
+        for i in 0..n {
+            let mut p = Particle::new(-30.0, 90.0, Response::default());
+            for s in 0..24 {
+                env.step(&mut p, 3600.0 * s as f64, 3600.0, k, gaussian_pair([7, i, s]));
+            }
+            let (m, nr) = geo::radii_of_curvature_km(-30.0);
+            let dn = (p.lat + 30.0).to_radians() * m * 1000.0;
+            let de = (p.lon - 90.0).to_radians() * nr * 1000.0 * 30f64.to_radians().cos();
+            sum_sq += dn * dn + de * de;
+        }
+        let rms_nm = (sum_sq / n as f64).sqrt() / 1852.0;
+        assert!((rms_nm - 5.0).abs() < 0.08, "{rms_nm}");
+    }
+
+    #[test]
+    fn a_particle_stops_at_an_island_and_is_kept() {
+        let east = constant_field("island", 0.5, 0.0);
+        let land = Land::from_fn(-31.0, 89.0, 0.01, 200, 200, |_, x| x == 150);
+        let env = Environment { current: &east, stokes: None, wind: None, land: Some(&land) };
+        let p = drift(&env, (-30.0, 90.0), Response::default(), 2.0, 3600.0);
+        assert_eq!(p.fate, Fate::Beached);
+        assert!((90.49..90.5).contains(&p.lon), "{}", p.lon);
+        // 0.5 deg of longitude at 30 S is 48.2 km: 96,400 s at 0.5 m/s, ending an hourly step.
+        assert!((96_400.0..=100_000.0).contains(&p.stopped_unix_s), "{}", p.stopped_unix_s);
+    }
+}
