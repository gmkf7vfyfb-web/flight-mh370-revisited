+# GDP drifter dispersion, 2014-16: 60-day segments starting every 3 days in 20-45S, 60-115E, for
+# setting each ocean model's random-walk diffusivity. Undrogued drifters float like debris
+# (current + Stokes); the dispersion ratio (variance of modelled over observed displacements,
+# report/drift_replay.py) shows how much spread each model lacks at each diffusivity.
+# Build: make drift D=config/drift/gdp-dispersion.toml
+base = "../ocean.toml"
+name = "gdp-dispersion"
+models = ["glorys12", "oscar2", "bran2016"]
+stokes = "waverys"
+wind = "era5_wind_3h"
+land = "gshhg_land"
+step_s = 10800.0
+
+[replay]
+drifters = ["gdp_2014", "gdp_2015", "gdp_2016"]
+first_utc = "2014-03-08T00:00:00Z"
+last_utc = "2016-06-30T00:00:00Z"
