diff --git a/crates/mh370/src/drift.rs b/crates/mh370/src/drift.rs
new file mode 100644
index 0000000..41f9900
--- /dev/null
+++ b/crates/mh370/src/drift.rs
@@ -0,0 +1,804 @@
+//! Drift maps: `mh370 drift <drift.toml> [<override.toml>...] <output-dir>`.
+//!
+//! Objects are released on a regular latitude/longitude grid at one time and carried by each
+//! named ocean model to an end time (crates/ocean), one object per grid node and class. A class
+//! has a fixed response (Stokes factor, windage, leeway). For each model the product is the end
+//! latitude and longitude of every node and class, as little-endian f32 arrays [lat][lon]
+//! (row 0 = south, longitude fastest), NaN where not computed: the node is on land, the path
+//! reached land, or it left a field's domain. A TOML manifest describes the grid, inputs and
+//! integrator, and reports an interpolation test: objects released at random points between
+//! the nodes, integrated directly and compared with bilinear interpolation of the node ends.
+//!
+//! With an `[ensemble]` table, many objects are released from every node of a source grid
+//! around the 7th arc, each class's response drawn per object from its stated ranges, and each
+//! object's fate, stopping time and position are written (for debris-find likelihoods).
+//!
+//! With a `[replay]` table instead of a grid, the objects are GDP drifters: segments of a fixed
+//! horizon start on a fixed schedule, and every segment's predicted end point is written beside
+//! the observed one (replay.csv), with the drifter's drogue state. A path that stops (land, or
+//! out of a field's domain) keeps its last position and is still scored, so the statistics are
+//! not those of survivors.
+
+use crate::config;
+use crate::output::code_revision;
+use ocean::{Environment, Fate, Field, Land, Particle, Response};
+use rayon::prelude::*;
+use serde::Deserialize;
+use std::collections::BTreeMap;
+use std::path::{Path, PathBuf};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct DriftConfig {
+    name: String,
+    /// Input files (resolved relative to the config that names them).
+    inputs: BTreeMap<String, PathBuf>,
+    /// Current fields to run, by `inputs` key. The key is the shared 'ocean-model' name.
+    models: Vec<String>,
+    /// `inputs` keys of the Stokes, wind and land inputs, where used.
+    #[serde(default)]
+    stokes: Option<String>,
+    #[serde(default)]
+    wind: Option<String>,
+    #[serde(default)]
+    land: Option<String>,
+    step_s: f64,
+    #[serde(default)]
+    diffusivity_m2_s: f64,
+    classes: Vec<Class>,
+    /// A drift map: release on a grid at one time, end at another.
+    #[serde(default)]
+    release_utc: Option<String>,
+    #[serde(default)]
+    end_utc: Option<String>,
+    #[serde(default)]
+    grid: Option<Grid>,
+    /// Report the largest object speed over the grid in this interval (e.g. around release).
+    #[serde(default)]
+    speed_window_utc: Option<[String; 2]>,
+    #[serde(default)]
+    check: Option<Check>,
+    /// Or a drifter replay.
+    #[serde(default)]
+    replay: Option<Replay>,
+    /// Or a release of many objects per node of a source grid around the 7th arc.
+    #[serde(default)]
+    ensemble: Option<Ensemble>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Replay {
+    /// GDP 6-hourly drifter files, by `inputs` key: ID, time, latitude, longitude, drogue-loss time.
+    drifters: Vec<String>,
+    /// Segments start every `every_days` from `first_utc` to `last_utc` and last `horizon_days`.
+    first_utc: String,
+    last_utc: String,
+    every_days: f64,
+    horizon_days: f64,
+    /// Segments must start in this box.
+    #[serde(flatten)]
+    area: Area,
+}
+
+#[derive(Deserialize, Clone, Copy)]
+#[serde(deny_unknown_fields)]
+struct Grid {
+    south: f64,
+    north: f64,
+    west: f64,
+    east: f64,
+    step: f64,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Class {
+    name: String,
+    #[serde(default)]
+    stokes: Param,
+    #[serde(default)]
+    windage: Param,
+    #[serde(default)]
+    leeway_m_s: Param,
+    #[serde(default)]
+    leeway_left_deg: Param,
+    /// Random-walk diffusivity for this class; the config's `diffusivity_m2_s` if absent.
+    #[serde(default)]
+    diffusivity_m2_s: Option<f64>,
+}
+
+/// A response term: a fixed value, or (ensembles only) a uniform range drawn once per object.
+#[derive(Deserialize, Clone, Copy, Debug)]
+#[serde(untagged)]
+enum Param {
+    Fixed(f64),
+    Range([f64; 2]),
+}
+
+impl Default for Param {
+    fn default() -> Self {
+        Param::Fixed(0.0)
+    }
+}
+
+impl Param {
+    fn at(&self, u: f64) -> f64 {
+        match *self {
+            Param::Fixed(v) => v,
+            Param::Range([a, b]) => a + u * (b - a),
+        }
+    }
+    fn nonzero(&self) -> bool {
+        !matches!(self, Param::Fixed(v) if *v == 0.0)
+    }
+    fn toml(&self) -> toml::Value {
+        match *self {
+            Param::Fixed(v) => v.into(),
+            Param::Range([a, b]) => toml::Value::Array(vec![a.into(), b.into()]),
+        }
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Ensemble {
+    release_utc: String,
+    end_utc: String,
+    /// Objects per source node, class and seed.
+    particles: usize,
+    seeds: Vec<u64>,
+    sources: Sources,
+    /// South, north, west, east: an object outside this box has left the domain. The same box
+    /// for every ocean model keeps fates comparable across models.
+    #[serde(default)]
+    domain: Option<[f64; 4]>,
+}
+
+/// Source nodes: a regular grid, kept where it is at sea and between `inside_nm` inside and
+/// `beyond_nm` beyond the arc of SATCOM epoch `arc_epoch` (inputs `satcom_observations` and
+/// `satcom_ephemeris`). Distance from the arc is `satcom::arc_distance_nm` at sea level, the
+/// measure the end-of-flight stage gives each impact.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Sources {
+    south: f64,
+    north: f64,
+    west: f64,
+    east: f64,
+    step: f64,
+    inside_nm: f64,
+    beyond_nm: f64,
+    arc_epoch: String,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Check {
+    sources: usize,
+    seed: u64,
+    #[serde(flatten)]
+    area: Area,
+}
+
+#[derive(Deserialize)]
+struct Area {
+    south: f64,
+    north: f64,
+    west: f64,
+    east: f64,
+}
+
+impl Class {
+    /// The response with each ranged term at quantile `u[k]` of its range.
+    fn response_at(&self, u: [f64; 4]) -> Response {
+        Response {
+            stokes: self.stokes.at(u[0]),
+            windage: self.windage.at(u[1]),
+            leeway_mps: self.leeway_m_s.at(u[2]),
+            leeway_left_deg: self.leeway_left_deg.at(u[3]),
+        }
+    }
+    fn response(&self) -> Response {
+        self.response_at([0.0; 4])
+    }
+    fn diffusivity(&self, cfg: &DriftConfig) -> f64 {
+        self.diffusivity_m2_s.unwrap_or(cfg.diffusivity_m2_s)
+    }
+    fn is_fixed(&self) -> bool {
+        [self.stokes, self.windage, self.leeway_m_s, self.leeway_left_deg].iter().all(|p| matches!(p, Param::Fixed(_)))
+    }
+}
+
+impl Grid {
+    fn shape(&self) -> (usize, usize) {
+        let n = |a: f64, b: f64| ((b - a) / self.step).round() as usize + 1;
+        (n(self.south, self.north), n(self.west, self.east))
+    }
+
+    /// Bilinear interpolation of a node array at (lat, lon); NaN if any corner is NaN.
+    fn interpolate(&self, values: &[f64], lat: f64, lon: f64) -> f64 {
+        let (ny, nx) = self.shape();
+        let (y, x) = ((lat - self.south) / self.step, (lon - self.west) / self.step);
+        let (i, j) = ((y.floor() as usize).min(ny - 2), (x.floor() as usize).min(nx - 2));
+        let (fy, fx) = (y - i as f64, x - j as f64);
+        let v = |a: usize, b: usize| values[a * nx + b];
+        (1.0 - fy) * ((1.0 - fx) * v(i, j) + fx * v(i, j + 1)) + fy * ((1.0 - fx) * v(i + 1, j) + fx * v(i + 1, j + 1))
+    }
+}
+
+pub fn main(args: &[String]) -> Result<(), String> {
+    if args.len() < 2 {
+        return Err("usage: mh370 drift <drift.toml> [<override.toml>...] <output-dir>".into());
+    }
+    let paths: Vec<PathBuf> = args.iter().map(PathBuf::from).collect();
+    let (configs, out) = paths.split_at(paths.len() - 1);
+    let cfg: DriftConfig = toml::Value::Table(config::load_merged(configs)?)
+        .try_into()
+        .map_err(|e| format!("{}: {e}", configs[0].display()))?;
+    if !(cfg.step_s > 0.0 && !cfg.classes.is_empty()) {
+        return Err("drift config needs a positive step and a class".into());
+    }
+    if cfg.ensemble.is_none() && !cfg.classes.iter().all(Class::is_fixed) {
+        return Err("response ranges are for ensembles; maps and replays need fixed values".into());
+    }
+    let map = match (&cfg.replay, &cfg.ensemble, &cfg.grid, &cfg.release_utc, &cfg.end_utc) {
+        (Some(_), None, None, None, None) | (None, Some(_), None, None, None) => None,
+        (None, None, Some(grid), Some(release), Some(end)) => {
+            let (release, end) = (satcom::parse_utc(release)?, satcom::parse_utc(end)?);
+            let (ny, nx) = grid.shape();
+            if !(end > release && grid.step > 0.0 && ny >= 2 && nx >= 2) {
+                return Err("a drift map needs end > release and a 2x2 or larger grid".into());
+            }
+            Some((*grid, release, end))
+        }
+        _ => return Err("a drift config has one of: [grid] with release_utc and end_utc, [replay], or [ensemble]".into()),
+    };
+    let replay = cfg.replay.as_ref().map(|r| segments(&cfg, r)).transpose()?;
+    let input = |key: &Option<String>, what: &str| -> Result<Option<PathBuf>, String> {
+        key.as_ref()
+            .map(|k| cfg.inputs.get(k).cloned().ok_or_else(|| format!("{what} input `{k}` is not in [inputs]")))
+            .transpose()
+    };
+    let land = input(&cfg.land, "land")?.map(|p| Land::open(&p)).transpose()?;
+    let sources = cfg.ensemble.as_ref().map(|e| source_nodes(&cfg, e, land.as_ref())).transpose()?;
+    let responds = |f: fn(&Class) -> bool| cfg.classes.iter().any(f);
+    let open = |path: Option<PathBuf>, needed: bool, what: &str| -> Result<Option<Field>, String> {
+        match (path, needed) {
+            (Some(p), true) => Field::open(&p).map(Some),
+            (None, true) => Err(format!("a class responds to {what}, but no {what} input is named")),
+            _ => Ok(None),
+        }
+    };
+    let mut stokes = open(input(&cfg.stokes, "stokes")?, responds(|c| c.stokes.nonzero()), "Stokes drift")?;
+    let mut wind = open(input(&cfg.wind, "wind")?, responds(|c| c.windage.nonzero() || c.leeway_m_s.nonzero()), "wind")?;
+    for model in &cfg.models {
+        let path = cfg.inputs.get(model).ok_or_else(|| format!("model `{model}` is not in [inputs]"))?;
+        let mut current = Field::open(path)?;
+        let dir = out[0].join(model);
+        std::fs::create_dir_all(&dir).map_err(|e| format!("{}: {e}", dir.display()))?;
+        let started = std::time::Instant::now();
+        match (&map, &replay) {
+            (Some((grid, release, end)), _) => {
+                run_map(&cfg, model, &mut current, stokes.as_mut(), wind.as_mut(), land.as_ref(), grid, (*release, *end), &dir)?
+            }
+            (_, Some(segments)) => run_replay(&cfg, &mut current, stokes.as_mut(), wind.as_mut(), land.as_ref(), segments, &dir)?,
+            _ => run_ensemble(&cfg, model, &mut current, stokes.as_mut(), wind.as_mut(), land.as_ref(), sources.as_ref().unwrap(), &dir)?,
+        }
+        eprintln!("{}: {model} in {:.0} s", cfg.name, started.elapsed().as_secs_f64());
+    }
+    Ok(())
+}
+
+#[allow(clippy::too_many_arguments)]
+fn run_map(
+    cfg: &DriftConfig,
+    model: &str,
+    current: &mut Field,
+    mut stokes: Option<&mut Field>,
+    mut wind: Option<&mut Field>,
+    land: Option<&Land>,
+    grid: &Grid,
+    (release, end): (f64, f64),
+    dir: &Path,
+) -> Result<(), String> {
+    let (ny, nx) = grid.shape();
+    let nodes: Vec<(f64, f64)> =
+        (0..ny).flat_map(|i| (0..nx).map(move |j| (grid.south + i as f64 * grid.step, grid.west + j as f64 * grid.step))).collect();
+    let checks: Vec<(f64, f64)> = cfg.check.as_ref().map_or(Vec::new(), |c| {
+        (0..c.sources as u64)
+            .map(|k| {
+                let u = |d: u64| ocean::uniform([c.seed, k, d]);
+                (c.area.south + u(0) * (c.area.north - c.area.south), c.area.west + u(1) * (c.area.east - c.area.west))
+            })
+            .collect()
+    });
+    let starts: Vec<(f64, f64)> = nodes.iter().chain(&checks).copied().collect();
+    let mut particles: Vec<Particle> = cfg
+        .classes
+        .iter()
+        .flat_map(|c| starts.iter().map(move |&(lat, lon)| Particle::new(lat, lon, c.response())))
+        .collect();
+    if let Some(land) = land {
+        for p in particles.iter_mut().filter(|p| land.is_land(p.lat, p.lon)) {
+            (p.fate, p.stopped_unix_s) = (Fate::Beached, release);
+        }
+    }
+
+    let diffusivities: Vec<f64> = cfg.classes.iter().map(|c| c.diffusivity(cfg)).collect();
+    let steps = ((end - release) / cfg.step_s).ceil() as usize;
+    for k in 0..steps {
+        let t = release + k as f64 * cfg.step_s;
+        let dt = cfg.step_s.min(end - t);
+        load(current, &mut stokes, &mut wind, t, t + dt)?;
+        let env = Environment { current, stokes: stokes.as_deref(), wind: wind.as_deref(), land };
+        particles.par_iter_mut().enumerate().for_each(|(i, p)| {
+            let diffusivity = diffusivities[i / starts.len()];
+            let noise = if diffusivity > 0.0 { ocean::gaussian_pair([0, i as u64, k as u64]) } else { [0.0; 2] };
+            env.step(p, t, dt, diffusivity, noise);
+        });
+    }
+
+    // Largest object speed over the sea nodes in the speed window, per class.
+    let speeds = match &cfg.speed_window_utc {
+        None => Vec::new(),
+        Some([a, b]) => {
+            let (a, b) = (satcom::parse_utc(a)?, satcom::parse_utc(b)?);
+            load(current, &mut stokes, &mut wind, a, b)?;
+            let env = &Environment { current, stokes: stokes.as_deref(), wind: wind.as_deref(), land };
+            let times: Vec<f64> = (0..=6).map(|s| a + (b - a) * s as f64 / 6.0).collect();
+            cfg.classes
+                .iter()
+                .map(|c| {
+                    let r = c.response();
+                    nodes
+                        .par_iter()
+                        .filter(|&&(lat, lon)| !land.is_some_and(|l| l.is_land(lat, lon)))
+                        .flat_map_iter(|&(lat, lon)| times.iter().filter_map(move |&t| env.velocity(t, lat, lon, &r).ok()))
+                        .map(|v| v[0].hypot(v[1]))
+                        .reduce(|| 0.0, f64::max)
+                })
+                .collect()
+        }
+    };
+
+    // Arrays, fates and the interpolation test, per class.
+    let per_class = starts.len();
+    let mut manifest = toml::Table::new();
+    let mut classes = Vec::new();
+    for (c, class) in cfg.classes.iter().enumerate() {
+        let block = &particles[c * per_class..(c + 1) * per_class];
+        let end_of = |p: &Particle| if p.fate == Fate::Afloat { (p.lat, p.lon) } else { (f64::NAN, f64::NAN) };
+        let lat: Vec<f64> = block[..nodes.len()].iter().map(|p| end_of(p).0).collect();
+        let lon: Vec<f64> = block[..nodes.len()].iter().map(|p| end_of(p).1).collect();
+        let files = [format!("{}-lat.f32", class.name), format!("{}-lon.f32", class.name)];
+        for (file, values) in files.iter().zip([&lat, &lon]) {
+            let bytes: Vec<u8> = values.iter().flat_map(|&v| (v as f32).to_le_bytes()).collect();
+            std::fs::write(dir.join(file), bytes).map_err(|e| format!("{file}: {e}"))?;
+        }
+        let count = |f: Fate| block[..nodes.len()].iter().filter(|p| p.fate == f).count() as i64;
+        let mut errors: Vec<f64> = Vec::new();
+        let mut not_computed = 0;
+        for (p, &(slat, slon)) in block[nodes.len()..].iter().zip(&checks) {
+            let direct = end_of(p);
+            let (ilat, ilon) = (grid.interpolate(&lat, slat, slon), grid.interpolate(&lon, slat, slon));
+            if direct.0.is_finite() && ilat.is_finite() && ilon.is_finite() {
+                errors.push(great_circle_km(direct, (ilat, ilon)));
+            } else {
+                not_computed += 1;
+            }
+        }
+        errors.sort_by(f64::total_cmp);
+        classes.push((class, files, [count(Fate::Afloat), count(Fate::Beached), count(Fate::LeftDomain), count(Fate::NoData)], errors, not_computed));
+    }
+
+    let float = |x: f64| toml::Value::Float(x);
+    let floats = |xs: Vec<f64>| toml::Value::Array(xs.into_iter().map(float).collect());
+    let strings = |xs: Vec<String>| toml::Value::Array(xs.into_iter().map(toml::Value::String).collect());
+    let quantile = |e: &Vec<f64>, q: f64| if e.is_empty() { f64::NAN } else { e[((e.len() - 1) as f64 * q).round() as usize] };
+    let set = |t: &mut toml::Table, k: &str, v: toml::Value| {
+        t.insert(k.into(), v);
+    };
+    set(&mut manifest, "product", cfg.name.clone().into());
+    set(&mut manifest, "model", model.into());
+    set(&mut manifest, "release_utc", cfg.release_utc.clone().unwrap().into());
+    set(&mut manifest, "end_utc", cfg.end_utc.clone().unwrap().into());
+    set(&mut manifest, "lat0_deg", float(grid.south));
+    set(&mut manifest, "lon0_deg", float(grid.west));
+    set(&mut manifest, "step_deg", float(grid.step));
+    set(&mut manifest, "nlat", (ny as i64).into());
+    set(&mut manifest, "nlon", (nx as i64).into());
+    set(&mut manifest, "classes", strings(classes.iter().map(|c| c.0.name.clone()).collect()));
+    set(&mut manifest, "windage", floats(classes.iter().map(|c| c.0.windage.at(0.0)).collect()));
+    set(&mut manifest, "stokes_factor", floats(classes.iter().map(|c| c.0.stokes.at(0.0)).collect()));
+    set(&mut manifest, "leeway_m_s", floats(classes.iter().map(|c| c.0.leeway_m_s.at(0.0)).collect()));
+    set(&mut manifest, "leeway_left_deg", floats(classes.iter().map(|c| c.0.leeway_left_deg.at(0.0)).collect()));
+    set(&mut manifest, "latitude_files", strings(classes.iter().map(|c| c.1[0].clone()).collect()));
+    set(&mut manifest, "longitude_files", strings(classes.iter().map(|c| c.1[1].clone()).collect()));
+    set(&mut manifest, "array_layout", "little-endian f32 [nlat][nlon], row 0 = lat0_deg, NaN = not computed".into());
+    set(&mut manifest, "not_computed", "node on land, path reached land (GSHHG raster or the model's dry cells), or left a field's domain".into());
+    if !speeds.is_empty() {
+        set(&mut manifest, "max_release_speed_m_s", floats(speeds));
+        set(&mut manifest, "speed_window_utc", strings(cfg.speed_window_utc.clone().unwrap().to_vec()));
+    }
+    set(&mut manifest, "integrator", "explicit midpoint (RK2) on WGS-84, radii of curvature at each start point".into());
+    set(&mut manifest, "step_s", float(cfg.step_s));
+    set(&mut manifest, "diffusivity_m2_s", floats(classes.iter().map(|c| c.0.diffusivity(cfg)).collect()));
+    set(&mut manifest, "time_interpolation", "linear between field time stamps; daily means stamped at 12:00 UTC".into());
+    set(&mut manifest, "space_interpolation", "bilinear over wet nodes, renormalised; never filled with zero".into());
+    set(&mut manifest, "code_revision", code_revision().into());
+    set(&mut manifest, "fields", provenance(cfg, current, stokes.as_deref(), wind.as_deref()));
+    let mut fates = toml::Table::new();
+    for (i, name) in ["afloat", "beached", "left_domain", "no_data"].iter().enumerate() {
+        fates.insert((*name).into(), toml::Value::Array(classes.iter().map(|c| c.2[i].into()).collect()));
+    }
+    set(&mut manifest, "node_fates", toml::Value::Table(fates));
+    if let Some(check) = &cfg.check {
+        let mut t = toml::Table::new();
+        let per = |f: &dyn Fn(&Vec<f64>) -> f64| floats(classes.iter().map(|c| f(&c.3)).collect());
+        t.insert("area".into(), floats(vec![check.area.south, check.area.north, check.area.west, check.area.east]));
+        t.insert("seed".into(), (check.seed as i64).into());
+        t.insert("n".into(), toml::Value::Array(classes.iter().map(|c| (c.3.len() as i64).into()).collect()));
+        t.insert("not_computed".into(), toml::Value::Array(classes.iter().map(|c| c.4.into()).collect()));
+        t.insert("median_km".into(), per(&|e| quantile(e, 0.5)));
+        t.insert("p95_km".into(), per(&|e| quantile(e, 0.95)));
+        t.insert("p99_km".into(), per(&|e| quantile(e, 0.99)));
+        t.insert("max_km".into(), per(&|e| e.last().copied().unwrap_or(f64::NAN)));
+        let over = |km: f64| per(&move |e: &Vec<f64>| e.iter().filter(|&&x| x > km).count() as f64 / e.len() as f64);
+        t.insert("fraction_over_3km".into(), over(3.0));
+        t.insert("fraction_over_25km".into(), over(25.0));
+        set(&mut manifest, "interpolation_test", toml::Value::Table(t));
+    }
+    let text = toml::to_string(&manifest).map_err(|e| e.to_string())?;
+    std::fs::write(dir.join("manifest.toml"), text).map_err(|e| e.to_string())
+}
+
+/// Ensemble release nodes: sea nodes of a regular grid in the band around the 7th arc, each with
+/// its grid row and column and its distance from the arc (NM, positive beyond it).
+struct SourceSet {
+    grid: Grid,
+    nodes: Vec<(usize, usize, f64, f64, f64)>,
+}
+
+fn source_nodes(cfg: &DriftConfig, e: &Ensemble, land: Option<&Land>) -> Result<SourceSet, String> {
+    let s = &e.sources;
+    let input = |k: &str| cfg.inputs.get(k).ok_or_else(|| format!("an ensemble needs input `{k}` to place the arc"));
+    let epochs = satcom::load_epochs(input("satcom_observations")?, input("satcom_ephemeris")?)?;
+    let epoch = epochs.iter().find(|x| x.id == s.arc_epoch).ok_or_else(|| format!("no SATCOM epoch `{}`", s.arc_epoch))?;
+    let bto = epoch.bto_us.ok_or("the arc epoch has no BTO")?;
+    let grid = Grid { south: s.south, north: s.north, west: s.west, east: s.east, step: s.step };
+    let (ny, nx) = grid.shape();
+    let mut nodes = Vec::new();
+    for i in 0..ny {
+        for j in 0..nx {
+            let (lat, lon) = (s.south + i as f64 * s.step, s.west + j as f64 * s.step);
+            let d = satcom::arc_distance_nm(epoch.satellite_km, lat, lon, 0.0, bto);
+            if (-s.inside_nm..=s.beyond_nm).contains(&d) && !land.is_some_and(|l| l.is_land(lat, lon)) {
+                nodes.push((i, j, lat, lon, d));
+            }
+        }
+    }
+    if nodes.is_empty() {
+        return Err("no source node lies at sea within the band".into());
+    }
+    Ok(SourceSet { grid, nodes })
+}
+
+/// Many objects from every source node; each object's fate, stopping time and position.
+#[allow(clippy::too_many_arguments)]
+fn run_ensemble(
+    cfg: &DriftConfig,
+    model: &str,
+    current: &mut Field,
+    mut stokes: Option<&mut Field>,
+    mut wind: Option<&mut Field>,
+    land: Option<&Land>,
+    sources: &SourceSet,
+    dir: &Path,
+) -> Result<(), String> {
+    const RESPONSE_KEY: u64 = 0x5eed_0f_0b1ec7;
+    let e = cfg.ensemble.as_ref().unwrap();
+    let (release, end) = (satcom::parse_utc(&e.release_utc)?, satcom::parse_utc(&e.end_utc)?);
+    if !(end > release && e.particles > 0 && !e.seeds.is_empty()) {
+        return Err("an ensemble needs end > release, particles and seeds".into());
+    }
+    let (n_src, n_cls, n) = (sources.nodes.len(), cfg.classes.len(), e.particles);
+    let per_seed = n_src * n_cls * n;
+    // Particle index: ((seed * sources + source) * classes + class) * particles + k.
+    let mut particles = Vec::with_capacity(e.seeds.len() * per_seed);
+    for &seed in &e.seeds {
+        for &(_, _, lat, lon, _) in &sources.nodes {
+            for (c, class) in cfg.classes.iter().enumerate() {
+                for k in 0..n {
+                    let id = ((particles.len() % per_seed) as u64, c, k).0;
+                    let u = [0, 1, 2, 3].map(|d| ocean::uniform([seed ^ RESPONSE_KEY, id, d]));
+                    particles.push(Particle::new(lat, lon, class.response_at(u)));
+                }
+            }
+        }
+    }
+    let diffusivities: Vec<f64> = cfg.classes.iter().map(|c| c.diffusivity(cfg)).collect();
+    let steps = ((end - release) / cfg.step_s).ceil() as usize;
+    for k in 0..steps {
+        let t = release + k as f64 * cfg.step_s;
+        let dt = cfg.step_s.min(end - t);
+        load(current, &mut stokes, &mut wind, t, t + dt)?;
+        let env = Environment { current, stokes: stokes.as_deref(), wind: wind.as_deref(), land };
+        particles.par_iter_mut().enumerate().for_each(|(i, p)| {
+            if p.fate != Fate::Afloat {
+                return;
+            }
+            let diffusivity = diffusivities[(i % per_seed) / n % n_cls];
+            let noise = if diffusivity > 0.0 {
+                ocean::gaussian_pair([e.seeds[i / per_seed], (i % per_seed) as u64, k as u64])
+            } else {
+                [0.0; 2]
+            };
+            env.step(p, t, dt, diffusivity, noise);
+            if let Some([south, north, west, east]) = e.domain {
+                if p.fate == Fate::Afloat && !((south..=north).contains(&p.lat) && (west..=east).contains(&p.lon)) {
+                    (p.fate, p.stopped_unix_s) = (Fate::LeftDomain, t + dt);
+                }
+            }
+        });
+        if k % 240 == 0 {
+            let afloat = particles.iter().filter(|p| p.fate == Fate::Afloat).count();
+            eprintln!("{}: {model} day {:.0}, {afloat} of {} afloat", cfg.name, (t - release) / 86_400.0, particles.len());
+        }
+    }
+
+    // Arrays per seed and class, [source][object]: fate (u8: 0 afloat at the end, 1 beached,
+    // 2 left the domain, 3 no data), days from release to stopping (NaN if afloat at the end),
+    // and the stopping (or final) latitude and longitude.
+    let write = |name: &str, bytes: Vec<u8>| std::fs::write(dir.join(name), bytes).map_err(|e| format!("{name}: {e}"));
+    let code = |f: Fate| match f {
+        Fate::Afloat => 0u8,
+        Fate::Beached => 1,
+        Fate::LeftDomain => 2,
+        Fate::NoData => 3,
+    };
+    let mut fates = toml::Table::new();
+    for (si, &seed) in e.seeds.iter().enumerate() {
+        for (c, class) in cfg.classes.iter().enumerate() {
+            let block: Vec<&Particle> = (0..n_src)
+                .flat_map(|s| (0..n).map(move |k| si * per_seed + (s * n_cls + c) * n + k))
+                .map(|i| &particles[i])
+                .collect();
+            let stem = format!("{}-seed{seed}", class.name);
+            let days = |p: &&Particle| if p.fate == Fate::Afloat { f32::NAN } else { ((p.stopped_unix_s - release) / 86_400.0) as f32 };
+            write(&format!("{stem}-fate.u8"), block.iter().map(|p| code(p.fate)).collect())?;
+            write(&format!("{stem}-days.f32"), block.iter().flat_map(|p| days(p).to_le_bytes()).collect())?;
+            write(&format!("{stem}-lat.f32"), block.iter().flat_map(|p| (p.lat as f32).to_le_bytes()).collect())?;
+            write(&format!("{stem}-lon.f32"), block.iter().flat_map(|p| (p.lon as f32).to_le_bytes()).collect())?;
+            let counts: Vec<toml::Value> = (0..4u8).map(|f| (block.iter().filter(|p| code(p.fate) == f).count() as i64).into()).collect();
+            fates.insert(stem, toml::Value::Array(counts));
+        }
+    }
+    write("sources.f64", sources.nodes.iter().flat_map(|&(_, _, lat, lon, arc)| [lat, lon, arc]).flat_map(f64::to_le_bytes).collect())?;
+    write("sources-index.u32", sources.nodes.iter().flat_map(|&(i, j, ..)| [i as u32, j as u32]).flat_map(u32::to_le_bytes).collect())?;
+
+    let mut m = toml::Table::new();
+    let mut set = |k: &str, v: toml::Value| {
+        m.insert(k.into(), v);
+    };
+    set("product", cfg.name.clone().into());
+    set("model", model.into());
+    set("release_utc", e.release_utc.clone().into());
+    set("end_utc", e.end_utc.clone().into());
+    set("particles_per_source_class_seed", (n as i64).into());
+    set("seeds", toml::Value::Array(e.seeds.iter().map(|&s| (s as i64).into()).collect()));
+    set("sources", (n_src as i64).into());
+    let g = &sources.grid;
+    set("grid", toml::Value::Array([g.south, g.north, g.west, g.east, g.step].map(Into::into).to_vec()));
+    set("inside_nm", e.sources.inside_nm.into());
+    set("beyond_nm", e.sources.beyond_nm.into());
+    set("arc_epoch", e.sources.arc_epoch.clone().into());
+    if let Some(d) = e.domain {
+        set("domain", toml::Value::Array(d.map(Into::into).to_vec()));
+    }
+    let mut classes = toml::Table::new();
+    for class in &cfg.classes {
+        let mut t = toml::Table::new();
+        t.insert("stokes".into(), class.stokes.toml());
+        t.insert("windage".into(), class.windage.toml());
+        t.insert("leeway_m_s".into(), class.leeway_m_s.toml());
+        t.insert("leeway_left_deg".into(), class.leeway_left_deg.toml());
+        t.insert("diffusivity_m2_s".into(), class.diffusivity(cfg).into());
+        classes.insert(class.name.clone(), toml::Value::Table(t));
+    }
+    set("classes", toml::Value::Table(classes));
+    set("fate_counts", toml::Value::Table(fates));
+    set("fate_codes", "counts are [afloat at end, beached, left domain, no data]; fate.u8 uses 0-3 in that order".into());
+    set(
+        "files",
+        concat!(
+            "sources.f64: [source] lat, lon, distance from the arc (NM, + beyond); sources-index.u32: [source] grid row, ",
+            "column; <class>-seed<k>-{fate.u8, days.f32, lat.f32, lon.f32}: [source][object], days to stopping (NaN if ",
+            "afloat), stopping or final position; little-endian"
+        )
+        .into(),
+    );
+    set("step_s", cfg.step_s.into());
+    set("responses", "ranged terms are uniform, drawn once per object".into());
+    set("code_revision", code_revision().into());
+    set("fields", provenance(cfg, current, stokes.as_deref(), wind.as_deref()));
+    std::fs::write(dir.join("manifest.toml"), toml::to_string(&m).map_err(|e| e.to_string())?).map_err(|e| e.to_string())
+}
+
+/// Replay GDP drifter segments and write each one's predicted end beside the observed end.
+fn run_replay(
+    cfg: &DriftConfig,
+    current: &mut Field,
+    mut stokes: Option<&mut Field>,
+    mut wind: Option<&mut Field>,
+    land: Option<&Land>,
+    (first, segments): &(f64, Vec<Segment>),
+    dir: &Path,
+) -> Result<(), String> {
+    let n = segments.len();
+    let mut particles: Vec<Particle> =
+        cfg.classes.iter().flat_map(|c| segments.iter().map(move |s| Particle::new(s.start.0, s.start.1, c.response()))).collect();
+    if let Some(land) = land {
+        for (i, p) in particles.iter_mut().enumerate().filter(|(_, p)| land.is_land(p.lat, p.lon)) {
+            (p.fate, p.stopped_unix_s) = (Fate::Beached, segments[i % n].start_unix_s);
+        }
+    }
+    let diffusivities: Vec<f64> = cfg.classes.iter().map(|c| c.diffusivity(cfg)).collect();
+    let steps = segments.iter().map(|s| s.start_step + s.steps).max().unwrap_or(0);
+    for k in 0..steps {
+        let t = first + k as f64 * cfg.step_s;
+        load(current, &mut stokes, &mut wind, t, t + cfg.step_s)?;
+        let env = Environment { current, stokes: stokes.as_deref(), wind: wind.as_deref(), land };
+        particles.par_iter_mut().enumerate().for_each(|(i, p)| {
+            let s = &segments[i % n];
+            if (s.start_step..s.start_step + s.steps).contains(&k) {
+                let diffusivity = diffusivities[i / n];
+                let noise = if diffusivity > 0.0 { ocean::gaussian_pair([0, i as u64, k as u64]) } else { [0.0; 2] };
+                env.step(p, t, cfg.step_s, diffusivity, noise);
+            }
+        });
+    }
+    let mut csv = String::from("id,drogue,start_unix_s,start_lat,start_lon,end_lat,end_lon");
+    for c in &cfg.classes {
+        csv += &format!(",{0}_lat,{0}_lon,{0}_fate", c.name);
+    }
+    csv.push('\n');
+    for (j, s) in segments.iter().enumerate() {
+        csv += &format!("{},{},{},{:.5},{:.5},{:.5},{:.5}", s.id, s.drogue, s.start_unix_s, s.start.0, s.start.1, s.end.0, s.end.1);
+        for c in 0..cfg.classes.len() {
+            let p = &particles[c * n + j];
+            csv += &format!(",{:.5},{:.5},{}", p.lat, p.lon, format!("{:?}", p.fate).to_lowercase());
+        }
+        csv.push('\n');
+    }
+    std::fs::write(dir.join("replay.csv"), csv).map_err(|e| e.to_string())?;
+    let r = cfg.replay.as_ref().unwrap();
+    let mut manifest = toml::Table::new();
+    manifest.insert("product".into(), cfg.name.clone().into());
+    manifest.insert("first_utc".into(), r.first_utc.clone().into());
+    manifest.insert("last_utc".into(), r.last_utc.clone().into());
+    manifest.insert("every_days".into(), r.every_days.into());
+    manifest.insert("horizon_days".into(), r.horizon_days.into());
+    manifest.insert("area".into(), toml::Value::Array([r.area.south, r.area.north, r.area.west, r.area.east].map(Into::into).to_vec()));
+    for state in ["drogued", "undrogued", "transition"] {
+        manifest.insert(format!("{state}_segments"), (segments.iter().filter(|s| s.drogue == state).count() as i64).into());
+    }
+    manifest.insert("step_s".into(), cfg.step_s.into());
+    manifest.insert("diffusivity_m2_s".into(), toml::Value::Array(diffusivities.iter().map(|&k| k.into()).collect()));
+    manifest.insert("code_revision".into(), code_revision().into());
+    manifest.insert("fields".into(), provenance(cfg, current, stokes.as_deref(), wind.as_deref()));
+    std::fs::write(dir.join("manifest.toml"), toml::to_string(&manifest).map_err(|e| e.to_string())?).map_err(|e| e.to_string())
+}
+
+/// One drifter segment: where it started, where it was one horizon later, and its drogue state.
+struct Segment {
+    id: String,
+    drogue: &'static str,
+    start_unix_s: f64,
+    start_step: usize,
+    steps: usize,
+    start: (f64, f64),
+    end: (f64, f64),
+}
+
+/// Segments from the GDP files: a drifter at a scheduled start time inside the area, with an
+/// observation exactly one horizon later. Returns the first scheduled start and the segments.
+fn segments(cfg: &DriftConfig, r: &Replay) -> Result<(f64, Vec<Segment>), String> {
+    let (first, last) = (satcom::parse_utc(&r.first_utc)?, satcom::parse_utc(&r.last_utc)?);
+    let (every, horizon) = (r.every_days * 86_400.0, r.horizon_days * 86_400.0);
+    let whole = |x: f64| (x / cfg.step_s - (x / cfg.step_s).round()).abs() < 1e-9;
+    if !(last >= first && every > 0.0 && horizon > 0.0 && whole(every) && whole(horizon)) {
+        return Err("a replay needs last_utc >= first_utc, and every_days and horizon_days in whole steps".into());
+    }
+    let mut tracks: BTreeMap<String, (f64, BTreeMap<i64, (f64, f64)>)> = BTreeMap::new();
+    for key in &r.drifters {
+        let path = cfg.inputs.get(key).ok_or_else(|| format!("drifter input `{key}` is not in [inputs]"))?;
+        let text = std::fs::read_to_string(path).map_err(|e| format!("{}: {e}", path.display()))?;
+        for (n, line) in text.lines().enumerate().skip(2) {
+            let bad = || format!("{}: line {}", path.display(), n + 1);
+            let f: Vec<&str> = line.split(',').collect();
+            if f.len() != 5 {
+                return Err(bad());
+            }
+            let (lat, lon): (f64, f64) = (f[2].parse().map_err(|_| bad())?, f[3].parse().map_err(|_| bad())?);
+            let track = tracks.entry(f[0].into()).or_insert((satcom::parse_utc(f[4])?, BTreeMap::new()));
+            track.1.insert(satcom::parse_utc(f[1])? as i64, (lat, lon));
+        }
+    }
+    let mut out = Vec::new();
+    for (id, (lost, track)) in &tracks {
+        for (&t0, &start) in track {
+            let t0 = t0 as f64;
+            let k = (t0 - first) / every;
+            let inside = (r.area.south..=r.area.north).contains(&start.0) && (r.area.west..=r.area.east).contains(&start.1);
+            if !(t0 >= first && t0 <= last && (k - k.round()).abs() < 1e-9 && inside) {
+                continue;
+            }
+            let Some(&end) = track.get(&((t0 + horizon) as i64)) else { continue };
+            let drogue = if t0 + horizon < *lost {
+                "drogued"
+            } else if t0 >= *lost {
+                "undrogued"
+            } else {
+                "transition"
+            };
+            let start_step = ((t0 - first) / cfg.step_s).round() as usize;
+            out.push(Segment { id: id.clone(), drogue, start_unix_s: t0, start_step, steps: (horizon / cfg.step_s).round() as usize, start, end });
+        }
+    }
+    if out.is_empty() {
+        return Err("no drifter segments match the replay schedule and area".into());
+    }
+    Ok((first, out))
+}
+
+/// Input files, their products and hashes (from each file's .json sidecar), for a manifest.
+fn provenance(cfg: &DriftConfig, current: &Field, stokes: Option<&Field>, wind: Option<&Field>) -> toml::Value {
+    let land = cfg.land.as_ref().and_then(|k| cfg.inputs.get(k)).map(PathBuf::as_path);
+    let mut fields = toml::Table::new();
+    for (role, path) in [("current", Some(current.path.as_path())), ("stokes", stokes.map(|f| f.path.as_path())), ("wind", wind.map(|f| f.path.as_path())), ("land", land)] {
+        let Some(path) = path else { continue };
+        let mut t = toml::Table::new();
+        let absolute = std::fs::canonicalize(path).unwrap_or_else(|_| path.to_path_buf());
+        t.insert("path".into(), absolute.display().to_string().into());
+        let sidecar: serde_json::Value = std::fs::read_to_string(format!("{}.json", path.display()))
+            .ok()
+            .and_then(|s| serde_json::from_str(&s).ok())
+            .unwrap_or_default();
+        for key in ["name", "product", "dataset", "source", "sha256"] {
+            if let Some(v) = sidecar.get(key).and_then(|v| v.as_str()) {
+                t.insert(key.into(), v.into());
+            }
+        }
+        fields.insert(role.into(), toml::Value::Table(t));
+    }
+    toml::Value::Table(fields)
+}
+
+/// Make every field's slices for [t0, t1] resident.
+fn load(current: &mut Field, stokes: &mut Option<&mut Field>, wind: &mut Option<&mut Field>, t0: f64, t1: f64) -> Result<(), String> {
+    current.load(t0, t1)?;
+    stokes.as_deref_mut().map_or(Ok(()), |f| f.load(t0, t1))?;
+    wind.as_deref_mut().map_or(Ok(()), |f| f.load(t0, t1))
+}
+
+fn great_circle_km(a: (f64, f64), b: (f64, f64)) -> f64 {
+    let (p1, p2) = (a.0.to_radians(), b.0.to_radians());
+    let h = ((p2 - p1) / 2.0).sin().powi(2) + p1.cos() * p2.cos() * ((b.1 - a.1).to_radians() / 2.0).sin().powi(2);
+    2.0 * 6_371.008_8 * h.sqrt().asin()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn bilinear_interpolation_of_node_values_is_exact_for_a_linear_field() {
+        let grid = Grid { south: -50.0, north: -49.0, west: 70.0, east: 71.0, step: 0.5 };
+        let (ny, nx) = grid.shape();
+        let values: Vec<f64> = (0..ny * nx).map(|k| 3.0 * (k / nx) as f64 - 2.0 * (k % nx) as f64).collect();
+        let v = grid.interpolate(&values, -49.25, 70.75);
+        assert!((v - (3.0 * 1.5 - 2.0 * 1.5)).abs() < 1e-12, "{v}");
+        assert_eq!(grid.interpolate(&values, -49.0, 71.0), values[ny * nx - 1]);
+    }
+}
