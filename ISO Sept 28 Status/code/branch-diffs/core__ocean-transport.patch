index 0000000..af98dc2
--- /dev/null
+++ b/.sources/ocean-drift/mhgrid.py
@@ -0,0 +1,83 @@
+"""Writer for MHGRID schema 3, the gridded-field layout read by crates/ocean/src/field.rs.
+
+Layout (little-endian, C order, longitude fastest; axes strictly increasing):
+    b"MHGRID1\\0", u32 schema=3, u32 time_axis=0 (Unix seconds),
+    u32 nt, ny, nx, nc, f64 times[nt], latitudes[ny], longitudes[nx],
+    then per component: 16-byte NUL-padded name, u32 encoding=1 (packed i16),
+    f64 scale, f64 offset, i16 missing, i16 land, i16 values[nt][ny][nx].
+A value is offset + scale * packed. `missing` marks an absent value, `land` a cell
+that is dry at every time. Neither is ever read as zero.
+"""
+
+import hashlib
+import os
+import struct
+from pathlib import Path
+
+import numpy as np
+
+MAGIC = b"MHGRID1\0"
+MISSING = -30000
+LAND = -29999
+
+
+class Writer:
+    """Sizes the file up front so slices can be written in any order, from any thread: every
+    write is positional (os.pwrite), with no shared file offset to race on."""
+
+    def __init__(self, path, times, latitudes, longitudes, names, scale, offset=0.0):
+        self.path = Path(path)
+        self.shape = (len(times), len(latitudes), len(longitudes))
+        self.scale, self.offset = float(scale), float(offset)
+        for axis in (times, latitudes, longitudes):
+            if not np.all(np.diff(np.asarray(axis, dtype=float)) > 0):
+                raise ValueError("MHGRID axes must be strictly increasing")
+        header = MAGIC + struct.pack("<6I", 3, 0, *self.shape, len(names))
+        header += b"".join(np.asarray(a, dtype="<f8").tobytes() for a in (times, latitudes, longitudes))
+        slab = 2 * int(np.prod(self.shape))
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT | os.O_TRUNC, 0o644)
+        os.pwrite(self.fd, header, 0)
+        at = len(header)
+        self.value_offsets = []
+        for name in names:
+            meta = name.encode("ascii").ljust(16, b"\0") + struct.pack("<Iddhh", 1, self.scale, self.offset, MISSING, LAND)
+            os.pwrite(self.fd, meta, at)
+            at += len(meta)
+            self.value_offsets.append(at)
+            at += slab
+        os.ftruncate(self.fd, at)
+
+    def pack(self, values, land=None):
+        """Float values (NaN = missing) to packed i16; `land` marks persistently dry cells."""
+        values = np.asarray(values, dtype=np.float64)
+        finite = np.isfinite(values)
+        packed = np.full(values.shape, MISSING, dtype="<i2")
+        scaled = np.rint((values[finite] - self.offset) / self.scale)
+        if scaled.size and (scaled.min() < -29990 or scaled.max() > 32767):
+            raise ValueError(f"{self.path.name}: value outside the packed range")
+        packed[finite] = scaled.astype("<i2")
+        if land is not None:
+            packed[land & ~finite] = LAND
+        return packed
+
+    def write(self, time_index, component, packed):
+        packed = np.ascontiguousarray(packed, dtype="<i2")
+        if packed.shape != self.shape[1:]:
+            raise ValueError(f"slice shape {packed.shape}, expected {self.shape[1:]}")
+        data = packed.tobytes()
+        if os.pwrite(self.fd, data, self.value_offsets[component] + 2 * time_index * packed.size) != len(data):
+            raise OSError(f"{self.path.name}: short write")
+
+    def close(self):
+        os.fsync(self.fd)
+        os.close(self.fd)
+        return sha256(self.path)
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for block in iter(lambda: stream.read(1 << 22), b""):
+            digest.update(block)
+    return digest.hexdigest()
