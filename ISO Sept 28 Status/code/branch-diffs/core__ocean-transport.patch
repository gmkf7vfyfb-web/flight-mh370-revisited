+++ b/.sources/ocean-drift/bran.py
@@ -0,0 +1,137 @@
+#!/usr/bin/env python3
+"""BRAN2016 surface currents to MHGRID schema 3 (crates/ocean/src/field.rs).
+
+Source: CSIRO Bluelink ReANalysis BRAN2016 (OFAM3, 0.1 deg, daily means), NCI THREDDS
+OPeNDAP: https://thredds.nci.org.au/thredds/dodsC/gb6/BRAN/BRAN_2016/OFAM/ocean_{u,v}_YYYY_MM.nc.
+No login. BRAN is free to use with an acknowledgement ("BRAN is made freely available by
+CSIRO Bluelink and is supported by the Bluelink Partnership: a collaboration between the
+Australian Department of Defence, Bureau of Meteorology and CSIRO"); CSIRO asks users to
+email bluelinkinfo@csiro.au with their organisation and intended use. BRAN2016 covers
+January 1994 to August 2016.
+
+The top level (2.5 m) of u and v on the B-grid velocity points is cut server-side to the
+requested box and written with the source's own packing (int16 x 3.051851e-4 m/s), so
+values are exact. Stamps are the source's (12:00 UTC, the centre of each daily mean).
+Cells missing on every day are written as land at the end.
+
+    bran.py --start 2014-03-07 --end 2014-03-24 [--south -55 --north 15 --west 0 --east 180] \
+        --output <file.mhgrid>
+"""
+
+import argparse
+import json
+import struct
+import time
+import urllib.request
+from concurrent.futures import ThreadPoolExecutor
+from datetime import date, datetime, timedelta, timezone
+from pathlib import Path
+
+import numpy as np
+
+import mhgrid
+
+URL = "https://thredds.nci.org.au/thredds/dodsC/gb6/BRAN/BRAN_2016/OFAM/ocean_{}_{:%Y_%m}.nc"
+SCALE = 3.051851e-4
+EPOCH_1979 = datetime(1979, 1, 1, tzinfo=timezone.utc).timestamp()
+
+
+def fetch(url, attempts=6):
+    for attempt in range(attempts):
+        try:
+            with urllib.request.urlopen(url, timeout=300) as response:
+                return response.read()
+        except Exception:
+            if attempt == attempts - 1:
+                raise
+            time.sleep(2**attempt)
+
+
+def ascii_values(url):
+    """The values of a one-variable DAP2 ASCII response: its last line, comma-separated."""
+    return np.array([float(v) for v in fetch(url).decode().strip().split("\n")[-1].split(",")])
+
+
+def dods_int32(blob):
+    """Values of a single-array DAP2 response (XDR: count twice, then big-endian int32)."""
+    data = blob[blob.index(b"\nData:\n") + 7 :]
+    n, m = struct.unpack(">II", data[:8])
+    if n != m or len(data) != 8 + 4 * n:
+        raise ValueError("unexpected DAP2 payload")
+    return np.frombuffer(data, ">i4", n, 8)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--start", type=date.fromisoformat, required=True)
+    parser.add_argument("--end", type=date.fromisoformat, required=True, help="last day, inclusive")
+    for edge, default in (("south", -55.0), ("north", 15.0), ("west", 0.0), ("east", 180.0)):
+        parser.add_argument(f"--{edge}", type=float, default=default)
+    parser.add_argument("--workers", type=int, default=4, help="parallel OPeNDAP requests (be kind to NCI)")
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+    months = sorted({(d.year, d.month) for d in (args.start + timedelta(k) for k in range((args.end - args.start).days + 1))})
+    probe = URL.format("u", date(*months[0], 1))
+    all_lat, all_lon = ascii_values(f"{probe}.ascii?yu_ocean"), ascii_values(f"{probe}.ascii?xu_ocean")
+    rows = np.flatnonzero((all_lat >= args.south - 1e-4) & (all_lat <= args.north + 1e-4))
+    cols = np.flatnonzero((all_lon >= args.west - 1e-4) & (all_lon <= args.east + 1e-4))
+    Y0, Y1, X0, X1 = rows[0], rows[-1], cols[0], cols[-1]
+    lat, lon = all_lat[Y0 : Y1 + 1], all_lon[X0 : X1 + 1]
+    plan, times = [], []
+    for year, month in months:
+        stamps = ascii_values(f"{URL.format('u', date(year, month, 1))}.ascii?Time")
+        for k, days in enumerate(stamps):
+            t = EPOCH_1979 + 86_400.0 * days
+            if args.start <= datetime.fromtimestamp(t, timezone.utc).date() <= args.end:
+                plan.append((year, month, k))
+                times.append(t)
+    writer = mhgrid.Writer(args.output, times, lat, lon, ["u", "v"], SCALE)
+
+    def convert(task):
+        t, c, (year, month, k) = task
+        var = ("u", "v")[c]
+        query = f"{var}.{var}%5B{k}:{k}%5D%5B0:0%5D%5B{Y0}:{Y1}%5D%5B{X0}:{X1}%5D"
+        raw = dods_int32(fetch(f"{URL.format(var, date(year, month, 1))}.dods?{query}")).reshape(len(lat), len(lon))
+        absent = raw == -32768
+        if np.abs(raw[~absent]).max(initial=0) >= 29_990:
+            raise ValueError("packed value collides with the MHGRID sentinels")
+        writer.write(t, c, np.where(absent, mhgrid.MISSING, raw).astype("<i2"))
+        return absent
+
+    ever_finite = np.zeros((len(lat), len(lon)), bool)
+    tasks = [(t, c, step) for t, step in enumerate(plan) for c in (0, 1)]
+    with ThreadPoolExecutor(args.workers) as pool:
+        for n, absent in enumerate(pool.map(convert, tasks), 1):
+            ever_finite |= ~absent
+            if n % 50 == 0:
+                print(f"{n}/{len(tasks)} slices", flush=True)
+    writer.close()
+    land = ~ever_finite
+    for c in range(2):
+        values = np.memmap(args.output, "<i2", "r+", offset=writer.value_offsets[c], shape=writer.shape)
+        for t in range(len(times)):
+            values[t][land] = mhgrid.LAND
+        values.flush()
+        del values
+    manifest = {
+        "name": "BRAN2016 (OFAM3) surface current (2.5 m), daily mean",
+        "product": "CSIRO Bluelink ReANalysis BRAN2016",
+        "source": URL.format("{u,v}", date(2014, 1, 1)).replace("2014_01", "YYYY_MM"),
+        "acknowledgement": "BRAN is made freely available by CSIRO Bluelink and is supported by the Bluelink "
+                           "Partnership: a collaboration between the Australian Department of Defence, Bureau of "
+                           "Meteorology and CSIRO.",
+        "time": {"first_utc": datetime.fromtimestamp(times[0], timezone.utc).isoformat(),
+                 "last_utc": datetime.fromtimestamp(times[-1], timezone.utc).isoformat(), "count": len(times),
+                 "stamp": "source Time (days since 1979-01-01), 12:00 UTC centre of each daily mean"},
+        "grid": {"latitude": [float(lat[0]), float(lat[-1]), len(lat)], "longitude": [float(lon[0]), float(lon[-1]), len(lon)]},
+        "packing": {"scale": SCALE, "offset": 0.0, "missing": mhgrid.MISSING, "land": mhgrid.LAND},
+        "land_cells": int(land.sum()),
+        "sha256": mhgrid.sha256(args.output),
+        "created_utc": datetime.now(timezone.utc).isoformat(timespec="seconds"),
+    }
+    Path(args.output + ".json").write_text(json.dumps(manifest, indent=1) + "\n")
+    print(json.dumps({k: manifest[k] for k in ("time", "land_cells", "sha256")}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/.sources/ocean-drift/cmems.py b/.sources/ocean-drift/cmems.py
