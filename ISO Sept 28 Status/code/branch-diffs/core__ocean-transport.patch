index 0000000..3e99784
--- /dev/null
+++ b/.sources/ocean-drift/gshhg_land.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""GSHHG shoreline to the MHLAND1 bit raster read by crates/ocean/src/land.rs.
+
+Source: GSHHG 2.3.7 (Wessel & Smith), full resolution, level-1 (land) polygons, from
+https://github.com/GenericMappingTools/gshhg-gmt/releases/download/2.3.7/gshhg-bin-2.3.7.zip
+(LGPL). Lakes are left as land: a drifting object cannot reach them.
+
+A cell is land when its centre is inside a land polygon (even-odd scanline fill).
+
+    gshhg_land.py <gshhg-bin-2.3.7.zip> <out.mhland> [--cell-arcsec 30]
+"""
+
+import argparse
+import hashlib
+import json
+import struct
+import zipfile
+from datetime import datetime, timezone
+
+import numpy as np
+
+SOUTH, NORTH, WEST, EAST = -55.0, 15.0, 0.0, 180.0
+
+
+def land_polygons(blob):
+    """Yield (lon, lat) arrays in degrees for every level-1 polygon, longitude unwrapped."""
+    at = 0
+    while at < len(blob):
+        header = struct.unpack(">11i", blob[at : at + 44])
+        n, flag = header[1], header[2]
+        points = np.frombuffer(blob, ">i4", 2 * n, at + 44).reshape(n, 2) * 1e-6
+        at += 44 + 8 * n
+        if flag & 255 != 1:
+            continue
+        lon = np.degrees(np.unwrap(np.radians(points[:, 0])))
+        lon -= 360.0 * np.floor((lon.min() + 180.0) / 360.0)  # west edge in [-180, 180)
+        yield lon, points[:, 1]
+
+
+def rasterise(polygons, cell):
+    ny, nx = round((NORTH - SOUTH) / cell), round((EAST - WEST) / cell)
+    crossings = [[] for _ in range(ny)]
+    for lon, lat in polygons:
+        if lat.max() < SOUTH or lat.min() > NORTH or lon.max() < WEST or lon.min() > EAST:
+            continue
+        x0, y0 = lon, lat
+        x1, y1 = np.roll(lon, -1), np.roll(lat, -1)
+        # Rows whose centre latitude c satisfies min(y0, y1) <= c < max(y0, y1).
+        lo = np.ceil((np.minimum(y0, y1) - SOUTH) / cell - 0.5).astype(np.int64)
+        hi = np.ceil((np.maximum(y0, y1) - SOUTH) / cell - 0.5).astype(np.int64)
+        lo, hi = np.clip(lo, 0, ny), np.clip(hi, 0, ny)
+        count = hi - lo
+        keep = count > 0
+        if not keep.any():
+            continue
+        edge = np.repeat(np.flatnonzero(keep), count[keep])
+        start = np.repeat(lo[keep], count[keep])
+        row = start + np.arange(len(edge)) - np.repeat(np.cumsum(count[keep]) - count[keep], count[keep])
+        centre = SOUTH + (row + 0.5) * cell
+        x = x0[edge] + (centre - y0[edge]) * (x1[edge] - x0[edge]) / (y1[edge] - y0[edge])
+        order = np.lexsort((x, row))
+        row, x = row[order], x[order]
+        bounds = np.flatnonzero(np.diff(row)) + 1
+        for r, xs in zip(row[np.r_[0, bounds]], np.split(x, bounds)):
+            if len(xs) % 2:
+                raise ValueError(f"odd crossing count in row {r}")
+            crossings[r].append(xs)
+    rows = np.zeros((ny, (nx + 7) // 8), np.uint8)
+    centres = WEST + (np.arange(nx) + 0.5) * cell
+    for r in range(ny):
+        if not crossings[r]:
+            continue
+        inside = np.zeros(nx, bool)
+        for xs in crossings[r]:
+            a = np.searchsorted(centres, xs[0::2])
+            b = np.searchsorted(centres, xs[1::2])
+            depth = np.zeros(nx + 1, np.int32)
+            np.add.at(depth, a, 1)
+            np.add.at(depth, b, -1)
+            inside |= np.cumsum(depth[:-1]) > 0
+        rows[r] = np.packbits(inside, bitorder="little")
+    return rows, ny, nx
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("zip")
+    parser.add_argument("output")
+    parser.add_argument("--cell-arcsec", type=float, default=30.0)
+    args = parser.parse_args()
+    cell = args.cell_arcsec / 3600.0
+    blob = zipfile.ZipFile(args.zip).read("gshhs_f.b")
+    rows, ny, nx = rasterise(land_polygons(blob), cell)
+    with open(args.output, "wb") as out:
+        out.write(b"MHLAND1\0" + struct.pack("<3d2I", SOUTH, WEST, cell, ny, nx) + rows.tobytes())
+    digest = hashlib.sha256(open(args.output, "rb").read()).hexdigest()
+    manifest = {
+        "source": "GSHHG 2.3.7 full resolution, level 1 (gshhs_f.b in gshhg-bin-2.3.7.zip)",
+        "source_sha256": hashlib.sha256(open(args.zip, "rb").read()).hexdigest(),
+        "grid": {"south": SOUTH, "west": WEST, "cell_deg": cell, "ny": ny, "nx": nx},
+        "land_fraction": float(np.unpackbits(rows, axis=1, bitorder="little")[:, :nx].mean()),
+        "sha256": digest,
+        "created_utc": datetime.now(timezone.utc).isoformat(timespec="seconds"),
+    }
+    with open(args.output + ".json", "w") as stream:
+        json.dump(manifest, stream, indent=1)
+        stream.write("\n")
+    print(json.dumps(manifest))
+
+
+if __name__ == "__main__":
+    main()
