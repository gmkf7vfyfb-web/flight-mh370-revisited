+# Drift map for Pleiades: where objects released on a 0.05 deg grid at 2014-03-08 00:40 UTC
+# are at 2014-03-23 04:00 UTC (the image time). Velocity is surface current plus a fraction
+# of the ERA5 10 m wind; Griffin & Oke's 1.2% stands in for Stokes drift, so there is no
+# explicit Stokes term, and there is no random walk. Build: make drift D=config/drift/pleiades-map.toml
+base = "../ocean.toml"
+name = "pleiades-map"
+models = ["glorys12", "oscar2", "bran2016"]
+wind = "era5_wind_hourly"
+land = "gshhg_land"
+release_utc = "2014-03-08T00:40:00Z"
+end_utc = "2014-03-23T04:00:00Z"
+step_s = 3600.0
+# Impact lies between 00:20 and 01:00; report the fastest object speed in that hour.
+speed_window_utc = ["2014-03-08T00:00:00Z", "2014-03-08T01:00:00Z"]
+
+[grid]
+south = -50.0
+north = -15.0
+west = 70.0
+east = 115.0
+step = 0.05
+
+[[classes]]
+name = "w0.000"
+windage = 0.0
+
+[[classes]]
+name = "w0.012"
+windage = 0.012
+
+[[classes]]
+name = "w0.030"
+windage = 0.03
+
+# Objects released between the nodes, integrated directly, against bilinear interpolation.
+[check]
+sources = 2000
+seed = 1
+south = -40.0
+north = -30.0
+west = 85.0
+east = 100.0
